g":6.7,"fat_g":7.9,"carbs_g":0.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01ynt8m1mc2vfeec","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá thu","ingredient_not_mentioned_by_name:Nước mắm cá","title_ingredient_not_mentioned:Cá thu","unlisted_ingredient_phrase:hon hop"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu027nt8m1zdgbhc9p#variant-1","name":"Cháo thịt gà","detail_name":"Cháo thịt gà","category":"Món nước 5 tuổi","age_group":"5 tuổi","serving":{"raw":"151.3 g / Tô nhỏ","quantity_value":151.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Thịt gà công nghiệp, đùi","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hạt sen khô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Khoai tây gọt vỏ rửa sạch sau đó cắt thành hạt lựu. Nấm rơm cắt bỏ gốc, ngâm muối, rửa sạch, để ráo. Hạt sen khô ngâm nước ấm cho hạt mềm. Thịt gà nên chọn ức gà, rửa với muối sau đó rửa sạch lại với nước, để ráo, xé sợi, ướp gia vị vừa ăn. Gạo các bạn vo sạch sau đó đổ nước và cho hạt sen, thịt gà sợi vào cùng bắt lên bếp. Khi thấy gạo nở bung đều, hạt sen mềm rồi thì tiếp tục phi gốc hành thơm sau đó cho khoai tây, nấm rơm đảo cho thơm rồi đổ vào nồi cháo Nấu sôi đến khi các loại rau củ vừa chín tới, nêm nếm lại, tắt bếp và cho hành ngò và tiêu vào. Cuối cùng các bạn tắt bếp nêm gia vị vừa ăn, cho vào tí tiêu cùng hành poa-rô lá và ngò cho thơm nhé.","nutrition":{"kcal":307.7,"protein_g":15.1,"fat_g":9.7,"carbs_g":40.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu027nt8m1zdgbhc9p","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02ipt8m1b9j35r3r#variant-1","name":"Cuốn tôm","detail_name":"Cuốn tôm","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"130.6 g / Dĩa nhỏ","quantity_value":130.6,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Tôm đồng","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nửa nạc, nửa mỡ (thịt đùi)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bún tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tần ô/cải cúc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Sơ chế tất cả các nguyên liệu: Tôm bóc vỏ, lấy đường chỉ sống lưng, rửa sạch để ráo. Thịt heo rửa sạch, luộc sơ qua nước sôi cho sạch. Các loại rau nhặt sạch, rửa sạch, để ráo. Tôm để ráo nước đem rang chín, cho chút nước mắm. Thịt luộc chín thái mỏng, bún cắt ngắn.\" \"Cho giấm bỗng, đường đỏ và lạc rang (giả nhỏ) vào xoong chưng kỹ cho khô. Trải rau xà lách ra, đặt bún, tôm thịt, giấm bỗng chưng, thơm mùi vào rồi cuốn tròn lại (cuốn chắc tay). Món này dùng với nước mắm và cà cuống.\"","nutrition":{"kcal":165.9,"protein_g":14.6,"fat_g":9,"carbs_g":6.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02ipt8m1b9j35r3r","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tần ô/cải cúc","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:tom thit","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02qzt8m1b0pta3v6#variant-1","name":"Ếch tần hạt sen","detail_name":"Ếch tần hạt sen","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"71.1 g / Dĩa nhỏ","quantity_value":71.1,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Ếch ( thịt đùi)","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Tôm khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rượu trắng (cồn 39 g)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nghệ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"\"Gừng cạo, rửa sạch, giã nhỏ, trộn với rượu. Nghệ cạo vỏ, rửa sạch, giã nhỏ, cho vào 1 thìa nước. Ếch rửa sạch, rạch sống lưng, lột da, mổ bỏ ruột, rứa sạch, chặt mỗi con làm 7 miếng, tẩm rượu, gừng rồi bỏ gia vị vào bóp kỹ, ướp 15 phút. Hạt sen tươi luộc chín. Tôm khô bóc vỏ, rứa sạch, để ráo. Hành khô bóc vỏ, đập giập. \"Cho dầu vào chảo, đun nóng già, bỏ hành củ vào phi thơm, trút thịt ếch vào xào cho ngấm gia vị, cho tôm vào xào cùng, đảo đều, khi tôm chín mềm xúc ra bát. Múc ếch đã xào với tôm cho vào nồi nước dùng nấu với hạt sen, đun nhỏ lửa.Tần như vậy chừng 35-45 phút, thịt ếch và hạt sen chín nhừ, nước cạn sánh, nêm nếm lại vừa ăn là được. Múc tất cả ra bát to, rắc thêm rất ít tiêu. ặt rửa sạch, cắt khúc. Rau mùi tàu nhặt rửa sạch, thái chỉ.","nutrition":{"kcal":109.4,"protein_g":11.5,"fat_g":3.7,"carbs_g":4.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02qzt8m1b0pta3v6","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_me