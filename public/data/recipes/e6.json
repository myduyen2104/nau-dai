":"https://dinhduong2598.food/mon-an/cmrg0p4qu00vit8m191ljs4xq","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:dau thuc","unlisted_ingredient_phrase:dau thuc vat","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:thuc vat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ 9-24 tháng","id":"mon_bot_nha_nau_cho_tre_9_24_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"9-24 tháng","id":"9_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv011mt8m127hi8sjd#variant-1","name":"Bún thang","detail_name":"Bún thang","category":"Món nước 18-35 tháng","age_group":"18-35 tháng","serving":{"raw":"127.3 g / Chén","quantity_value":127.3,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bún tươi","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Trứng vịt (55g/quả)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Thịt gà công nghiệp, lườn","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Gừng đã rửa sạch đem nướng cho đến khi nào chín và có mùi thơm. Bước 2: Cho gà vào nồi luộc, đến khi sôi thì cho một chút gia vị 1 muỗng hạt nêm, 1/2 muỗng đường, 1 muỗng cafe muối và hành khô, gừng đã nướng thơm vào, hạ nhỏ lửa để gà chín bên trong. Sau khi vớt ra để nguội Sau, bạn dùng tay xé sợi vừa ăn và để riêng. Bước 3: Xương heo cho vào nồi đun sôi với nước, sau đó đổ hết nước đó đi, cho ra vào nước lạnh rửa sạch vụn xương. Sau đó đổ xương vào nồi nước luộc gà ninh nhừ (khoảng 2 – 3 tiếng) để làm nước dùng. Bước 4: Trong khi ninh xương để nấu nước dùng, bạn bật một bên bếp khác lên, cho chảo chống dính lên bếp. Khi chảo nóng già thì cho tôm khô vào rang thơm rồi cho ra đĩa. Bước 5: Cho dầu ăn vào tráng đều mặt chảo, cho bát trứng đã đánh vào rán sao cho thật mỏng. Đến chi chín cho trứng ra đĩa, đợi trứng nguội thì thái thành sợi nhỏ. Bước 6: Khi nồi nước ninh xương đun được khoảng 50 phút đến 1 tiếng, thì cho tôm khô đã rang, đường phèn, hạt nêm, muối và chút nước mắm vào, khuấy đều. Tiếp tục ninh thêm 1 hoặc 2 tiếng nữa thì nêm nếm lại gia vị cho vừa miệng, cho hành lá và rau răm xắt nhỏ vào, rồi tắt bếp. Bước 7: Bún đem trần qua với nước, xếp các loại nhân lên trên rồi chan nước dùng vào là xong. Nếu ai có thể ăn được mắm tôm thì bạn cho ½ thìa cafe mắm tôm lên trên.","nutrition":{"kcal":197.2,"protein_g":8.1,"fat_g":7.5,"carbs_g":24.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv011mt8m127hi8sjd","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt gà công nghiệp, lườn","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mam tom","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:rau ram","unlisted_ingredient_phrase:tom kho","unlisted_ingredient_phrase:uong phen","unlisted_ingredient_phrase:voi nuoc","unlisted_ingredient_phrase:xuong heo"],"source_categories":[{"label":"Món nước 18-35 tháng","id":"mon_nuoc_18_35_thang","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"18-35 tháng","id":"18_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw014wt8m1qf8lomki#variant-1","name":"Cà chua dồn thịt","detail_name":"Cà chua dồn th