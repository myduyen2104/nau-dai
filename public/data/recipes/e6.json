 tay cho đến khi đường tan ra và chuyển thành màu nâu. Tiếp theo, bạn cho thêm nước vào, khuấy đều tay và đun sôi. Đun tiếp cho đến khi nước màu sánh và sệt lại thì bắc chảo xuống.Bạn cho nước màu vào nồi gà, trộn đều và cho lên bếp để đun sôi. Khi gà sôi, bạn dùng đũa đảo đều, chỉnh lửa nhỏ liu riu, cho hành củ, sả ớt vào và mở nắp để đun cho đến khi thịt gà săn, chắc thịt, còn nước kho thì sệt và sánh lại là được. Bạn nêm nếm lại cho vừa miệng là có thể tắt bếp.","nutrition":{"kcal":203.5,"protein_g":18.4,"fat_g":12,"carbs_g":5.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02tet8m1e6d8irap","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Sả cây","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Ớt khô bột","ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:nuoc mau"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03e7t8m15rxjn7n9#variant-1","name":"Mì Quảng gà","detail_name":"Mì Quảng gà","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"492.5 g / Tô nhỏ","quantity_value":492.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Mì quảng tươi","quantity_raw":"170 g","quantity_value":170,"quantity_unit":"g"},{"name":"Thịt gà ta","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hoa chuối","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau kinh gi