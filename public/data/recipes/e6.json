_unit":"g"}],"instructions_raw":"Miến dong ngâm với nước ấm cho sợi miến mềm, vớt ra để ráo, cắt vừa ăn. Thịt bò rửa sạch, thái mỏng, ướp gia vị. Nấm hương khô ngâm mềm, thái mỏng. Cải bó xôi cắt gốc, rửa sạch, cắt khúc vừa ăn. Cà rốt gọt vỏ, rửa sạch, thái sợi. Ớt vàng to, ớt đỏ to rửa sạch, thái lát mỏng. Hành tây gọt vỏ, rửa sạch, thái mỏng. Rau húng, rau mùi, hành lá rửa sạch, Bắt chảo lên bếp, thêm dầu, phi thơm tỏi, cho thịt bò vào xào chín rồi vớt ra. Thêm tiếp dầu vào chảo để xào nấm hương, cà rốt, hành tây, ớt đỏ to, ớt vàng to, cải bó xôi. Nêm gia vị vừa ăn, múc ra. Làm nước sốt: Bắt chảo lên bếp, thêm dầu ăn tỏi phi thơm, thêm xì dầu, đường, nước, nấu sôi, thêm bột bắp khuấy đều cho nước sốt sánh lại. Trộn miếng dong với các nguyên liệu đã xào chín, thêm nước sốt vào đảo đều cho ngấm đều. Thêm hành phi, vừng rang, dầu mè lên trên và đảo đều.","nutrition":{"kcal":358.6,"protein_g":12.3,"fat_g":10.9,"carbs_g":53.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03jvt8m15p12txxt","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô 6-7 tuổi","id":"mon_kho_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03xpt8m1xf7pj8pf#variant-1","name":"Phở gà","detail_name":"Phở gà","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"449 g / Tô vừa","quantity_value":449,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"250 g","quantity_value":250,"quantity_unit":"g"},{"name":"Thịt gà ta","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau ngổ","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau húng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Thịt gà sau khi đã rửa sạch chà xát với muối, sau đó cho vào nồi nước lạnh đun với lửa vừa. Khi luộc bỏ thêm gừng đập dập, hành tím và một ít muối. Rau giá ăn kèm rửa sạch, để ráo. Gà luộc sau khi sôi thì vặn nhỏ lửa, vớt bọt. Lưu ý luộc gà không nên chín quá, thịt gà dễ bị khô và mất ngọt. Để kiểm tra xem gà có chín chưa, bạn có thể dùng đũa xâm sâu vào phần thịt, nếu gà chín thì sẽ không thấy nước đỏ chảy ra. Sau khi gà chín thì vớt gà ra để nguội, bạn có thể thái miếng hoặc xé nhỏ thành sợi tùy thích. Phần xương gà sau khi đã rửa sạch thì cho vào nồi áp suất và đổ nước sôi vào hầm cho đến khi xương mềm và hết vị ngọt. Nếu không sợ béo, bạn có thể đổ nước luộc gà vừa luộc và bỏ thêm xương gà đã được tách thịt ở trên vào hầm chung. Cho túi vải gia vị đã buộc vào nồi, nêm nếm gia vị cho vừa ăn và khuấy đều đến khi gia vị hòa quyện hết. Hầm thêm khoảng 20 phút thì vớt túi gia vị đó ra. Sau đó, để lửa nhỏ liu riu cho nước nóng. Cho bánh phở đã trần vào tô, xếp thịt gà luộc lên trên. Khi ăn, rải hành lá và các loại rau thơm trang trí, chan nước lèo vào rồi ăn cùng rau sống hoặc quẩy sẽ rất ngon.","nutrition":{"kcal":607.9,"protein_g":24.3,"fat_g":16,"carbs_g":93.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03xpt8m1xf7pj8pf","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Chanh","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Tương ngô","unlisted_ingredient_phrase:xuong ga"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72n0498t8m1kfg9q9t5#variant-1","name":"ROHTO N26 CHẢ GIÒ NHÂN TÔM","detail_name":"ROHTO N26 CHẢ GIÒ NHÂN TÔM","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"55 g","quantity_value":55,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Chả giò nhân tôm thịt Vissan","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":138.4,"protein_g":0,"fat_g":5,"carbs_g":0},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72n0498t8m1kfg9q9t5","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72n049ht8m1do203i1x#variant-1","name":"ROHTO N26 MẮM CHƯNG","detail_name":"ROHTO N26 MẮM CHƯNG","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"107.3 g","quantity_value":107