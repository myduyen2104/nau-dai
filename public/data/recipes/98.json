 kế đến cho tỏi băm vào xào cho hơi vàng, cho thịt vào chảo, trộn đều, khoảng 3 phút. Kế đến cho tôm vào trộn đều. Tiếp tục xào thêm khoảng 10 phút cho nước gia vị trong chảo rút hết, chỉ còn chút mỡ. Tắt lửa, bắt chảo tôm ra khỏi bếp. Món tôm ram thịt dùng chung với cơm nóng hay cháo trắng đều ngon.","nutrition":{"kcal":150.8,"protein_g":11.7,"fat_g":9.5,"carbs_g":5.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05bwt8m1uo3j2jpz","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Hành lá (hành hoa)","ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05hpt8m11myk9fbf#variant-1","name":"Trứng vịt luộc","detail_name":"Trứng vịt luộc","category":"Món mặn","age_group":null,"serving":{"raw":"120 g / Dĩa vừa","quantity_value":120,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Trứng vịt (55g/quả)","quantity_raw":"110 g","quantity_value":110,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Đun nước sôi, cho trứng vào luộc trong 10 phút. Cho trứng ra nước lạnh, bóc vỏ. Cho tỏi, đường vào chén, giả nát, cho nước mắm, nước lọc, nước cốt chanh, nêm nếm vừa ăn","nutrition":{"kcal":205.2,"protein_g":14.6,"fat_g":13.2,"carbs_g":7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05hpt8m11myk9fbf","quality