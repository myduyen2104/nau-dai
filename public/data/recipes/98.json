[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tw00c8t8m1c0xll13d#variant-1","name":"Bánh bèo thập cẩm","detail_name":"Bánh bèo thập cẩm","category":"Món khô","age_group":null,"serving":{"raw":"205 g / Dĩa","quantity_value":205,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":[{"name":"Bột dong lọc","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Bột gạo tẻ","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Bột gạo nếp","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Mỡ lợn nước","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Pha hỗn hợp bột gạo tẻ, bột gạo nếp với nước theo tỷ lệ 1 bột : 2 nước, để bột nở khoảng 30 phút, khuấy đều trước khi làm bánh. Cho chén hấp lên xửng hấp, nồi hấp cho nước nhiều và lửa lớn, cho chén nóng đều thì đổ bột vào. Đậy nắp, hấp chín bánh, khi bánh chín vớt ra để nguội. Đậu xanh rửa sạch, ngâm mềm, luộc chín tán nhuyễn để làm nhân bánh bèo. Tôm khô rửa sạch, tán nhuyễn sấy khô rưới lên bánh. Tôm rửa sạch, ướp gia vị, xào chín. Hành lá rửa sạch, để ráo, cắt nhỏ làm mỡ hành. Cho nước sôi vào giữa lòng bột, trộn đều. Sau đó cho phần bột còn lại vào, dùng tay trộn đều cho đến khi bột dẻo, mịn. Bột đã nhào mịn, ngắt một phần nhỏ lăn trong rồi cán dẹt, cho một ít nhân tôm vào giữa gấp đôi miếng bột lại, vuốt chặt mép để giữ miếng bánh hình bán nguyệt. Luộc bánh: Bắt nồi nước lên đun sôi, cho thêm ít dầu ăn và muối, thả bánh vào luộc cho đến khi bánh nổi lên là đã chín. Vớt bánh ra thả vào ngay vào một bát nước nguội, sau đó vớt ra sếp lên đĩa rồi thoa một chút dầu ăn để bánh không bị dính vào nhau. Sắp bánh bèo, bánh bột lọc ra đĩa, thêm nhân đậu xanh lên bánh bèo, rưới tôm khô lên. Thêm mỡ hành, giò lụa, rau chua lên rồi chan nước mắm đã pha vào là thưởng thức.","nutrition":{"kcal":604.2,"protein_g":14.6,"fat_g":21.6,"carbs_g":88.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00c8t8m1c0xll13d","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:au xanh","unlisted_ingredient_phrase:banh tom","unlisted_ingredient_phrase:bot tron","unlisted_ingredient_phrase:gio lua","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:lam banh","unlisted_ingredient_phrase:nhan tom","unlisted_ingredient_phrase:tom kho","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tw00f5t8m1itkpix8h#variant-1","name":"Bánh da lợn","detail_name":"Bánh da lợn","category":"Bánh","age_group":null,"serving":{"raw":"50 g","quantity_value":50,"quantity_unit":"g","portion_label":null},"ingredients":null,"instructions_raw":null,"nutrition":{"kcal":151.5,"protein_g":1.5,"fat_g":5,"carbs_g":25.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00f5t8m1itkpix8h","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","instructions_missing_from_detail","listing_count_not_visible_in_detail"],"integrity_findings":[],"source_categories":[{"label":"Bánh","id":"banh","kind":"food_category","baseLabel":"Bánh"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qy01h4t8m1wlhpzulk#variant-1","name":"Canh bí đao nấu tôm","detail_name":"Canh bí đao nấu tôm","category":"Món canh 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"84.5 g / Chén","quantity_value":84.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bí đao (bí xanh)","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bí gọt vỏ, bỏ ruột cắt sợi nhỏ Tôm bỏ đầu bóc vỏ băm nhuyễn. Sau đó ướp tôm với gia vị cho thấm Xào sơ tôm với dầu ăn và hành phi, cho nước vào nấu sôi. Cho bí đao vô nấu tầm 3 phút. Nêm nếm cho vừa ăn. Múc canh ra tô, rắc hành lên.","nutrition":{"kcal":29.3,"protein_g":2.3,"fat_g":1.2,"carbs_g":2.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qy01h4t8m1wlhpzulk","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Bí đao (bí xanh)","ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 6-7 tuổi","id":"mon_canh_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01w0t8m109mn44f5#variant-1","name":"Canh rau ngót nấu tôm","detail_name":"Canh rau ngót nấu tôm","category":"Món canh 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"46.5 g / Chén","quantity_value":46.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau ngót","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Rau ngót tuốt lá bỏ lá già úa. Rửa sạch vò nát để bớt hăng. Tôm lọt vỏ lấy gân tôm rửa sạch, ướp với gia vị Cho dầu vào nồi phi thơm hành tím cắt mỏng, đổ tôm vào xào đến khi tôm chín. Đổ nước vào chờ sôi bỏ rau ngót vào nhỏ lửa nấu sôi tầm 7 phút vì rau ngót lâu mềm. Chín rau nêm lại vừa ăn.","nutrition":{"kcal":31.1,"protein_g":3,"fat_g":1.1,"carbs_g":2.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01w0t8m109mn44f5","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 25-35 tháng tuổi","id":"mon_canh_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01zxt8m1h2g8z9qm#variant-1","name":"Chả lụa kho tiêu","detail_name":"Chả lụa kho tiêu","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"44 g / Dĩa nhỏ","quantity_value":44,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Giò lụa","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Hành củ tươi gọt vỏ rửa sạch. Chả lụa cắt vừa ăn. Đặt 1 chảo dầu nóng lên bếp phi thơm hành cùng dầu ăn. Cho chả lụa vào đảo đều thêm gia vị cho vừa ăn, để nhỏ lửa đến khi cạn bớt nước thì tắt bếp múc chả ra dĩa và thưởng thức.","nutrition":{"kcal":102.7,"protein_g":6,"fat_g":8.3,"carbs_g":1.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01zxt8m1h2g8z9qm","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:cha lua"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02j7t8m1ete8yvld#variant-1","name":"Đậu cô ve (đậu que) xào thịt bò","detail_name":"Đậu cô ve (đậu que) xào thịt bò","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"59.5 g / Dĩa nhỏ","quantity_value":59.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu cô ve","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, cắt thành miếng mỏng, bản to,ướp với hạt nêm, nước tương và một ít dầu ăn rồi để trong vòng 15 – 20 phút cho thịt bò ngấm gia vị. Đậu que nhặt rồi bẻ khúc ngắn khoảng 2 lóng tay. Rửa sạch rồi trụng qua nước sôi có ngâm chút muối. Chuẩn bị một chiếc chảo vừa, đun sôi 1 muỗng dầu ăn, cho hành tây vào sơ cho đến khi thấy thịt bò trong lại thì cho thịt bò vào xào chung cho đến khi thịt bò săn lại. Ch thịt bò ra chén và tiếp tục sử dụng chảo đó để đun sôi dầu rồi phi thơm tỏi, cho đậu vào xào, nêm nếm gia vị vừa ăn. Xào đều tay cho đậu chín tới rồi cho thịt bò vừa xào lúc nãy vào , đảo đều rồi tắt bếp.","nutrition":{"kcal":141.5,"protein_g":7.9,"fat_g":3.7,"carbs_g":19.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02j7t8m1ete8yvld","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Cà rốt","unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nuoc tuong"],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02wnt8m1zheowv0i#variant-1","name":"Gỏi đu đủ tôm thịt","detail_name":"Gỏi đu đủ tôm thịt","category":"Món xào 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"156.2 g / Dĩa vừa","quantity_value":156.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Đu đủ xanh","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Sau khi mua tôm về, bạn cần rửa sạch với muối, bỏ chỉ đen trên lưng tôm rồi đem hấp. Sau khi tôm chín, bạn vớt ra để ráo, lột vỏ và bỏ phần đầu, nhớ chừa lại phần đuôi giúp trang trí món gỏi thêm bắt mắt. Thịt: sau khi mua về bạn cũng rửa sạch lại với muối, rồi mang đi luộc chín, sau đó thái từng lát mỏng. Để sẵn 1 thau nước lạnh, càng lạnh càng tốt, bạn cho vào thau một ít đường, vắt thêm 1 quả chanh vào thau và thêm vài viên đá lạnh. Gọt sạch vỏ đu đủ, rửa sạch rồi đem bào thành những sợi dài. Sau đó ngâm trong thau nước lạnh đã chuẩn bị sẵn để đu đủ không bị đen và sạch mủ. Cà rốt bạn cạo phần vỏ bên ngoài, rửa sạch lại với nước muối loãng, bào hoặc thái thành từng sợi mỏng vừa ăn. Ớt bạn bổ dọc, lấy hết hạt và cắt sợi dài như cà rốt. Hành củ bóc vỏ, rửa sạch, cắt khoanh mỏng. Hành tím, tỏi bóc bỏ vỏ, băm nhuyễn, phi vàng Chanh vắt lấy nước, lọc bỏ hạt. Đậu phộng rang sẵn, đập dập. Pha nước trộn gỏi: Cho đường với nước mắm (theo tỷ lệ 1:1) vào nồi nhỏ, nấu hỗn hợp trên cho đến lúc đường tan thì tắt bếp, để nguội và chờ cho đến khi nước mắm keo lại như mật ong thì cho ít nước cốt chanh vào. Vậy là nước trộn gỏi chua ngọt của chúng ta đã hoàn thành. Ướp gia vị các nguyên liệu Bạn cần chuẩn bị sẵn 1 cái tô to, cho lần lượt các nguyên liệu sau vào: giấm, nước lọc, muối, sau đó khuấy đều. Tiếp đó, lần lượt cho cà rốt, hành tây, ớt đỏ ngâm từ 15 cho đến 30 phút, vớt ra ngoài, vắt nhẹ cho đến khi ráo nước. Hoàn thành món gỏi đu đủ tôm thịt : Bây giờ, việc bạn cần làm là trộn tất cả các nguyên liệu lại với nhau (tôm thịt, cà rốt, đu đủ, hành tây, ớt) cùng với hỗn hợp nước mắm đường chua ngọt vào trong một cái bát to, trộn đều. Sau cùng, nêm nếm cho hợp với khẩu vị của gia đình bạn. Bày thành phẩm gỏi đu đủ tôm thịt ra đĩa, cho thêm rau răm, rắc ít lạc rang lên ăn kèm.","nutrition":{"kcal":166.8,"protein_g":7,"fat_g":9,"carbs_g":14.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02wnt8m1zheowv0i","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đu đủ xanh","unlisted_ingredient_phrase:chua ngot","unlisted_ingredient_phrase:hanh cu","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:it uong","unlisted_ingredient_phrase:mat ong","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nho chua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:tom thit","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào 8-18 tuổi","id":"mon_xao_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo036gt8m1n8jtiofv#variant-1","name":"LH-C1-Salad Trộn Sốt Mayonnaise","detail_name":"LH-C1-Salad Trộn Sốt Mayonnaise","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"81.1 g","quantity_value":81.1,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Rau sà lách","quantity_raw":"27.3 g","quantity_value":27.3,"quantity_unit":"g"},{"name":"Cà chua bi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cải bắp tím","quantity_raw":"4 g","quantity_value":4,"quantity_unit":"g"},{"name":"Quất chín (cả vỏ)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"8.3 g","quantity_value":8.3,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"4 g","quantity_