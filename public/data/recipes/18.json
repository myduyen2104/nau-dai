[{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00zft8m1u23ezgj8#variant-1","name":"Bún khô xào tôm giá hẹ","detail_name":"Bún khô xào tôm giá hẹ","category":"Món khô","age_group":null,"serving":{"raw":"295 g / Dĩa vừa","quantity_value":295,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Bún khô","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"90 g","quantity_value":90,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hẹ lá","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"12 g","quantity_value":12,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Bún khô ngâm mềm, vớt để ráo nước. Cắt khúc vừa ăn. Giá rửa sạch, để ráo Hẹ lá bỏ lá úa, rửa sạch, để ráo, cắt khúc. Tôm rửa sạch, bóc vỏ, ướp gia vị Bắt chảo lên bếp, thêm dầu, thêm hành tỏi băm phi thơm, rồi cho tôm vào đảo đều,thêm giá, hen vào xào chín. Thêm bún khô vào trộn đều, thêm gia vị vừa ăn đảo đều cho chín rồi tắt bếp.","nutrition":{"kcal":593.9,"protein_g":27.3,"fat_g":15.4,"carbs_g":87.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00zft8m1u23ezgj8","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv010et8m1jtzu7iws#variant-1","name":"Bún ốc","detail_name":"Bún ốc","category":"Món nước","age_group":null,"serving":{"raw":"440.5 g / Tô nhỏ","quantity_value":440.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"200 g","quantity_value":200,"quantity_unit":"g"},{"name":"Ốc bươu","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hoa chuối","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sơ chế nguyên liệu: – Hành, tỏi mỗi loại một củ đem bóc vỏ, đập dập, băm nhỏ. Một củ hành còn lại đem thái mỏng. – Sơ chế ốc: – Nên mua ốc trước 1 – 2 ngày và ngâm ốc với nước vo gạo để ốc nhả hết chất bẩn. Thay nước vo gạo thường xuyên vào mỗi buổi nấu cơm. Nếu không có nhiều thời gian, hãy ngâm ốc với 2 – 3 trái ớt băm nhuyễn. – Rửa sạch ốc rồi luộc chín, lễ ruột ốc ra, bỏ hết phần phân ở ruột ốc, đem rửa sạch rồi bóp với giấm một lần cho sạch nhớt. – Đem ruột ốc ướp với nước mắm, bột nghệ, một chút hành tỏi băm khoảng 30 phút cho thấm gia vị. – Nước luộc ốc để im cho lặng cặn rồi lọc lấy phần nước trong nấu bún. – Cà chua rửa sạch, bổ miếng cau theo chiều dọc thành 6 – 8 miếng. – Ớt bỏ hạt, băm nhỏ. – Các loại rau sống rửa sạch, để ráo, thái nhỏ vừa ăn. – Hành lá, tía tô, rau thơm rửa sạch, thái nhỏ. – Xương heo rửa sạch, chần sơ qua nước sôi. – Giò lụa cắt từng khúc Các bước nấu bún ốc: Bước 1. Xào ớt. – Dùng một chiếc chảo nhỏ, cho vào khoảng 5 thìa dầu ăn, khi dầu nóng bạn cho ớt băm vào xào rồi múc ra chén. Bước 2. Nấu nước dùng. – Cho xương heo vào nồi với khoảng 2 lít nước cùng một chút muối, hạt tiêu, hành tím thái mỏng. Ninh xương với lửa nhỏ và không đậy vung, thường xuyên vớt bọt để nước dùng trong hơn. Sau khoảng 40 phút – 1 tiếng thì vớt xương ra, chỉ lấy nước. – Dùng một chiếc nồi khác, phi thơm hành tỏi băm với chút dầu ăn rồi cho nhân ốc vào xào, đảo nhanh tay với lửa lớn để ốc thấm dầu, săn lại và thơm. Khi ốc chín, tắt bếp rồi trộn với lá tía tô xắt nhỏ. Vớt ốc ra chén để riêng, múc nước xào để riêng. – Tiếp tục phi thơm hành tỏi với chút dầu ăn, cho cà chua vào xào chín rồi đổ nước luộc ốc, nước hầm xương và nước xào ốc vào nấu sôi, thêm chút giấm bỗng để nước dùng có vị chua dịu. Nêm nếm gia vị vừa ăn, hạ lửa liu riu giữ nóng. Bước 3. Thành phẩm bún ốc. Chần bún qua nước sôi rồi cho vào tô với lượng vừa ăn, cho nhân ốc lên trên, rắc thành lá, rau thơm rồi chan nước dùng nóng. Ăn kèmrau sống.","nutrition":{"kcal":445.1,"protein_g":18.8,"fat_g":10.7,"carbs_g":69},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv010et8m1jtzu7iws","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Ốc bươu","ingredient_not_mentioned_by_name:Hoa chuối","ingredient_not_mentioned_by_name:Chanh","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:8 mieng","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham","unlisted_ingre