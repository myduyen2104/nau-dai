on-an/cmrg0p7gh054pt8m1kmv0mseh","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Xì dầu","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:nuoc dung","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh054ut8m18lswz34g#variant-1","name":"Thịt bò tái me","detail_name":"Thịt bò tái me","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"109.2 g / Dĩa vừa","quantity_value":109.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá (loại đặc biệt)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch rồi thái mỏng. Me rửa sạch rồi ngâm với nước sôi để lấy nước cốt. Hành tây lột vỏ, cắt khoanh rồi ngâm vào nước đá lạnh. Hành tím lột vỏ, cắt lát mỏng. Đậu phộng rang vàng, lột vỏ. Ngò gái , ngò rí rửa sạch, để ráo. Tỏi lột vỏ, băm nhuyễn. Ớt tỉa hoa, xắt lát. Trộn đều hỗn hợp đường, nước mắm, tỏi, hạt tiêu. Dùng bao tay bóp bóp cho thịt bò ngấm đều gia vị rồi để ướp trong vòng 30 phút . Nước cốt me cho lên bếp đun sôi với đường, khuấy đều cho đến khi hỗn hợp keo lại. Sau đó cho thịt bò vào xào tái. Trộn các nguyên liệu trên lại với nhau rồi nêm nêm lại với nước mắm cho vừa miệng ăn. Cho thịt bò lên dĩa, rắc lên ít ngò rí, tiêu cho món ăn dậy vị thơm.","nutrition":{"kcal":156.6,"protein_g":15,"fat_g":7.6,"carbs_g":7.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh054ut8m18lswz34g","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Quả me chua","ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:ngo gai","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh056it8m1f1d0463l#variant-1","name":"Thịt heo kho măng","detail_name":"Thịt heo kho măng","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"75 g / Dĩa nhỏ","quantity_value":75,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Măng tre","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước dừa non tươi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thịt heo rửa sạch để ráo ướp gia vị trong 30 phút. Măng tre luộc xả nước nhiều lần cho bớt đắng, cắt miếng vừa ăn. Hành củ tươi, tỏi ta lột vỏ rửa sạch băm nhỏ. Hành lá rửa sạch bỏ rể cắt nhỏ. Đặt nồi lên bên phi thơm hành tỏi, cho tiếp thịt và xào chung cho thịt săn lại. Kế tiếp cho măng vào cùng với nước dừa tươi kho đến khi thịt mềm, nêm nếm gia vị vừa ăn rồi cho hành lá lên mặt. Sau cùng tắt bếp và có thể dùng được.","nutrition":{"kcal":183.5,"protein_g":7.6,"fat_g":15.4,"carbs_g":4.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh056it8m1f1d0463l","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:thit va","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh0571t8m1bac9ia2y#variant-1","name":"Thịt heo luộc chấm mắm tỏi","detail_name":"Thịt heo luộc chấm mắm tỏi","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"52 g / Dĩa nhỏ","quantity_value":52,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Thịt heo mua về rửa thật sạch với nước muối loãng. Nếu không thích ăn thịt luộc nhiều mỡ thì bạn có thể chọn mua thịt heo đùi sẽ nhiều nạc hơn nhé! Cho thịt ba chỉ đã rửa sạch vào nồi nước sôi cùng với hành tím, luộc chín rồi vớt ra. Đặt miếng thịt heo lên thớt. Do miếng thịt còn khá nóng nên bạn có thể ghim đũa vào miếng thịt rồi dùng dao cắt thịt luộc thành những lát mỏng. Cho tỏi, đường vào chén, giả nhuyễn, thêm nước mắm, nước lọc khuấy tan, thêm nước cốt chanh, nêm nếm vừa ăn.","nutrition":{"kcal":184.3,"protein_g":8.4,"fat_g":14.1,"carbs_g":5.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh0571t8m1bac9ia2y","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gi05but8m11drsee1y#variant-1","name":"Tôm rim thịt ba rọi","detail_name":"Tôm rim thịt ba rọi","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"51 g / Dĩa nhỏ","quantity_value":51,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Tôm đồng","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Tôm rửa sạch, cắt bỏ đuôi, để ráo nước, ướp gia vị. Đặt chảo lớn lên bếp, để lửa lớn, khi chảo thật nóng, cho dầu ăn vào, kế đến cho tỏi băm vào xào cho hơi vàng, cho thịt vào chảo, trộn đều, khoảng 3 phút. Kế đến cho tôm vào trộn đều. Tiếp tục xào thêm khoảng 10 phút cho nước gia vị trong chảo rút hết, chỉ còn chút mỡ. Tắt lửa, bắt chảo tôm ra khỏi bếp. Món tôm ram thịt dùng chung với cơm nóng hay cháo trắng đều ngon.","nutrition":{"kcal":107.9,"protein_g":7.8,"fat_g":7.1,"carbs_g":3.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05but8m11drsee1y","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]