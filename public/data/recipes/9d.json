[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tx00krt8m1tv6uf17b#variant-1","name":"Bánh ướt","detail_name":"Bánh ướt","category":"Món khô","age_group":null,"serving":{"raw":"250 g / Phần","quantity_value":250,"quantity_unit":"g","portion_label":"Phần"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"95 g","quantity_value":95,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Bánh tôm","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Nem chua","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau húng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Bột bánh ướt thêm một chút xíu muối, thêm nước vào khuấy đều cho đến khi bột tan hoàn toàn. Bắc chảo lên bếp mở lửa vừa, thêm dầu ăn vào chảo, phi thơm hành tím, khi hành thơm vàng bạn vớt ra chén 1 nửa để ăn kèm. Bắc chảo lên bếp mở lửa vừa, quét dầu ăn lên mặt chảo, đổ một vá bột vào chảo, lắc nhẹ để bột dàn mỏng đều, đậy nắp lại. Sau 20 - 25 giây khi bánh đã chín, bạn đổ bánh ra mâm sạch (đã phết dầu) rồi cuốn bánh lại, nhanh tay đổ bột vào chảo để làm mẻ bánh thứ 2. Dưa leo rửa sạch, cắt thành những thanh nhỏ, ngắn khoảng 1 lóng tay. Rau thơm rửa sạch, cắt nhỏ, chả lụa cắt miếng nhỏ khoảng 1 lóng tay, giá trụng với nước sôi khoảng 2 phút cho chín. Xếp bánh ướt rau thơm, dưa leo, chả lụa, bánh tôm, nem chua, hành phi ra đĩa và chấm với nước mắm pha, ăn ngay khi còn nóng bạn nhé.","nutrition":{"kcal":604.8,"protein_g":19.2,"fat_g":14.2,"carbs_g":100.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tx00krt8m1tv6uf17b","quality_status":"needs_review","warnings":["duplicate_identical_catalog_metadata","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh uot","unlisted_ingredient_phrase:bot banh","unlisted_ingredient_phrase:cha lua","unlisted_ingredient_phrase:mam pha","unlisted_ingredient_phrase:nuoc mam pha","unlisted_ingredient_phrase:rau thom","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00lkt8m1xmh88dv0#variant-1","name":"Bắp nếp luộc (1/2Trái vừa)","detail_name":"Bắp nếp luộc (1/2Trái vừa)","category":"Món ăn vặt từ 5-18 tuổi","age_group":"5-18 tuổi","serving":{"raw":"60 g","quantity_value":60,"quantity_unit":"g","portion_label":null},"ingredients":null,"instructions_raw":null,"nutrition":{"kcal":103.2,"protein_g":2.3,"fat_g":1.3,"carbs_g":20.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00lkt8m1xmh88dv0","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","instructions_missing_from_detail","listing_count_not_visible_in_detail"],"integrity_findings":[],"source_categories":[{"label":"Món ăn vặt từ 5-18 tuổi","id":"mon_an_vat_tu_5_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món ăn vặt"}],"source_age_group":{"label":"5-18 tuổi","id":"5_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00u6t8m12hutdysx#variant-1","name":"Bột gan gà, cà rốt","detail_name":"Bột gan gà, cà rốt","category":"Món bột nhà nấu cho trẻ từ 7-8 tháng","age_group":"7-8 tháng","serving":{"raw":"65 g / Chén","qua