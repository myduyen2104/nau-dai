tegory","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bv029mt8m1l48aome7#variant-1","name":"Cháo tim heo bí đỏ hạt sen","detail_name":"Cháo tim heo bí đỏ hạt sen","category":"Cháo 9-12 tháng tuổi","age_group":"9-12 tháng","serving":{"raw":"87 g / Chén","quantity_value":87,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Tim heo (lợn)","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Bí đỏ (bí ngô)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"}],"instructions_raw":"* Tim heo rửa qua muối, sau đó rửa sạch lại bằng nước, băm nhuyễn. * Hạt sen rửa sạch, tách bỏ tim sen. Bí đỏ gọt vỏ, bỏ hột, rửa sạch. Hạt sen và bí đỏ đem đi luộc chín mềm, vớt để ráo, tán nhuyễn. * Hòa tan tim heo với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng, bắc lên bếp khuấy đều cho đến khi sôi, thêm hạt sen và bí đỏ vào cho sôi lại. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":195.2,"protein_g":6.8,"fat_g":8.1,"carbs_g":23.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bv029mt8m1l48aome7","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Bí đỏ (bí ngô)","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam"],"source_categories":[{"label":"Cháo 9-12 tháng tuổi","id":"chao_9_12_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"9-12 tháng","id":"9_12_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02k1t8m1jnxz05tx#variant-1","name":"Đậu hà lan xào tỏi","detail_name":"Đậu hà lan xào tỏi","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"81.2 g / Dĩa nhỏ","quantity_value":81.2,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Đậu hà lan","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, cắt thành miếng mỏng, bản to,ướp với hạt nêm, nước tương và một ít dầu ăn rồi để trong vòng 15 – 20 phút cho thịt bò ngấm gia vị. Đậu que nhặt rồi bẻ khúc ngắn khoảng 2 lóng tay. Rửa sạch rồi trụng qua nước sôi có ngâm chút muối. Chuẩn bị một chiếc chảo vừa, đun sôi 1 muỗng dầu ăn, cho hành tây vào sơ cho đến khi thấy thịt bò trong lại thì cho thịt bò vào xào chung cho đến khi thịt bò săn lại. Ch thịt bò ra chén và tiếp tục sử dụng chảo đó để đun sôi dầu rồi phi thơm tỏi, cho đậu vào xào, nêm nếm gia vị vừa ăn. Xào đều tay cho đậu chín tới rồi cho thịt bò vừa xào lúc nãy vào , đảo đều rồi tắt bếp.","nutrition":{"kcal":92.4,"protein_g":4.9,"fat_g":3.2,"carbs_g":11.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02k1t8m1jnxz05tx","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu hà lan","ingredient_not_mentioned_by_name:Đường kính","title_ingredient_not_mentioned:Đậu hà lan","unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nuoc tuong","unliste