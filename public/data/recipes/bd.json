_g":32.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00ynt8m1qwwieuck","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00zht8m1cx3fc7c7#variant-1","name":"Bún mắm","detail_name":"Bún mắm","category":"Món nước 18-35 tháng","age_group":"18-35 tháng","serving":{"raw":"144.3 g / Tô nhỏ","quantity_value":144.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Mực tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cá điêu hồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Sơ chế nguyên liệu Đầu tiên, làm sạch mực, cắt thành khoanh tròn. Tôm thì cũng rửa sạch, cắt bỏ râu và đầu tôm, còn xương heo tương tự cũng được rửa sạch và cắt khúc. Sả đập dập, cắt nhỏ còn cà tím cắt khúc dài vừa ăn. Nấu mắm cá linh Dùng một nồi nhỏ nấu sôi 200ml nước. Khi nước sôi, cho mắm cá linh vào, nấu đến khi mắm cá dẻo, mềm là được. Sau đó, múc nước mắm cá ra, lọc qua rây, bỏ phần xác chỉ lấy phần nước. Đặt một nồi khác lên bếp cho nước và xương heo vào nồi, nấu sôi khoảng 20 phút. Sau đó, bạn phi thơm sả với dầu ăn trong chảo, cho cà tím vào xào 3 phút. Tiếp theo, cho cà tím đã xào, ớt, nước mắm cá linh vào nồi xương heo nấu cùng. Nêm gia vị sao cho vừa ăn, nấu thêm khoảng 10 phút. Thịt heo quay cắt miếng nhỏ, vừa ăn. Tôm, mực ống đem luộc chín. Khi tôm chín sẽ chuyển sang màu hồng cam và cong lại. Cuối cùng bạn chỉ cần cho bún tươi ra tô, chan nước lên, thêm thịt heo quay, tôm, mực ống vào , ăn kèm với giá.","nutrition":{"kcal":235.3,"protein_g":9.3,"fat_g":11.1,"carbs_g":25.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00zht8m1cx3fc7c7","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:ca linh","unlisted_ingredient_phrase:heo quay","unlisted_ingredient_phrase:mam ca linh","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:xuong heo"],"source_categories":[{"label":"Món nước 18-35 tháng","id":"mon_nuoc_18_35_thang","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"18-35 tháng","id":"18_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw014nt8m1yjuiaj8u#variant-1","name":"Cá chim kho ngót","detail_name":"Cá chim kho ngót","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"75 g / Dĩa nhỏ","quantity_value":75,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá chim","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cần tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hà