 ri thì bạn nên thái to một chút. Luộc cà rốt và khoai tây chín nhưng không quá mềm. Vớt ra và để cho ráo nước. Nấu cà ri Cho một lớp dầu ăn mỏng vào nồi to. Khi dầu đã nóng, bạn cho thịt gà đã ướp và đảo sơ cho nóng rồi cho nước dừa vào. Hầm thịt gà với nước dừa khoảng 30 phút thì cho các loại củ vào hầm cùng. Nếu bạn thấy nước quá cạn thì có thể cho thêm một chút nước ấm nhưng tốt nhất vẫn là nên cho thêm nước dừa. Khi mà thịt gà đã chín thì bạn hạ nhỏ lửa lại, hầm thêm chút nữa cho nước cà ri sắc và thật thấm, đậm vị thì tắt bếp.","nutrition":{"kcal":288.4,"protein_g":12.2,"fat_g":10.3,"carbs_g":37.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tx00h0t8m1rg3jn5yf","quality_status":"unmatched","warnings":["duplicate_listing_row_occurrence","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Cary bột","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:khoai tay","unlisted_ingredient_phrase:tuong nhat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 3-4 tuổi","id":"mon_nuoc_3_4_tuoi","kind":"food_category","baseLabel":"Món nước 3-4 tuổi"}],"source_age_group":null,"source_tag_evidence_status":"catalog_capture_unmatched_to_detail"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00n1t8m1p7y2hez1#variant-1","name":"BBGP-18-24M-Măng tây xào","detail_name":"BBGP-18-24M-Măng tây xào","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"22.9 g","quantity_value":22.9,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Măng tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"ins