i thấy nồi súp sánh lại thì dừng lại. Không nên đổ ngay cùng 1 lúc sẽ dễ bị đặc quá nhé. Sau cùng từ từ đổ trứng đánh tan vào khấy theo 1 chiều để tạo vân cho đẹp. Nấu đến khi nồi súp chuyển màu trong thì tắt bếp, múc ra chén, rắc rau mùi, ttiêu bột, ớt tùy ý lên và thưởng thức","nutrition":{"kcal":157.9,"protein_g":7.4,"fat_g":4.2,"carbs_g":22.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04xst8m1fl3vc6nx","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Hành lá (hành hoa)","ingredient_not_mentioned_by_name:Xì dầu","ingredient_not_mentioned_by_name:Dầu mè","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:o trung","unlisted_ingredient_phrase:pha voi","unlisted_ingredient_phrase:pha voi nuoc","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước 18-35 tháng","id":"mon_nuoc_18_35_thang","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"18-35 tháng","id":"18_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh057et8m1qnknhaid#variant-1","name":"Thịt heo nạc kho tiêu","detail_name":"Thịt heo nạc kho tiêu","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"123.2 g / Dĩa vừa","quantity_value":123.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hà