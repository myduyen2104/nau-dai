uantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sơ chế Cua biển rửa sạch, hấp chín, gỡ lấy thịt. Trứng cút luộc chín, lột vỏ. Mì sợi trụng qua nước sối, để ráo Các loại rau ăn kèm rửa sạch, để ráo. Nấu nước dùng Bắt nồi lên bếp phi thơm hành, đổ nước vào nấu nước dùng, Phi thơm hành xào săn phần thịt cua đã gỡ rồi đổ vào nồi nước dùng. Xếp mì, trứng cút ra bát, Chan nước dùng rồi rắc hành, mùi, hạt tiêu lên trên và thưởng thức, ăn kèm với rau.","nutrition":{"kcal":595.5,"protein_g":27.8,"fat_g":13.8,"carbs_g":90.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03cbt8m1gf253w9d","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Mỡ lợn nước","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:nuoc dung","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03i8t8m11bga4llg#variant-1","name":"Miến gà","detail_name":"Miến gà","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"189.5 g / Tô nhỏ","quantity_value":189.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Miến dong khô","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Thịt gà ta","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":". Bước 1: Sơ chế nguyên liệu Miến tùy loại mà bạn ngâm nước trước với thời gian phù hợp cho miến mềm sau đó vớt ra để ráo. Bước 2: Luộc gà lấy nước dùng Hành tím lột vỏ đập dập sơ, cho vào nước luộc chung với gà. Thêm nhiều đầu hành lá để nước dùng ngọt vị hơn. Luộc khoảng 30 phút gà chín mềm thì vớt ra, xé sợi. Nước luộc gà bạn nêm nếm cho vừa ăn. Khi dùng cho miến đã luộc vào tô, xếp thịt gà lên, chan nước dùng vào , rắc rau răm đã cắt nhỏ, dùng khi còn nóng kết hợp với các loại rau đi kèm..","nutrition":{"kcal":432.3,"protein_g":14.6,"fat_g":13,"carbs_g":64.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03i8t8m11bga4llg","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Gừng tươi","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:rau ram","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence