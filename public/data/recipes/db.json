tatus":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qy01i2t8m1by6m5z4h#variant-1","name":"Canh bún","detail_name":"Canh bún","category":"Món nước","age_group":null,"serving":{"raw":"230 g / Tô vừa","quantity_value":230,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bún tươi","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"18 g","quantity_value":18,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Sơ chế nguyên liệu Hành lá rửa sạch, phần lá cắt khúc, phần đầu băm nhuyễn. Cà chua rửa sạch, cắt miếng vừa ăn, xào sơ chín. Ngò rửa sạch, cắt khúc. Hành tím, tỏi bỏ vỏ, băm nhuyễn. Rau muống nhặt, rửa sạch, luộc chín. Chế biến cua đồng Cua ngâm nước khoảng 1 – 2 giờ để loại bỏ hết đất cát, rửa lại nhiều lần cho thật sạch. Lột yếm cua, mai cua để riêng. Dùng muỗng nạo lấy phần gạch cua cho vào chén, ướp với một ít tiêu xay, hạt nêm. Mai cua đem đi xay nhuyễn. Nấu nước dùng và làm riêu cua Cho cua vừa xay ở bước trên vào một cái âu lớn rồi hòa với ít nước, dùng tay bóp nhẹ cho thịt cua tan vào nước. Dùng ray lọc nước cua trước khi cho vào nồi. Cứ thế lặp đi lặp lại hai bước này đến khi bạn thấy lượng nước đã đủ để nấu bún và trong âu chỉ còn lại vỏ cua cứng ráp là được. Nêm mắm tôm, hạt nêm vào nồi nước cua vừa lọc rồi đặt lên bếp đun ở lửa vừa. Chú ý không để lửa to quá, gạch cua rất dễ bị cháy hoặc trào ra ngoài. Khuấy đều tay để riêu cua kết lại và vớt ra tô để riêng. Tiếp tục cho cà chua đã xào sơ 1 vào nồi nước cua, nêm nếm lại cho vừa ăn rồi cứ tiếp tục đun với lửa nhỏ. Nấu canh bún Dùng chảo vừa xào cà chua phi thơm hành tím băm nhuyễn, sau đó cho phần gạch cua đã chuẩn bị ở bước 1 vào đảo đều và tắt bếp. Phần này bạn có thể cho luôn vào nồi nước riêu cua để tạo màu hoặc cho riêng vào từng tô khi ăn đều được. Nếu cho gạch cua xào vào nồi nước dùng, bạn chỉ cần nấu thêm 3 – 5 phút là được. Trước khi tắt bếp, bạn cho giấm bỗng vào, tùy theo khẩu vị của bạn mà có thể cho ít hoặc nhiều. Trong món bún riêu cua của người miền Bắc thường cho thêm giấm bỗng vào để tạo ra vị chua thanh dịu dàng và mùi thơm đặc trưng. Cho BÚN, hành, riêu cua, giò lụa, rau muống vào tô. Chan nước dùng lên trên và thêm ít ngò, tiêu xay là bạn đã có món BÚN RIÊU CUA vô cùng hấp dẫn, chuẩn vị, ăn kèm với đĩa rau sống và chấm với mắm tôm là ngon tuyệt vời.","nutrition":{"kcal":258,"protein_g":7.2,"fat_g":5.8,"carbs_g":44.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qy01i2t8m1by6m5z4h","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Chanh","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:ca chua","unlisted_ingredient_phrase:cua ong","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mam tom","unlisted_ingredient_phrase:nau canh","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc khoang"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01uft8m17wfzqxum#variant-1","name":"Canh rau dền đỏ nấu tôm","detail_name":"Canh rau dền đỏ nấu tôm","category":"Món canh 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"81.8 g / Chén","quantity_value":81.8,"quantit