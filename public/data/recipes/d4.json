hịt chín vừa đủ độ, không bị dai. Nêm lại gia vị lần cuối cho vừa ăn. Xúc ra đĩa, thêm vào 1 chút hạt tiêu và ăn nóng với cơm.","nutrition":{"kcal":62.5,"protein_g":3.6,"fat_g":3.5,"carbs_g":4.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04xlt8m1u0s07qr5","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Súp lơ xanh","ingredient_not_mentioned_by_name:Cà rốt","title_ingredient_not_mentioned:Súp lơ xanh","title_ingredient_not_mentioned:Cà rốt","unlisted_ingredient_phrase:hat tieu"],"source_categories":[{"label":"Món xào từ 18 tháng đến 5 tuổi","id":"mon_xao_tu_18_thang_den_5_tuoi","kind":"food_category","baseLabel":"Món xào từ 18 tháng đến 5 tuổi"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh052ut8m1v3q1otjs#variant-1","name":"Tép rang","detail_name":"Tép rang","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"174 g / Dĩa vừa","quantity_value":174,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Tép gạo","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Tép rửa sạch rồi dùng kéo cắt bỏ râu tép, hành lá cắt nhỏ, tỏi băm nhuyễn Cho chảo lên bếp đun nóng chảo, dầu ăn vào đun nóng dầu, rồi cho hành, tỏi vào phi thơm, cho tép vào đảo đều cho tép chín đều. Tép chuyển màu đỏ mới cho muối, nước mắm, hạt nêm, tiêu, đường đảo đều cho tép thấm đều gia vị. Rang cho đến khi tép rút cạn nước mới cho hành lá vào đảo đều là tắt bếp. Cho tép ra đĩa dùng với cơm nóng.","nutrition":{"kcal":192.1,"protein_g":18,"fat_g":11.8,"carbs_g":4.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh052ut8m1v3q1otjs","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hat nem"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gi05ect8m1epkemij7#variant-1","name":"Trứng cuộn tam sắc","detail_name":"Trứng cuộn tam sắc","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"39 g / Dĩa nhỏ","quantity_value":39,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng vịt (55g/quả)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Chả heo (lợn)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Trứng vịt đập ra bát, đánh tan. Thêm vào đó 1 ít hạt nêm cho đậm đà, và 1 ít nước lọc (sẽ giúp trứng khi rán được tơi và xốp hơn). Bước 2: Mộc nhĩ đem ngâm nước ấm cho nở, thái nhỏ. Trộn đều giò sống với môc nhĩ, bình thường giò sống mua về đã được ướp gia vị khá vừa miệng nên không cần cho gia vị nữa, đeo bao tay vào trộn thật đều. Bước 3: Cà rốt cạo vỏ, thái sợi mỏng, hành lá rửa sạch thái nhỏ Bước 4: Chuẩn bị chảo chống dính để rán trứng. Đặt chảo lên bếp, đợi chảo nóng cho dầu ăn vào chảo, nghiêng nhẹ chảo để dầu ăn láng đều khắp mặt chảo. Đợi dầu ăn sôi thì đổ trứng, nghiêng nhẹ trứng để trứng dàn khắp mặt chảo. Với món trứng cuộn tam sắc, các nàng chỉ cần rán vàng mặt dưới, còn mặt trên của trứng chỉ cần đợi cho trứng se lại (nếu rán khô quá sẽ khó cuộn, dễ bị gãy) thì nhấc ra khỏi bếp, để hơi nguội, các nàng có thể để nguyên trứng trong chảo hoặc nhẹ nhàng lấy ra đĩa. Sau đó dùng thìa đã nhúng qua bát dầu ăn, phết 1 lớp hỗn hợp mọc lên trên bề mặt trứng Tiếp tục rải đều cà rốt đã thái sợi lên bề mặt mọc Dùng tay cuộn tròn lại, cho vào đĩa và hấp khoảng 25 phút để phần mọc bên trong được chín đều Cuối cùng cắt thành từng khoanh nhỏ xếp ra dĩa.","nutrition":{"kcal":95.8,"protein_g":3.5,"fat_g":7.9,"carbs_g":2.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05ect8m1epkemij7","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Chả heo (lợn)","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:gio song","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:kho qua","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:o trung","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]