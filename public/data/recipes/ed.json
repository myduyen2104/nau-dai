 heo chần qua nước sôi, rửa sạch rồi cho vào nồi nước lạnh ninh lấy nước dùng cùng với thịt chân giò cùng với cà rốt và củ cải trắng. Phi hành thơm vào nồi và đổ nước hầm xương vào. Sau đó thịt chân giò mềm vớt ra cắt lát mỏng. Xếp nui luộc chín ra bát, cho thịt chân giò vào chan nước dùng rồi rắc hành, mùi, hạt tiêu lên trên và thưởng thức. ăn kèm với rau","nutrition":{"kcal":381.8,"protein_g":14.4,"fat_g":16.4,"carbs_g":43.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6or03rmt8m1q2fz6aqa","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:chan gio","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:xuong heo"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72n049wt8m1q87r0bbf#variant-1","name":"ROHTO N27 TÔM RIM TRỨNG CÚT","detail_name":"ROHTO N27 TÔM RIM TRỨNG CÚT","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"104.7 g","quantity_value":104.7,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Tôm nước ngọt","quantity_raw":"55 g","quantity_value":55,"quantity_unit":"g"},{"name":"Trứng cút (10g/quả)","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"4 g","quantity_value":4,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Bột ngọt 