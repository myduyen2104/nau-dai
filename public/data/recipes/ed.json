it":"g"},{"name":"Hành tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước cốt dừa, đóng hộp","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Ếch làm sạch, ướp gia vị. Hành tây bóc vỏ, rửa sạch, cắt múi cau. Nấm mèo ngâm nở, cắt miếng. Hành lá bỏ rể, rửa sạch, cắt nhỏ. Tỏi bóc vỏ, băm nhuyễn. Sả sửa sạch, băm nhuyễn. Rau mùi rửa sạch, cắt nhỏ. Làm nóng dầu, phi thơm sả băm. Cho ếch vào đảo sơ, thêm 1 muỗng cà phê bột nghệ nếu thích đậm màu, cho nấm, hành tây, đậy nắp 2 phút. Mở nắp ra đảo đều, nêmnếm gia vị rồi cho nước cốt dừa, đợi sôi lại tắt bếp. Cho thịt ếch xào lăn ra tô, rắc thêm hành lá, rau mùi, dùng với cơm nóng. Đây là món ăn đơn giản dễ làm và rất dễ thành công thích hợp cho các chị em còn non nghề bếp tập tành làm thử ngay.","nutrition":{"kcal":96.5,"protein_g":8.7,"fat_g":4.7,"carbs_g":5.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02r6t8m13qwotvdb","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Sả cây","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_t