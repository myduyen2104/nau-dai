à chuyển sang màu trắng. Nấu nước dùng Cho vào nồi 1 lít nước dùng gà, cho gà, cà rốt và nấm hương vào nêm nếm vừa ăn. Nấu đến khi hỗn hợp cà rốt và nấm hương chín mềm thì tắt bếp. Trụng mì Bắc chảo khác lên bếp cùng 1 lít nước, cho mì vào trụng khoảng 3 phút đến khi mì mềm thì vớt ra tô, chan nước dùng vào, cho gà, nấm, rau củ vào là, ăn kèm với rau thơm, giá.","nutrition":{"kcal":456.8,"protein_g":20.7,"fat_g":11.1,"carbs_g":69.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03cgt8m1u936sdul","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:rau thom","unlisted_ingredient_phrase:uop thit","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03o0t8m1k10g0ppm#variant-1","name":"Mướp xào thịt bò","detail_name":"Mướp xào thịt bò","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"131.5 g / Dĩa vừa","quantity_value":131.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Mướp","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Để lòng gà sạch nhớt và khử mùi hôi bạn cho gà ngâm với muối khoảng 10 phút, sau đó rửa sạch lại với vài lần nước. Tiến hành cắt nhỏ lòng gà thành những miếng vừa ăn rồi cho vào tô. Ướp lòng gà với muối, hạt nêm, khoảng 15 phút cho phần lòng gà được thấm vị. Mướp bạn gọt bỏ vỏ, rửa sạch rồi cắt thành những khúc vừa ăn. Đặt chảo lên bếp rồi cho dầu ăn, tiếp đến bạn cho lòng gà đã ướp vào xào trên lửa vừa khoảng 10 phút cho lòng gà chín rồi đổ ra đĩa. Tiếp tục cho vào dầu ăn, cho mướp xào khoảng 5 phút cho mướp săn lại. Cuối cùng cho phần lòng gà đã xào trước đó vào cùng với mướp đảo đều thêm 5 phút, nêm nếm gia vị vừa ăn, rắc hành ngò, 1 ít tiêu vào và tắt bếp.","nutrition":{"kcal":85.8,"protein_g":5.2,"fat_g":5.9,"carbs_g":3.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6or03o0t8m1k10g0ppm","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt bò loại 1","title_ingredient_not_mentioned:Thịt bò loại 1","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:long ga","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03uxt8m137zqleen#variant-1","name":"Ốc bươu xào sả ớt","detail_name":"Ốc bươu xào sả ớt","category":"Món mặn","age_group":null,"serving":{"raw":"189.5 g / Dĩa vừa","quantity_value":189.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Ốc bươu","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thự