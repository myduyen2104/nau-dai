[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tw00cot8m1phsyo8ki#variant-1","name":"BÁNH BỘT LỌC","detail_name":"BÁNH BỘT LỌC","category":"Món khô","age_group":null,"serving":{"raw":"173 g / Dĩa","quantity_value":173,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":[{"name":"Bột dong lọc","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Tép gạo","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Mỡ lợn nước","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":"Hành củ bóc vỏ, bào mỏng, làm hành phi. Tép gạo rửa sạch, ướp gia vị, xào chín. Hành lá rửa sạch, để ráo, cắt nhỏ làm mỡ hành. Cho nước sôi vào giữa lòng bột, trộn đều. Sau đó cho phần bột còn lại vào, dùng tay trộn đều cho đến khi bột dẻo, mịn. Bột đã nhào mịn, ngắt một phần nhỏ lăn trong rồi cán dẹt, cho một ít nhân tôm vào giữa gấp đôi miếng bột lại, vuốt chặt mép để giữ miếng bánh hình bán nguyệt. Luộc bánh: Bắt nồi nước lên đun sôi, cho thêm ít dầu ăn và muối, thả bánh vào luộc cho đến khi bánh nổi lên là đã chín. Vớt bánh ra thả vào ngay vào một bát nước nguội, sau đó vớt ra sếp lên đĩa rồi thoa một chút dầu ăn để bánh không bị dính vào nhau. Thêm mỡ hành, giò lụa, rau chua lên rồi chan nước mắm đã pha vào là thưởng thức.","nutrition":{"kcal":476.6,"protein_g":11.2,"fat_g":20.7,"carbs_g":61.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00cot8m1phsyo8ki","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_menti