-4 tuổi"}],"source_age_group":null,"source_tag_evidence_status":"catalog_capture_unmatched_to_detail"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu028jt8m139xh4rwp#variant-1","name":"Cháo thịt heo","detail_name":"Cháo thịt heo","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"210.5 g / Tô vừa","quantity_value":210.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Gạo nếp cái","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cà rốt, khoai tây các bạn gọt vỏ rữa sạch sau đó cắt thành hạt lựu. Đậu xanh đã bóc vỏ ngâm nước ấm khoảng 2 tiếng. Thịt heo nạc, rửa với muối sau đó rửa sạch lại với nước, để ráo, băm thịt nhỏ, ướp gia vị vừa ăn. Gạo các bạn vo sạch sau đó đổ đậu xanh đã ngâm và thịt heo băm vào cùng bắt lên bếp. Khi thấy gạo nở bung đều, đậu xanh nở mềmrồi thì tiếp tục phi gốc hành thơm sau đó cho cà rốt, khoai tây vào đảo cho thơm rồi đổ vào nồi cháo Nấu sôi đến khi các loại rau củ vừa chín tới, nêm nếm lại, tắt bếp và cho hành ngò và tiêu vào.","nutrition":{"kcal":700.8,"protein_g":21.8,"fat_g":24.2,"carbs_g":99.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu028jt8m139xh4rwp","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:heo nac","unlisted_ingredient_phrase:thit heo nac","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02eat8m1rg78lg3u#variant-1","name":"Chim bồ câu quay","detail_name":"Chim bồ câu quay","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"43 g / Dĩa nhỏ","quantity_value":43,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bồ câu ra ràng","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Nước dừa non tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Cary bột","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"\"Bồ câu cắt tiết, thả vào nước lạnh. Đun nước sôi, bắc ra pha vào 1 ít nước lạnh, nhúng chim vào cho ướt đều rồi đem ra nhổ lông, khoét phía dưới moi bộ lòng ra, làm sạch, chặt bỏ chân. Đun một xoong nước sôi khác, cho quế chi + đinh hương + hồi hương và muối vào, xong cho chim vào chần qua, lật đi lật lại cho thật đều, vớt ra liền, rửa lại nước lạnh, nhổ hết lông măng cho sạch, để ráo nước. Ướp gia vị nước màu dừa, ngũ vị hương, muối, tiêu, xì dầu, bột nêm, tất cả trộn đều. Cho bồ câu vào ướp trộn đều, để độ 1/2 giờ cho bồ câu thấm đều gia vị. \"Rán bồ câu: bắc chảo dầu thật sôi thả bồ câu vào rán ( nên cho vài tép tỏi đập vào phi thơm) rán cho bồ câu vàng đều. Vớt bồ câu ra , để ráo dầu, chặt thành từng miếng vừa ăn.","nutrition":{"kcal":115.3,"protein_g":4.7,"fat_g":9.6,"carbs_g":2.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02eat8m1rg78lg3u","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gừng tươi","ingredient_not_mentioned_by_name:Hành củ tươi","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:mau dua","unlisted_ingredient_phrase:nuoc mau","unlisted_ingredient_phrase:nuoc mau dua","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02eit8m14j0h8g2l#variant-1","name":"Chim bồ câu tần","detail_name":"Chim bồ câu tần","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"40 g / Dĩa nhỏ","quantity_value":40,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bồ câu ra ràng","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Rượu trắng (cồn 39 g)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_un