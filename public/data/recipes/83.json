[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tx00ktt8m1tfnoaofd#variant-1","name":"Bánh ướt thịt bằm","detail_name":"Bánh ướt thịt bằm","category":"Món khô từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"203 g / Dĩa nhỏ","quantity_value":203,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau húng","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Bột bánh ướt thêm một chút xíu muối, thêm nước vào khuấy đều cho đến khi bột tan hoàn toàn. Bắc chảo lên bếp mở lửa vừa, thêm dầu ăn vào chảo, phi thơm hành tím, khi hành thơm vàng bạn vớt ra chén 1 nửa để ăn kèm. Bắc chảo lên bếp mở lửa vừa, quét dầu ăn lên mặt chảo, đổ một vá bột vào chảo, lắc nhẹ để bột dàn mỏng đều, đậy nắp lại. Sau 20 - 25 giây khi bánh đã chín, bạn đổ bánh ra mâm sạch (đã phết dầu) rồi cuốn bánh lại, nhanh tay đổ bột vào chảo để làm mẻ bánh thứ 2. Dưa leo rửa sạch, cắt thành những thanh nhỏ, ngắn khoảng 1 lóng tay. Rau thơm rửa sạch, cắt nhỏ, chả lụa cắt miếng nhỏ khoảng 1 lóng tay, giá trụng với nước sôi khoảng 2 phút cho chín. Xếp bánh ướt rau thơm, dưa leo, chả lụa, bánh tôm, nem chua, hành phi ra đĩa và chấm với nước mắm pha, ăn ngay khi còn nóng bạn nhé.","nutrition":{"kcal":633.9,"protein_g":21,"fat_g":33.5,"carbs_g":62.8},"source_url":"https://dinhduong2