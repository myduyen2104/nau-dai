quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"6 g","quantity_value":6,"quantity_unit":"g"}],"instructions_raw":"Tôm làm sạch, rửa sạch, băm nhuyễn. Rau ngót lấy lá non, rửa sạch, băm nhuyễn. Bí đỏ gọt vỏ, rửa sạch, luộc chín, tán nhuyễn. Hòa tan bột gạo và tôm với nước, bắc lên bếp khuấy đều đến khi sôi, thêm rau ngót, bí đỏ vào khuấy đều, nấu chín. Tắt bếp. Thêm dầu thực vật vào khuấy đều.","nutrition":{"kcal":178.4,"protein_g":7.3,"fat_g":6.6,"carbs_g":22.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00w1t8m1jhxt7dnm","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bí đỏ (bí ngô)","unlisted_ingredient_phrase:dau thuc","unlisted_ingredient_phrase:dau thuc vat","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:thuc vat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ 9-24 tháng","id":"mon_bot_nha_nau_cho_tre_9_24_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"9-24 tháng","id":"9_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00yqt8m1zc3veua4#variant-1","name":"Bún gạo xào thập cẩm","detail_name":"Bún gạo xào thập cẩm","category":"Món khô 5 tuổi","age_group":"5 tuổi","serving":{"raw":"136 g / Dĩa nhỏ","quantity_value":136,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Bún khô","quantity_raw":"45 g","quantity_value":45,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Trứng cút (10g/quả)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":