it":"g","portion_label":"Chén"},"ingredients":[{"name":"Rong biển khô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Rong biển khô ngâm trong nước cho nở ra, vớt ra để ráo. Thịt heo rửa sạch, băm nhuyễn ướp với gia vị. Nấm rơm rửa sạch, cắt đôi.Đậu hũ cắt miếng vuông. Làm nóng nồi trên bếp với dầu ăn, cho hành vào xào đến khi hành hơi vàng thì thêm tỏi vào đảo cho thơm rồi trút thịt heo vào xào sơ rồi bạn thêm vào lượng nước vừa đủ dùng, chờ nước sôi thì thả nấm, đậu hũ vào nấu sôi rồi cho rong biển vào, đun sôi lại lần nữa nêm lại nước cho vừa ăn rồi tắt bếp.","nutrition":{"kcal":69.4,"protein_g":5.1,"fat_g":3.8,"carbs_g":5.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01wet8m1pk1o1gxq","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món canh 6-7 tuổi","id":"mon_canh_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01yyt8m1pozf48fe#variant-1","name":"Chả cá thu chiên sốt cà","detail_name":"Chả cá thu chiên sốt cà","category":"Món mặn","age_group":null,"serving":{"raw":"100 g / Dĩa nhỏ","quantity_value":100,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá thu","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Cá thu rửa sạch, lấy phần thịt xay nhuyễn, ướp gia vị, trộn đều, vo viên nhỏ vừa ăn. Cà chua rửa sạch, bỏ hạt băm nhuyễn Hành, tỏi bóc vỏ, băm nhuyễn Đun nóng dầu, cho chả cá vào chiên vàng đều các mặt, vớt ra đĩa. Phi vàng hành tỏi băm, cho cà chua vào đảo đều, nêm nếm gia vị, cho chả cá chiên vào, nấu lửa nhỏ trong 5 phút, tắt bếp","nutrition":{"kcal":151.8,"protein_g":11.7,"fat_g":9.3,"carbs_g":5.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01yyt8m1pozf48fe","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt020pt8m1ic47lv5n#variant-1","name":"Chân giò heo nấu giả cầy","detail_name":"Chân giò heo nấu giả cầy","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"56 g / Dĩa nhỏ","quantity_value":56,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Chân giò heo (lợn)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Mắm tôm loãng","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Riềng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nghệ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Chân giò heo rửa sạch để ráo. Hành lá rửa sạch bỏ rễ cắt nhỏ. Giềng, nghệ tươi rửa sạch cạo vỏ, đập dập. Rau răm rửa sạch bỏ lá úa. Tỏi ta lột vỏ rửa sạch băm nhỏ. Chân giò heo dùng lửa hun cháy sém có mùi thơm, dùng dao cạo lớp bụi bên ngoài rồi chặt miếng vừa ăn. Kế tiếp cho giò heo giềng, nghệ và gia vi vào nồi cùng mắm tôm pha loãng ướp tất cả trong 30 phút. Sau đó cho thêm nước lọc vào ninh đến khi giò heo mềm. Lúc này nêm lại gia vị rồi tắt bếp.","nutrition":{"kcal":102.3,"protein_g":5.2,"fat_g":7.6,"carbs_g":3.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt020pt8m1ic47lv5n","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giấm","ingredient_not_mentioned_by_name:Riềng","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:rau ram","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02ctt8m1rwh7i22z#variant-1","name":"Chè nếp đậu trắng","detail_name":"Chè nếp đậu trắng","category":"Chè (18 tháng trở lên)","age_group":"18 tháng","serving":{"raw":"122 g / Chén","quantity_value":122,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đậu trắng hạt (đậu tây)","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Gạo nếp máy (loại thường)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"\"Ngâm đậu cùng muối trong khoảng vài tiếng, rồi rửa sạch vớt ra. Làm như vậy đậu khi nấu sẽ mau mềm, chè ăn sẽ tan ngày trong miệng. Sau đó tiếp tục cho đậu vào nồi cùng với nước rồi luộc. Cho thêm muối cho vào để đậu có vị bùi bùi ngon hơn. Thời gian luộc trong khoảng 40 phút và luộc với lửa nhỏ để đậu không bị nứt. Canh chừng cho đến khi đậu mềm thì tắt lửa rồi vớt ra. Tiếp theo là rửa sạch nếp, để cho có độ nhựa độ dẻo hơn thì cho muối vào trong nếp & ngâm. Cho nước cốt dừa vào ngâm trong khoảng 15 phút để cho hạt nếp béo và dẻo hơn. Trong khi chờ đợi nếp thì tranh thủ làm nước cốt. Lấy nước cốt đặc & nước cốt loãng cùng đường phèn & muối hòa tan vào nhau. Tiếp theo lấy bột năng, bột gạo và ba thìa canh nước cốt hòa vào nhau để tạo độ sánh. Nấu hỗn hợp này trên lửa nhỏ để nước cốt được béo & sánh lại. Sau khi gạo nếp đã ngâm xong thì nấu chín. Cho đường phèn vào và khuấy đều cho tan. Sau đó đậu trắng cho vào nấu cùng với xôi. Khuấy cho nếp cùng đậu hòa quyện vào nhau, đậu mềm, xôi nếp dẻo là hoàn tất. Khi nào ăn thì bạn hãy múc chè đậu trắng ra chén, sau đó rưới vào nước cốt dừa rồi thưởng thức.\"","nutrition":{"kcal":451.3,"protein_g":11,"fat_g":10.1,"carbs_g":79.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02ctt8m1rwh7i22z","quality_status":"needs_review","warnings":["identica