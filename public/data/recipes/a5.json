Cá điêu hồng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dứa ta (thơm)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cần tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Cà chua bạn rửa sạch, cắt múi cau. Rau cần cắt bỏ rễ, nhặt bỏ lá già úa, rửa sạch rồi cắt khúc. Cá diêu hồng bạn làm sạch mang, ruột, cạo vảy rồi rửa qua với nước. Tiếp đến, bạn lấy muối và chanh chà xát khắp mình và trong bụng cá, xả lại dưới vòi nước cho sạch. Cắt cá làm đôi, để ráo. Phi thơm tỏi bằm, cho cà chua thái múi cau vào xào sơ với ít gia vị vào. Cho nước vào vừa đủ rồi đun sôi, nêm lại gia vị vừa ăn. Rồi cho cá vào nấu chín, cho rau cần vào rồi tắt bếp. Múc canh ra bát.","nutrition":{"kcal":45.6,"protein_g":4.5,"fat_g":0.8,"carbs_g":5.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01tht8m1kz9h42k0","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh 8-18 tuổi","id":"mon_canh_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt022ct8m1m4qk6j9o#variant-1","name":"Cháo cá lóc nấm rơm","detail_name":"Cháo cá lóc nấm rơm","category":"Món nước 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"138.5 g / Tô nhỏ","quantity_value":138.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cá quả (cá lóc)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw"