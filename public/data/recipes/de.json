_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04xyt8m1czw9h4gc#variant-1","name":"Súp nấm rơm","detail_name":"Súp nấm rơm","category":"Món nước 18-35 tháng","age_group":"18-35 tháng","serving":{"raw":"102.6 g / Tô nhỏ","quantity_value":102.6,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ngô bắp tươi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt gà công nghiệp, lườn","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Trứng cút (10g/quả)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"Nấu nước dùng xương ống Xương ống luộc qua rồi rửa sạch cho hết chất bẩn. Ninh xương khoảng 1 giờ rồi chắt lấy 1 lít nước dùng làm nước súp. Sơ chế nguyên liệu Bắp mỹ: rửa sạch, tách hạt. Ức gà mua về rửa sạch, luộc chín trong nồi nước hầm, vớt ra, xé sợi. Nấm rơm cắt gốc, ngâm nước muối, rửa sạch lại với nước lạnh, để ráo, nếu nấm nào to có thể cắt đôi. Bột năng pha với nước. Nấu súp Nước dùng sôi, cho lần lượt bắp mỹ, gà xé, nấm rơm vào nấu chín, sau đó nêm nếm cho vừa ăn Tiếp theo cho bột năng vào, chú ý là đổ từ từ, đến khi thấy nồi súp sánh lại thì dừng lại. Không nên đổ ngay cùng 1 lúc sẽ dễ bị đặc quá nhé. Sau cùng từ từ đổ trứng đánh tan vào khấy theo 1 chiều để tạo vân cho đẹp. Bạn có thể lọc chỉ lấy lòng trắng trứng cho vào thì tạo vân trắng sẽ đẹp hơn. Nấu đến khi nồi súp chuyển màu trong cho thêm trứng cút vào rồi tắt bếp, múc ra chén, rắc rau mùi, tiêu bột, ớt tùy ý lên và thưởng thức","nutrition":{"kcal":155.2,"protein_g":8,"fat_g":4.1,"carbs_g":21.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04xyt8m1czw9h4gc","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt gà công nghiệp, lườn","ingredient_not_mentioned_by_name:Hành lá (hành hoa)","ingredient_not_mentioned_by_name:Xì dầu","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:long trang","unlisted_ingredient_phrase:long trang trung","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:o trung","unlisted_ingredient_phrase:pha voi","unlisted_ingredient_phrase:pha voi nuoc","unlisted_ingredient_phrase:trang trung","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước 18-35 tháng","id":"mon_nuoc_18_35_thang","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"18-35 tháng","id":"18_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh053lt8m1296qgmwb#variant-1","name":"Thịt ba rọi kho tiêu","detail_name":"Thịt ba rọi kho tiêu","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"95 g / Dĩa vừa","quantity_value":95,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Làm nước màu ướp thịt ba chỉ kho tiêu: Cho đường và dầu ăn vào nồi, đun và dùng đũa khuấy đều cho đến khi đường cháy thành màu cánh kiến thì cho vào ít nước lọc, khuấy đều, tắt bếp Rửa sạch thịt ba chỉ, cắt nhỏ vừa ăn rồi trộn đều với gia vị. Đổ thêm nước màu vừa đun vào thịt, ướp khoảng 10 phút. Cách kho thịt ba chỉ: đun nóng dầu ăn rồi cho tỏi băm vào phi thơm. Dùng đũa gắp thịt đã ướp cho vào nồi, đảo đều tay. Khi thịt kho tiêu săn lại thì cho nước ướp thịt vào, đảo đều rồi đun với lửa vừa.. Khi nước cạn đi một nữa thì đậy nấp đun thêm đến khi nước thịt ba chỉ kho tiêu gần cạn, rắc thêm tiêu, hành là được.","nutrition":{"kcal":364.9,"protein_g":16.7,"fat_g":31.2,"carbs_g":4.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh053lt8m1296qgmwb","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc mau","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh053yt8m10z2lvqhc#variant-1","name":"Th