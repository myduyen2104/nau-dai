uantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Gừng cạo, rửa sạch, giã nhỏ, trộn với rượu. Nghệ cạo vỏ, rửa sạch, giã nhỏ, cho vào 1 thìa nước. Ếch rửa sạch, rạch sống lưng, lột da, mổ bỏ ruột, rứa sạch, chặt mỗi con làm 7 miếng, tẩm rượu, gừng rồi bỏ gia vị vào bóp kỹ, ướp 15 phút. Hạt sen tươi luộc chín. Tôm khô bóc vỏ, rứa sạch, để ráo. Hành khô bóc vỏ, đập giập. Rau mùi tàu nhặt rửa sạch, thái chỉ. \"Cho dầu vào chảo, đun nóng già, bỏ hành củ vào phi thơm, trút thịt ếch vào xào cho ngấm gia vị, cho tôm vào xào cùng, đảo đều, khi tôm chín mềm xúc ra bát. Múc ếch đã xào với tôm cho vào nồi nước dùng nấu với hạt sen, đun nhỏ lửa.Tần như vậy chừng 35-45 phút, thịt ếch và hạt sen chín nhừ, nước cạn sánh, nêm nếm lại vừa ăn là được. Múc tất cả ra bát to, rắc hạt tiêu, rau mùi tàu lên trên.","nutrition":{"kcal":194.1,"protein_g":25,"fat_g":4.4,"carbs_g":7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02r3t8m16poh4o1v","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:mui tau","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:rau mui tau"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02s2t8m15w1gql2z#variant-1","name":"Gà chiên nước mắm","detail_name":"Gà chiên nước mắm","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"116 g / Dĩa vừa","quantity_value":116,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt gà công nghiệp, đùi","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Gà rửa sạch để ráo, ướp gia vị 30 phút. Tỏi bóc vỏ rửa sạch băm nhỏ ướp cùng thịt gà. Bắc chảo lên, cho bơ vào chiên gà vàng đều, vớt ra. Cho thêm gia vị vào đảo đều trong phần bơ lúc nãy, khi tỏi đã thơm thì cho lại gà vào đảo đều cho thấm.Xếp gà ra đĩa. Gà chiên xong thơm mùi bơ tỏi nồng nàn.","nutrition":{"kcal":196.2,"protein_g":18.3,"fat_g":11.8,"carbs_g":4.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02s2t8m15w1gql2z","quality_status":"needs_review","warnings":["recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Chanh","title_ingredient_not_mentioned:Nước mắm cá"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02yzt8m1nybn4bh2#variant-1","name":"Hàu xào ớt đỏ","detail_name":"Hàu xào ớt đỏ","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"99.5 g / Dĩa","quantity_value":99.5,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":[{"name":"Hàu","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw"