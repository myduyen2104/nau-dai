ity_unit":"g"},{"name":"Bơ thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Pho mát","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rượu vang trắng (cồn 9.5 g)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"Sơ chế tôm Tôm mua về bạn cắt bỏ râu và chân cho gọn lại để dễ chế biến nhé. Bẻ nhẹ phần đầu của tôm rồi nặn hết chất thải bên trong đầu tôm ra ngoài. Lột sạch vỏ tôm rồi dùng tay hoặc dao để kéo bỏ phần chỉ trên lưng tôm. Sau đó rửa lại với nước muối pha loãng để khử mùi tanh của tôm. Rửa lại với nước sạch một lần nữa và để cho tôm ráo nước. Sơ chế các nguyên liệu khác Bạn tiến hành sơ chế các nguyên liệu khác như sau: Phô mai dạng thỏi: bào thành từng sợi nhỏ. Tỏi: bỏ vỏ rồi cắt chúng thành từng lát mỏng. Làm tôm sốt phô mai Đầu tiên, bắc chảo lên bếp rồi cho bơ lạt vào đun cho chảy. Cho thêm phần tỏi cắt lát vào và phi cho thơm. Tiếp theo, bạn cho phần tôm vào chảo, thêm muối và tiêu rồi trộn đều chúng. Sau đó, xào cho đến khi tôm chuyển sang màu cam. Cuối cùng là cho phô mai vào chảo, đậy nắp và đun thêm 3 - 5 phút cho phô mai tan hết ra là món ăn hoàn thành.","nutrition":{"kcal":159.2,"protein_g":19.3,"fat_g":6.6,"carbs_g":4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh059ut8m1y3hoim3d","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bơ thực vật","ingredient_not_mentioned_by_name:Pho mát","ingredient_not_mentioned_by_name:Rượu vang trắng (cồn 9.5 g)","ingredient_not_mentioned_by_name:Bột bắp (bột ngô vàng)","unlisted_ingredient_phrase:mai dang","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:pho mai","unlisted_ingredient_phrase:pho mai dang","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05k1t8m1rmdws4v8#variant-1","name":"Vịt hấp xí muội","detail_name":"Vịt hấp xí muội","category":"Món mặn","age_group":null,"serving":{"raw":"91.5 g / Dĩa vừa","quantity_value":91.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rượu trắng (cồn 39 g)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"1. Chuẩn bị - Vịt làm sạch - Gừng giã nát ngâm với rượu trắng chà xát ngoài da vịt để 10 - 15 phút, rửa vịt lại thật sạch. - Xí muội tán nhuyễn. - Tương hột vắt nước rồi lấy hột bằm nhuyễn, rồi lại trộn với nước tương hột. - Trộn chung: xí muội, tương hột, hành tỏi bằm nhỏ, cọng hành lá đập dập cắt khúc 3cm, muối, tiêu, đường, bột ngọt. - Ướp 2/3 hỗn hợp trên vào bụng vịt, may lại. Ướp chút muối ngoài da vịt. 2. Chế biến - Chiên vịt: bắc chảo dầu nóng phi tỏi cho thơm, cho vịt vào chiên sơ rồi vớt ra. - Hấp vịt: để vịt vào mâm nhôm, ướp thêm 1/3 hỗn hợp tương, xí muội, gia vị... ngoài da vịt. Cho mâm vịt vào xửng hấp độ 1 giờ, khi thịt vịt mềm là được. 3. Trình bày - Mổ bụng vịt , trút nước trong thịt ra, rồi chặt miếng vừa ăn, sắp vào dĩa theo dạng vịt nằm, rưới nước sốt lên thịt vịt.","nutrition":{"kcal":214.8,"protein_g":9.7,"fat_g":14,"carbs_g":6.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05k1t8m1rmdws4v8","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc tuong","unlisted_ingredient_phrase:tuong hot","unlisted_ingredient_phrase:vit bac","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05k4t8m1y5zyzdrp#variant-1","name":"Vịt kho gừng","detail_name":"Vịt kho gừng","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"29 g / Dĩa nhỏ","quantity_value":29,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Rửa sạch thịt vịt với muối, đem chặt thịt vịt thành những miếng nhỏ vừa ăn. Ướp thịt vịt với gừng cắt sợi, tỏi băm nhỏ + gia vị. Ướp thịt vịt khoảng 20 phút. Cho ít dầu + đường trên lửa nhỏ (để làm nước màu). Khi đường chuyển qua màu cánh gián cho tỏi băm nhỏ và thịt vào xào săn thịt, cho gừng cắt sợi vào. Cho ít nước vào nấu trên lửa nhỏ. Nêm nếm lại cho vừa ăn, kho đến khi thịt vừa đủ độ mềm, nước kho còn sâm sấp thì tắt bếp. Cho thịt vịt kho gừng ra dĩa. Dùng với cơm nóng","nutrition":{"kcal":77.7,"protein_g":3.7,"fat_g":6.4,"carbs_g":1.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05k4t8m1y5zyzdrp","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:nuoc mau","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"}]