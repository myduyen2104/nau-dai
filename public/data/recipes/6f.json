lue":20,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Gà rửa sạch, để ráo, cắt miếng vừa ăn, ướp gia vj trong 30 phút. Tỏi bóc vỏ, rửa sạch, sau đó băm nhuyễn. Bắc một cái chảo lên bếp và cho lượng dầu ăn vừa phải vào, sau khi dầu nóng thì cho đùi gà đã ướp vào, chiên sơ với lửa lớn đến khi gà hơi vàng, sau đó gắp ra. Đổ phần dầu đã chiên và chừa lại 1 ít dầu, sau đó cho tỏi đã băm nhuyễn vào và phi đến khi vàng thơm. Cho phần nước xốt vào và đảo đều lên.Tiếp theo cho đùi gà vào và trở đều để gà thấm gia vị. Vặn lửa nhỏ, và cho nước dừa vào và đậy nắp lại, nấu gà trong 30 phút. Gà chín, tắt bếp, nước xốt sẽ sền sệt và gà sẽ có màu vàng thơm.","nutrition":{"kcal":203.3,"protein_g":18.5,"fat_g":11.9,"carbs_g":6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02u4t8m18oo4nprv","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt gà công nghiệp, đùi","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Hạt nêm Knorr","ingredient_not_mentioned_by_name:Hạt tiêu"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02y2t8m1l4fkw9av#variant-1","name":"Hamburger chay (170g/cái)","detail_name":"Hamburger chay (170g/cái)","category":"Hamburger","age_group":null,"serving":{"raw":"170.1 g / Cái","quantity_value":170.1,"quantity_unit":"g","portion_label":"Cái"},"ingredi