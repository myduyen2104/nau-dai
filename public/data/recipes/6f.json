://dinhduong2598.food/mon-an/cmrg0p7rw05ght8m1vps11agr#variant-1","name":"Trứng nhồi tôm thịt","detail_name":"Trứng nhồi tôm thịt","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"48 g / Dĩa nhỏ","quantity_value":48,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng vịt (55g/quả)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc mông","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cách chế biến như sau: Thịt nạc băm nhỏ. Trứng vịt luộc chín, bóc vỏ. Xắt đôi quả trứng, lấy phần lòng đỏ ra hết, 1 phần lòng trắng giữ lại, 1 phần lòng trắng xắt nhỏ, tôm tươi làm sạch thái nhỏ. Trộn thịt băm, tôm với lòng đỏ, lòng trắng trứng xắt nhỏ và ướp với hành tím và gia vị. Sau đó nhồi phần nhân thịt vào 1 phần lòng trắng trứng còn lại. Bắc chảo dầu sôi, cho từng quả trứng nhồi thịt vào chảo rán vàng. Tắt bếp cho ra dĩa.","nutrition":{"kcal":103.1,"protein_g":5.9,"fat_g":8.5,"carbs_g":1.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05ght8m1vps11agr","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:long trang","unlisted_ingredient_phrase:long trang trung","unlisted_ingredient_phrase:trang trung"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]