ầu, phi thơm tỏi, cho thịt bò vào xào chín rồi vớt ra. Thêm tiếp dầu vào chảo để xào nấm hương, cà rốt, hành tây, ớt đỏ to, ớt vàng to, cải bó xôi. Nêm gia vị vừa ăn, múc ra. Làm nước sốt: Bắt chảo lên bếp, thêm dầu ăn tỏi phi thơm, thêm xì dầu, đường, nước, nấu sôi, thêm bột bắp khuấy đều cho nước sốt sánh lại. Trộn miếng dong với các nguyên liệu đã xào chín, thêm nước sốt vào đảo đều cho ngấm đều. Thêm hành phi, vừng rang, dầu mè lên trên và đảo đều.","nutrition":{"kcal":286.7,"protein_g":10.1,"fat_g":10.4,"carbs_g":38.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03jtt8m11sd9kwlq","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô 3-4 tuổi","id":"mon_kho_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03pbt8m17klpw1el#variant-1","name":"Nem cua bể","detail_name":"Nem cua bể","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"66.3 g / Dĩa nhỏ","quantity_value":66.3,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cua bế","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tôm biển","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm hương tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Miến dong khô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Củ đậu","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bánh đa nem/ Bánh tráng","quantity_raw":"7 g","q