raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Lá hoành thánh (thành phần nguyên liệu có trứng)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hẹ lá","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"4 g","quantity_value":4,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Xương ống, thịt nạc dăm rửa sạch với muối, trụng sơ qua nước sôi, để ráo. Rau giá các loại rửa sạch, để ráo. Nấu nước lèo cho mì hoành thánh xá xíu: cho vào nồi xương ống (đã trụng qua nước sôi), hành củ tươi nướng và 2 lít nước, hầm 40 phút để xương ra chất ngọt, nêm nếm gia vị theo khẩu vị từng gia đình. Thịt nạc dăm dùng nĩa châm nhiều lần vào thịt để khi ướp gia vị được thấm đều hơn. Ướp thịt với xốt thịt nướng xá xíu 30 phút cho thịt thấm gia vị. Làm nóng 2 muỗng canh dầu ăn, cho 10gr tỏi, 10gr hành tím vào phi thơm. Sau đó gắp thịt đã ướp vào, thêm 300ml nước dừa tươi rồi đun sôi. Sau đó hạ lửa nhỏ, rim liu riu đến khi nước sốt cạn lại. Trong lúc rim thường xuyên tưới sốt lên trên miếng thịt để thịt thấm đều gia vị. Sau khi rim cạn nước gắp thịt vào khay đem nướng 20 phút ở 180 độ C. Sau đó cắt thành lát mỏng. Trộn nhân hoành thánh gồm thịt băm, hành tím băm, tiêu và gia vị. Lấy vỏ hoành thánh bọc nhân lại bên trong thành những khối hình đồng tiền như hình. Đun sôi nước, cho hoành thánh vào luộc 3 phút đến khi hoành thánh chín, nổi lên mặt nước thì vớt ra. Mì tươi trụng qua nước sôi, gắp mì ra tô, xếp xen kẻ hoành thánh, xá xíu, rau giá lên trên, chế nước lèo vào, ăn cùng với rau giá.","nutrition":{"kcal":558.6,"protein_g":22.9,"fat_g":27.1,"carbs_g":55.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03czt8m12lzumxp9","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:nac dam","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:thit nuong","unlisted_ingredient_phrase:uop thit","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03ovt8m1b5cnyunt#variant-1","name":"Nấm rơm xào thịt bò","detail_name":"Nấm rơm xào thịt bò","category":"Món xào","age_group":null,"serving":{"raw":"140.5 g / Dĩa vừa","quantity_value":140.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Nấm rơm","quantity_raw":"84 g","quantity_value":84,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Bò thăn thái mỏng ướp với nước tương, dầu hào, tỏi, sả băm, bột bắp, xíu tiêu xay trộn đều để thấm 15 ph. Nấm rơm cạo chân, rửa nhanh để ráo. Cái nào lớn cắt đôi. Nấm nhỏ khía đầu cho khỏi bọng nước khi ăn dễ phỏng miệng. Hành tây xắt múi cau mỏng. Bắc chảo lên bếp chảo nóng thêm dầu ăn. Phi thơm hành tỏi băm, cho thịt bò vào xào nhanh lửa lớn cho tái. Trút ra đĩa riêng. Cùng chảo đó thêm nấm rơm vào đảo 2ph cho chín, thêm hành tây đảo vài dạo nữa. Nêm dầu hào vừa ăn. Trộn thịt bò đã xào rồi tắt bếp. Trút ra đĩa rắc hành ngò, tiêu xay, dùng với cơm.\"","nutrition":{"kcal":153.1,"protein_g":13.5,"fat_g":9.6,"carbs_g":3.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6or03ovt8m1b5cnyunt","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:bot bap","unlisted_ingredient_phrase:dau hao","unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:nuoc tuong","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món xào","id":"mon_xao","kind":"food_category","baseLabel":"Món xào"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03rbt8m1yhprho1m#variant-1","name":"Nui thịt gà","detail_name":"Nui thịt gà","category":"Món nước 18-35 tháng","age_group":"18-35 tháng","serving":{"raw":"86 g / Chén","quantity_value":86,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Nui khô","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt gà công nghiệp, đùi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Sơ chế Mua gà về rửa sạch với muối, gừng, sau đó rửa lại với nước lạnh. Cà rốt, củ cải trắng gọt vỏ, rửa sạch, cắt lát mỏng. Nui luộc đến khi nào chín vớt ra để ráo. Nấu nước dùng Luộc gà lấy nước ngọt, khi gà chín, vớt ra xé thịt sợi, còn lại tất cả đầu, cánh cổ, chân đem bỏ vào nồi nước luộc gà tiếp tục ninh với củ cải và cà rốt. Phi hành thơm vào nồi và đổ nước hầm xương vào, nêm nếm gia vị vừa ăn cho bé. Xếp nui ra bát, cho thịt gà đã xé vào,. Chan nước dùng vào.","nutrition":{"kcal":202.6,"protein_g":9.6,"fat_g":7.5,"carbs_g":24.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6or03rbt8m1yhprho1m","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:nuoc ngot","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 18-35 tháng","id":"mon_nuoc_18_35_thang","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"18-35 tháng","id":"18_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tv00abt8m1p4loje5o#variant-1","name":"Phở bò sốt vang","detail_name":"Phở bò sốt vang","category":"Món nước 18-35 tháng","age_group":"18-35 tháng","serving":{"raw":"116 g / Chén","quantity_value":116,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Thịt bò loại 2","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rượu vang đỏ (cồn 9.5 g)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"- Bước 1: Thịt bò chần qua nước sôi rồi rửa sạch, sau đó đem thái miếng vuông (nên thái to một chút vì khi nấu thịt sẽ bị ngót đi). - Bước 2: Ướp thịt với bột nghệ, gia vị và rượu vang. -Bước 3: Phi thơm tỏi với bơ, cho thịt bò vào xào qua. Nêm thêm chút gia vị, đảo đều, sau đó đổ nước vào nồi, đun sôi. -Bước 4: Cà chua thái miếng vào. Xào chín mềm cà rồi dùng thìa dằm cho cà nhuyễn ra. - Bước 5: Trút cà chua vừa xào nhuyễn vào nồi thịt bò, thêm lá nguyệt quế, 1 mẩu gừng đập dập, quế và hồi đã rửa sạch vào. Đun sôi khoảng vài phút rồi hạ lửa ninh liu riu. - Bước 6: Khi thịt bò đã chín nhừ thì cho tương cà vào, nêm thêm chút hạt nêm, đảo đều. Thả hành hoa và rau mùi thái nhỏ vào rồi tắt bếp. Bước 7: Chần bánh phở qua nước sôi, chia bánh phở vào từng bát tô rồi múc thịt bò sốt vang chan lên bát bánh phở.","nutrition":{"kcal":197.4,"protein_g":7.7,"fat_g":8.4,"carbs_g":22.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tv00abt8m1p4loje5o","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:hanh hoa","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:tuong ca","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món nước 18-35 tháng","id":"mon_nuoc_18_35_thang","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"18-35 tháng","id":"18_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72n048tt8m1585b7wtp#variant-1","name":"ROHTO N25 BÒ XÀO BÔNG HẸ","detail_name":"ROHTO N25 BÒ XÀO BÔNG HẸ","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"165 g","quantity_value":165,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Thịt bò loại 2","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Bông hẹ","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":183.7,"protein_g":12.5,"fat_g":11.5,"carbs_g":8.5},"source_url":"https://dinhduong