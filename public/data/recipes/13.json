ity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bạn cắt hành tím thành những lát mỏng. Hành lá thì đập dập phần thân cây rồi cắt nhỏ, phần lá đem cắt nhỏ. Phần ngò gai và ngò om cũng cắt nhỏ - Ướp thịt Bạn cho một nửa lượng hành lá băm khi nãy vào chén thịt băm cùng đường, nêm, muối. Sau đó trộn đều lên và ướp thịt trong 5 phút. -Sơ chế khoai mỡ Khoai mỡ đem đi gọt vỏ rồi cắt thành hình hạt lựu. - Phi hành Bắc một cái chảo lên bếp, làm nóng 1 muỗng canh dầu ăn rồi để lửa nhỏ, cho hành tím vào phi đến khi hành chuyển qua màu vàng và có mùi thơm thì vớt ra. - Xào sơ thịt Tận dụng lại nồi và dầu đã phi hành tím, bạn để lửa nhỏ và cho phần thân hành lá đã băm nhuyễn vào nồi rồi phi lên. Khi hành vàng và thơm thì bạn cho thịt băm vào xào cùng đến lúc thịt chuyển sang màu trắng thì bạn tắt bếp và vớt thịt ra. - Nấu canh Bắc một cái nồi rồi cho nước vào và đun sôi. Khi nước sôi thì bạn cho khoai mỡ vào đun trong khoảng 5 phút rồi cho phần thịt băm vào đun cùng. Lúc này bạn cho vào nồi nước mắm rồi nêm nếm lại cho vừa miệng. Tiếp tục đun thêm 5 phút nữa thì bạn cho hành lá, ngò gai và ngò om vào rồi tắt bếp, múc ra tô và rắc ít hành phi lên để thưởng thức.","nutrition":{"kcal":74.6,"protein_g":2.3,"fat_g":1.8,"carbs_g":12.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01prt8m1sxl4bsuq","quality_status":"needs_review","warnings":["duplicate_identical_catalog_metadata","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:nau canh","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món canh","id":"mon_canh","kind":"food_category","baseLabel":"Món canh"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu022ot8m1jvutxd3r#variant-1","name":"Chạo chay","detail_name":"Chạo chay","category":"Món chay","age_group":null,"serving":{"raw":"101.6 g / Dĩa vừa","quantity_value":101.6,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Khoai tây","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Phô mai Con Bò Cười (hộp 120g/8 miếng)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Bơ mặn","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bột mì","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Khoai tây rửa sạch, hấp chín. Trong trường hợp muốn hấp nhanh thì bạn khía thành khía nhỏ. Khi khoai còn đang ấm, bạn bóc vỏ. Cắt thành từng lát mỏng, cho vào bát rồi tán nhuyễn sẽ dễ dàng hơn. Vì chạo phải tán nhuyễn mới ngon nên trong quá trình thực hiện, bạn phải tán thật nhuyễn và mịn. Phần mía rửa sạch, chặt thành từng khúc ngắn khoảng từ 10-12 cm, đường kính khoảng 1 cm là vừa đẹp. Róc vỏ và gọt lại cho tròn đều đẹp hơn. Dùng giấy bạc cuộn mía lại. Nhưng nếu nhà bạn có giấy bạc cũng không sao. Sau khi tán nhuyễn khoai tây, trộn chung với phô mai, bơ mặn. Để chạo tôm chay có thêm độ dẻo, bạn cho thêm 1 muỗng súp bột năng, tức là khoảng 2 muỗng cà phê bột năng Nêm muối, tiêu, thêm chút đường (chú ý cho ít đường để chiên không bị cháy). Để cho khỏi dính tay, bạn dúng thìa vào trong dầu, sau đó bọc phần hỗn hợp trên bên ngoài của cây mía. Chuẩn bị sẵn 1 đĩa để đựng chạo tôm chay. Lưu ý bạn nên phết qua 1 chút dầu lên trên bề mặt của chiếc đĩa để không bị dính. Không nên phết phần chạo quá nhiều lên cây mía sẽ làm cho cây mía quá thô. Bạn chỉ cần lấy phần nguyên liệu bằng 1 quả chanh lớn là được. Cho dầu vào chảo, đun nóng rồi cho chạo tôm chay vào nhưng không nên bỏ quá nhiều vì chúng dễ dính vào với nhau. Đến khi chạo có màu vàng thì gắp ra, thấm qua dầu rồi trình bày món ăn lên bàn, ăn kèm với nước chấm","nutrition":{"kcal":207.2,"protein_g":3.6,"fat_g":12.3,"carbs_g":21.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu022ot8m1jvutxd3r","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:it uong","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:phan nguyen","unlisted_ingredient_phrase:phan nguyen lieu","unlisted_ingredient_phrase:tom chay","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món chay","id":"mon_chay","kind":"food_category","baseLabel":"Món chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bv02aet8m1nrd4howb#variant-1","name":"Cháo tôm đậu hà lan bí đỏ","detail_name":"Cháo tôm đậu hà lan bí đỏ","category":"Cháo 13-24 tháng tuổi","age_group":"13-24 tháng","serving":{"raw":"98.5 g / Chén","quantity_value":98.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đậu hà lan","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bí đỏ (bí ngô)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"}],"instructions_raw":"* Tôm rửa sạch, bỏ đầu, bóc vỏ, bỏ 2 đường đen trên sống lưng và dưới bụng, băm nhuyễn. * Đậu hà lan rửa sạch. Bí đỏ gọt vỏ, bỏ hột, rửa sạch. Đậu hà lan và bí đỏ đem đi luộc đến khi chín mềm, vớt để ráo, tán nhuyễn. * Hòa tan tôm với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng, bắc lên bếp khuấy đều cho đến khi sôi, thêm đậu hà lan và bí đỏ vào cho sôi lại. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":216.1,"protein_g":8.6,"fat_g":8.9,"carbs_g":25.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bv02aet8m1nrd4howb","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Bí đỏ (bí ngô)","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam"],"source_categories":[{"label":"Cháo 13-24 tháng tuổi","id":"chao_13_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"13-24 tháng","id":"13_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bv02b6t8m1stcv2q7z#variant-1","name":"Cháo trứng gà đậu hà lan rau ngót","detail_name":"Cháo trứng gà đậu hà lan rau ngót","category":"Cháo 13-24 tháng tuổi","age_group":"13-24 tháng","serving":{"raw":"106.5 g / Chén","quantity_value":106.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Trứng gà ta (35g/quả)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đậu hà lan (hạt)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau ngót","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"6 g","quantity_value":6,"quantity_unit":"g"}],"instructions_raw":"* Trứng gà đập vỏ đỗ ra ch