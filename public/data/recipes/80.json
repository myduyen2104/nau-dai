oned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Cá quả (cá lóc)","ingredient_not_mentioned_by_name:Nấm hương khô","title_ingredient_not_mentioned:Cá quả (cá lóc)","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam"],"source_categories":[{"label":"Cháo 7-8 tháng tuổi","id":"chao_7_8_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"7-8  tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02q2t8m1txv7z6ct#variant-1","name":"Ếch chiên nước mắm","detail_name":"Ếch chiên nước mắm","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"80 g / Dĩa nhỏ","quantity_value":80,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Ếch ( thịt đùi)","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"4 g","quantity_value":4,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Ếch rửa sạch, để ráo ướp với gia vị trong 30 phút. Đặt chảo dầu nóng thả ếch vào chiên vàng đều 2 mặt. Pha hỗn hợp gồm đường, nước mắm cho vừa ăn. Khi ếch chín vàng đều rới hỗn hợp nước mắm lên mình ếch để nhỏ lửa cho thấm gia vị rồi tắt bếp.","nutrition":{"kcal":109.4,"protein_g":14.2,"fat_g":4.8,"carbs_g":2.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02q2t8m1txv7z6ct","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tỏi ta","unlisted_ingredient_phrase:hon hop"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02wyt8m1sr5jjcts#variant-1","name":"Gỏi ngó sen chay","detail_name":"Gỏi ngó sen chay","category":"Món xào chay","age_group":null,"serving":{"raw":"96.2 g / Dĩa vừa","quantity_value":96.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Ngó sen","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tàu hủ ky tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Ngó sen tướt sơ, ngắt khúc, rửa sạch sau đó ngâm trong thau nước đá có vắt chanh. Cà rốt bạn cạo phần vỏ bên ngoài, rửa sạch lại với nước muối loãng, bào hoặc thái thành từng sợi mỏng vừa ăn. Tàu hũ ky rửa sạch, chiên giòn, cắt miếng vừa ăn. Ớt bạn bổ dọc, lấy hết hạt và cắt sợi dài như cà rốt. Hành củ bóc vỏ, rửa sạch, cắt khoanh mỏng. Hành tím, tỏi bóc bỏ vỏ, băm nhuyễn, phi vàng Chanh vắt lấy nước, lọc bỏ hạt. Đậu phộng rang sẵn, đập dập. Pha nước trộn gỏi: Cho đường với nước mắm chay hoặc nước tương (theo tỷ lệ 1:1) vào nồi nhỏ, nấu hỗn hợp trên cho đến lúc đường tan thì tắt bếp, để nguội và chờ cho đến khi nước mắm keo lại như mật ong thì cho ít nước cốt chanh vào. Vậy là nước trộn gỏi chua ngọt của chúng ta đã hoàn thành. Ướp gia vị các nguyên liệu Bạn cần chuẩn bị sẵn 1 cái tô to, cho lần lượt các nguyên liệu sau vào: giấm, nước lọc, muối, sau đó khuấy đều. Tiếp đó, lần lượt cho cà rốt, ngó sen, ớt đỏ ngâm từ 15 cho đến 30 phút, vớt ra ngoài, vắt nhẹ cho đến khi ráo nước. Hoàn thành món gỏi: Bây giờ, việc bạn cần làm là trộn tất cả các nguyên liệu lại với nhau (ngó sen, cà rốt, ớt, tàu hũ ky) cùng với hỗn hợp nước mắm đường chua ngọt vào trong một cái bát to, trộn đều. Sau cùng, nêm nếm cho hợp với khẩu vị của gia đình bạn. Bày thành phẩm gỏi ngó sen chay ra đĩa, cho thêm rau răm, rắc ít lạc rang lên ăn kèm.","nutrition":{"kcal":120.9,"protein_g":5,"fat_g":5.7,"carbs_g":12.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02wyt8m1sr5jjcts","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Xì dầu","unlisted_ingredient_phrase:chien gion","unlisted_ingredient_phrase:chua ngot","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:mam chay","unlisted_ingredient_phrase:mat ong","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:nuoc mam chay","unlisted_ingredient_phrase:nuoc tuong","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào chay","id":"mon_xao_chay","kind":"food_category","baseLabel":"Món xào chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},