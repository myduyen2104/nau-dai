":170,"quantity_unit":"g","portion_label":"Ly"},"ingredients":[{"name":"Bí đỏ (bí ngô)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Sữa đặc có đường Việt Nam","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"NutiMilk Sữa chua ăn có đường - NutiFood","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"}],"instructions_raw":"Bí đỏ, cà rốt gọt vỏ, rửa sạch, cắt miếng nhỏ, cho vào nồi hấp chín. Cho bí đỏ, cà rốt đã luộc, sữa đặc, sữa chua, đá nhỏ vào máy xay sinh tố, xay nhuyễn, đổ ra ly là đã có một ly sinh tố bí đỏ cà rốt thơn ngon, bổ dưỡng.","nutrition":{"kcal":155,"protein_g":4.1,"fat_g":3.3,"carbs_g":27.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72n04ext8m1jwjayx76","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Bí đỏ (bí ngô)","ingredient_not_mentioned_by_name:Sữa đặc có đường Việt Nam"],"source_categories":[{"label":"Sinh tố, kem, trái cây đóng hộp","id":"sinh_to_kem_trai_cay_dong_hop","kind":"food_category","baseLabel":"Sinh tố, kem, trái cây đóng hộp"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gf04umt8m14cilm6li#variant-1","name":"Sườn cốt lết kho","detail_name":"Sườn cốt lết kho","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"50 g / Dĩa nhỏ","quantity_value":50,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thịt heo rửa sạch để ráo ướp gia vị trong 20 phút. Hành củ tươi lột vỏ rửa sạch băm nhỏ. Cho đường và nước vào đun cho đường tan hết và chuyển sang màu cánh gián. Xếp thịt vào nồi nước đường vừa đun nêm thêm gia vị cho vừa ăn. Kho thịt trên lửa nhỏ cho đến khi cạn nước. Cuối cùng tắt bếp.","nutrition":{"kcal":195.3,"protein_g":8.3,"fat_g":17.1,"carbs_g":2.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gf04umt8m14cilm6li","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:nuoc uong"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04vet8m1wxhxg88q#variant-1","name":"Sườn nấu đậu","detail_name":"Sườn nấu đậu","category":"Món mặn","age_group":null,"serving":{"raw":"147.5 g / Dĩa vừa","quantity_value":147.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Đậu trắng hạt (đậu tây)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sườn heo rửa sạch để ráo ướp gia vị 30 phút. Cà chua rửa sạch cắt nhỏ. Cà rốt , khoai tây gọt vỏ rửa sạch cắt vừa ăn. Đậu trắng rửa sạch để ráo. Hành lá , rau mùi rửa sạch bỏ rể cắt vừa ăn. Tỏi ta bóc vỏ rửa sạch băm nhuyễn. Đặt 1 cái nồi lên bếp phi thơm tỏi , cho tiếp thịt vào xào sơ, tiếp theo cho cà chua vào xào chung. Kế tiếp cho nước vào đun sôi trên lửa nhỏ. Tiếp theo cho khoai tây, cà rốt, đậu trắng vào nấu chung, nêm nếm gia vị lại cho vừa ăn. Cuối cùng cho hành lá và rau mùi vào rồi tắt bếp.","nutrition":{"kcal":476.9,"protein_g":22.3,"fat_g":38.4,"carbs_g":10.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04vet8m1wxhxg88q","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:suon heo"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04xnt8m1okx26cr4#variant-1","name":"Súp lơ xanh, cà rốt xào tôm","detail_name":"Súp lơ xanh, cà rốt xào tôm","category":"Món xào từ 18 tháng đến 5 tuổi","age_group":"18 tháng","serving":{"raw":"74 g","quantity_value":74,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Súp lơ xanh","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Dùng dao nhỏ tách súp lơ thành các múi đều nhau. Múi to bổ dọc làm đôi. Phần cuống gọt vỏ nếu cần, thái thành các lát mỏng. Bông súp lơ có nhiều khe/kẽ nên khó rửa, cần ngâm nước muối loãng 5-10 phút. Cà rốt nạo vỏ, bào sợi, thái lát mỏng hoặc miếng tròn tùy thích. Tôm lột vỏ, bỏ đầu. Tôm to cần rút chỉ đen. Rửa tôm sạch và để ráo rồi ướp với chút bột canh và hạt tiêu. Đun nóng dầu ăn rồi cho tôm vào xào. Khi tôm đổi màu và săn lại thì cho cà rốt vào xào trước rồi đến súp lơ. Nêm nếm thêm gia vị cho vừa miệng rồi tắt bếp. Rắc thêm hạt tiêu nếu thích ăn cay hoặc trang trí thêm vài cọng rau mùi nếu có.","nutrition":{"kcal":59.7,"protein_g":3.3,"fat_g":3.3,"carbs_g":4.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04xnt8m1okx26cr4","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Súp lơ xanh","title_ingredient_not_mentioned:Súp lơ xanh","unlisted_ingredient_phrase:bot canh","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:rau mui"],"source_categories":[{"label":"Món xào từ 18 tháng đến 5 tuổi","id":"mon_xao_tu_18_thang_den_5_tuoi","kind":"food_category","baseLabel":"Món xào từ 18 tháng đến 5 tuổi"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh058rt8m10whpah6f#variant-1","name":"thịt heo xào dưa","detail_name":"thịt heo xào dưa","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"154.3 g","quantity_value":154.3,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"1