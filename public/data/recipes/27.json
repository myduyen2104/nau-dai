ạt màu điều cho vào túi lọc để nấu nước dùng. Cho thịt bò chay, gói gia vị phở bò chay vào xào chung, tiếp đến cho thêm nước dừa và nước dùng vào đun sôi, cho thêm túi gia vị vào nấu chung. Sau khi nước sôi cho tiếp củ cải vào nấu thêm 10 phút, thêm nấm rơm và đậu hủ vào nồi nấu thêm một lúc. Cuối cùng nêm thêm muối, đường, hạt nêm vào cho vừa miệng. Lấy bánh phở đem trụng qua nước sôi, rồi cho vào tô, xếp đậu phụ và hành tây lên trên, sau đó chan thêm nước dùng và rắc thêm một chút tiêu, thưởng thức ngay khi còn nóng.","nutrition":{"kcal":594.2,"protein_g":21.6,"fat_g":15.1,"carbs_g":95.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03w9t8m18wobx7tc","quality_status":"needs_review","warnings":["duplicate_ingredient_names","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["duplicate_ingredient_names","ingredient_not_mentioned_by_name:Đậu tương (đậu nành)","ingredient_not_mentioned_by_name:Bột mì","ingredient_not_mentioned_by_name:Rau thơm","ingredient_not_mentioned_by_name:Rau mùi tàu/ Ngò gai","ingredient_not_mentioned_by_name:Rau ngổ","ingredient_not_mentioned_by_name:Rau húng","ingredient_not_mentioned_by_name:Tương ngô","ingredient_not_mentioned_by_name:Chanh","unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:thit bo","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:tui loc"],"source_categories":[{"label":"Món nước- chay","id":"mon_nuoc_chay","kind":"food_category","baseLabel":"Món nước- chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72m0453t8m1ndj5sklh#variant-1","name":"ROHTO N14 - CANH CHUA","detail_name":"ROHTO N14 - CANH CHUA","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"114.7 g","quantity_value":114.7,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"