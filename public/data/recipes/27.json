[{"name":"Ếch ( thịt đùi)","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Ớt khô bột","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Cá mua về cắt khúc vừa ăn rửa sạch, ướp với gia vị trong 30 phút. Hành củ lọt vỏ băm nhuyễn, hành lá rửa sạch, bỏ rể, cắt nhỏ. Bắt nồi lên bếp cho đường và nước vào đun nhỏ lửa đến khi đường có màu cánh gián. Kế tiếp xếp cá vào tộ cùng với hành băm, nêm thêm gia vị cho vừa ăn, kho lửa nhỏ đến khi cá có màu nâu thì tắt bếp rắc tiêu và hành lá lên trên.","nutrition":{"kcal":196.4,"protein_g":20.4,"fat_g":11.2,"carbs_g":4.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02qft8m12yvw4767","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Ếch ( thịt đùi)","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Ớt khô bột","ingredient_not_mentioned_by_name:Nước mắm cá","title_ingredient_not_mentioned:Ếch ( thịt đùi)","unlisted_ingredient_phrase:uong co"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02wut8m1xo2frkwa#variant-1","name":"Gỏi măng tươi","detail_name":"Gỏi măng tươi","category":"Món luộc","age_group":null,"serving":{"raw":"156.2 g / Dĩa vừa","quantity_value":156.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Măng tre","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Vừng (đen, trắng)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Thịt heo bạn đem rửa sạch với nước muối loãng. Sau đó, bạn cho thịt vào nồi nước đem đi luộc. Bạn luộc đến khi thịt chín thì vớt ra để ráo rồi thái sợi hoặc thái miếng mỏng. Đối với tôm, bạn cắt gọn râu, rút chỉ đen và rửa sạch. Tiếp theo, bạn cho tôm vào nồi nước đem đi luộc. Tôm khi đã chín, bạn gắp tôm ra và thả vào một bát nước đá đã chuẩn bị sẵn để ngâm trong khoảng 10 phút thì bóc vỏ tôm, chẻ dọc làm hai nếu tôm lớn. Vừng đen ran sơ Hành tây gọt vỏ, rửa sạch, thái khoanh mỏng Bạn cho một ít dầu vào chảo đun nóng, sau đó cho hành tím bào vào xào sơ cho thơm. Măng tươi mới mua về, bạn bóc bỏ bẹ, luộc với nước sôi nhiều lần và mỗi lần luộc phải xả lại bằng nước sạch. Khi thử thấy măng mềm đã bớt chất đắng thì rửa kỹ, vắt ráo và thái thành các miếng mỏng. Sau khi thái măng thành các miếng mỏng, bạn tiếp tục cho măng vào một nồi nước và luộc lại một lần nữa, sau đó vớt ra để ráo. Tiếp đến, bạn đun nóng 2 thìa dầu ăn trên chảo và cho măng vào xào nêm hạt nêm, bột ngọt, tiêu. Bạn băm tỏi và ớt thật nhuyễn, để riêng. Sau đó, bạn cho vào đường, nước mắm, nước cốt chanh, ớt băm vào và khuấy đều cho đường tan và nêm nếm lại cho vừa ăn. Bạn cho tôm, thịt, măng, hành tây vào tô lớn, cho thêm lá chanh, rau thơm và vừng rang vào, rưới đều phần nước mắm trộn gỏi còn lại vào hỗn hợp, trộn thật kĩ cho ngấm gia vị. Cuối cùng bạn bày ra đĩa, rắc đậu phộng rang, hành tím phi lên trên và ăn kèm với cơm/bánh phồng tôm.","nutrition":{"kcal":172.8,"protein_g":7,"fat_g":10.3,"carbs_g":13.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02wut8m1xo2frkwa","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:au phong","unlisted_ingredient_phrase:banh phong","unlisted_ingredient_phrase:banh phong tom","unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:la chanh","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:phong tom","unlisted_ingredient_phrase:tom thit","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món luộc","id":"mon_luoc","kind":"food_category","baseLabel":"Món luộc"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo0371t8m11q7dvd91#variant-1","name":"LH-C2-Bánh mì bò kho","detail_name":"LH-C2-Bánh mì bò kho","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"272.