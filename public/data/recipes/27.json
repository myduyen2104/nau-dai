a"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01mft8m132wcxjpq#variant-1","name":"Canh chua dưa cải thịt bò","detail_name":"Canh chua dưa cải thịt bò","category":"Món canh từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"45.5 g / Chén","quantity_value":45.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dưa cải bẹ","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cà chua rửa sạch, bổ múi cau. Lấy cải chua ra rửa cho bớt mặn. Sau đó cắt cải chua khúc nhỏ vừa ăn cho vào nồi thêm nước đun sôi, cho cà chua vào. Khi nước sôi nhẹ thì mình nêm nếm gia vị. Điều chỉnh sao cho nước canh có vị chua chua mặn mặn là được. Thịt bò thái lát mỏng và ướp với gia vị. Sau đó bắt chảo và phi tỏi với dầu cho vàng và vớt tỏi ra. Bỏ thịt bò đã ướp vào xào sơ với dầu tỏi cho thơm. Tắt bếp nồi canh và đổ thịt bò vào khuấy đều. Sau đó bỏ luôn phần tỏi đã phi vào trong nồi canh sẽ làm cho canh thơm ngon hơn.","nutrition":{"kcal":30.5,"protein_g":2.6,"fat_g":1.4,"carbs_g":2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01mft8m132wcxjpq","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh từ 3-4 tuổi","id":"mon_canh_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinh