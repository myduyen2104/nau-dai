.6,"carbs_g":1.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04w1t8m1z7ctfu08","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:nuoc mau","unlisted_ingredient_phrase:nuoc uong","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04xmt8m16msb1r1y#variant-1","name":"Súp lơ xanh, cà rốt xào thịt bò","detail_name":"Súp lơ xanh, cà rốt xào thịt bò","category":"Món xào 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"126.5 g / Dĩa vừa","quantity_value":126.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Súp lơ xanh","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Súp lơ rửa sạch, cắt miếng vừa ăn. Cà rốt gọt vỏ rửa sạch, cắt miếng vừa ăn.Thịt bò rửa sạch, thái mỏng rồi ướp gia vị. Đun nóng dầu, rồi cho súp lơ, cà rốt vào xào chín tới. Cho tiếp thịt bò vào xào nhanh tay trên lửa lớn để thịt chín vừa đủ độ, không bị dai. Nêm lại gia vị lần cuối cho vừa ăn. Xúc ra đĩa, thêm vào 1 chút hạt tiêu và ăn nóng với cơm.","nutrition":{"kcal":107.1,"protein_g":6.9,"fat_g":6,"carbs_g":6.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04xmt8m16msb1r1y","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Súp lơ xanh","ingredient_not_mentioned_by_name:Muối","title_ingredient_not_mentioned:Súp lơ xanh","unlisted_ingredient_phrase:hat tieu"],"source_categories":[{"label":"Món xào 8-18 tuổi","id":"mon_xao_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh0585t8m17d47tu8u#variant-1","name":"Thịt heo quay chay","detail_name":"Thịt heo quay chay","category":"Món chay","age_group":null,"serving":{"raw":"89.5 g / Dĩa vừa","quantity_value":89.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bột gạo nếp","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bánh mì","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Tàu hủ ky khô","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"27 g","quantity_value":27,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"27 g","quantity_value":27,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Dừa nạo lọc lấy nước cốt. Pha bột gạo với nước cốt dừa khuấy đều rồi bắc lên bếp quậy liên tục với lửa nhỏ đến khi hỗn hợp sệt lại thì tắt bếp và vẫn tiếp tục khuấy thêm vài vòng nữa. Bánh mì cắt dọc bỏ bớt phần ruột, cán phẳng. Đậu hũ cắt theo chiều dọc dày 1.5cm. Trải vỏ bánh mì ngửa mặt trong ra, phết phần hỗn hợp vừa làm đều lên. Tiếp tục đắp lớp đậu phụ lên trên cùng. Gói chặt lại bằng lá chuối cho các phần dính đều nhau và đem hấp chừng 20 phút. Sau khi lấy ra thì để nguội rồi gỡ lá chuối ra. Hòa xì dầu, bột nêm, muối, đường và tiêu rồi dùng cọ quét đều lên mặt bánh mì. Để hơi khô rồi cắt thành từng thớ dài như miếng thịt quay thường.Cho từng miếng thịt vào áp chảo lần lượt các mặt. Lưu ý áp chảo phần mặt bánh mì trước sao cho mặt bánh mì vàng giòn như màu da của thịt quay.Cắt miếng vuông vừa ăn. Thành phẩm phải có da màu vàng cam, giòn đều. Lớp giả mỡ trong và hơi dai. Các lớp dính với nhau không bị rời rạc.","nutrition":{"kcal":248,"protein_g":9.5,"fat_g":13.6,"carbs_g":21.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh0585t8m17d47tu8u","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tàu hủ ky khô","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món chay","id":"mon_chay","kind":"food_category","baseLabel":"Món chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05ftt8m16afqk3o1#variant-1","name":"Trứng gà chiên nấm","detail_name":"Trứng gà chiên nấm","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"95.5 g / Dĩa nhỏ","quantity_value":95.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"75 g","quantity_value":75,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Trứng gà đập ra chén, cho gia vị, hành lá cắt nhỏ vào khuấy đều. Nấm rơm rửa sạch, cắt mỏng. Làm nóng dầu ăn trong chảo, cho lần lượt nấm rơm, hỗn hợp trứng vịt vào, tráng đều, chiên nhỏ lửa. Tiếp theo, gấp đôi miếng trứng lại, chiên thêm 1 phút. Tắt bếp, bày món ăn ra đĩa và dùng với cơm trắng.","nutrition":{"kcal":151,"protein_g":10.1,"fat_g":11.5,"carbs_g":2.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05ftt8m16afqk3o1","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:trung vit"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]