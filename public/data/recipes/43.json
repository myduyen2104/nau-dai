abel":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gf04q9t8m1helud5gu#variant-1","name":"Sữa hạnh nhân nhà nấu (có đường) 200ml/ly","detail_name":"Sữa hạnh nhân nhà nấu (có đường) 200ml/ly","category":"Sữa đậu nành (1 tuổi trở lên)","age_group":"1 tuổi","serving":{"raw":"200 g / Ly","quantity_value":200,"quantity_unit":"g","portion_label":"Ly"},"ingredients":[{"name":"Hạt hạnh nhân (chưa rang)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"NutiMilk Sữa tươi tiệt trùng có đường","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Nước lọc","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"}],"instructions_raw":"Hạnh nhân ngâm mềm, bóc vỏ cho vào máy xay sinh tố xay cùng với nước, lọc lấy nước cốt. Trộn nước hạn nhân với đường, sữa tươi, thêm một ít lá dứa nấu sôi, lưu ý trong lúc nấu khuấy đều để sữa không bị dinh đáy nồi. Cho sữa sôi đều khoảng 5 phút là tắt bếp. Có thể uống nóng hoặc lạnh tùy thích.","nutrition":{"kcal":212.9,"protein_g":6.7,"fat_g":12.8,"carbs_g":19.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gf04q9t8m1helud5gu","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Sữa đậu nành (1 tuổi trở lên)","id":"sua_dau_nanh_1_tuoi_tro_len","kind":"age_scoped_food_category","baseLabel":"Sữa đậu nành"}],"source_age_group":{"label":"1 tuổi","id":"1_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh057zt8m1sypy2kea#variant-1","name":"Thịt heo quay","detail_name":"Thịt heo quay","category":"Món mặn","age_group":null,"serving":{"raw":"56 g / Dĩa vừa","quantity_value":56,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":null,"instructions_raw":"Thịt heo các bạn lóc bỏ xương và mỡ thừa sau đó đem rửa với dung dịch nước ấm pha với giấm và muối.Trong quá trình rửa các bạn dùng dao cạo sạch lớp da, lưu ý nhẹ tay tránh làm rách da heo để da được nổ giòn đều hơn.Rửa lại bằng nước sạch 2 lần và dùng khăn ăn thấm để miếng thịt được khô ráo hoàn toàn.Dùng dao khứa trên phần thịt khoảng 1-2 cm để khi ướp thịt sẽ thấm đều gia vị hơn.Pha hỗn hợp bột khô gồm: đường, tỏi, ớt, gừng, ngũ vị hương và tiêu.Tiếp tục pha hỗn hợp gồm: chao, tương ăn phở, nước tương và dầu hào.Trộn đều cho chao được nhuyễn và thoa hỗn hợp lên các mặt của miếng thịt trừ phần da và để thấm gia vị từ 5-10 phút. Hỗn hợp này không bắt buộc tuy nhiên nếu các bạn muốn món ăn được đậm vị, giòn rụm giống như ngoài hàng.Đun 1 nồi nước sôi để luộc thịt trong vòng 20 phút. Không để nước ngập lên phần da.Dùng 1 cây nĩa hoặc 1 bó xiên thịt nướng đâm lên phần da heo, cách này giúp da heo khi nướng sẽ nổ giòn hơn.Pha hỗn hợp gồm: giấm, bột nở (baking soda), muối. Trộn đều hỗn hợp và quét lên phần da heo. Lưu ý cần thấm cho da thật khô rồi mới quét lên.Làm nóng lò với chế độ lửa trên và dưới ở 200°C trong 10 phút.Để miếng thịt lên vỉ nướng và cho vào lò nướng ở 200°C trong 20 phút.","nutrition":{"kcal":224.6,"protein_g":11.5,"fat_g":19.7,"carbs_g":0.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh057zt8m1sypy2kea","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","listing_count_not_visible_in_detail","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:baking soda","unlisted_ingredient_phrase:dau hao","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc tuong","unlisted_ingredient_phrase:pha voi","unlisted_ingredient_phrase:thit heo","unlisted_ingredient_phrase:thit nuong","unlisted_i