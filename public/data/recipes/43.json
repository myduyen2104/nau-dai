"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01jlt8m17sb718ag#variant-1","name":"Canh cải chua thịt bò","detail_name":"Canh cải chua thịt bò","category":"Món canh 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"112.2 g / Chén","quantity_value":112.2,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Dưa cải bẹ","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Dưa cải vớt ra, rửa sạch để ráo Thịt bò làm sạch, cắt lát vừa ăn, phi thơm hành tỏi với dầu ăn, xào sơ thịt bò với một chút gia vị rồi trút vào nồi hầm, thêm nước đủ ăn. Xào sơ qua dưa cải với bột nêm cho ngấm gia vị Trút dưa cải đã xào vào nồi bò hầm, đun sôi, nếm gia vị vừa ăn. Tắt bếp","nutrition":{"kcal":45.4,"protein_g":3.9,"fat_g":1.4,"carbs_g":4.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01jlt8m17sb718ag","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:bot nem"],"source_categories":[{"label":"Món canh 8-18 tuổi","id":"mon_canh_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01x7t8m1218y9od5#variant-1","name":"Canh su su thịt heo","detail_name":"Canh su su thịt heo","category":"Món canh 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"43.5 g / Chén","quantity_value":43.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Su su","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Th