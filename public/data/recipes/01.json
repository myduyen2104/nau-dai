d_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cà chua","ingredient_not_mentioned_by_name:Sốt cà chua - Life Tomato Ketchup","ingredient_not_mentioned_by_name:Bột Năng Tài Ký","ingredient_not_mentioned_by_name:Muối","title_ingredient_not_mentioned:Cà chua","title_ingredient_not_mentioned:Sốt cà chua - Life Tomato Ketchup","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:pha toi"],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh059at8m1vaspgp0s#variant-1","name":"thịt kho tiêu chay","detail_name":"thịt kho tiêu chay","category":"Món chay","age_group":null,"serving":{"raw":"73 g / Dĩa vừa","quantity_value":73,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Đậu tương (đậu nành)","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Nước tương MAGGI Đậu Nành Đậm Đặc - NESTLÉ","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Thịt heo chay mua về, đem ngâm cho nở mềm ra rồi xé miếng vừa ăn.Ướp thịt cùng với nước tương, muối, đường, thìa tiêu và bột nêm chay .Trộn đều để thịt thấm gia vị, để ít nhất là 15-20 phút trước khi đem đi kho.Trong lúc ngâm thịt cho nở ra, tranh thủ sơ chế chỗ hành barô. Hành đem cắt bỏ phần gốc rễ, rửa sạch rồi chia thành 2 phần, đầu hành và lá hành.Đầu hành thì thái nhỏ, còn phần ngọn thì cắt khúc 2 – 3 cm.Phi thơm hành boa rô cùng với một ít dầu. Sau đó, cho phần thịt chay đã ướp sẵn vào, đảo đều tay cho các gia vị thấm lại với nhau.Khi thấy thịt đã gần chín, cho một ít nước lọc cùng đường vào đun sôi để lấy n