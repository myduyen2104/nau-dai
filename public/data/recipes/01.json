rồi nhanh tay đổ bột vào chảo để làm mẻ bánh thứ 2. Trên chiếc bánh đã được đổ ra, bạn múc một muỗng canh nhân thịt lên, trải đều thịt và cuốn lại. Lặp lại cho tới khi hết bột. Dưa leo rửa sạch, cắt thành những thanh nhỏ, ngắn khoảng 1 lóng tay. Rau thơm rửa sạch, cắt nhỏ, chả lụa cắt miếng nhỏ khoảng 1 lóng tay, giá trụng với nước sôi khoảng 2 phút cho chín. Xếp bánh cuốn, rau thơm, dưa leo, chả lụa, hành phi ra đĩa và chấm với nước mắm pha, ăn ngay khi còn nóng bạn nhé.","nutrition":{"kcal":708.1,"protein_g":25,"fat_g":39,"carbs_g":65.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00elt8m1ig16ld65","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:bot banh","unlisted_ingredient_phrase:cha lua","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mam pha","unlisted_ingredient_phrase:nuoc mam pha","unlisted_ingredient_phrase:rau thom","unlisted_ingredient_phrase:thit va","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00ljt8m183adpe8v#variant-1","name":"Bắp nếp luộc (1/2Trái vừa)","detail_name":"Bắp nếp luộc (1/2Trái vừa)","category":"Món ăn vặt từ 2-5 tuổi","age_group":"2-5 tuổi","serving":{"raw":"60 g / 1/2 Trái","quantity_value":60,"quantity_unit":"g","portion_label":"1/2 Trái"},"ingredients":null,"instructions_raw":null,"nutrition":{"kcal":103.2,"protein_g":2.3,"fat_g":1.3,"carbs_g":20.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00ljt8m183adpe8v","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","instructions_missing_from_detail","listing_count_not_visible_in_detail"],"integrity_findings":[],"source_categories":[{"label":"Món ăn 