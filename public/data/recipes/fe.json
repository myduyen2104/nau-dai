lại lần nữa thì nêm nếm cho vừa ăn. Làm cá dầm – Ướp cá thu cùng tiêu, nước mắm, bột ngọt, gừng, một ít rượu và đem hấp trong 30 phút là được Pha nước mắm chấm – Làm nước chấm bằng cách cho tỏi băm, ớt cắt lát và nước mắm ngon vào chén, trộn đều. Lưu ý, không thêm đường để nước mắm giữ được vị ngon nguyên chất. Trình bày và thưởng thức – Xếp bún ra tô, cho chả cá hấp, chiên và cá dầm lên trên rồi chan nước dùng vào và thưởng thức cùng rau sống. Thêm chút nước mắm sẽ làm món ăn thêm đậm đà.","nutrition":{"kcal":377,"protein_g":15.3,"fat_g":11.5,"carbs_g":53.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00y7t8m133tx7pwl","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giá đậu xanh","unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:nguyen chat","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 6-7 tuổi","id":"mon_nuoc_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv013bt8m17e2x6nsj#variant-1","name":"Cá bạc má chiên","detail_name":"Cá bạc má chiên","category":"Món mặn","age_group":null,"serving":{"raw":"72 g / Dĩa nhỏ","quantity_value":72,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá nục","quantity_raw":"65 g","quantity_value":65,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":132.1,"protein_g":13.1,"fat_g":9.1,"carbs_g":0},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv013bt8m17e2x6nsj","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integ