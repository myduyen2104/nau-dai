ity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bí đỏ (bí ngô)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"6 g","quantity_value":6,"quantity_unit":"g"}],"instructions_raw":"Tôm làm sạch, rửa sạch, băm nhuyễn. Hạt sen bỏ tim sen(nếu có), rửa sạch, luộc chín, tán nhuyễn. Bí đỏ gọt vỏ, bỏ hạt, luộc chín, tán nhuyễn. Hòa tan bột gạo và tôm với nước, bắc lên bếp khuấy đều đến khi sôi, thêm bí đỏ, hạt sen vào khuấy đều. Tắt bếp. Thêm dầu thực vật vào khuấy đều.","nutrition":{"kcal":163.3,"protein_g":6,"fat_g":6.5,"carbs_g":20.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00w2t8m1raer6v8p","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bí đỏ (bí ngô)","unlisted_ingredient_phrase:dau thuc","unlisted_ingredient_phrase:dau thuc vat","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:thuc vat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ từ 7-8 tháng","id":"mon_bot_nha_nau_cho_tre_tu_7_8_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"7-8 tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv010pt8m1hhbqslx4#variant-1","name":"Bún riêu chay","detail_name":"Bún riêu chay","category":"Món nước- chay","age_group":null,"serving":{"raw":"404 g / Tô vừa","quantity_value":404,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bún tươi","quantity_raw":"210 g","quantity_value":210,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"48 g","quantity_value":48,"quantity_unit":"g"},{"name":"Đậu tương (đậu nành)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"26 g","quantity_value":26,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Đậu phụ tươi, đậu phụ non rửa sạch, để ráo, đậu phụ non cắt thành từng miếng vuông vừa ăn, cho 2 thứ vào âu riêng. Bóp nhuyễn đậu phụ tươi, thêm canh tương đậu nành, muối, đường và trộn đều. Cà chua rửa sạch, cắt múi cau. Các loại rau ăn kèm, làm sạch, để ráo. Hành boa rô rửa sạch, phần đầu đập dập, phần lá cắt nhỏ.Chuẩn bị chảo dầu nóng, trút đậu phụ non đã cắt miếng vuông vào chiên vàng rồi vớt ra đĩa. Đặt chảo lên bếp, đun nóng một ít màu dầu điều, phi thơm đầu hành.Cho lần lượt cà chua, củ cải trắng, một chút hành boa rô đã sơ chế vào xào chín cùng 1 ít muối, đường, xào đều tay. Tiếp tục dùng lại chảo đó, đun nóng ít dầu, cho đậu phụ đã bóp nát vào xào chung với một ít muối. Xào khoảng 5 – 7 phút, tiếp tục cho bột mì vào, đảo đều. Bột mì có tác dụng kết dính để khi đun sẽ tạo thành mảng riêu nổi lên bề mặt. Khi thấy rau củ quả hầm đã chín mềm, tiến hành vớt bỏ bã, lọc lại nước dùng.Sau đó, cho hỗn hợp rau củ đã xào cùng đậu phụ chiên vào và nấu khoảng 15 phút. Nêm vào nồi nước dùng một ít giấ, dùng muỗng múc từng muôi hỗn hợp đậu phụ riêu cua thả vào nồi nước dùng, đun lửa nhỏ để mảng riêu đậu phụ nổi lên bề mặt. Nêm nếm lại gia vị cho vừa ăn, thêm một ít hành boa rô cắt nhỏ vào và tắt bếp. Khi ăn, bạn gắp một ít bún vào tô lớn, chan nước dùng có lẫn cà chua, đậu phụ, nấm các loại và múc một ít riêu đậu phụ, rắc thêm một ít hành boa rô, rau mùi cắt nhỏ. Dùng nóng với các loại rau ăn kèm.","nutrition":{"kcal":471.9,"protein_g":17.3,"fat_g":15.1,"carbs_g":67.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv010pt8m1hhbqslx4","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:cai trang","unlisted_ingredient_phrase:cu cai trang","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:rau mui","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước- chay","id":"mon_nuoc_chay","kind":"food_category","baseLabel":"Món nước- chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw015ut8m10izwbpdg#variant-1","name":"Cá điêu hồng kho","detail_name":"Cá điêu hồng kho","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"57 g / Dĩa nhỏ","quantity_value":57,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá điêu hồng","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cá diêu hồng đánh vảy, bỏ hết nội tạng, rửa sạch để ráo, ướp gia vị trong 15 phút. Bắt nồi lên bếp, cho vào dầu ăn, đường, để lửa nhỏ, khuấy đều cho đến khi đường đổi màu vàng cánh gián thì cho cá vào, trở đều 2 mặt cá. Thịt cá săn lại thì cho nước vào săm sắp cá là được. Để lửa nhỏ đến khi nước sền sệt thì tắt bếp","nutrition":{"kca