n hết chất thải bên trong đầu tôm ra ngoài. Lột sạch vỏ tôm rồi dùng tay hoặc dao để kéo bỏ phần chỉ trên lưng tôm. Sau đó rửa lại với nước muối pha loãng để khử mùi tanh của tôm. Rửa lại với nước sạch một lần nữa và để cho tôm ráo nước. Sơ chế các nguyên liệu khác Bạn tiến hành sơ chế các nguyên liệu khác như sau: Phô mai dạng thỏi: bào thành từng sợi nhỏ. Tỏi: bỏ vỏ rồi cắt chúng thành từng lát mỏng. Làm tôm sốt phô mai Đầu tiên, bắc chảo lên bếp rồi cho bơ lạt vào đun cho chảy. Cho thêm phần tỏi cắt lát vào và phi cho thơm. Tiếp theo, bạn cho phần tôm vào chảo, thêm muối và tiêu rồi trộn đều chúng. Sau đó, xào cho đến khi tôm chuyển sang màu cam. Cuối cùng là cho phô mai vào chảo, đậy nắp và đun thêm 3 - 5 phút cho phô mai tan hết ra là món ăn hoàn thành.","nutrition":{"kcal":83.6,"protein_g":7,"fat_g":4.4,"carbs_g":3.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh059qt8m1s60xqdi0","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bơ thực vật","ingredient_not_mentioned_by_name:Pho mát","ingredient_not_mentioned_by_name:Rượu vang trắng (cồn 9.5 g)","ingredient_not_mentioned_by_name:Bột bắp (bột ngô vàng)","unlisted_ingredient_phrase:mai dang","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:pho mai","unlisted_ingredient_phrase:pho mai dang","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05fjt8m1nnv0r0w1#variant-1","name":"Trứng gà chiên hàu","detail_name":"Trứng gà chiên hàu","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"50 g / Dĩa nhỏ","quantity_value":50,"quantity_unit":"g","portion_label":"