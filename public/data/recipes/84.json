ity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món xào 8-18 tuổi","id":"mon_xao_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03b6t8m15gpkzrz2#variant-1","name":"Măng xào mực tươi","detail_name":"Măng xào mực tươi","category":"Món xào","age_group":null,"serving":{"raw":"143 g / Dĩa vừa","quantity_value":143,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Măng tre","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Mực tươi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Mực tươi rửa sạch, cắt khoanh. Măng tươi khi mua về dùng dao cắt thành lát mỏng. Luộc măng với nước sôi nhiều lần và mỗi lần luộc phải xả lại bằng nước sạch cho đến khi măng mềm và bớt chất đắng thì vớt ra để ráo. Hành lá rửa sạch, phần thân băm nhuyễn, phần lá cắt nhỏ Bắc chảo lên bếp, cho vào chảo dầu ăn rồi đợi dầu nóng, sau đó cho thêm hành băm nhuyễn vào phi thơm. Tiếp theo, cho vào chảo phần mực đã được sơ chế, bột ngọt, hạt nêm, đường vào rồi xào cho đến khi mực săn lại thì để ra tô. Cho vào chảo thêm canh dầu ăn và hành băm nhuyễn vào phi thơm. Sau đó cho phần măng tươi đã được sơ chế cùng bột ngọt, hạt nêm, đường, nước mắm vào rồi đảo đều lên khoảng 3 phút cho măng được thấm vị. Tiến hành cho phần mực xào trước đó vào và đảo đều hỗn hợp rồi cho thêm 2 quả ớt và 2 nhánh hành lá băm nhỏ. Đảo đều cho đến khi các nguyên liệu hòa trộn vào nhau rồi nếm nếm gia vị cho vừa miệng, tắt bếp và cho món ăn ra đĩa.","nutrition":{"kcal":106,"protein_g":6.7,"fat_g":5.5,"carbs_g":8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03b6t8m15gpkzrz2","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món xào","id":"mon_xao","kind":"food_category","baseLabel":"Món xào"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03ert8m1sl1atvfp#variant-1","name":"Mì thịt bò","detail_name":"Mì thịt bò","category":"Món nước 5 tuổi","age_group":"5 tuổi","serving":{"raw":"123 g / Tô nhỏ","quantity_value":123,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Mì sợi khô","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Mỡ lợn nước","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, cắt miếng vừa ăn. Tiếp đó cho gừng và một lượng nước vừa đủ vào nồi để trụng thịt bò. Hành lá, hẹ lá rửa sạch, cắt khúc Rau sà lách, giá đỗ nhặt, rửa sạch, để ráo Thịt sau khi trụng thì rửa sạch lại bằng nước ấm rồi để sang một bên. Cho một ít dầu vào chảo, sau đó cho tiêu hạt, vài lát gừng vào chảo, đảo đều ở mức lửa nhỏ. Tới khi nguyên liệu có mùi thơm, bạn bật bếp lên mức lửa vừa, cho thịt bò và các gia vị vào chảo. Đảo đều để thịt bò được ngấm đều gia vị. Sau đó múc thịt bò để riêng. Đổ nước vào chảo thịt để tráng lấy nước ngọt từ thịt bò xào ra nước . Sau đó đỗ lượng nước này vào nồi và thêm nước vào vừa đủ đun sôi nêm nếm cho phù hợp với khẩu vị cá nhân và nấu thêm 5 đến 10 phút nữa thì tắt bếp. Cho mì đã luộc chín ra bát, thêm thịt bò, hành lá, ngò rí nước dùng vào ăn kèm với rau sà lách, hẹ lá, giá","nutrition":{"kcal":307.6,"protein_g":13.5,"fat_g":9.6,"carbs_g":42.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03ert8m1sl1atvfp","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Mỡ lợn nước","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:lieu co","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nguyen lieu co","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ngot","unlisted_ingredient_phrase:rau sa lach","unlisted_ingredient_phrase:sa lach","unlisted_ingredient_phrase:tu thit"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03fdt8m1fniqrp26#variant-1","name":"Mì thịt heo trứng cút","detail_name":"Mì thịt heo trứng cút","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"294 g / Tô vừa","quantity_value":294,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Mì sợi khô","quantity_raw":"110 g","quantity_value":110,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"50 g","quanti