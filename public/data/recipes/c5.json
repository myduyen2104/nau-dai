598.food/mon-an/cmrg0p65f02c8t8m1hteydi6n","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Chè (18 tháng trở lên)","id":"che_18_thang_tro_len","kind":"age_scoped_food_category","baseLabel":"Chè"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02vvt8m1pu7zvkxw#variant-1","name":"Giá xào chay","detail_name":"Giá xào chay","category":"Món xào chay","age_group":null,"serving":{"raw":"101.5 g / Dĩa vừa","quantity_value":101.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Giá đậu xanh","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Đậu phụ rửa sạch, cắt dọc thành từng miếng nhỏ vừa ăn, đun nóng chảo, cho đậu phụ vào rán vàng hai mặt. Vớt đậu phụ ra đĩa có lót giấy thấm bớt dầu ăn. Giá đỗ, nấm cắt bỏ chân, cà rốt cạo vỏ rửa sạch, để ráo. Rau mùi rửa sạch, để ráo. Nấm, cà rốt thái sợi. Đậu phụ sau khi rán, để nguội, thái sợi. Đun nóng ít dầu ăn, phi đầu hành barô thơm, cho cà rốt vào xào, rưới vào một ít xì dầu, tiếp tục xào đến đến khi cà rốt chín mềm. Cho tiếp nấm, đậu phụ vào, đảo nhẹ tay để đậu phụ không bị nát, xào tiếp khoảng 