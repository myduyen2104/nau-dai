uantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Mực tươi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Gan heo (lợn)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Hủ tiếu ngâm nước cho mềm, vớt ra để ráo. Thịt heo nạc, mực, gan heo rửa sạch cắt miếng mỏng, ướp gia vị. Cà rốt gọt vỏ rửa sạch, bào sợi. Bắt chảo lên bếp, thêm dầu ăn vào, dầu nóng thì thêm thịt heo, mực, gan heo vào xào chín. Thêm cà rốt vào đảo đều cho chín. Nêm gia vị vừa ăn. Thêm hủ tiếu vào đảo đều rồi tắt bếp.","nutrition":{"kcal":345.6,"protein_g":12.5,"fat_g":16.2,"carbs_g":38.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i0312t8m1j970q3ty","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bột dong lọc","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:heo nac","unlisted_ingredient_phrase:thit heo nac"],"source_categories":[{"label":"Món khô 5 tuổi","id":"mon_kho_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo034at8m1y5bdqk7h#variant-1","name":"Khoai tây xào thịt bò","detail_name":"Khoai tây xào thịt bò","category":"Món xào","age_group":null,"serving":{"raw":"75.5 g / Dĩa vừa","quantity_value":75.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch rồi thái miếng mỏng, ướp trong khoảng 15-20 phút. Khoai tây nạo vỏ, rửa sạch rồi thái miếng. Luộc sơ qua để khi xào đỡ bị nát. Cho dầu ăn vào chảo, làm nóng dầu cho thịt bò vào xào. Tăng nhiệt độ, xào đến khi thịt bò chín tới, chuyển sang màu hồng nhạt, hơi tái là được. Tắt bếp, cho thịt bò ra bát riêng. Tiếp tục cho dầu ăn vào chảo, nóng dầu cho khoai tây vào xào. Lúc này nên hạ nhiệt độ xuống để khoai tây không bị cháy, dính vào đáy nồi. Xào khoai tây đến khi chín tới thì cho thịt bò trở lại để xào cùng đồng thời nêm nếm gia vị cho vừa ăn. Tắt bếp, trút món ăn ra đĩa, thưởng thức khi còn nóng.","nutrition":{"kcal":114.5,"protein_g":5.2,"fat_g":5.8,"carbs_g":11},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oo034at8m1y5bdqk7h","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món xào","id":"mon_xao","kind":"food_category","baseLabel":"Món xào"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo037rt8m15fz33edw#variant-1","name":"LH-C2-Dưa leo","detail_name":"LH-C2-Dưa leo","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"100 g","quantity_value":100,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Dưa chuột/ Dưa leo","quantity_raw":"90 g","quantity_value":90,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":19.2,"protein_g":0.9,"fat_g":0.1,"carbs_g":3.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oo037rt8m15fz33edw","q