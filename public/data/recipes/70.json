n kèm với rau và bánh đa nướng.","nutrition":{"kcal":363.2,"protein_g":18.9,"fat_g":10.6,"carbs_g":49.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03eat8m1hjf6fb49","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Tôm biển","ingredient_not_mentioned_by_name:Hoa chuối","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","title_ingredient_not_mentioned:Tôm biển","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:thit ga","unlisted_ingredient_phrase:voi nuoc","unlisted_ingredient_phrase:xuong heo"],"source_categories":[{"label":"Món nước 6-7 tuổi","id":"mon_nuoc_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03n5t8m1wcndat3y#variant-1","name":"Mực xào chua ngọt","detail_name":"Mực xào chua ngọt","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"86 g / Dĩa nhỏ","quantity_value":86,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Mực tươi","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ớt vàng to","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":