[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tw00d2t8m1tsl4miia#variant-1","name":"Bánh canh cua","detail_name":"Bánh canh cua","category":"Món nước 18-35 tháng","age_group":"18-35 tháng","serving":{"raw":"148 g / Chén","quantity_value":148,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bánh canh tươi","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cua bế","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"}],"instructions_raw":"Cua biển mua về rửa sạch, hấp chín, gỡ lấy phần thịt và gạch để riêng. Cho hành băm nhuyễn vào chảo phi thơm với dầu ăn, rồi xào thịt cua cùng ít mắm, tiêu cho thơm. Gạch cua bạn cũng phi hành khô, xào qua, để riêng. Sơ chế các nguyên liệu khác Cà rốt, củ cái trắng gọt vỏ rửa sạch, cắt lát mỏng. Nấm rơm gọt bỏ đuôi, ngâm muối, rửa sạch, cái nào to cắt đôi Thịt chân giò luộc chín, thái khoanh. Rửa sạch tôm, cắt bỏ râu Nấu nước dùng Xương lợn chần qua nước sôi, rửa sạch rồi cho vào nồi nước lạnh ninh lấy nước dùng. Phi hành thơm vào nồi và đổ nước hầm xương vào. Cho cà rốt, củ cải vào cho ngọt nước và mềm. Bỏ tôm vào nước lèo cho ngọt. Khi tôm chín vớt ra bóc vỏ. Cho nấm rơm vào nêm nếm vừa ăn, nên nấu nhạt cho bé. Hòa một ít bột năng đổ từ từ vào nồi nước dùng, vừa đổ vừa khuấy đều để tạo độ sánh. Xếp bánh canh ra bát, cho thịt chân giò, thịt cua, gạch cua, tôm . Chan nước dùngvào.","nutrition":{"kcal":222.5,"protein_g":7.7,"fat_g":11.1,"carbs_g":23.7},"source_url":"https://dinhduong2598.