 lửa nhỏ chừng 2 giờ.","nutrition":{"kcal":158,"protein_g":11.4,"fat_g":9.4,"carbs_g":7.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00q5t8m124inf1ko","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:thit va","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00r8t8m158crtvq1#variant-1","name":"Bò sốt chua ngọt","detail_name":"Bò sốt chua ngọt","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"66 g / Dĩa nhỏ","quantity_value":66,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Dứa ta (thơm)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch thái mỏng ướp gia vị trong 15 phút. Dứa gọt vỏ bỏ mắt rửa sạch thái từng miếng vừa ăn. Ớt đỏ to, ớt xanh to, ớt vàng to, rửa sạch thái miếng vừa ăn. Bắt chảo dầu nóng phi thơm tỏi cho thịt bò vào xào vừa chín tới xúc thịt bỏ ra dĩa. Dùng chiến chảo đó cho thêm dầu ăn xào dứa, ớt đỏ, ớt xanh ớt vàng cho chín đều nêm nếm gia vị vừa ăn cho thêm chút dấm vào. Kế tiếp cho thịt bò đã xào vào đảo nhanh tay. Bột bắp quậy cho nước sôi để nguội cho vào sau cùng rồi tắt bếp. Xúc ra dĩa cho thêm rau mùi và chút tiêu lên trên mặt là có thể thưởng thức.","nutrition":{"kcal":94.8,"protein_g":8.8,"fat_g":4.6,"carbs_g":4.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00r8t8m158crtvq1","quality_status":"needs_review","warnings":["duplicate_listing_row_occurrence","identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giấm","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:ot o to","unlisted_ingredient_phrase:ot vang","unlisted_ingredient_phrase:ot vang to","unlisted_ingredient_phrase:ot xanh","unlisted_ingredient_phrase:ot xanh to","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:vang to","unlisted_ingredient_phrase:xanh to","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00v7t8m18a9bc659#variant-1","name":"Bột thịt cua, cà rốt","detail_name":"Bột thịt cua, cà rốt","category":"Món bột nhà nấu cho trẻ từ 7-8 tháng","age_group":"7-8 tháng","serving":{"raw":"66 g / Chén","quantity_value":66,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cua bế","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"6 g","quantity_value":6,"quantity_unit":"g"}],"instructions_raw":"Cua rửa sạch, luộc chín, gỡ thịt, tán nhuyễn. Cà rốt gọt vỏ, rửa sạch, luộc chín, tán nhuyễn. Hòa tan bột gạo với nước, bắc lên bếp khuấy đều đến khi sôi, thêm cà rốt vào nấu chín, thêm thịt cua vào khuấy đều. Tắt bếp. Thêm dầu thực vật vào khuấy đều.","nutrition":{"kcal":156,"protein_g":5.1,"fat_g":6.2,"carbs_g":19.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00v7t8m18a9bc659","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:dau thuc","unlisted_ingredient_phrase:dau thuc vat","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:thuc vat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ từ 7-8 tháng","id":"mon_bot_nha_nau_cho_tre_tu_7_8_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"7-8 tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw0160t8m1gnisxghq#variant-1","name":"Cá điêu hồng kho cải chua","detail_name":"Cá điêu hồng kho cải chua","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"82 g / Dĩa nhỏ","quantity_value":82,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá điêu hồng","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Dưa cải bẹ","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Thì là","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước dừa non tươi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Cá mua về rửa sạch để ráo. Dưa cải bẹ rửa sạch cắt vừa ăn. Cà chua rửa sạch cắt múi cau. Thìa là rửa sạch, bỏ gốc, cắt khúc vừa ăn. Hành củ, tỏi lột vỏ băm nhuyễn. Hành lá rửa sạch bỏ rễ, cắt khúc vừa ăn. Đặt chảo lên chiên cá vàng đều 2 mặt. Gạn bớt dầu cho hành tỏi băm nhuyễn vào phi thơm. Cho cà chua vào xào tái, cho tiếp dưa cải bẹ vào xào. Sau đó cho cá vào rồi cho tiếp nước dừa vào nêm nếm cho vừa ăn trên bếp lửa nhỏ. Đến khi cạn bớt nước tắt bếp.","nutrition":{"kcal":75.8,"protein_g":7.3,"fat_g":3.4,"carbs_g":4.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw0160t8m1gnisxghq","quality_status":"needs_review","warnings":["recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá điêu hồng","ingredient_not_mentioned_by_name:Thì là","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","title_ingredient_not_mentioned:Cá điêu hồng"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt020vt8m10xb068vi#variant-1","name":"Cháo thập cẩm","detail_name":"Cháo thập cẩm","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"114.5 g / Tô nhỏ","quantity_value":114.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"45 g","quantity_value":45,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hạt sen khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cà rốt, khoai tây các bạn gọt vỏ rữa sạch sau đó cắt thành hạt lựu. Nấm rơm cắt bỏ gốc, ngâm muối, rửa sạch, để ráo. Hạt sen khô ngâm nước ấm cho hạt mềm. Thịt heo nạc, rửa với muối sau đó rửa sạch lại với nước, để ráo, băm thịt nhỏ, ướp gia vị vừa ăn. Gạo các bạn vo sạch sau đó đổ nước và cho hạt sen, thịt heo băm vào cùng bắt lên bếp. Khi thấy gạo nở bung đều, hạt sen mềm rồi thì tiếp tục phi gốc hành thơm sau đó cho cà rốt, khoai tây, nấm rơm đảo cho thơm rồi đổ vào nồi cháo Nấu sôi đến khi các loại rau củ vừa chín tới, nêm nếm lại, tắt bếp và cho hành ngò và tiêu vào. Cuối cùng các bạn tắt bếp nêm gia vị vừa ăn, cho vào tí tiêu cùng hành poa-rô lá và ngò cho thơm nhé!","nutrition":{"kcal":339.2,"protein_g":11.4,"fat_g":14.5,"carbs_g":41.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt020vt8m10xb068vi","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:heo nac","unlisted_ingredient_phrase:thit heo nac","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02x8t8m1y6st4w88#variant-1","name":"Gỏi sứa","detail_name":"Gỏi sứa","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"136.2 g / Dĩa vừa","quantity_value":136.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Xoài sống","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Sứa khô, có muối","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Sứa rửa sạch, để ráo. Thịt heo nạc luộc chín, cắt lát mỏng. Xoài xanh rửa sạch gọt vỏ, sau đó ngâm ngay vào nước đá lạnh. Dùng dao cắt tỉa hoặc nạo nhỏ để sắt xoài thành từng sợi như thái chỉ. Cà rốt gọt vỏ, rửa sạch, thái sợi. Các loại rau thơm nhặt sạch và sắt nhỏ 3-4cm. Tỏi bóc vỏ sắt thật nhuyễn, ớt bỏ hạt cũng bằm nhuyễn để một bên. Tiếp tục lấy nước mắm và đường, chanh theo tỉ lệ thích hợp (vì còn phụ thuộc vào nguyên liệu nhiều hay ít) hòa cùng ít nước nguội, khuấy cho tan đều rồi nếm thử. Vừa khẩu vị mới cho tỏi ớt vào. Lấy một củ hành bóc vỏ đập dập cho vào chảo dầu nóng. Hành phi thơm. Bắc lên bếp một chiếc chảo khác, đun nóng cho đậu phộng vào đảo đều tay. Đậu chín vớt ra ngoài cho nguội rồi sát vỏ, bỏ vào cối giã nhỏ. Sử dụng một chiếc thố hoặc thau to để trộn, cho sứa, thịt heo, xoài, cà rốt vào thau, thêm nước mắm vào đảo đều cho các nguyên liệu thấm gia vị. Nguyên liệu của món này không lo bị mềm nên lúc này có thể bóp mạnh tay cho gia vị thấm đều. Sau đó, cho rau thơm vào trộn đều. Dùng chiếc đĩa có lòng lớn để bày gỏi ra, không quên trang trí thêm hoa ớt kèm đậu phộng rang.","nutrition":{"kcal":171.1,"protein_g":6,"fat_g":9.3,"carbs_g":17},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02x8t8m1y6st4w88","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Sứa khô, có muối","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:heo nac","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:rau thom","unlisted_ingredient_phrase:thit heo nac","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo037ht8m127a4qatq#variant-1","name":"LH-C2-Canh mây","detail_name":"LH-C2-Canh mây","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"80 g","quantity_value":80,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Cà chua","quantity_raw":"62.5 g","quantity_value":62.5,"quantity_unit":"g"},{"name":"Cần tây","quantity_raw":"4 g","quantity_value":4,"quantity_unit":"g"},{"name":"Trứng gà công nghiệp (