 g","quantity_value":100.5,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Bí đao (bí xanh)","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Sườn heo (lợn)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":43.1,"protein_g":3.3,"fat_g":1.9,"carbs_g":3.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qy01h7t8m1zpcgrxyl","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món canh","id":"mon_canh","kind":"food_category","baseLabel":"Món canh"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01rit8m1ddt75514#variant-1","name":"Canh mít non nấu tôm","detail_name":"Canh mít non nấu tôm","category":"Món canh 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"114.2 g / Chén","quantity_value":114.2,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Mít non","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Mít gọt vỏ, bỏ cùi, ngâm trong nước chanh pha loãng trong vòng 15 phút cho bớt mủ và không bị thâm đen. Sau đó rửa lại với nước sạch rồi thái miếng vừa ăn. Nếu là mua mít bào sẵn chỉ cần rửa sạch. Tôm bóc vỏ, bỏ đầu, rút chỉ đen, chà sơ qua với muối rồi rửa sạch, để ráo. Hoặc có thể để nguyên vỏ, chỉ bỏ đầu, rửa sạch, giã thô. Cho dầu ăn vào nồi đun nóng, phi thơm hành củ đã đập dập. Cho tôm vào xào săn. Bắt nồi lên cho nước vào nấu sôi, nước sôi thì cho mít vào nấu chín. Tắt bếp cho hành lá vào.","nutrition":{"kcal":49.1,"protein_g":4.2,"fat_g":1.5,"carbs_g":10.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01rit8m1ddt75514","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hanh cu","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh 8-18 tuổi","id":"mon_canh_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu0267t8m1yndr3gbk#variant-1","name":"Cháo nấm","detail_name":"Cháo nấm","category":"Món nước- chay","age_group":null,"serving":{"raw":"188.5 g / Tô nhỏ","quantity_value":188.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Gạo nếp cái","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm thường tươi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Kim chi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"}],"instructions_raw":"Nấm nhặt rửa sạch, bổ đôi nếu cây nấm to. Hành khô cắt gốc, lột vỏ, xắt lát mỏng. Cà rốt rửa sạch, gọt vỏ và cắt hạt lựu. Kim chi rửa sạch, cắt nhỏ. Gạo nếp, gạo tẻ, đậu xanh vo kỹ. Cho gạo và đậu xanh vào nồi, thêm nước ngập mặt gạo và đậu khoảng 2 đốt ngón tay rồi ninh bật lửa nhỏ, ninh kỹ. Trong khi ninh cháo, phi thơm hành khô, cho nấm và cà rốt, kim chi vào xào, nêm gia vị hơi đậm một chút. Nếu trong quá trình nấu mà cháo cạn nước thì dùng nước sôi thêm vào đến khi cháo đạt độ đặc mong muốn.Khi cháo nhừ cho đồ đã xào vào đảo đều, nêm nếm lại gia vị cho vừa ăn rồi tắt bếp. Múc ra chén, dùng nóng.","nutrition":{"kcal":382,"protein_g":12.2,"fat_g":9.4,"carbs_g":63.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu0267t8m1yndr3gbk","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Nấm thường tươi","ingredient_not_mentioned_by_name:Nấm rơm","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món nước- chay","id":"mon_nuoc_chay","kind":"food_category","baseLabel":"Món nước- chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02ypt8m1dkbrvaor#variant-1","name":"Hạt điều (8 hạt/phần)","detail_name":"Hạt điều (8 hạt/phần)","category":"Món ăn vặt từ 2-5 tuổi","age_group":"2-5 tuổi","serving":{"raw":"16 g / Phần","quantity_value":16,"quantity_unit":"g","portion_label":"Phần"},"ingredients":null,"instructions_raw":null,"nutrition":{"kcal":97.3,"protein_g":2.9,"fat_g":7.4,"carbs_g":4.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02ypt8m1dkbrvaor","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","instructions_missing_from_detail","listing_count_not_visible_in_detail"],"integrity_findings":[],"source_categories":[{"label":"Món ăn vặt từ 2-5 tuổi","id":"mon_an_vat_tu_2_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món ăn vặt"}],"source_age_group":{"label":"2-5 tuổi","id":"2_5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"htt