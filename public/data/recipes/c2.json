,"quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cà tím rửa sạch, cắt khúc, khoét rỗng ruột. Thịt heo rửa sạch băm nhỏ. Mộc nhỉ ngâm nở băm nhỏ. Tỏi ta lột vỏ rửa sạch băm nhỏ. Hành lá rửa sạch bỏ rể cắt nhỏ. Trộn đều hỗn hợp gồm thịt heo, mộc nhỉ , tỏi, cùng với gia vị. Sau đó nhồi thịt vào ruột cà tím. Đặt 1 chiếc nồi lên nấu sôi nước cho cà tím đã nhồi vào hấp trong 20 phút thì cà tím chín. Sau cùng tắt bếp và có thể dùng được.","nutrition":{"kcal":309.4,"protein_g":13.8,"fat_g":23.2,"carbs_g":11.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh057rt8m1azu34fqr","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hon hop"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05mdt8m1daekmsl2#variant-1","name":"Xíu mại nhồi trứng cút","detail_name":"Xíu mại nhồi trứng cút","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"55 g / Dĩa nhỏ","quantity_value":55,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Trứng cút (10g/quả)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quanti