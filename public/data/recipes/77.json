nh.","nutrition":{"kcal":83.2,"protein_g":2.8,"fat_g":6.6,"carbs_g":3.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02dkt8m1sg321pzj","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gừng tươi","ingredient_not_mentioned_by_name:Hành củ tươi","ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02prt8m1lfgx2xsd#variant-1","name":"Ếch chiên bơ","detail_name":"Ếch chiên bơ","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"38 g / Dĩa nhỏ","quantity_value":38,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Ếch ( thịt đùi)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Bơ mặn","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Ếch rửa sạch, để ráo ướp với gia vị trong 30 phút. Đặt chảo dầu nóng thả ếch vào chiên vàng đều 2 mặt. Khi ếch chín vàng quết lên bề mặt 1 lớp bơ rồi vớt ra dĩa, xếp ra dĩa và thưởng thức.","nutrition":{"kcal":72.2,"protein_g":6,"fat_g":4.4,"carbs_g":2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02prt8m1lfgx2xsd","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Bơ mặn","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 thá