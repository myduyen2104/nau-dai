t":"g"}],"instructions_raw":"Thịt bò rửa sạch thái mỏng vừa ăn, ướp gia vị trong 20 phút. Lá lốt rửa sạch cắt đôi. Sả cây rửa sạch bằm nhuyễn. Rau mùi rửa sạch cắt bỏ gốc thái nhỏ. Đặt chảo lên bếp phi thơm tỏi cùng dầu ăn, sau đó cho thịt bò vào xào tái xúc ra dĩa. Dùng tiếp chảo này cho thêm dầu ăn vào xào cùng sã bằm nhuyễn và lá lốt, cho tiếp thịt bò vào xào đều, nêm nếm gia vị vừa ăn. Tắt bếp múc ra dĩa cho thêm tiêu và rau mùi lên mặt là có thể dùng được.","nutrition":{"kcal":203.3,"protein_g":23.1,"fat_g":8.9,"carbs_g":8.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00s2t8m1156chgj7","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Hành tây","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv0124t8m1eqjbepfr#variant-1","name":"Bún thịt bò xào","detail_name":"Bún thịt bò xào","category":"Món khô 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"332 g / Tô nhỏ","quantity_value":332,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity