[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tx00klt8m1j0tfkv8a#variant-1","name":"Bánh ướt","detail_name":"Bánh ướt","category":"Món khô 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"139 g / Dĩa nhỏ","quantity_value":139,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Bánh tôm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nem chua","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau húng","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Bột bánh ướt thêm một chút xíu muối, thêm nước vào khuấy đều cho đến khi bột tan hoàn toàn. Bắc chảo lên bếp mở lửa vừa, thêm dầu ăn vào chảo, phi thơm hành tím, khi hành thơm vàng bạn vớt ra chén 1 nửa để ăn kèm. Bắc chảo lên bếp mở lửa vừa, quét dầu ăn lên mặt chảo, đổ một vá bột vào chảo, lắc nhẹ để bột dàn mỏng đều, đậy nắp lại. Sau 20 - 25 giây khi bánh đã chín, bạn đổ bánh ra mâm sạch (đã phết dầu) rồi cuốn bánh lại, nhanh tay đổ bột vào chảo để làm mẻ bánh thứ 2. Dưa leo rửa sạch, cắt thành những thanh nhỏ, ngắn khoảng 1 lóng tay. Rau thơm rửa sạch, cắt nhỏ, chả lụa cắt miếng nhỏ khoảng 1 lóng tay, giá trụng với nước sôi khoảng 2 phút cho chín. Xếp bánh ướt rau thơm, dưa leo, chả lụa, bánh tôm, nem chua, hành phi ra đĩa và chấm với nước mắm pha, ăn ngay khi còn nóng bạn nhé.","nutrition":{"kcal":280.2,"protein_g":9.8,"fat_g":8.8,"carbs_g":40.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tx00klt8m1j0tfkv8a","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh uot","unlisted_ingredient_phrase:bot banh","unlisted_ingredient_phrase:cha lua","unlisted_ingredient_phrase:mam pha","unlisted_ingredient_phrase:nuoc mam pha","unlisted_ingredient_phrase:rau thom","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô 3-4 tuổi","id":"mon_kho_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00tbt8m1c5vzw5om#variant-1","name":"Bột cá rô cải bó xôi","detail_name":"Bột cá rô cải bó xôi","category":"Món bột nhà nấu cho trẻ 9-24 tháng","age_group":"9-24 tháng","serving":{"raw":"86 g / Chén","quantity_value":86,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ giã","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Cá rô đồng","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Cải bó xôi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"6 g","quantity_value":6,"quantity_unit":"g"}],"instructions_raw":"Cá rô rửa sạch, băm nhuyễn Cải xanh chọn lá non, rửa sạch, lấy lá băm nhuyễn Hòa tan bột gạo và cá rô với nước, bắc lên bếp khuấy đều cho đến khi sôi, thêm cải xanh vào nấu chín. Thêm dầu ăn vào khuấy đều","nutrition":{"kcal":180.4,"protein_g":7.7,"fat_g":7.9,"carbs_g":19.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00tbt8m1c5vzw5om","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["in