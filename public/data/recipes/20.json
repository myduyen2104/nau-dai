n vào từng bát dành cho các thành viên trong gia đình.","nutrition":{"kcal":287.3,"protein_g":9.8,"fat_g":11,"carbs_g":37.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03k4t8m16jxoj8jk","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước 3-4 tuổi","id":"mon_nuoc_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]