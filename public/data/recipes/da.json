dient_phrase:rau mui","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05nht8m1rhbifab1#variant-1","name":"Xôi khoai mì","detail_name":"Xôi khoai mì","category":"Xôi","age_group":null,"serving":{"raw":"127.2 g / Dĩa vừa","quantity_value":127.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Gạo nếp cái","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Khoai mì (củ sắn)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Vừng (đen, trắng)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Vo và ngâm nếp Cho nếp vào thau nhỏ vo với nước sạch, vo nhẹ để tránh mất hết các vitamin ở trong nếp. Vo trong khoảng 4 - 5 lần cho đến khi thấy nước trong hơn. Sau đó, cho nước nóng vào ngâm với nếp trong khoảng 15 phút cho nếp mềm hơn. Sơ chế nguyên liệu Khoai mì chúng ta gọt sạch vỏ, rửa với nước sạch, tiếp theo cắt thành các miếng nhỏ có kích thước khoảng 1 lóng tay. Ngâm với nước để loại bỏ phần mủ của khoai. Hành tím ta bóc vỏ, rửa sạch, băm nhỏ rồi đem phi thơm. Hành lá rửa sạch, xắt nhỏ. Nấu xôi Cho nếp vào nồi, đường, muối vào nếp, cho nước nóng vào nồi chứa nếp, cho nước ngập hơn nếp khoảng 1/4 lóng tay (dùng nước nóng để sôi nhanh chín hơn). Cho toàn bộ khoai mì đã cắt nhỏ vào chung với nồi nếp, tiếp theo cho dầu ăn hành tím phi lúc nãy vào cho sôi có độ bóng và mềm, lắc đều để nước và dầu phủ đều hỗn hợp, sau đó cho vào nồi áp suất để nấu. Làm mỡ hành Cho chảo lên bếp, cho dầu ăn vào, thêm 1 ít muối và đợi dầu nóng. Sau đó, cho hành lá cắt nhỏ vào rồi đảo đều, khi hành hơi teo lại, thấm dầu bóng, đẹp là được. Giã muối mè Cho mè trắng, mè đen, 1 ít đậu phộng rang bóc vỏ, 1ít muối, đường vào túi ni - lông trong. Sau đó giã dập hỗn hợp này và trộn đều. Hoàn thành Khi nồi áp suất đã hoàn thành thời gian nấu, ta tắt nồi và mở nắp, cho xôi ra ngoài, phết mỡ hành, cho hành phi, rải đều muối mè trên bề mặt của xôi và thưởng thức.","nutrition":{"kcal":371.2,"protein_g":10,"fat_g":9.8,"carbs_g":60.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05nht8m1rhbifab1","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Xôi","id":"xoi","kind":"food_category","baseLabel":"Xôi"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05nst8m12bcz5rml#variant-1","name":"Xôi sầu riêng","detail_name":"Xôi sầu riêng","category":"Xôi (18 tháng trở lên)","age_group":"18 tháng","serving":{"raw":"140.2 g / Dĩa vừa","quantity_value":140.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Gạo nếp cái","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Sầu riêng","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Ngâm gạo Gạo nếp vo sạch, sau đó ngâm qua đêm với nước lạnh hoặc ngâm với nước ấm trong vòng 3 - 4 giờ cho gạo nở mềm. Sau khi ngâm gạo nếp, bạn cho gạo ra rổ, để cho ráo nước.Tiếp theo, cho gạo nếp vào tô, thêm ít muối cùng với nước cốt dừa vào và trộn đều. Nấu xôi Cho gạo nếp vào xửng và hấp. Trong khi hấp xôi, bạn cho sầu riêng và đường vào tô, dùng thìa dằm nhuyễn ra. Sau khi hấp khoảng 20 phút, bạn kiểm tra xem xôi đã mềm chưa hay chưa. Khi xôi mềm, bạn cho sầu riêng vào, dùng đũa trộn đều rồi hấp thêm khoảng 5 phút nữa là được.","nutrition":{"kcal":436.5,"protein_g":8.6,"fat_g":8.9,"carbs_g":80.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05nst8m12bcz5rml","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Xôi (18 tháng trở lên)","id":"xoi_18_thang_tro_len","kind":"age_scoped_food_category","baseLabel":"Xôi"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"}]