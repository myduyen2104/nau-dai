au đó cho khoai tây, nấm rơm đảo cho thơm rồi đổ vào nồi cháo Nấu sôi đến khi các loại rau củ vừa chín tới, nêm nếm lại, tắt bếp và cho hành ngò và tiêu vào. Cuối cùng các bạn tắt bếp nêm gia vị vừa ăn, cho vào tí tiêu cùng hành poa-rô lá và ngò cho thơm nhé!","nutrition":{"kcal":291.1,"protein_g":10.9,"fat_g":7.3,"carbs_g":45.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu027lt8m1bcs5bcwd","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02jrt8m1tmadtfu8#variant-1","name":"Đậu cove, cà rốt, luộc, bơ","detail_name":"Đậu cove, cà rốt, luộc, bơ","category":"Món luộc","age_group":null,"serving":{"raw":"144.59 g / Chén","quantity_value":144.59,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cà rốt","quantity_raw":"74.77 g","quantity_value":74.77,"quantity_unit":"g"},{"name":"Đậu cô ve","quantity_raw":"59.82 g","quantity_value":59.82,"quantity_unit":"g"},{"name":"Quả bơ vỏ xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":"Canh bầu gọt vỏ, rửa sạch. Cắt miếng vừa ăn Thịt rửa sạch băm nhuyễn. Ướp gia vị Bắt nồi lên cho dầu vào phi hành cho thơm. Cho thịt vào xào săn, đổ nước vào, nước sôi cho bầu vào, đợi nước sôi lần nữa nêm nếm gia vị vừa ăn. Tắt bếp. Cho hành lá cắt nhỏ vào cho thơm.","nutrition":{"kcal":245.8,"protein_g":14.4,"fat_g":2.1,"carbs_g":42.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02jrt8m1tmadtfu8","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_menti