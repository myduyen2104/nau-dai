:"g"},{"name":"Hạt nêm Knorr","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Tôm bóc vỏ, bỏ đầu, ướp hạt nêm, tiêu, đường. Cải thìa rửa sạch từng bẹ, bẹ lớn chẻ đôi, bẹ nhỏ để nguyên. Trụng nhanh trong nước có pha chút muối. ... Đặt chảo lên bếp, cho dầu vào phi thơm hành, tỏi. Cho tôm vào xào chín, nêm dầu hào, dầu mè, xì dầu. Cho cải thìa vào đảo đều, gắp ra đĩa, dọn dùng.","nutrition":{"kcal":30.5,"protein_g":0.6,"fat_g":2.1,"carbs_g":2.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01e4t8m1bn3rhzlo","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:dau hao","unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món xào từ 18 tháng đến 5 tuổi","id":"mon_xao_tu_18_thang_den_5_tuoi","kind":"food_category","baseLabel":"Món xào từ 18 tháng đến 5 tuổi"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01lxt8m11nvi2nb5#variant-1","name":"Canh chua","detail_name":"Canh chua","category":"Món canh chay","age_group":null,"serving":{"raw":"139.5 g / Chén","quantity_value":139.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đậu phụ (đậu hũ)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Bạc hà (dọc mùng)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đậu bắp","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Đổ me ra bát, thêm nước sôi vào, chần me cho tan, sau đó lọc bỏ bã và giữ lại phần nước cốt me. Thơm gọt bỏ mắt, cắt xéo. Cà chua rửa sạch, cắt múi cau. Tước bỏ vỏ dọc mùng. Rửa sạch đậu bắp và dọc mùng, cắt lát xéo. Đậu phụ non rửa sạch, cắt khoanh tròn. Đun nóng một muỗng dầu ăn để phi đầu hành ba rô. Cho cà chua vào xào chín trong 3 phút, sau đó thêm thơm và nêm nếm vừa ăn. Đổ 2 - 3 bát nước vào nồi đang nấu, đun sôi, thêm nước cốt me và đun tiếp 10 phút nữa. Cho thêm đậu bắp và đun 5 phút. Cuối cùng, cho đậu phụ non và dọc mùng vào, đun lửa nhỏ, nêm nếm lại cho thật vừa miệng rồi thêm rau mùi và tắt bếp.","nutrition":{"kcal":57.8,"protein_g":5.2,"fat_g":1.2,"carbs_g":6.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01lxt8m11nvi2nb5","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nuoc cot"],"source_categories":[{"label":"Món canh chay","id":"mon_canh_chay","kind":"food_category","baseLabel":"Món canh chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01t4t8m12bme56mr#variant-1","name":"Canh nấm rơm rau dền thịt bằm","detail_name":"Canh nấm rơm rau dền thịt bằm","category":"Món canh 5 tuổi","age_group":"5 tuổi","serving":{"raw":"92.5 g / Chén","quantity_value":92.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau giền cơm","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt nạc rửa sạch cắt mỏng, băm nhuyễn, ướp gia vị vừa đủ. Rau dền nhặt lấy phần ăn được, rửa sạch. Nấm rơm rửa sạch, cắt đôi. Bắt nồi lên bếp, phi thơm hành, cho thịt vào đảo đều, sau đó cho nước vào nấu sôi, nước sôi cho nấm rơm, mướp vào nấu chín. Nêm gia vị vừa ăn.","nutrition":{"kcal":77.1,"protein_g":4.8,"fat_g":5.3,"carbs_g":2.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01t4t8m12bme56mr","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01v4t8m1baqhlk1k#variant-1","name":"Canh rau má nấu thịt bằm","detail_name":"Canh rau má nấu thịt bằm","category":"Món canh 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"71.8 g / Chén","quantity_value":71.8,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau má, má mơ","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc vai","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Rau má rửa sạch, cắt vừa ăn.Thịt heo nạc rửa sạch, băm nhuyễn, ướp gia vị. Bắt nồi lên bếp thêm chút dầu ăn phi thơm hành, cho thịt vào đảo đều rồi thêm nước vào nấu sôi khoảng 5 phút, thêm rau má vào nấu sôi trở lại thì nêm nếm, tắt bếp.","nutrition":{"kcal":71.5,"protein_g":4,"fat_g":4.5,"carbs_g":3.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01v4t8m1baqhlk1k","quality_status":"needs_review","w