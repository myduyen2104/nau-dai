ăn. Củ cải trắng, cà rốt gọt vỏ, cắt sợi mỏng, ngâm muối, sau đó rửa sạch, ngâm với hỗn hợp dấm, đường trong 1 giờ. Nấu tan hỗn hợp nước lọc, nước mắm, đường, dấm, cho thêm tỏi, ớt băm nhuyễn Hành lá: nhặt, rửa sạch, cắt nhỏ, làm nóng chảo, cho mở lợn vào nấu sôi, tắt bếp, cho phần mở lợn đang sôi vào hành lá đã cắt nhỏ. Cho cơm ra dĩa, để bì, đồ chua lên. Chan mỡ hành và ăn với nước mắm.","nutrition":{"kcal":742.2,"protein_g":26.5,"fat_g":32.8,"carbs_g":85.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02hit8m13r3ys46s","quality_status":"needs_review","warnings":["duplicate_identical_catalog_metadata","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Cơm","id":"com","kind":"food_category","baseLabel":"Cơm"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02ztt8m1wal0awjh#variant-1","name":"Hoành thánh buộc nhân tôm chiên giòn","detail_name":"Hoành thánh buộc nhân tôm chiên giòn","category":"Món khô từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"282.1 g / Dĩa vừa","quantity_value":282.1,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Lá hoành thánh (thành phần nguyên liệu có trứng)","quantity_raw":"110 g","quantity_value":110,"quantity_unit":"g"},{"name":"Tôm biển","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"