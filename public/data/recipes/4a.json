raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Chặt thịt gà thành miếng vừa ăn. Băm nhuyễn hành củ, sả thái nhỏ. Ướp thịt gà với sả, gia vị, để khoảng 15phút. Đun nóng dầu, phi thơm hành băm, cho gà vào chảo. Xào gà trên lửa lớn cho thấm gia vị. Thêm nước vào kho cho đến khi miếng gà mềm và thấm, nêm nếm vừa ăn, tắt bếp.","nutrition":{"kcal":66.8,"protein_g":5.8,"fat_g":4.2,"carbs_g":1.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05hut8m1hjrg8q8q","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Sả cây","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05lkt8m18z9n13hk#variant-1","name":"Vịt trộn chua ngọt","detail_name":"Vịt trộn chua ngọt","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"113.3 g / Dĩa vừa","quantity_value":113.3,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"Thịt vịt sau khi mua về bạn dùng muối xát đều lên da để khử mùi hôi hiệu quả. Sau đó, rửa lại với 3 lần nước sạch. Chuẩn bị một âu nước lạnh nhỏ. Bóc vỏ hành tây, rửa sạch rồi thái thành sợi mỏng và cho hết vào âu nước lạnh ngâm trong khoảng 15 – 20 phút cho bớt mùi hăng. Rau răm nhặt những lá non rồi mang rửa sạch và vớt ra rổ để ráo nước. Tỏi bóc lớp vỏ khô bên ngoài rồi dùng dao băm nhuyễn Đậu phụng mang đi rang chín đều. Sau đó, xa vỏ và cho vào cối giã nhỏ vừa phải, đừng mịn quá. Cà rốt gọt vỏ, rửa sạch, cắt sợi nhuyễn. Bạn pha nước chấm: nước cốt chanh, nước mắm, đường, nước trắng, ớt, tỏi băm nhuyễn. Nhớ trộn đều cho các nguyên liệu quyện đều vào nhau nhé. Vịt sau khi sơ chế xong, bạn mang luộc chín. Sau đó, vớt ra để ráo nước, đợi nguội rồi xé sợi. Chuẩn bị một âu sạch. Tiến hành cho lần lượt các nguyên liệu vào chung, gồm: thịt vịt xé sợi, hành tây, cà rốt, rau răm đã được sơ chế. Rưới nước chấm vào âu nguyên liệu ở bước 2 rồi trộn đều và để yên khoảng 15 phút cho nước chấm thấm đều vào nguyên liệu. Cuối cùng, bạn rắc đậu phụng đập nhỏ và một ít tiêu xay lên trên rồi dọn ra dĩa, trang trí tùy thích và mời mọi người thưởng thức.","nutrition":{"kcal":162.1,"protein_g":8.3,"fat_g":8.9,"carbs_g":12.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05lkt8m18z9n13hk","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phộng (lạc hạt)","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc cot","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05m3t8m15b7sjzeb#variant-1","name":"Xíu mại kho cà","detail_name":"Xíu mại kho cà","category":"Món mặn","age_group":null,"serving":{"raw":"104 g / Dĩa nhỏ","quantity_value":104,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Củ đậu","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt heo rửa sạch, xay nhuyễn .Cà chua rửa sạch, bỏ hạt, cắt hạt lựu nhỏ . Mộc nhĩ ngâm mềm, rửa sạch, cắt nhỏ. Tỏi bó vỏ, băm nhuyễn . Cho thịt xay, tỏi, mộc nhĩ, gia vị vào tô, trộn đều. Lấy 1 cái đĩa lớn, thoa một lớp dầu ăn lên bề mặt đĩa để khi hấp thịt không bị dính. Sau đó lấy hỗn hợp thịt ở trên viên thành những viên tròn vừa ăn, xếp thịt viên lên đĩa, thực hiện đến khi hết thịt. Cho thịt vào hấp khoảng 10 phút cho chín. Bắc chảo lên bếp,phi thơm tỏi. Tiếp đó cho cà chua vào đảo kỹ, rồi cho phần sốt cà chua và phần nước khi hấp thịt vào cùng. Nêm nếm vừa ăn, cho những viên thịt đã hấp chín vào đảo đều, đun nhỏ lửa cho thịt ngấm sốt và đến khi nước sốt sền sệt là được. Tắt bếp, cho thịt ra đĩa cùng với nước sốt sau đó rắc xíu hành lá, rau mùi lên trên là được.","nutrition":{"kcal":301.5,"protein_g":13.2,"fat_g":24.2,"carbs_g":8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05m3t8m15b7sjzeb","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:sot ca chua","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"}]