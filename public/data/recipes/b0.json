","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cà rốt, khoai tây gọt vỏ, rửa sạch, cắt khúc, cho ra rổ để ráo. Đậu Hà Lan rửa sạch Thịt bò rửa sạch, cắt miếng vừa ăn. Tỏi bóc vỏ, băm nhuyễn Phi thơm tỏi băm, đổ nước vào, nấu sôi. Khi nước sôi, cho cà rốt, khoai tây, đậu vào, nấu khoảng 10 phút. Tiếp theo, cho thịt bò vào cùng, nấu khoảng 3 phút. Nêm gia vị cho vừa ăn. Tắt bếp, múc canh ra tô, rắc hành lá vào và thưởng thức!","nutrition":{"kcal":90.8,"protein_g":7.2,"fat_g":4.2,"carbs_g":6.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00pzt8m1ozowlpqg","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Rau mùi","ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","title_ingredient_not_mentioned:Rau mùi","unlisted_ingredient_phrase:hanh la"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu027xt8m1uh1gqpgo#variant-1","name":"Cháo thịt gà đậu xanh cải xanh","detail_name":"Cháo thịt gà đậu xanh cải xanh","category":"Cháo 7-8 tháng tuổi","age_group":"7-8  tháng","serving":{"raw":"69 g / Chén","quantity_value":69,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt gà công nghiệp, đùi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"5 g","quan