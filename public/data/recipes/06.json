, xếp trứng cút lên trên.","nutrition":{"kcal":673.9,"protein_g":16.7,"fat_g":26.9,"carbs_g":91.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03knt8m1jxdttsef","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:au xanh","unlisted_ingredient_phrase:cai thia","unlisted_ingredient_phrase:gia au xanh","unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:heo nac","unlisted_ingredient_phrase:moc nhi","unlisted_ingredient_phrase:thit heo nac","unlisted_ingredient_phrase:tom thit","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:trung cut","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03qat8m1monkyz0r#variant-1","name":"Nhãn nhục đá (100ml/ ly)","detail_name":"Nhãn nhục đá (100ml/ ly)","category":"Nước trái cây (7 tháng trở lên)","age_group":"7 tháng","serving":{"raw":"20 g / Ly","quantity_value":20,"quantity_unit":"g","portion_label":"Ly"},"ingredients":[{"name":"Nhãn khô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":"Long nhãn rửa sạch để ráo. Bắt nước lên bếp, lá dứa bó lại rồi cho vào nồi, thêm đường vào nấu cho tan. Nước đường sôi và đường tan hết thì cho long nhãn vào, tắt bếp đậy nắp. Thêm đá là có ngay một ly nhãn nhục đá.","nutrition":{"kcal":68.9,"protein_g":0.4,"fat_g":0.1,"carbs_g":16.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6or03qat8m1monkyz0r","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nuoc uong"],"source_categories":[{"label":"Nước trái cây (7 tháng trở lên)","i