cà ri thì bạn nên thái to một chút. Luộc cà rốt và khoai tây chín nhưng không quá mềm. Vớt ra và để cho ráo nước. Nấu cà ri Cho một lớp dầu ăn mỏng vào nồi to. Khi dầu đã nóng, bạn cho thịt gà đã ướp và đảo sơ cho nóng rồi cho nước dừa vào. Hầm thịt gà với nước dừa khoảng 30 phút thì cho các loại củ vào hầm cùng. Nếu bạn thấy nước quá cạn thì có thể cho thêm một chút nước ấm nhưng tốt nhất vẫn là nên cho thêm nước dừa. Khi mà thịt gà đã chín thì bạn hạ nhỏ lửa lại, hầm thêm chút nữa cho nước cà ri sắc và thật thấm, đậm vị thì tắt bếp.","nutrition":{"kcal":313.4,"protein_g":13,"fat_g":10.4,"carbs_g":42.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tx00h1t8m1zuwhoyd3","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Cary bột","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:khoai tay","unlisted_ingredient_phrase:tuong nhat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00tdt8m1g355183q#variant-1","name":"Bột chiên","detail_name":"Bột chiên","category":"Món khô","age_group":null,"serving":{"raw":"185 g / Dĩa","quantity_value":185,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"45 g","quantity_value":45,"quantity_unit":"g"},{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đu đủ xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nước tương MAGGI Đậu Nành Đậm Đặc - NESTLÉ","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":"Đu đủ xanh gọt bỏ, bào sợi, ngâm nước, để ráo. Hành lá bỏ gốc, rửa sạch, cắt nhỏ. Trộn đều bột gạo với nước, khuấy đều. Cho bột gạo vào khay hấp chín. Bột nguội, Cắt miếng vuông vừa ăn. Bắt chảo lên bếp cho dầu ăn vào, chiên bột vàng đều, đập trứng vào, thêm hành lá lên trên, Trứng chín thì vớt bột chiên ra đĩa. Cho đủ đủ lên trên. Pha nước chấm gồm nước tương và tương ớt vừa ăn. Rưới nước chấm lên bột chiên là có thể thưởng thức ngay.","nutrition":{"kcal":421.5,"protein_g":10.2,"fat_g":24.3,"carbs_g":42.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00tdt8m1g355183q","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","unlisted_ingredient_phrase:bot chien","unlisted_ingredient_phrase:tuong ot","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00ygt8m12zg9y9br#variant-1","name":"Bún chả cá lã vọng","detail_name":"Bún chả cá lã vọng","category":"Món khô từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"499 g / Tô vừa","quantity_value":499,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bún tươi","quantity_raw":"300 g","quantity_value":300,"quantity_unit":"g"},{"name":"Cá trê","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Riềng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Thì là","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nghệ