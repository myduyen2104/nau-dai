ame":"Cơm tấm bì","detail_name":"Cơm tấm bì","category":"Cơm 18 tháng đến 18 tuổi","age_group":"18 tháng","serving":{"raw":"280 g / Dĩa vừa","quantity_value":280,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bì heo (lợn)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Mỡ lợn nước","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Gạo tấm vo sạch, mang đi nấu. Thịt nạc rửa sạch, cắt lát mỏng, ướp đường, ướp mắm, sau đó đem đi khìa vàng. Trộn bì với thính, muối, đường, hạt nêm, dầu ăn, thịt nạt cắt sợi nhỏ để lên trên Dưa chuột, cà chua rửa sạch, cắt miếng vừa ăn. Củ cải trắng, cà rốt gọt vỏ, cắt sợi mỏng, ngâm muối, sau đó rửa sạch, ngâm với hỗn hợp dấm, đường trong 1 giờ. Nấu tan hỗn hợp nước lọc, nước mắm, đường, dấm, cho thêm tỏi, ớt băm nhuyễn Hành lá: nhặt, rửa sạch, cắt nhỏ, làm nóng chảo, cho mở lợn vào nấu sôi, tắt bếp, cho phần mở lợn đang sôi vào hành lá đã cắt nhỏ. Cho cơm ra dĩa, để bì, đồ chua lên. Chan mỡ hành và ăn với nước mắm.","nutrition":{"kcal":391.5,"protein_g":15.7,"fat_g":10.1,"carbs_g":59.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02hgt8m1wcyl387p","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Cơm 18 tháng đến 18 tuổi","id":"com_18_thang_den_18_tuoi","kind":"food_category","baseLabel":"Cơm 18 tháng đến 18 tuổi"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02hrt8m1lkp056kh#variant-1","name":"Cơm tấm sườn","detail_name":"Cơm tấm sườn","category":"Cơm","age_group":null,"serving":{"raw":"303 g / Dĩa vừa","quantity_value":303,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Sườn heo (lợn)","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Sườn cốt lếch rửa sạch, để ráo ướp gia vị, nướng chín. Hành tím đem bóc vỏ và băm nhuyễn. Cà chua dưa chuột rửa sạch, cắt lát mỏng. Cà rốt, củ cải gọt vỏ, rửa sạch, bào sợi, ngâm chua ngọt. Gạo vo sạch nấu săm sắp mặt nước. Nấu cơm trong 30 phút. Cơm chín. Hành lá bỏ gốc, rửa sạch, cắt nhỏ, phi thơm với dầu ăn. Nước mắm pha với đường và chanh để tạo hỗn hợp nước mắm vừa ăn. Múc cơm ra đĩa, rưới mỡ hành lên, thêm sườn, rưới nước mắm pha lên trên. Ăn kèm với cà chua, dưa leo, cà rốt, củ cải ngâm chua ngọt.","nutrition":{"kcal":601.4,"protein_g":26.9,"fat_g":16.9,"carbs_g":85.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02hrt8m1lkp056kh","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:chua ngot","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:mam pha","unlisted_ingredient_phrase:ngam chua","unlisted_ingredient_phrase:ngam chua ngot","unlisted_ingredient_phrase:nuoc mam pha","unlisted_ingredient_phrase:pha voi","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Cơm","id":"com","kind":"food_category","baseLabel":"Cơm"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02p5t8m1uhajtnop#variant-1","name":"Dưa leo","detail_name":"Dưa leo","category":"Món luộc 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"100 g / Dĩa nhỏ","quantity_value":100,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":null,"instructions_raw":"Dưa leo rửa sạch, gọt vỏ, cắt lát mỏng.","nutrition":{"kcal":18,"protein_g":0.8,"fat_g":0.1,"carbs_g":3.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02p5t8m1uhajtnop","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","listing_count_not_visible_in_detail","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:dua leo"],"source_categories":[{"label":"Món luộc 8-18 tuổi","id":"mon_luoc_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món luộc"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02q5t8m1g9z7f17e#variant-1","name":"Ếch chiên nước mắm","detail_name":"Ếch chiên nước mắm","category":"Món mặn","age_group":null,"serving":{"raw":"166 g / Dĩa vừa","quantity_value":166,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Ếch ( thịt đùi)","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Ếch rửa sạch, để ráo ướp với gia vị trong 30 phút. Đặt chảo dầu nóng thả ếch vào chiên vàng đều 2 mặt. Pha hỗn hợp gồm đường, nước mắm cho vừa ăn. Khi ếch chín vàng đều rới hỗn hợp nước mắm lên mình ếch để nhỏ lửa cho thấm gia vị rồi tắt bếp.","nutrition":{"kcal":197.1,"protein_g":30.5,"fat_g":6.7,"carbs_g":4.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02q5t8m1g9z7f17e","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tỏi ta","unlisted_ingredient_phrase:hon hop","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02xht8m1vcyxgya2#variant-1","name":"Gỏi xoài tôm khô","detail_name":"Gỏi xoài tôm khô","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"121.2 g / Dĩa vừa","quantity_value":121.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Xoài sống","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Tôm khô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Tôm khô rửa qua nước cho sạch. Ngâm tôm vào nước ấm cho mềm, sau 15 phút vớt ra để ráo. Có thể dùng chày giã nhẹ để khi xào tôm gia vị sẽ thấm tốt hơn. Xoài xanh rửa sạch gọt vỏ, sau đó ngâm ngay vào nước đá lạnh. Dùng dao cắt tỉa hoặc nạo nhỏ để sắt xoài thành từng sợi như thái chỉ. Bỏ tất cả vào thố để tạm trong ngăn mát tủ lạnh. Các loại rau thơm nhặt sạch và sắt nhỏ 3-4cm. Tỏi bóc vỏ sắt thật nhuyễn, ớt bỏ hạt cũng bằm nhuyễn để một bên. Tiếp tục lấy nước mắm và đường theo tỉ lệ thích hợp (vì còn phụ thuộc vào nguyên liệu nhiều hay ít) hòa cùng ít nước nguội, khuấy cho tan đều rồi nếm thử. Vừa khẩu vị mới cho tỏi ớt vào. Lấy một củ hành bóc vỏ đập dập cho vào chảo dầu nóng. Hành phi thơm, trút tôm vào đảo nhanh tay, gia giảm thêm chút mắm chút đường cho tôm thêm hương vị. Thấy tôm săn lại thì tắt bếp. Bắc lên bếp một chiếc chảo khác, đun nóng cho đậu phộng vào đảo đều tay. Đậu chín vớt ra ngoài cho nguội rồi sát vỏ, bỏ vào cối giã nhỏ. Sử dụng một chiếc thố hoặc thau to để trộn gỏi xoài tôm khô, sử dụng trực tiếp thố xoài đang để trong tủ lạnh cũng được. Trút tôm khô vừa xào vào, rưới nước mắm cho đều. Nguyên liệu của món này không lo bị mềm nên lúc này có thể bóp mạnh 