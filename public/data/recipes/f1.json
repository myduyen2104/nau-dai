ng khoảng 30 phút cho thịt ngấm đều.Đặt nồi lên bếp, vặn nhỏ lửa, cho đường vào nồi, khuấy đều đến khi đường tan và chuyển sang màu cánh gián.Cho 1 bát nước lọc nhỏ vào nồi nước đường, đun sôi rồi cho thịt vào hầm khoảng 30 phút.Sau 30 phút, bạn cho trứng cút và ớt vào, nêm nếm gia vị sao cho vừa miệng thì tắt bếp","nutrition":{"kcal":479.4,"protein_g":21.8,"fat_g":41.3,"carbs_g":6.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh056xt8m167fbwifu","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng vịt (55g/quả)","ingredient_not_mentioned_by_name:Tỏi ta","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc uong","unlisted_ingredient_phrase:thit ba","unlisted_ingredient_phrase:thuc pham","unlisted_ingredient_phrase:trung cut","unlisted_ingredient_phrase:uop thit","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05l3t8m1ph89uyso#variant-1","name":"Vịt tần nấm sen","detail_name":"Vịt tần nấm sen","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"39 g / Dĩa nhỏ","quantity_value":39,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Sơ chế và ướp thịt vịt Thịt vịt mua về bạn rửa sạch, xoa bóp kỹ vịt với gừng cắt nhỏ và muối hạt. Sau đó bạn để yên 15 phút rồi rửa lại bằng nước sạch, chặt thịt vịt thành từng miếng vừa ăn, để ráo. Sơ chế các nguyên liệu khác Hạt sen và nấm đông cô rửa sạch, ngâm nước ấm khoảng 30 phút rồi vớt ra, để ráo. Hành tím, tỏi bạn bóc vỏ, cắt đôi. Gừng cạo vỏ, cắt lát mỏng. Hành lá rửa sạch, cắt khúc. Xào thịt vịt Cho vào nồi 1 muỗng canh dầu ăn, đun nóng rồi cho gừng, hành, tỏi vào phi cho thơm. Tiếp đến cho thịt vịt vào xào trên lửa lớn đến khi thịt vịt săn lại. Sau đó, nêm nước mắm, dầu hào, đường vàng, bột canh rồi đảo đều cho thịt thấm gia vị. Hầm thịt vịt cùng hạt sen nấm đông cô Cho vào nồi thịt vịt nước dừa tươi, nấu sôi sau đó hạ lửa nhỏ, đậy nắp nồi hầm khoảng 45 - 60 phút, trong thời gian hầm bạn nhớ hớt bọt thường xuyên để nước hầm được trong. Tiếp đến, cho hạt sen, nấm hương vào đảo đều. Đậy nắp hầm thêm 15 phút nữa rồi nêm nếm lại cho vừa ăn, cuối cùng rắc thêm hành lá và tắt bếp.","nutrition":{"kcal":95.6,"protein_g":4.8,"fat_g":6.5,"carbs_g":4.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05l3t8m1ph89uyso","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot canh","unlisted_ingredient_phrase:dau hao","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]