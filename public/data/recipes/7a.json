tity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Mỡ lợn nước","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, cắt miếng vừa ăn. Tiếp đó cho gừng và một lượng nước vừa đủ vào nồi để trụng thịt bò. Thịt sau khi trụng thì rửa sạch lại bằng nước ấm rồi để sang một bên. Cho một ít dầu vào chảo, sau đó cho tiêu hạt, vài lát gừng vào chảo, đảo đều ở mức lửa nhỏ. Tới khi nguyên liệu có mùi thơm, bạn bật bếp lên mức lửa vừa, cho thịt bò và các gia vị vào chảo. Đảo đều để thịt bò được ngấm đều gia vị. Sau đó múc thịt bò để riêng. Đổ nước vào chảo thịt để tráng lấy nước ngọt từ thịt bò xào ra nước . Sau đó đỗ lượng nước này vào nồi và thêm nước vào vừa đủ đun sôi nêm nếm cho phù hợp với khẩu vị cá nhân và nấu thêm 5 đến 10 phút nữa thì tắt bếp. Cho mì đã luộc chín ra bát, thêm thịt bò, nước dùng vào ăn kèm với giá.","nutrition":{"kcal":272.6,"protein_g":12.4,"fat_g":9.5,"carbs_g":34.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03eqt8m1jk3v5u2b","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Mỡ lợn nước","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:lieu co","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nguyen lieu co","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ngot","unlisted_ingredient_phrase:tu thit"],"source_categories":[{"label":"Món nước 3-4 tuổi","id":"mon_nuoc_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03gjt8m1fudc20j9#variant-1","name":"Mì xào bò","detail_name":"Mì xào bò","category":"Món khô 5 tuổi","age_group":"5 tuổi","serving":{"raw":"103 g / Dĩa nhỏ","quantity_value":103,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Mì sợi khô","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Mì sợi khô ngâm với nước ấm cho mềm, vớt ra để ráo, trộn với dầu ăn cho khỏi dính. Thịt bò rửa sạch, băm nhuyễn, ướp gia vị. Cà rốt gọt vỏ, rửa sạch, thái sợi. Bắt chảo lên bếp, thêm dầu ăn, tỏi phi thơm rồi thêm cà rốt vào đảo đều, thêm thịt bò vào xào chín, Nêm gia vị vừa ăn. Thêm mì vào đảo đều rồi tắt bếp.","nutrition":{"kcal":309.6,"protein_g":11.2,"fat_g":11.4,"carbs_g":41.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03gjt8m1fudc20j9","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô 5 tuổi","id":"mon_kho_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03hct8m1j5ungvkj#variant-1","name":"Mì ý cá hồi","detail_name":"Mì ý cá hồi","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"302 g / Dĩa","quantity_value":302,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":[{"name":"Mì Spaghetti, khô","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Cá hồi","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, bằm nhỏ, ướp gia vị. Cà chua rửa sạch, cắt đôi bỏ hạt và cho vào máy xay sinh tố xay nhuyễn. Hành tây lột vỏ, rửa sạch, băm nhỏ. Hành củ và tỏi bạn bóc vỏ, rửa sạch và băm nhỏ. Rau mùi bỏ rễ, rửa sạch. Dưa leo rửa sạch, cắt lát mỏng. Cho khoảng 2 lít nước vào nồi và nấu sôi, bạn thêm vào nồi nước 2 thìa dầu ăn và 1 chút muối để sợi mỳ chín sẽ đậm vị hơn và không bị dính vào nhau. Nước sôi bạn thả mỳ ý vào luộc (nhớ để tơi mỳ ra để khi chúng mềm và chìm trong nước không bị dính vào nhau). Sau khi mỳ đã hoàn toàn chìm trong nước, bạn luộc thêm khoảng 2 – 3 phút cho sợi mỳ chín mềm có thể dùng đũa ngắt thử là được, giai đoạn này bạn nhớ đảo sợi mỳ để chúng không dính vào nhau. Thời gian luộc mỳ sẽ khoảng 8 – 10 phút như hướng dẫn trên bao bì. Mỳ chín, vớt ra rổ (rá) và để ráo nước. Bắc chảo lên bếp, cho 1 xíu dầu ăn cho nóng và cho hành củ, tỏi đã băm nhuyễn vào phi cho thơm. Cho hành tây vào đảo đều cho tới khi hành chín ngả màu hơi trong. Tiếp tục cho sốt cà chua vào cùng với 1 xíu muối, nấu cho hỗn hợp sốt hơi sền sệt thì cho thịt bò vào đảo đều cho thịt tơi ra. Nếu thấy hỗn hợp sốt bây giờ bị đặc lại thì bạn có thể thêm vào chút nước. Thịt bò chín và gia vị vừa ăn, rắc thêm 1 ít hạt tiêu và tắt bếp nhé. Xếp mì ra đĩa và rưới sốt cà chua thịt bò lên trên. Trộn đều là có thể thưởng thức ngay. Ăn kèm với dưa leo.","nutrition":{"kcal":610.3,"protein_g":31.8,"fat_g":16,"carbs_g":84.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03hct8m1j5ungvkj","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Mì Spaghetti, khô","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:dua leo","unlisted_ingredient_phrase:hanh cu","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:sot ca chua","unlisted_ingredient_phrase:thit bo","unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03mct8m1h9gqb4c2#variant-1","name":"Mực lăn bột chiên","detail_name":"Mực lăn bột chiên","category":"Món mặn","age_group":null,"serving":{"raw":"122.5 g / Dĩa vừa","quantity_value":122.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Mực tươi","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Bột mì","quantity_raw":"12 g","quantity_value":12,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sơ chế mực bằng cách rút đầu và lấy m