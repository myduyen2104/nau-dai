rotein_g":4.6,"fat_g":3.5,"carbs_g":5.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01wht8m11xyrdv49","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món canh từ 3-4 tuổi","id":"mon_canh_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu024pt8m120e2v5kl#variant-1","name":"Cháo gan gà súp lơ xanh","detail_name":"Cháo gan gà súp lơ xanh","category":"Cháo 13-24 tháng tuổi","age_group":"13-24 tháng","serving":{"raw":"98.5 g / Chén","quantity_value":98.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Gan gà","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Súp lơ xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"}],"instructions_raw":"* Gan gà rửa muối, sau đó rửa sạch dưới vòi nước, đem đi luộc rồi tán nhuyễn * Súp lơ xanh rửa sạch, băm nhuyễn. * Hòa tan gan gà với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng , bắc lên bếp khuấy đều cho đến khi sôi, thêm súp lơ xanh vào nấu chín. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":220.8,"protein_g":8.7,"fat_g":9.4,"carbs_g":25.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu024pt8m120e2v5kl","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Cháo 13-24 tháng tuổi","id":"chao_13_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"13-24 tháng","id":"13_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02d8t8m1t1ro6e40#variant-1","name":"Chim bồ câu hầm cốm hạt sen","detail_name":"Chim bồ câu hầm cốm hạt sen","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"29 g / Dĩa nhỏ","quantity_value":29,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bồ câu ra ràng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cốm","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Miến dong khô","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"\"Chim làm sạch, rút xương, ướp tiêu, muối, bột gia vị để thấm 10 phút. Xương chim hầm lấy nước dùng. Thịt nạc băm nhuyễn, ướp gia vị. Hạt sen luộc mềm. Nấm ngâm nước rửa sạch, cắt bỏ chân, lấy vài tai xắt nhỏ. Còn lại để nguyên hoặc cắt đôi. Miến ngâm nước, vớt ra để ráo. Hành lá cắt lấy phần trắng , lấy vài cọng tỉa hoa.\" Trộn chung thịt nạc , 1/2 hạt sen, cốm, nấm cắt nhỏ, hành củ băm nhỏ phi vàng, gia vị… rồi dồn thịt vào bụng chim, may lại, để ráo. Bắc chảo dầu lên bếp đun sôi, gác vỉ lên chảo cho chim lên, múc mỡ xối lên cho săn thịt và hơi vàng. Bắc nồi nước dùng lên bếp đun sôi, cho chim vào hầm mềm, cho chút muối, vài lát gừng, để lửa nhỏ và hớt bọt kỹ. Thỉnh thoảng trở chim cho chín mềm đều. Khi chim mềm, cho nấm, miến và sen còn lại và nấu tiếp.Nêm gia vị vừa ăn. Cho hành vào rồi nhắc xuống.","nutrition":{"kcal":90.9,"protein_g":3.5,"fat_g":6.8,"carbs_g":4.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02d8t8m1t1ro6e40","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nấm hương khô","ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:bot gia","unlisted_ingredient_phrase:bot gia vi","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:thit va"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02ekt8m1ybr0w03x#variant-1","name":"Chim bồ câu tần","detail_name":"Chim bồ câu tần","category":"Món mặn","age_group":null,"serving":{"raw":"58.5 g / Dĩa nhỏ","quantity_value":58.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bồ câu ra ràng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Rượu trắng (cồn 39 g)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Chim làm sạch,ướp tiêu muối vào bụng chim, cài hai chân lại. Nấm hương ngâm nước, bỏ chân,rủa sạch, nếu to thái đôi. Hành khô bóc vỏ, củ nhỏ để nguyên,củ to cắt đôi. Hạt sen thông tâm bỏ vỏ lụa luộc chín,hành củ tươi rửa sạch.\" \" Chao chim qua dầu đặt lên liễn,trải nấm hương,hạt sen, hành củ khô, gừng lên mình chim, cho khoảng 200ml nước dùng vào, nêm gia vị,rượu,đậy vung kín,đặt vào nồi nước đem tần đến khi chín nhừ. Bày chim ra bát,bày nấm hương,hạt sen xung quanh, hành chần lên trên,chan nước tần, rắc tiêu, ăn nóng\"","nutrition":{"kcal":151.7,"protein_g":5.4,"fat_g":8.2,"carbs_g":7.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02ekt8m1ybr0w03x","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt bồ câu ra ràng","ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","title_ingredient_not_mentioned:Thịt bồ câu ra ràng","unlisted_ingredient_phrase:nuoc dung","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}