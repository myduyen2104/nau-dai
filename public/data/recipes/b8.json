ue":47,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cốm","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Miến dong khô","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Vịt làm sạch, xát muối trong và ngoài vịt, rửa lại cho sạch, đểráo. Thịt nạc dăm rửa sạch băm nhỏ, ướp nước mắm + tiêu + hành bằm. Nấm hương, nấm mèo ngâm mềm rửa sạch, bỏ chân, băm nhỏ. Hạt sen luộc chín mềm, bỏ tim sen. Miến ngâm mềm, vớt ráo, băm nhỏ. Trộn đều thịt nạc + hạt sen + nấm hương + nấm mèo + cốm + miến, nêm thêm chút nước mắm + đường, trộn thật đều Dồn hỗn hợp trên vào bụng vịt cho vừa căng rồi dùng chỉ may lại Hành lá, rau ngò, rứa sạch xắt nhỏ Bắc chảo nóng, cho dầu vào, phi hanh thơm, cho vịt vào chiên sơ. Cho vịt vào nồi, đổ nước vào sâm sấp, nấu cho đến khi vịt mềm, nước cạn bớt, nêm lại vừa ăn, lấy vịt để ra đĩa sâu lòng. Hòa bột năng với chút nước lã, đổ vào nồi nước vịt, quậy đều, cho nước sền sệt, cho hành lá vào nhắc đổ lên mình vịt, bên trên rắc tiêu + rau ngò. Món này ăn nóng mới nóng","nutrition":{"kcal":127.1,"protein_g":5.7,"fat_g":8.2,"carbs_g":7.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05jct8m1f637jwbw","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Gừng tươi","ingredient_not_mentioned_by_name:Tỏi ta","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nac dam","unlisted_ingredient_phrase:rau ngo","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05jut8m18o8xtdrf#variant-1","name":"Vịt hấp trung hoa","detail_name":"Vịt hấp trung hoa","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"88.5 g / Dĩa vừa","quantity_value":88.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rượu trắng (cồn 39 g)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Sơ chế thịt vịt Đầu tiên, để khử mùi tanh của thịt vịt, sau khi mua về bạn đem rửa sạch rồi cắt thành miếng nhỏ vừa ăn. Tiếp đến, băm nhỏ 1 củ gừng rồi cho vào ướp với thịt trong vòng 20 phút. Sau khi ướp xong, đem thịt vịt rửa lại với nước. Ướp thịt vịt Cho tỏi băm vào thịt vịt với các gia vị ướp cho thấm. Sau đó đem thịt vịt đi hấp, chín thì vớt ra dĩa. Làm nước sốt Bắc chảo lên bếp và cho vào chảo 2 muỗng canh dầu ăn. Đợi dầu nóng, bạn cho hành tỏi vào phi thơm, sau đó cho xì dầu, rượu trắng và các loại gia vị nêm nếm vừa ăn, cuối cùng cho 1 ít bột năng để cho nước sốt có độ sệt Trút hỗn hợp nước sốt lên thịt vịt đã hấp. Có thể trang trí hành lá lên trên cho bắt mắt.","nutrition":{"kcal":216.9,"protein_g":9.6,"fat_g":14,"carbs_g":6.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05jut8m18o8xtdrf","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:uop thit","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05kut8m1l0x6rtp6#variant-1","name":"Vịt quay tiêu","detail_name":"Vịt quay tiêu","category":"Món mặn","age_group":null,"serving":{"raw":"106.5 g / Dĩa nhỏ","quantity_value":106.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu hào maggi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Sơ chế thịt vịt Thịt vịt sau khi mua về, bạn rửa sạch với nước rồi khử mùi hôi. Bạn có thể khử mùi hôi cho vịt bằng rất nhiều cách: Trộn muối và giấm với nhau, dùng hỗn hợp này để bóp vịt cả bên trong lẫn ngoài; dùng chanh tươi chà xát lên thân vịt nhiều lần; bóp vịt với gừng giã nhuyễn hay rượu trắng,…. Cuối cùng, bạn rửa vịt lại với nước rồi để ráo, vịt đã sạch và hoàn toàn hết mùi hôi. Bước 2: Chuẩn bị nước ướp Nước ướp bạn pha theo tỷ lệ như sau: tiêu xay + hạt nêm + dầu hào + nước mắm Bước 3: Chuẩn bị ướp vịt Dùng nước ướp vừa pha xoa lên mình vịt. Hành tây, cà rốt bạn gọt sạch vỏ rửa sạch và thái lát mỏng. Bước 4: Nướng vịt Cho vịt vào lò nướng để nướng, bạn cũng có thể dùng lò nướng hoặc dùng bếp than hoa Cứ nướng khoảng 20 phút bạn lại tưới một lớp nước ướp lên vịt để món ăn không bị khô. Làm như vậy khoảng 3 lần là thịt vịt sẽ chín tới và da vàng giòn. Khi vịt chín vàng đều là được. Bước 5: Hoàn thành Chặt vịt thành những miếng vừa ăn cho đều, đẹp mắt rồi xếp ra đĩa và trang trí cùng với cà rốt hành tây.","nutrition":{"kcal":151.5,"protein_g":8.2,"fat_g":8.9,"carbs_g":9.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05kut8m1l0x6rtp6","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:ruou trang","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"}]