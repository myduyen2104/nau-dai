8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00p0t8m15bl7zli5","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01yst8m1j0dk6pit#variant-1","name":"Chả cá thu chiên sốt cà","detail_name":"Chả cá thu chiên sốt cà","category":"Món mặn 18-24 tháng tuổi","age_group":"18-24 tháng","serving":{"raw":"38 g / Dĩa nhỏ","quantity_value":38,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá thu","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cá thu rửa sạch, lấy phần thịt xay nhuyễn, ướp gia vị, trộn đều, vo viên nhỏ vừa ăn. Cà chua rửa sạch, bỏ hạt băm nhuyễn Hành, tỏi bóc vỏ, băm nhuyễn Đun nóng dầu, cho chả cá vào chiên vàng đều các mặt, vớt ra đĩa. Phi vàng hành tỏi băm, cho cà chua vào đảo đều, nêm nếm gia vị, cho chả cá chiên vào, nấu lửa nhỏ trong 5 phút, tắt bếp","nutrition":{"kcal":66.7,"protein_g":3.8,"fat_g":5.1,"carbs_g":1.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01yst8m1j0dk6pit","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn 18-24 tháng tuổi","id":"mon_man_18_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"18-24 tháng","id":"18_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ts0010t8m1coxxiuhl#variant-1","name":"Cơm gạo huyết rồng độn miến","detail_name":"Cơm gạo huyết rồng độn miến","category":"Cơm","age_group":null,"serving":{"raw":"60 g / Chén 200 ml","quantity_value":60,"quantity_unit":"g","portion_label":"Chén 200 ml"},"ingredients":[{"name":"Gạo huyết rồng","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Miến dong khô","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"}],"instructions_raw":"Vo sơ gạo, sau đó ngâm gạo huyết rồng bằng nước ấm trong 45 phút để hạt gạo mềm và dẻo hơn. Cho nước vào nồi với tỉ lệ nước-gạo là 2:1. Bạn có thể dùng nước ngâm gạo để nấu cơm, như thế sẽ giữ lại chất dinh dưỡng của gạo huyết rồng.Cắm điện và bật nút nấu. Khi cơm chín, nồi sẽ tự động chuyển sang chế độ hâm, đợi thêm 10-15 phút nữa cho cơm mềm và nở đều hơn. Xới tơi cơm rồi múc ra chén là bạn đã có thể dùng bữa.","nutrition":{"kcal":208.2,"protein_g":2.8,"fat_g":0,"carbs_g":49.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ts0010t8m1coxxiuhl","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Miến dong khô","unlisted_ingredient_phrase:dinh duong"],"source_categories":[{"label":"Cơm","id":"com","kind":"food_category","baseLabel":"Cơm"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02m0t8m126jpie8j#variant-1","name":"Đậu hũ non sốt cà chua","detail_name":"Đậu hũ non sốt cà chua","category":"Món mặn","age_group":null,"serving":{"raw":"192 g / Dĩa vừa","quantity_value":192,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Đậu phụ (đậu hũ)","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Đậu hũ non mua sẵn ngoài chợ, cắt thành miếng nhỏ, hình vuông vừa ăn. Cà chua rửa sạch, cắt hạt lựu. Tỏi bóc vỏ, băm nhuyễn. Làm nóng dầu ăn, phi thơm tỏi. Cho cà chua vào, đảo đều đến khi cà chua mềm. Thêm gia vị cho vừa ăn. Đổ nước vào, nấu sôi khoảng 1 phút. Tiếp theo, cho đậu hũ vào, nấu lim rim nhỏ lửa cho ngấm phần sốt. Dùng đũa trở nhẹ tay miếng đậu hũ. Chú ý không để miếng đậu hũ bị nớt. Tắt bếp, cho món ăn ra đĩa.","nutrition":{"kcal":202.8,"protein_g":17.2,"fat_g":13.2,"carbs_g":4.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02m0t8m126jpie8j","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","unlisted_ingredient_phrase:au hu non"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo038rt8m1smy4lx1a#variant-1","name":"Lươn bọc lá lốt","detail_name":"Lươn bọc lá lốt","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"146.5 g / Dĩa vừa","quantity_value":146.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Lươn","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Lá lốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tía tô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Thái lươn thành những miếng dài cỡ ngón tay. Ướp lươn với ½ thìa cà phê bột canh, ½ thìa cà phê bột nghệ và đầu trắng của hành hoa. Rửa sạch vài lá tía tô và lá lốt, vẩy sạch nước, thái sợi, cho vào bát thịt nạc xay. Thêm hành tím, tỏi đã đập dập, thêm ½ thìa cà phê bột canh, chút hạt tiêu, trộn đều các nguyên liệu cho dẻo. Trải miếng lươn ra thớt, cho hỗn hợp thịt xay vào giữa, cuộn tròn miếng lươn lại. Tiếp tục trải lá lốt ra thớt, cho cuộn lươn bọc thịt lên, cuộn lá lốt lại. Lấy hành hoa vừa chần buộc cố định lại để lá lốt không bị bung ra. Cho dầu ăn vào chảo, chờ dầu nóng già thì cho từng miếng lươn cuộn vào chảo, vặn nhỏ lửa/giảm nhiệt độ để lươn chín vàng mà lá lốt không bị cháy.","nutrition":{"kcal":281.2,"protein_g":20.8,"fat_g":14.7,"carbs_g":16.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oo038rt8m1smy4lx1a","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Mộc nhĩ/ Nấm mèo","ingredient_not_mentioned_by_name:Sả cây","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:au trang","unlisted_ingredient_phrase:bot canh","unlisted_ingredient_phrase:hanh hoa","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nguyen lieu"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03jut8m17ob28bql#variant-1","name":"Miến trộn Hàn Quốc","detail_name":"Miến trộn Hàn Quốc","category":"Món khô 5 tuổi","age_group":"5 tuổi","serving":{"raw":"196 g / Dĩa nhỏ","quantity_value":196,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Miến dong khô","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cải bó xôi","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Ớt vàng to","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Vừng (đen, trắng)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Miến dong ngâm với nước ấm cho sợi miến mềm, vớt ra để ráo, cắt vừa ăn. Thịt bò rửa sạch, thái mỏng, ướp gia vị. Nấm hương khô ngâm mềm, thái mỏng. Cải bó xôi cắt gốc, rửa sạch, cắt khúc vừa ăn. Cà rốt gọt vỏ, rửa sạch, thái sợi. Ớt vàng to, ớt đỏ to rửa sạch, thái lát mỏng. Hành tây gọt vỏ, rửa sạch, thái mỏng. Bắt chảo lên bếp, thêm dầu, phi thơm tỏi, cho thịt bò vào xào chín rồi vớt ra. Thêm tiếp dầu vào chảo để xào nấm hương, cà rốt, hành tây, ớt đỏ to, ớt vàng to, cải bó xôi. Nêm gia vị vừa ăn, múc ra. Làm nước sốt: Bắt chảo lên bếp, thêm dầu ăn tỏi phi thơm, thêm xì dầu, đường, nước, nấu sôi, thêm bột bắp khuấy đều cho nước sốt sánh lại. Trộn miếng dong với các nguyên liệu đã xào chín, thêm nước sốt vào đảo đều cho ngấm đều. Thêm hành phi, vừng rang, dầu mè lên trên và đảo đều.","nutrition":{"kcal":315.4,"protein_g":11.6,"fat_g":10.7,"carbs_g":43.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03jut8m17ob28bql","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô 5 tuổi","id":"mon_kho_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03x9t8m1o822826n#variant-1","name":"Phở bò xào","detail_name":"Phở bò xào","category":"Món khô 5 tuổi","age_group":"5 tuổi","serving":{"raw":"214 g / Dĩa nhỏ","quantity_value":214,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"120 g","quantity_value":120,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cải xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, thái lát mỏng, ướp gia vị. Cà rốt gọt vỏ, rửa sạch, thái lát mỏng. Cải xanh cắt gốc, rửa sạch, cắt khúc vừa ăn. Giá đậu xanh rửa sạch, để ráo. Bắt chảo lên bếp, thêm dầu ăn vào phi thơm tỏi, thêm thịt bò vào xào chín rồi vớt ra. Tiếp tục xào cà rốt, cải xanh, giá đậu xanh nêm gia vị vừa ăn. Sau đó thêm phở vào đảo đều đến chín, rồi thêm thịt bò vào đảo đều. Tắt bếp. Thêm rau mùi lên trên, ăn kèm với tương ngô, tương ớt.","nutrition":{"kcal":306.5,"protein_g":13.8,"fat_g":9.1,"carbs_g":43.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03x9t8m1o822826n","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:tuong ot"],"source_categories":[{"label":"Món khô 5 tuổi","id":"mon_kho_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh059tt8m1t9zb5pah#variant-1","name":"Tôm bỏ lò","detail_name":"Tôm bỏ lò","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"71.1 g / Dĩa nhỏ","quantity_value":71.1,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Tôm biển","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Bơ thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Pho mát","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rượu vang trắng (cồn 9.5 g)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"Sơ chế tôm Tôm mua về bạn cắt bỏ râu và chân cho gọn lại để dễ chế biến nhé. Bẻ nhẹ phần đầu của tôm rồi nặn hết chất thải bên trong đầu tôm ra ngoài. Lột sạch vỏ tôm rồi dùng tay hoặc dao để kéo bỏ phần chỉ trên lưng tôm. Sau đó rửa lại với nước muối pha loãng để khử mùi tanh của tôm. Rửa lại với nước sạch một lần nữa và để cho tôm ráo nước. Sơ chế các nguyên liệu khác Bạn tiến hành sơ chế các nguyên liệu khác như sau: Phô mai dạng thỏi: bào thành từng sợi nhỏ. Tỏi: bỏ vỏ rồi cắt chúng thành từng lát mỏng. Làm tôm sốt phô mai Đầu tiên, bắc chảo lên bếp rồi cho bơ lạt vào đun cho chảy. Cho thêm phần tỏi cắt lát vào và phi cho thơm. Tiếp theo, bạn cho phần tôm vào chảo, thêm muối và tiêu rồi trộn đều chúng. Sau đó, xào cho đến khi tôm chuyển sang màu cam. Cuối cùng là cho phô mai vào chảo, đậy nắp và đun thêm 3 - 5 phút cho phô mai tan hết ra là món ăn hoàn thành.","nutrition":{"kcal":114.5,"protein_g":10.5,"fat_g":6.2,"carbs_g":3.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh059tt8m1t9zb5pah","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bơ thực vật","ingredient_not_mentioned_by_name:Pho mát","ingredient_not_mentioned_by_name:Rượu vang trắng (cồn 9.5 g)","ingredient_not_mentioned_by_name:Bột bắp (bột ngô vàng)","unlisted_ingredient_phrase:mai dang","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:pho mai","unlisted_ingredient_phrase:pho mai dang",