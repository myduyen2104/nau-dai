_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cá lóc rửa sạch với muối cho hết nhớt, phi lê thành từng miếng nhỏ vừa ăn, ướp gia vị trong 10 phút. Măng tre rửa sạch luộc với muối rồi cắt khúc vừa ăn. Hành củ lột vỏ rửa sạch, băm nhuyễn. Hánh lá rửa sạch, bỏ rể, cắt nhỏ. Cho dầu ăn vào chảo chiên sơ cá rồi vớt ra dĩa. Gặn bớt dầu cho hành đã băm nhuyễn vào vào thơm cho tiếp măng vào xào. Cuối cùng cho tiếp cá vào xào đến khi chín kỹ nêm nếm gia vị vừa ăn, cho thêm hành lá đã cắt nhỏ vào rồi tắt bếp múc cá và măng ra dĩa rắc lên trên mặt 1 ít tiêu.","nutrition":{"kcal":83.1,"protein_g":5.4,"fat_g":5.8,"carbs_g":2.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw0190t8m1cyk2at46","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01f2t8m109behrz0#variant-1","name":"Cải xanh xào nấm đông cô","detail_name":"Cải xanh xào nấm đông cô","category":"Món xào chay","age_group":null,"serving":{"raw":"176.5 g / Dĩa vừa","quantity_value":176.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cải xanh","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm mỡ (nấm tây)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cắt đậu phụ thành miếng vuông nhỏ vừa miệng ăn, chiên giòn, để ráo dầu. Nếu dùng nấm đông cô khô thì ngâm nước cho mềm và cắt làm hai. Cải ngọt rửa sạch, cắt thành khúc nhỏ, trụng sơ với nước sôi, rồi vớt ra để ráo nước. Nấu nước luộc cải cho sôi trở lại và cho cà rốt đã rửa sạch và cắt nhỏ vào, trụng sơ và vớt ra ngoài để cho ráo nước. Bắc chảo lên bếp, để lửa to và cho vào dầu ăn. Bỏ tỏi vào xào lên cho thơm. Sau đó cho nấm vào xào qua rồi cho các gia vị và đậu phụ đã chiên giòn vào chảo để cho sôi để nước cạn bớt. Sau cùng cho đậu Hà Lan và cải ngọt vào. Sau đó cho nước và bột khoai đã được trộn sẵn vào cho nước sốt được sánh, xào cho sệt lại là được.","nutrition":{"kcal":109.6,"protein_g":5.9,"fat_g":6.6,"carbs_g":7.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01f2t8m109behrz0","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:au ha lan","unlisted_ingredient_phrase:bot khoai","unlisted_ingredient_phrase:cai ngot","unlisted_ingredient_phrase:chien gion","unlisted_ingredient_phrase:tron san","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món xào chay","id":"mon_xao_chay","kind":"food_category","baseLabel":"Món xào chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qy01hwt8m1d62kzz57#variant-1","name":"Canh bông cải nấm rơm thịt heo","detail_name":"Canh bông cải nấm rơm thịt heo","category":"Món canh từ 18-24 tháng tuổi","age_group":"18-24 tháng","serving":{"raw":"38.5 g / Chén","quantity_value":38.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Súp lơ trắng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":