vào nồi, cho thơm vào rồi đun sôi lại lần nữa thì nêm nếm cho vừa ăn. Làm cá dầm – Ướp cá thu cùng tiêu, nước mắm, bột ngọt, gừng, một ít rượu và đem hấp trong 30 phút là được Pha nước mắm chấm – Làm nước chấm bằng cách cho tỏi băm, ớt cắt lát và nước mắm ngon vào chén, trộn đều. Lưu ý, không thêm đường để nước mắm giữ được vị ngon nguyên chất. Trình bày và thưởng thức – Xếp bún ra tô, cho chả cá hấp, chiên và cá dầm lên trên rồi chan nước dùng vào và thưởng thức cùng rau sống. Thêm chút nước mắm sẽ làm món ăn thêm đậm đà.","nutrition":{"kcal":444.2,"protein_g":16.3,"fat_g":11.5,"carbs_g":69},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00y9t8m12nzavxbz","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giá đậu xanh","unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:nguyen chat","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00zgt8m1r53l3ozr#variant-1","name":"Bún khô xào tôm giá hẹ","detail_name":"Bún khô xào tôm giá hẹ","category":"Món khô từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"295 g / Dĩa vừa","quantity_value":295,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Bún khô","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"90 g","quantity_value":90,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_u