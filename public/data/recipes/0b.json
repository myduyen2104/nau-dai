ng 2 phút. Sau đó, cho phần cải đã cắt nhỏ vào nồi. Dìm cải xuống dưới mặt nước và đun trong khoảng 6-8 phút. . Nêm thêm vào một chút tiêu nếu muốn món canh có một chút vị cay nồng.","nutrition":{"kcal":53.9,"protein_g":4.7,"fat_g":1.3,"carbs_g":5.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01lpt8m1s829poti","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:au hu non"],"source_categories":[{"label":"Món canh chay","id":"mon_canh_chay","kind":"food_category","baseLabel":"Món canh chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02iit8m12dvsdoui#variant-1","name":"Cua sốt me","detail_name":"Cua sốt me","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"58 g / Dĩa nhỏ","quantity_value":58,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cua bế","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cua biển rửa sạch, để ráo, luộc chín, gỡ lấy thịt. Hành củ tươi bóc vỏ rửa sạch, bằm nhỏ. Hành lá rửa sạch bỏ rể, cắt nhỏ. Me hòa chung với nước ấm. Bắt chảo lên bếp cho một ít dầu, cho hành củ đã băm nhỏ vào phi thơm. Cho cua vào xào, nêm nếm gia vị vừa ăn. Cuối cùng cho nước me vào nêm nếm lại vừa ăn rồi tắt bếp.","nutrition":{"kcal":95.3,"protein_g":7.2,"fat_g":5.2,"carbs_g":5.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02iit8m12dvsdoui","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Quả me chua","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02l8t8m17214wwrb#variant-1","name":"Đậu hũ kho thịt","detail_name":"Đậu hũ kho thịt","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"48 g / Dĩa nhỏ","quantity_value":48,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Đậu phụ chiên","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Đậu hũ rửa sạch, để ráo, cắt thành khối vuông nhỏ vừa ăn. Hành , tỏi làm sạch, băm nhỏ. Thịt rửa sạch, để ráo rồi cắt miếng mỏng vừa ăn. Ướp thịt với gia vị, hành và tỏi băm. Đảo đều cho thịt thấm gia vị. Ướp thịt khoảng 30 - 40 phút. Bắc chảo lên bếp, bật bếp lửa vừa, cho đậu vào chiên ngập dầu. Chiên cho đậu vàng đều các mặt thì vớt ra, để ráo bớt dầu. Bắc nồi lên bếp, cho khoảng 1 muỗng canh dầu ăn vào nồi, làm nóng dầu với lửa vừa rồi cho phần hành băm còn lại vào phi thơm. Khi hành vàng thơm thì vớt hành cho vào tô thịt, trộn đều lên. Cho tiếp vào nồi đường, nấu lửa vừa và đảo đều cho đường tan ra, có màu vàng nâu đẹp mắt thì giảm lửa nhỏ nhất, cho phần tỏi băm còn lại vào phi thơm. Cho thịt đã ướp vào xào săn lại, cho thêm nước vào nồi cho nước xấp xấp thịt. Kho thịt được khoảng 15 phút, nước bắt đầu cạn và thịt sắp chín thì cho đậu hũ vào, đảo đều.Cuối cùng, cho một ít tiêu vào nồi vào tắt bếp.","nutrition":{"kcal":101.9,"protein_g":6.2,"fat_g":7.4,"carbs_g":2.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02l8t8m17214wwrb","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:noi lam","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02lut8m1pe5a7862#variant-1","name":"Đậu hủ non sốt cà chua","detail_name":"Đậu hủ non sốt cà chua","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"60 g / Dĩa nhỏ","quantity_value":60,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Đậu phụ (đậu hũ)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Đậu hũ non mua sẵn ngoài chợ, cắt thành miếng nhỏ, hình vuông vừa ăn. Cà chua rửa sạch, cắt hạt lựu. Tỏi bóc vỏ, băm nhuyễn. Làm nóng dầu ăn, phi thơm tỏi. Cho cà chua vào, đảo đều đến khi cà chua mềm. Thêm gia vị cho vừa ăn. Đổ nước vào, nấu sôi khoảng 1 phút. Tiếp theo, cho đậu hũ vào, nấu lim rim nhỏ lửa cho ngấm phần sốt. Dùng đũa trở nhẹ tay miếng đậu hũ. Chú ý không để miếng đậu hũ bị nớt. Tắt bếp, cho món ăn ra đĩa.","nutrition":{"kcal":79.4,"protein_g":3.6,"fat_g":6.7,"carbs_g":1.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02lut8m1pe5a7862","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","unlisted_ingredient_phrase:au hu non"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03out8m1n4gpyuiy#variant-1","name":"Nấm rơm xào lòng gà","detail_name":"Nấm rơm xào lòng gà","category":"Món xào","age_group":null,"serving":{"raw":"126 g / Dĩa vừa","quantity_value":126,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Nấm rơm","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Lòng gà (cả bộ)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Nấm rơm búp: gọt sạch chân, ngâm nước lạnh có pha bột năn, để khoảng 20 phút, rửa sạch để ráo, cắt đôi. Lòng gà: chà muối, rửa thật sạch, cắt lát mỏng. Hành tây trắng: bóc vỏ, cắt dọc làm 8. Hành lá: bóc vỏ, cắt ngắn 3 cm. Tỏi: đập giập, bóc vỏ. Bắc chảo nóng, cho dầu ăn vào đun nóng thêm tỏi vào phi thơm, cho lòng gà vào xào thật săn, cho một ít nước lạnh vào, đậy nắp lại cho lòng gà chín. Cho nấm rơm vào xào thật thấm, nêm gia vị vừa ăn, thêm hành tây vào xào chín. Khi tất cả vừa chín, nhắc xuống.","nutrition":{"kcal":122.2,"protein_g":6.5,"fat_g":7.9,"carbs_g":6.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6or03out8m1n4gpyuiy","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hanh la"],"source_categories":[{"label":"Món xào","id":"mon_xao","kind":"food_category","baseLabel":"Món xào"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03rgt8m18xin784z#variant-1","name":"Nui thịt gà","detail_name":"Nui thịt gà","category":"Món nước","age_group":null,"serving":{"raw":"225.5 g / Tô nhỏ","quantity_value":225.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Nui khô","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Thịt gà ta","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hẹ lá","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"0 g","quantity_value":0,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Sơ chế nguyên liệu Nui luộc chín, đỗ ra rỗ cho ráo nước. Các loại rau nhặt, rửa sạch Bước 2: Luộc gà lấy nước dùng Hành tím lột vỏ đập dập sơ, cho vào nước luộc chung với gà. Thêm nhiều đầu hành lá để nước dùng ngọt vị hơn. Luộc khoảng 30 phút gà chín mềm thì vớt ra, xé sợi. Nước luộc gà bạn nêm nếm cho vừa ăn. Khi dùng cho nui đã luộc vào tô, xếp thịt gà lên, chan nước dùng vào , rắc rau thơm đã cắt nhỏ, dùng khi còn nóng kết hợp với các loại rau đi kèm..","nutrition":{"kcal":455.6,"protein_g":22.1,"fat_g":11.6,"carbs_g":64.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6or03rgt8m18xin784z","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","quantity_zero_or_negative"],"integrity_findings":["quantity_zero_or_negative","ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03x1t8m1jntyljat#variant-1","name":"Phở bò viên","detail_name":"Phở bò viên","category":"Món nước 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"232.3 g / Tô nhỏ","quantity_value":232.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"140 g","quantity_value":140,"quantity_unit":"g"},{"name":"Giò bò","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Xương rửa sạch cho lên ninh cùng 1 chút muối. Nếu là xương bò thì nên nướng qua xương, sau đó luộc qua, đổ nước đầu đi rồi mới ninh tiếp. Ninh xương tối thiểu 6 tiếng (tối đa 12 tiếng) sẽ cho món nước dùng rất ngon. Có thể làm từ tối hôm trước, cho xương vào ninh để hôm sau có nồi nước dùng ngon. Bước 2: - Gừng, hành khô, quế, hồi, thảo quả nướng rồi đập dập, tất cả cho vào ninh cùng nồi nước xương. Khi gần được thì thêm 1 củ hành tây vào đun cùng tiếp. Khi nước dùng đã ninh xong thì thêm hạt nêm vừa ăn (chú ý hớt bỏ bọt trong quá trình ninh xương). Bước 3: Bò viên bỏ chung với nồi xương hầm, khi nào thấy chín vớt ra cắt làm đôi viên bò viên. Bánh phở chần qua nước sôi. Bước 4: Tất cả xếp vào bát, chan nước dùng, thêm chanh, ớt là có bát phở xịn sò tại gia.","nutrition":{"kcal":357.7,"protein_g":13.2,"fat_g":11.2,"carbs_g":51.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03x1t8m1jntyljat","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giò bò","ingredient_not_mentioned_by_name:Thịt bò loại 1","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Tương ngô","unlisted_ingredient_phrase:bo vien","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:xuong bo"],"source_categories":[{"label":"Món nước 6-7 tuổi","id":"mon_nuoc_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"so