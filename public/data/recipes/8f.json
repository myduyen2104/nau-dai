0.5,"fat_g":12.5,"carbs_g":88.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6or03s1t8m1pja00az0","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03wjt8m1il639w6x#variant-1","name":"Phở bò nạm gầu","detail_name":"Phở bò nạm gầu","category":"Món nước","age_group":null,"serving":{"raw":"427.7 g / Tô nhỏ","quantity_value":427.7,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"220 g","quantity_value":220,"quantity_unit":"g"},{"name":"Thịt bò loại 2","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Rau húng","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Bột ngọt (mì chính)","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Tương ớt","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Xương rửa sạch cho lên ninh cùng 1 chút muối. Nếu là xương bò thì nên nướng qua xương, sau đó luộc qua, đổ nước đầu đi rồi mới ninh tiếp. Ninh xương tối thiểu 6 tiếng (tối đa 12 tiếng) sẽ cho món nước dùng rất ngon. Có thể làm từ tối hôm trước, cho xương vào ninh để hôm sau có nồi nước dùng ngon. Bước 2: - Gừng, hành khô, quế, hồi, thảo quả nướng rồi đập dập, tất cả cho vào ninh cùng nồi nước xương. Khi gần được thì thêm 1 củ hành tây vào đun cùng tiếp. Khi nước dùng đã ninh xong thì thêm hạt nêm vừa ăn (chú ý hớt bỏ bọt trong quá trình ninh xương). Bước 3: Nạm, gầu bò rửa với muối, rửa sạchlại với nước, hầm chung với nồi xương hầm, khi nào thấy chín mềm vớt ra thái miếng vừa ăn. Hành, mùi tàu, rau mùi/húng rửa sạch, cắt ngắn. Bánh phở chần qua nước sôi. Bước 4: Tất cả xếp vào bát, chan nước dùng, thêm chanh, ớt là có bát phở xịn sò tại gia.","nutrition":{"kcal":551.4,"protein_g":26.4,"fat_g":14.6,"carbs_g":80},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03wjt8m1il639w6x","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt bò loại 2","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Tương ớt","ingredient_not_mentioned_by_name:Tương ngô","unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:voi nuoc","unlisted_ingredient_phrase:xuong bo"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72m047vt8m1hkjjoei3#variant-1","name":"ROHTO N21ĐẬU QUE LUỘC","detail_name":"ROHTO N21ĐẬU QUE LUỘC","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"80 g","quantity_value":80,"quantity_unit":"g","portion_label":null},"ingredients":nul