g","portion_label":"Chén"},"ingredients":[{"name":"Cá điêu hồng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dứa ta (thơm)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cần tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cà chua bạn rửa sạch, cắt múi cau. Rau cần cắt bỏ rễ, nhặt bỏ lá già úa, rửa sạch rồi cắt khúc. Cá diêu hồng bạn làm sạch mang, ruột, cạo vảy rồi rửa qua với nước. Tiếp đến, bạn lấy muối và chanh chà xát khắp mình và trong bụng cá, xả lại dưới vòi nước cho sạch. Cắt cá làm đôi, để ráo. Phi thơm tỏi bằm, cho cà chua thái múi cau vào xào sơ với ít gia vị vào. Cho nước vào vừa đủ rồi đun sôi, nêm lại gia vị vừa ăn. Rồi cho cá vào nấu chín, cho rau cần vào rồi tắt bếp. Múc canh ra bát.","nutrition":{"kcal":31.8,"protein_g":3.9,"fat_g":0.7,"carbs_g":2.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01tdt8m10xr8ohdb","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01vlt8m1bvdaef0h#variant-1","name":"Canh rau ngót","detail_name":"Canh rau ngót","category":"Món canh","age_group":null,"serving":{"raw":"27.7 g / Chén","quantity_value":27.7,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau ngót","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn), n