 cho vừa khẩu vị ăn của gia đình Đảo đều và sau đó cho ra đĩa.","nutrition":{"kcal":262.4,"protein_g":14.2,"fat_g":7.2,"carbs_g":35.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03lvt8m1qbi1hgtw","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Súp lơ xanh","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món chay","id":"mon_chay","kind":"food_category","baseLabel":"Món chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03mdt8m18qoeri5a#variant-1","name":"Mực lăn bột chiên","detail_name":"Mực lăn bột chiên","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"126 g / Dĩa vừa","quantity_value":126,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Mực tươi","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Bột mì","quantity_raw":"12 g","quantity_value":12,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":"Sơ chế mực bằng cách rút đầu và lấy mai mực, nội tạng bỏ đi sau đó bóc da mực. Rửa lại cho sạch rồi cắt mực thành các khoanh khoảng 2cm. Ướp gia vị Phần bột mì cho vào bát rồi thêm 1 xíu nước khuấy đều, thấy bột đặc sệt là được không nên pha loãng quá nhé. Đun nóng dầu, cho từng khoanh mực nhúng vào bát bột rồi cho vào dầu để chiên, đến khi vàng giòn thì vớt ra dĩa có giấy thấm dầu.","nutrition":{"kcal":200.3,"protein_g":17.6,"fat_g":11,"carbs_g":8.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03mdt8m18qoeri5a","quality_status":"complete","warnings":[],"integrity_findings":[],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_1