,"kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04vat8m1npuoo1xz#variant-1","name":"Sườn nấu đậu","detail_name":"Sườn nấu đậu","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"58.5 g / Dĩa nhỏ","quantity_value":58.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đậu trắng hạt (đậu tây)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Sườn heo cắt miếng 3cm, ướp với gia vị để thấm 45 phút. Khoai tây, cà rốt gọt vỏ, rửa sạch cắt khối 2cm. Cà chua bỏ hạt, bằm nhuyễn. Tỏi băm nhỏ. Đậu ngâm qua đêm hoặc ngâm cho đến khi hạt đậu nở gấp đôi. Rửa lại sạch, để ráo. Cho dầu ăn vào chảo, chiên sơ sườn. Xào cà chua: Tiếp tục cho tỏi vào phi vàng, cho cà chua vào xào chung cho đến khi cà chua mềm. Hầm hỗn hợp sườn đậu cà chua: Cho hỗn hợp cà chua vào nồi, cho sườn, đậu, cà rốt, khoai tây vào. Đổ nước dùng vào. Ninh cho đến khi cà rốt, khoai tây và đậu trắng mềm hẳn. Múc sườn nấu đậu ra tô, dùng với cơm hoặc bánh mì.","nutrition":{"kcal":180.4,"protein_g":7.6,"fat_g":13.7,"carbs_g":7.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04vat8m1npuoo1xz","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh mi","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:suon heo","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05g4t8m1lb7i3bhp#variant-1","name":"Trứng gà chiên thịt bằm","detail_name":"Trứng gà chiên thịt bằm","category":"Món mặn","age_group":null,"serving":{"raw":"120 g / Dĩa vừa","quantity_value":120,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Trứng gà đập ra tô. Thêm gia vị vào, khuấy đều. Thịt heo bằm cho ra chén. Hành lá cắt nhỏ. Phi thơm phần thân hành lá, cho thịt heo bằm vào, đảo đều 1 phút. Đổ trứng gà vào, tráng mỏng. Chiên nhỏ lửa cho trứng chín đều. Cuối cùng rắc thêm ít tiêu. Cho món ăn ra đĩa, dùng với cơm trắng.","nutrition":{"kcal":219,"protein_g":15.1,"fat_g":16.7,"carbs_g":2.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05g4t8m1lb7i3bhp","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Hạt nêm Knorr","ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:o trung","unlisted_ingredient_phrase:o trung ga"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05l2t8m14wj4ej4z#variant-1","name":"Vịt tần nấm sen","detail_name":"Vịt tần nấm sen","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"34 g / Dĩa nhỏ","quantity_value":34,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Sơ chế và ướp thịt vịt Thịt vịt mua về bạn rửa sạch, xoa bóp kỹ vịt với gừng cắt nhỏ và muối hạt. Sau đó bạn để yên 15 phút rồi rửa lại bằng nước sạch, chặt thịt vịt thành từng miếng vừa ăn, để ráo. Sơ chế các nguyên liệu khác Hạt sen và nấm đông cô rửa sạch, ngâm nước ấm khoảng 30 phút rồi vớt ra, để ráo. Hành tím, tỏi bạn bóc vỏ, cắt đôi. Gừng cạo vỏ, cắt lát mỏng. Hành lá rửa sạch, cắt khúc. Xào thịt vịt Cho vào nồi 1 muỗng canh dầu ăn, đun nóng rồi cho gừng, hành, tỏi vào phi cho thơm. Tiếp đến cho thịt vịt vào xào trên lửa lớn đến khi thịt vịt săn lại. Sau đó, nêm nước mắm, dầu hào, đường vàng, bột canh rồi đảo đều cho thịt thấm gia vị. Hầm thịt vịt cùng hạt sen nấm đông cô Cho vào nồi thịt vịt nước dừa tươi, nấu sôi sau đó hạ lửa nhỏ, đậy nắp nồi hầm khoảng 45 - 60 phút, trong thời gian hầm bạn nhớ hớt bọt thường xuyên để nước hầm được trong. Tiếp đến, cho hạt sen, nấm hương vào đảo đều. Đậy nắp hầm thêm 15 phút nữa rồi nêm nếm lại cho vừa ăn, cuối cùng rắc thêm hành lá và tắt bếp.","nutrition":{"kcal":85.8,"protein_g":4.3,"fat_g":6.4,"carbs_g":2.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05l2t8m14wj4ej4z","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot canh","unlisted_ingredient_phrase:dau hao","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05n0t8m18k6stffz#variant-1","name":"Xôi chiên phồng","detail_name":"Xôi chiên phồng","category":"Xôi","age_group":null,"serving":{"raw":"123 g / Dĩa vừa","quantity_value":123,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Gạo nếp cái","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"}],"instructions_raw":"Sơ chế nguyên liệu Bạn ngâm gạo nếp, đậu xanh trong 4 - 5 tiếng hoặc qua đêm cho nở mềm. Bạn có thể ngâm đậu với nước nóng trong vòng 2 - 3 giờ để rút ngắn thời gian. Hấp và nghiền đậu xanh Tiếp theo, bạn đem đậu xanh đi hấp trong 10 phút cho chín mềm và lấy ra tô lớn rồi dùng vá đánh nhuyễn đậu, bạn cũng có thể cho đậu vào máy xay sinh tố và xay nhuyễn để tiết kiệm thời gian thực hiện. Khi đậu được tán nhuyễn, bạn trộn đều đậu với nếp và cho 1 thìa đường vào trộn đều. Hấp xôi Bạn cho phần nếp đã trộn đều ở trên vào nồi, cho thêm nước cốt dừa và hấp trong vòng 40 phút để xôi chín mềm. Bạn nên tạo một lỗ ngay chính giữa để hơi nước thoát lên, giúp xôi chín đều và ngon hơn. Sau đó, bạn nhào xôi sao cho các hạt nhỏ dính đều vào nhau thành khối rồi cho từng chút dầu vào khối nếp, nhào và miết kỹ khoảng 10 phút cho đến khi khối xôi nếp dẻo, mềm, không dính tay là được. Ép xôi Bạn cho xôi vào khuôn và ép chặt, sau đó lấy xôi ra cho vào túi nilon và để trong ngăn đá tủ lạnh tầm 4 - 5 tiếng thì lấy ra, cắt xôi theo hình tròn để chiên. Nếu không có khuôn thì có thể ép bằng tay, bạn dùng bàn tay miết cho các hạt dẹp ra, kết dính với nhau. Chú ý miết kỹ để không bị hở bánh, làm bánh không phồng được. Chiên xôi Bạn đun sôi chảo dầu cho nóng, khi dầu sôi nóng già thì cho xôi sau khi được cắt vào chiên. Lưu ý, ban đầu xôi sẽ chìm, sau đó nổi lên thì bạn dùng vá ép xôi giúp xôi chiên phồng đều. Bạn chiên xôi phồng đến khi vàng đều thì vớt ra để ráo dầu.","nutrition":{"kcal":460.3,"protein_g":15,"fat_g":10.5,"carbs_g":77.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05n0t8m18k6stffz","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findin