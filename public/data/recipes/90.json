[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00mht8m1cnx8jjol#variant-1","name":"BBGP-18-24M-Cải thảo cà rốt xào","detail_name":"BBGP-18-24M-Cải thảo cà rốt xào","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"22.7 g","quantity_value":22.7,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Cải thảo","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":23.9,"protein_g":0.3,"fat_g":2,"carbs_g":1.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00mht8m1cnx8jjol","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00wvt8m1pfdukeao#variant-1","name":"Bún bò Huế","detail_name":"Bún bò Huế","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"354.5 g / Tô nhỏ","quantity_value":354.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"220 g","quantity_value":220,"quantity_unit":"g"},{"name":"Thịt bò loại 2","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Chân giò heo (lợn)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hoa chuối","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Sơ chế nguyên liệu Thịt và xương bò thì nên rửa qua với nước muối rồi đến nước giấm, sau đó xả thật sạch dưới nước để khử hoàn toàn mùi hôi của thịt bò, để ráo. Phần bắp bò, bạn cuộn lại rồi dùng sợi chỉ buộc lại. Giò heo: cạo lông, rửa sạch, cho vào nồi nước, ninh đến khi da heo trong là được, tắt bếp, vớt ra. Bạn có thể cho vào một tí muối để luộc cùng. Các loại rau: nhặt bỏ phần hư, rửa sạch, để ráo. Ớt tươi: cắt nhỏ, cho vào nước mắm. Hành lá: cắt lấy phần đầu hành trắng, sắt sợi nhỏ. Củ hành trắng sắt mỏng. Rau răm sắt vừa phải cỡ 2/3 ngón tay út. Sả và gừng thì đập dập, rửa sạch. Huyết: nấu nồi nước sôi và cho phần huyết vào luộc cùng với ít muối, đường. Khi nào huyết đông, bạn dùng đũa đâm mà không thấy nước màu hồng chảy ra là được. Vớt ra, ngâm trong nước lạnh, rồi cắt thành miếng vừa ăn. Pha phần mắm ruốc Huế với ½ chén nước, khuấy đều. Bước 2: Ướp thịt Bạn ướp tất cả các thịt theo công thức sau: 2 muỗng canh đường + 1 muỗng canh muối + ½ muỗng canh bột ngọt + 1 muỗng canh mắm ruốc đã pha + 2 muỗng canh hành tím băm + 2 muỗng canh tỏi băm + 2 muỗng canh sả băm. Bước 3: Hầm thịt và xương Bắc nồi lên bếp, cho 3 cây sả và ½ lượng gừng vào đáy nồi trước rồi mới cho xương và thịt giò heo vào, đổ vào lượng nước xâm xấp vừa ngập mặt thịt, đậy nấp, đun cho sôi. Khi thấy nồi sôi già thì hạ lửa nhỏ để liu riu thêm vài phút, tắt bếp. Vớt giò heo ra ngâm trong thau nước lạnh cho thịt săn chắc. Với phần bắp bò, nạm bò và gân bò thì bạn cũng hầm tương tự như xương và giò heo với lượng sả và gừng còn lại. Lưu ý: vì thịt bò và thịt heo có độ dai khác nhau nên vì vậy phải hầm 2 loại thịt này riêng. Bước 4: Nấu nước dùng bún bò Huế miền nam Cho 2 loại nước hầm ban nãy vào chung 1 nồi lớn và cho thêm lượng nước vào sao cho đủ khoảng 5 lít nước, đun cho sôi rồi nêm nếm gia vị theo tỉ lệ sau: 3 muỗng canh nước mắm + 2 muỗng canh muối + 2 muỗng canh đường + 2 muỗng café bột ngọt + chén mắm ruốc Huế đã pha loãng. Sau cùng bạn cho huyết heo, chả vào nồi nước. Đợi cho sôi là bạn đã nước dùng cho món bún bò của mình. Nếu bạn muốn nước dùng của mình có màu đẹp hơn thì có thể thực hiện thêm bước sau: Cho sả băm + tỏi băm vào chảo dầu nóng phi cho thơm rồi thêm vào màu điều, đảo nhanh đều tay thì tắt bếp. Cho phần này vào nồi nước dùng đang nấu. Bước 5: Trình bày món ăn Trụng bún qua nước sôi rồi cho vào bát, xếp thịt, gân, chả, giò, rắc ít rau ngò và chan nước dùng vào. Dọn kèm rau muống chẻ, bắp chuối bào, giá, rau thơm, chanh ớt, sa tế…","nutrition":{"kcal":459.1,"protein_g":18.2,"fat_g":14.5,"carbs_g":64.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00wvt8m1pfdukeao","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:cha gio","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:mam ruoc","unlisted_ingredient_phrase:mam ruoc hue","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:nuoc mau","unlisted_ingredient_phrase:rau ngo","unlisted_ingredient_phrase:rau ram","unlisted_ingredient_phrase:ruoc hue","unlisted_ingredient_phrase:thit heo","unlisted_ingredient_phrase:thit va","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:uop thit","unlisted_ingredient_phrase:voi nuoc","unlisted_ingredient_phrase:x