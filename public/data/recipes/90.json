quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Lươn làm hết nhớt, rửa sạch để ráo, xắt khúc khoảng 4 cm. Ướp thịt lươn với gia vị. Nghệ củ gọt vỏ, xắt sợi. Hành củ bóc vỏ, rửa sạch, băm nhuyễn Cho nồi lên bếp, đổ dầu vào, bật bếp, phi thơm hành, cho gừng vào đảo qua. Cho lươn vào, đảo đều rồi cho nước vào. Nêm gia vị rồi đun nhỏ lửa tới khi lươn chín, nước gần cạn thì tắt bếp, xếp lươn ra đĩa ăn cùng cơm trắng.","nutrition":{"kcal":151.2,"protein_g":15.1,"fat_g":4.3,"carbs_g":13.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oo038yt8m1tlbsjxvr","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03hft8m1qdogits0#variant-1","name":"Mì ý sốt bò bằm","detail_name":"Mì ý sốt bò bằm","category":"Món khô 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"205 g / Dĩa nhỏ","quantity_value":205,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Mì Spaghetti, khô","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, bằm nhỏ, ướp gia vị. Cà chua rửa sạch, cắt đôi bỏ hạt và cho vào máy xay sinh tố xay nhuyễn. Hành tây lột vỏ, rửa sạch, băm nhỏ. Hành củ và tỏi bạn bóc vỏ, rửa sạch và băm nhỏ. Rau mùi bỏ rễ, rửa sạch. Dưa chuột rửa sạch, cắt lát mỏng. Sà lách rửa sạch, để ráo. Mì spaghetti luộc chín, vớt ra để ráo. Khi luộc thêm chút dầu ăn cho mì không bị dính. Bắc chảo lên bếp, cho 1 xíu dầu ăn cho nóng và cho hành củ, tỏi đã băm nhuyễn vào phi cho thơm. Cho hành tây vào đảo đều cho tới khi hành chín ngả màu hơi trong. Tiếp tục cho sốt cà chua vào cùng với 1 xíu muối, nấu cho hỗn hợp sốt hơi sền sệt thì cho thịt bò vào đảo đều cho thịt tơi ra. Nếu thấy hỗn hợp sốt bây giờ bị đặc lại thì bạn có thể thêm vào chút nước. Thịt bò chín và gia vị vừa ăn, rắc thêm 1 ít hạt tiêu và tắt bếp nhé. Xếp sà lách, dưa leo, mì ra đĩa và rưới sốt cà chua thịt bò lên trên. Trộn đều là có thể thưởng thức ngay.","nutrition":{"kcal":352.6,"protein_g":17.4,"fat_g":9.6,"carbs_g":48.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03hft8m1qdogits0","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hanh cu","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:sot ca chua"],"source_categories":[{"label":"Món khô 6-7 tuổi","id":"mon_kho_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03wut8m1gv9jx8q1#variant-1","name":"Phở bò tái gầu","detail_name":"Phở bò tái gầu","category":"Món nước 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"256.5 g / Tô nhỏ","quantity_value":256.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt bò loại 2","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Xương rửa sạch cho lên ninh cùng 1 chút muối. Nếu là xương bò thì nên nướng qua xương, sau đó luộc qua, đổ nước đầu đi rồi mới ninh tiếp. Ninh xương tối thiểu 6 tiếng (tối đa 12 tiếng) sẽ cho món nước dùng rất ngon. Có thể làm từ tối hôm trước, cho xương vào ninh để hôm sau có nồi nước dùng ngon. Bước 2: - Gừng, hành khô, quế, hồi, thảo quả nướng rồi đập dập, tất cả cho vào ninh cùng nồi nước xương. Khi gần được thì thêm 1 củ hành tây vào đun cùng tiếp. Khi nước dùng đã ninh xong thì thêm hạt nêm vừa ăn (chú ý hớt bỏ bọt trong quá trình ninh xương). Bước 3: Gầu bò rửa với muối, rửa sạch lại với nước, hầm chung với nồi xương hầm, khi nào thấy chín mềm vớt ra thái miếng vừa ăn. Bắp bò rửa sạch thái lát mỏng vừa ăn. Hành, mùi tàu, rau mùi/húng rửa sạch, cắt ngắn. Bánh phở chần qua nước sôi. Bước 4: Tất cả xếp vào bát, chan nước dùng. Lưu ý nước lèo phải thật sôi để khi chan vào đảm bảo tái bắp bò sẽ chín.","nutrition":{"kcal":365.1,"protein_g":15,"fat_g":9.9,"carbs_g":55.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03wut8m1gv9jx8q1","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt bò loại 1","ingredient_not_mentioned_by_name:Thịt bò loại 2","ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Chanh","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Tương ngô","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mui tau","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:voi nuoc","unlisted_ingredient_phrase:xuong bo"],"source_categories":[{"label":"Món nước 6-7 tuổi","id":"mon_nuoc_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04v2t8m1d49rm07k#variant-1","name":"Sườn heo nấu ragu","detail_name":"Sườn heo nấu ragu","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"47 g / Dĩa nhỏ","quantity_value":47,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Sườn heo (lợn)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantit