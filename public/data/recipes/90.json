 khẩu vị. Cuối cùng cho cần tây vào đảo đều rồi tắt bếp.","nutrition":{"kcal":90.7,"protein_g":7.3,"fat_g":5.6,"carbs_g":3.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw014mt8m1gs6ou34l","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá chim","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","title_ingredient_not_mentioned:Cá chim","unlisted_ingredient_phrase:can tay"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw019tt8m1u4x7e3pp#variant-1","name":"Cá ngừ kho thơm","detail_name":"Cá ngừ kho thơm","category":"Món mặn","age_group":null,"serving":{"raw":"146.5 g / Dĩa nhỏ","quantity_value":146.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá ngừ","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Dứa ta (thơm)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Ớt khô bột","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1.5 g","quantity_value":1.5,"quantity_unit":"g"}],"instructions_raw":"Cá mua về rửa sạch, cắt khoanh. Dứa gọt vỏ bỏ mắt rửa sạch, cắt khúc vừa ăn. Tỏi ta, hành củ tươi bóc vỏ rửa sạch bằm nhuyễn. Hành lá rửa sạch bỏ rễ, cắt nhỏ. Bắc chảo dầu nóng chiên sơ cá. Đặt 1 cái nồi cho đường và nước vào đun sôi nhỏ lửa đến khi đường có màu vàng cánh gián thì tắt bếp. Tiếp theo đó xếp cá và dứa vào nồi cùng với hành củ tươi và tỏi ta đã băm nhuyễn vào cùng. Sau đó nêm gia vị vừa ăn, kho cá trên lửa nhỏ đến khi cá có màu nâu thì cho thêm ớt bột và hành lá vào và tắt bếp. Múc cá ra dĩa rắc thêm ít tiêu lên bề mặt.","nutrition":{"kcal":145,"protein_g":17.7,"fat_g":5.3,"carbs_g":7.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw019tt8m1u4x7e3pp","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá ngừ","ingredient_not_mentioned_by_name:Nước mắm cá","title_ingredient_not_mentioned:Cá ngừ","unlisted_ingredient_phrase:uong co"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01pht8m1ptawhkeb#variant-1","name":"canh khổ qua thịt heo","detail_name":"canh khổ qua thịt heo","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"142.6 g","quantity_value":142.6,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Khổ qua (mướp đắng)","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.3 g","quantity_value":0.3,"quanti