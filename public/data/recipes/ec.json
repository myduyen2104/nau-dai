 kính"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gi05dqt8m138hs4zmg#variant-1","name":"Trứng chiên cà chua","detail_name":"Trứng chiên cà chua","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"65 g / Dĩa nhỏ","quantity_value":65,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng gà ta (35g/quả)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cà chua cắt múi cau. Hành lá cắt nhỏ. Trứng cho vào chén đánh tan cùng hạt nêm. Đun nóng dầu ăn trong chảo, cho trứng vào chiên chín khoảng 80% thì cho ra đĩa. Cho cà chua và muối vào, đảo đều cho cà chua chín mềm và ra nước thì trút trứng trở lại chảo, xóc đều lên. Rắc thêm hành lá, chiên khoảng 2-3 phút nữa là được. Cho trứng chiên cà chua ra đĩa, dùng với cơm nóng rất ngon.","nutrition":{"kcal":76.4,"protein_g":4.1,"fat_g":6.2,"carbs_g":1.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05dqt8m138hs4zmg","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà ta (35g/quả)","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat nem"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"}]