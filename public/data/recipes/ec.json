.7,"protein_g":11.9,"fat_g":8,"carbs_g":7.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03v9t8m1rdlhi8vk","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hat nem"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03x3t8m1gxr8jm5m#variant-1","name":"Phở bò viên","detail_name":"Phở bò viên","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"324.5 g / Tô nhỏ","quantity_value":324.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"170 g","quantity_value":170,"quantity_unit":"g"},{"name":"Giò bò","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau ngổ","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau húng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Xương rửa sạch cho lên ninh cùng 1 chút muối. Nếu là xương bò thì nên nướng qua xương, sau đó luộc qua, đổ nước đầu đi rồi mới ninh tiếp. Ninh xương tối thiểu 6 tiếng (tối đa 12 tiếng) sẽ cho món nước dùng rất ngon. Có thể làm từ tối hôm trước, cho xương vào ninh để hôm sau có nồi nước dùng ngon. Bước 2: - Gừng, hành khô, quế, hồi, thảo quả nướng rồi đập dập, tất cả cho vào ninh cùng nồi nước xương. Khi gần được thì thêm 1 củ hành tây vào đun cùng tiếp. Khi nước dùng đã ninh xong thì thêm hạt nêm vừa ăn (chú ý hớt bỏ bọt trong quá trình ninh xương). Bước 3: Bò viên bỏ chung với nồi xương hầm, khi nào thấy chín vớt ra cắt làm đôi viên bò viên. Bánh phở chần qua nước sôi. Bước 4: Tất cả xếp vào bát, chan nước dùng, thêm chanh, ớt là có bát phở xịn sò tại gia.","nutrition":{"kcal":446.8,"protein_g":14.9,"fat_g":14.5,"carbs_g":65.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03x3t8m1gxr8jm5m","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giò bò","ingredient_not_mentioned_by_name:Rau thơm","ingredient_not_mentioned_by_name:Rau mùi tàu/ Ngò gai","ingredient_not_mentioned_by_name:Rau ngổ","ingredient_not_mentioned_by_name:Rau húng","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Tương ngô","unlisted_ingredient_phrase:bo vien","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:xuong bo"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh058xt8m1g151ip82#variant-1","name":"Thịt heo xào hạt điều","detail_name":"Thịt heo xào hạt điều","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"72.2 g / Dĩa nhỏ","quantity_value":72.2,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hạt điều","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ớt xanh to","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Thịt heo rửa sạch ướp gia vị. Ớ xanh, ớt đỏ rửa sạch cắt khúc vừa ăn. Hành tây gọt vỏ rửa sạch, bổ múi cau. Tỏi ta lột vỏ rửa sạch băm nhuyễn. Bắt 1 chảo nóng phi thơm tỏi, cho thêm thịt vào xào đều cùng gia vị, thêm hạt điều rang vào xào cho ngấm gia vị. Đến khi thịt mềm cho thêm hành tây đã cắt vừa ăn vào nấu chín đều tất cả . Sau đó pha bột bắp với nước sôi để nguội cho vào chảo thịt. Sau cùng tắt bếp rắc thêm tiêu vào.","nutrition":{"kcal":200.6,"protein_g":6.8,"fat_g":14.8,"carbs_g":10.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh058xt8m1g151ip82","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_ph