ity_unit":"g"}],"instructions_raw":"Cải thảo rửa sạch, cắt miếng vừa ăn. Thịt cắt miếng nhỏ hoặc bằm, xay tuỳ thích rồi ướp gia vị. Bắt nồi lên bếp, cho dầu ăn và bỏ thịt vào xào. Sau đó cho nước lọc vào Nước sôi lần nữa cho cải thảo vào, sôi lên lại nêm nếm cho vừa khẩu vị nha, tắt bếp.","nutrition":{"kcal":56.2,"protein_g":2.5,"fat_g":4.5,"carbs_g":1.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01lkt8m1uq25usxi","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Hành lá (hành hoa)","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nuoc loc"],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01put8m1m1gfpugk#variant-1","name":"Canh khoai mỡ nấu tôm","detail_name":"Canh khoai mỡ nấu tôm","category":"Món canh từ 18-24 tháng tuổi","age_group":"18-24 tháng","serving":{"raw":"25.5 g / Chén","quantity_value":25.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Khoai mỡ (củ cái)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Khoai mỡ gọt vỏ, rửa sạch, bào mỏng Tôm tươi bóc vỏ, băm nhỏ, ướp chút gia vị, Bắt nồi lên cho nước vào đun sôi, nước sôi cho tôm vào tiếp đó cho khoai mỡ vào hầm nhừ khoảng 10 phút. Khi canh khoai mỡ đã nhừ, dùng muỗng canh tán thêm cho nhuyễn, nêm nếm vừa ăn. Tắt bếp.","nutrition":{"kcal":31.3,"protein_g":1.5,"fat_g":0.1,"carbs_g":6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01put8m1m1gfpugk","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh từ 18-24 tháng tuổi","id":"mon_canh_tu_18_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"18-24 tháng","id":"18_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01tlt8m1qqexp7ql#variant-1","name":"Canh rau đay","detail_name":"Canh rau đay","category":"Món canh chay","age_group":null,"serving":{"raw":"171.5 g / Chén","quantity_value":171.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau đay","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Rau đay lặt ngọn và lá non, rửa rau thật sạch, để ra rổ cho ráo. Đậu hũ xắt lát dài, dày 5mm, chiên vàng, xắt nhỏ. Làm nóng dầu trong nồi, phi thơm hành. Chođậu hũ vào xào thấm dầu, nêm chút muối + hạt nêm, để một lúc cho đậu hũ thấm gia vị. Thêm nước vào nồi canh, nấu sôi, nêm nếm lại cho vừa ăn. Vò rau đay cho giập, thả vào nồi canh, canh vừa sôi lại thì bắc nồi xuống ngay.","nutrition":{"kcal":65.9,"protein_g":6.4,"fat_g":1.4,"carbs_g":7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01tlt8m1qqexp7ql","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","unlisted_ingredient_phrase:hat nem"],"source_categories":[{"label":"Món canh chay","id":"mon_canh_chay","kind":"food_category","baseLabel":"Món canh chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01y4t8m17s128s83#variant-1","name":"Canh súp lơ, cà rốt","detail_name":"Canh súp lơ, cà rốt","category":"Món canh chay","age_group":null,"serving":{"raw":"121.5 g / Chén","quantity_value":121.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cà rốt","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Súp lơ trắng","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Chuẩn bị một nồi nước, cho muối, hành tím bổ đôi vào. Gọt vỏ, rửa sạch cà rốt, cắt cà rốt theo ý thích song không cắt quá nhỏ. Cho cà rốt vào nồi, nấu tiếp khoảng 15 phút. Đậu phụ rửa sạch, thái miếng vuông. Cho súp lơ xanh và đậu hũ vào sau cùng, nấu khoảng 3 phút. Nêm nếm đến khi canh vừa miệng.","nutrition":{"kcal":59.9,"protein_g":4.2,"fat_g":1.3,"carbs_g":7.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01y4t8m17s128s83","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Súp lơ trắng","unlisted_ingredient_phrase:lo xanh","unlisted_ingredient_phrase:sup lo xanh"],"source_categories":[{"label":"Món canh chay","id":"mon_canh_chay","kind":"food_category","baseLabel":"Món canh chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt021tt8m1i47evcwy#variant-1","name":"Cháo cá diêu hồng cà chua","detail_name":"Cháo cá diêu hồng cà chua","category":"Cháo 9-12 tháng tuổi","age_group":"9-12 tháng","serving":{"raw":"92 g / Chén","quantity_value":92,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Cá nạc/cá thác lác","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"7 g","quantity_value":7