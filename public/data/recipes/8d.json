s":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Pho mát","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:pho mai"],"source_categories":[{"label":"Cháo 13-24 tháng tuổi","id":"chao_13_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"13-24 tháng","id":"13_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02hqt8m1rabj03rf#variant-1","name":"Cơm tấm sườn","detail_name":"Cơm tấm sườn","category":"Cơm","age_group":null,"serving":{"raw":"251 g / Dĩa nhỏ","quantity_value":251,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Sườn heo (lợn)","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Sườn cốt lếch rửa sạch, để ráo ướp gia vị, nướng chín. Hành tím đem bóc vỏ và băm nhuyễn. Cà chua dưa chuột rửa sạch, cắt lát mỏng. Cà rốt, củ cải gọt vỏ, rửa sạch, bào sợi, ngâm chua ngọt. Gạo vo sạch nấu săm sắp mặt nước. Nấu cơm trong 30 phút. Cơm chín. Hành lá bỏ gốc, rửa sạch, cắt nhỏ, phi thơm với dầu ăn. Nước mắm pha với đường và chanh để tạo hỗn hợp nước mắm vừa ăn. Múc cơm ra đĩa, rưới mỡ hành lên, thêm sườn, rưới nước mắm pha lên trên. Ăn kèm với cà chua, dưa leo, cà rốt, củ cải ngâm chua ngọt.","nutrition":{"kcal":443.1,"protein_g":21,"fat_g":12.1,"carbs_g":62.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02hqt8m1rabj03rf","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:chua ngot","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:mam pha","unlisted_ingredient_phrase:ngam chua","unlisted_ingredient_phrase:ngam chua ngot","unlisted_ingredient_phrase:nuoc mam pha","unlisted_ingredient_phrase:pha voi"],"source_categories":[{"label":"Cơm","id":"com","kind":"food_category","baseLabel":"Cơm"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02lht8m1xf8sv3wy#variant-1","name":"Đậu hủ kho thịt ba chỉ","detail_name":"Đậu hủ kho thịt ba chỉ","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"42 g / Dĩa nhỏ","quantity_value":42,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Đậu phụ chiên","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Đậu hũ rửa sạch, để ráo, cắt thành khối vuông nhỏ vừa ăn. Hành , tỏi làm sạch, băm nhỏ. Thịt rửa sạch, để ráo rồi cắt miếng mỏng vừa ăn. Ướp thịt với gia vị, hành và tỏi băm. Đảo đều cho thịt thấm gia vị. Ướp thịt khoảng 30 - 40 phút. Bắc chảo lên bếp, bật bếp lửa vừa, cho đậu vào chiên ngập dầu. Chiên cho đậu vàng đều các mặt thì vớt ra, để ráo bớt dầu. Bắc nồi lên bếp, cho dầu ăn vào nồi, làm nóng dầu với lửa vừa rồi cho phần hành băm còn lại vào phi thơm. Khi hành vàng thơm thì vớt hành cho vào tô thịt, trộn đều lên. Cho tiếp vào nồi đường, nấu lửa vừa và đảo đều cho đường tan ra, có màu vàng nâu đẹp mắt thì giảm lửa nhỏ nhất, cho phần tỏi băm còn lại vào phi thơm. Cho thịt đã ướp vào xào săn lại, cho thêm nước vào nồi cho nước xấp xấp thịt. Kho thịt được khoảng 15 phút, nước bắt đầu cạn và thịt sắp chín thì cho đậu hũ vào, đảo đều. Tắt bếp.","nutrition":{"kcal":93.8,"protein_g":5.9,"fat_g":6.6,"carbs_g":2.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02lht8m1xf8sv3wy","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:noi lam","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02qxt8m1mdoi91cx#variant-1","name":"Ếch tần hạt sen","detail_name":"Ếch tần hạt sen","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"57.1 g / Dĩa nhỏ","quantity_value":57.1,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Ếch ( thịt đùi)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Tôm khô","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Rượu trắng (cồn 39 g)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nghệ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"\"Gừng cạo, rửa sạch, giã nhỏ, trộn với rượu. Nghệ cạo vỏ, rửa sạch, giã nhỏ, cho vào 1 thìa nước. Ếch rửa sạch, rạch sống lưng, lột da, mổ bỏ ruột, rứa sạch, chặt mỗi con làm 7 miếng, tẩm rượu, gừng rồi bỏ gia vị vào bóp kỹ, ướp 15 phút. Hạt sen tươi luộc chín. Tôm khô bóc vỏ, rứa sạch, để ráo. Hành khô bóc vỏ, đập giập. \"Cho dầu vào chảo, đun nóng già, bỏ hành củ vào phi thơm, trút thịt ếch vào xào cho ngấm gia vị, cho tôm vào xào cùng, đảo đều, khi tôm chín mềm xúc ra bát. Múc ếch đã xào với tôm cho vào nồi nước dùng nấu với hạt sen, đun nhỏ lửa.Tần như vậy chừng 35-45 phút, thịt ếch và hạt sen chín nhừ, nước cạn sánh, nêm nếm lại vừa ăn là được. Múc tất cả ra bát to, rắc thêm rất ít tiêu.","nutrition":{"kcal":92.5,"protein_g":8.8,"fat_g":3.5,"carbs_g":3.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02qxt8m1mdoi91cx","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:nuoc dung"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"