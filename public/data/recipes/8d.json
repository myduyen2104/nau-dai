ón này ăn nóng mới nóng","nutrition":{"kcal":247.4,"protein_g":11.6,"fat_g":15.6,"carbs_g":15.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05jet8m1pfwo10qq","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Gừng tươi","ingredient_not_mentioned_by_name:Tỏi ta","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nac dam","unlisted_ingredient_phrase:rau ngo","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]