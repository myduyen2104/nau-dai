 ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cá ngừ rửa sạch với nước, cắt khoanh vừa ăn. Đặt chảo dầu nóng sau đó cho cá vào chiên vàng đều 2 mặt. Pha hỗn hợp nước chấm gồm chanh, đường, nước mắm, và nước sôi để nguội. Khuấy đều hỗn hợp cho tan đường, nếm lại cho vừa ăn. Cá sau khi chiên vàng đều 2 mặt tắt bếp múc ra dĩa, cùng hỗn hợp nước chấm là có thể dùng được.","nutrition":{"kcal":145.9,"protein_g":21.2,"fat_g":5.3,"carbs_g":3.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw019ct8m13sb5yngv","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tỏi ta","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01ckt8m12xr4z3wp#variant-1","name":"Cá thu kho thịt ba chỉ","detail_name":"Cá thu kho thịt ba chỉ","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"87.5 g / Dĩa vừa","quantity_value":87.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cá thu","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm