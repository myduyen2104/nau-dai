lue":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Mực rửa sạch để ráo cắt miếng vừa ăn. Cà chua rửa sạch cắt múi cau. Hành tây lột vỏ, rửa sạch cắt múi cau. Ớt vàng to và ớt đỏ to rửa sạch cắt vừa ăn. Tỏi ta lột vỏ rửa sạch băm nhỏ. Hành lá, rau mùi rửa sạch bỏ rể cắt vừa ăn. Đặt 1 cái chảo phi thơm tỏi rồi cho cà chua vào xào đều, cho thêm ớt vàng và ớt đỏ vào xào đều. Sau đó cho mực vào cùng gia vị xào nhanh tay cho mực chín nêm nếm cho vừa ăn. Cho tiếp hành tây, hành lá và rau mùi vào xào tiếp. Sau đó tắt bếp , rắc thêm tiêu lên bề mặt.","nutrition":{"kcal":144,"protein_g":14.2,"fat_g":5.9,"carbs_g":9.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03n8t8m1t4bpcx9q","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03p3t8m193g3z4b5#variant-1","name":"Nấm xào sả ớt","detail_name":"Nấm xào sả ớt","category":"Món chay","age_group":null,"serving":{"raw":"201 g / Dĩa nhỏ","quantity_value":201,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Nấm hương tươi","quantity_raw":"150 g","quan