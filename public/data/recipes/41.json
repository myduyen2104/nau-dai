a của mẻ, vừa ăn.","nutrition":{"kcal":300.8,"protein_g":12.9,"fat_g":11.4,"carbs_g":36.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00yct8m1t2kn977g","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá trê","ingredient_not_mentioned_by_name:Giấm","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô 5 tuổi","id":"mon_kho_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw0179t8m1z1auypje#variant-1","name":"Cá kèo kho rau răm","detail_name":"Cá kèo kho rau răm","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"72 g / Dĩa nhỏ","quantity_value":72,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá bống","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước dừa non tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cá mua về rửa sạch lại với muối cho hết nhớt, ướp với gia vị trong 30 phút. Rau răm rửa sạch nhặt bỏ lá vàng úa. Hành củ tươi, tỏi lột vỏ rữa sạch băm nhuyễn. Thịt ba rọi rửa sạch cắt mỏng. Bắc nồi lên bếp cho nước và đường vào đun nhỏ lửa đến khi đường tan 