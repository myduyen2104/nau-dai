ame":"Thịt heo (lợn) nạc","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Dưa cải bẹ","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước dừa non tươi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Ớt khô bột","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Thịt rửa sạch và thấm khô, thái miếng vuông vừa ăn. Hành băm nhuyễn, tỏi bóc vỏ để nguyên tép. Cà chua rửa sạch, bổ múi cau. Cho thịt vào nồi, bật bếp lửa vừa, chiên sơ qua cho thịt sém vàng và ra bớt mỡ. Sau đó gạt thịt sang 1 góc chảo, cho hành băm, tỏi xào cho thơm rồi cho nước màu vào, đảo đều. Tiếp đến bạn cho nước tương, gia vị vào đảo đều cho thịt thấm gia vị rồi cho dưa chua, cà chua lên trên. Thêm nước xâm xấp mặt thịt và kho cho đến khi thịt cạn nước là được.","nutrition":{"kcal":303.9,"protein_g":13.4,"fat_g":24.3,"carbs_g":8.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh0564t8m1jn3nvqfq","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:nuoc mau","unlisted_ingredient_phrase:nuoc tuong","unlisted_ingredient_phrase:thit va"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05ngt8m14l9wq0jh#variant-1","name":"Xôi gấc","detail_name":"Xôi gấc","category":"Xôi (18 tháng trở lên)","age_group":"18 tháng","serving":{"raw":"178 g / Dĩa nhỏ","quantity_value":178,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Gạo nếp cái","quantity_raw":"119.5 g","quantity_value":119.5,"quantity_unit":"g"},{"name":"Gấc","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Rượu trắng (cồn 39 g)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Gạo nếp cho ra thau, đổ nước ấm ngập mặt gạo và đậu. Ngâm trong vòng 4-5 tiếng (hoặc trước khi đi ngủ ngâm gạo đỗ, sáng hôm sau nấu), tùy theo nếu có thời gian, còn nếu không thì 3 tiếng cũng được. Trái gấc bạn bổ đôi, sau đó dùng muỗng nạo lấy thịt gấc cho vào chén sạch. Tiếp theo, bạn cho một ít rượu trắng vào chén gấc, đeo bao tay vào và bóp nhẹ nhàng để tách thịt ra khỏi hạt. Lúc này, bạn loại bỏ phần hạt đen đi và giữ lại thịt gấc đỏ để nấu cùng với nếp thành món xôi gấc. Gạo nếp sau khi ngâm và gấc đã tách thịt, bạn trộn nếp và gấc vào với nhau, thêm 1 chút muối. Trộn nhẹ nhàng và đều tay cho đến khi nếp được nhuộm một màu đỏ au bóng bẩy của gấc. Cho nước sôi và nước cốt dừa vào xâm xấp mặt gạo và gấc đã trộn đều vào nồi cơm điện, bật nút nấu chín. Sau khi cạn nước nồi cơm điện sẽ chuyển qua chế độ hâm nóng bạn cứ để như vậy khoảng 10 phút thì bật lại nút nấu. Nồi cơm điện sẽ chuyển qua chế độ nấu lần 2. Bạn để như vậy 30 phút sau thì xôi chín.","nutrition":{"kcal":598.6,"protein_g":12,"fat_g":13.8,"carbs_g":104.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05ngt8m14l9wq0jh","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:xoi gac"],"source_categories":[{"label":"Xôi (18 tháng trở lên)","id":"xoi_18_thang_tro_len","kind":"age_scoped_food_category","baseLabel":"Xôi"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"}]