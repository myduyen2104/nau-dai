raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Bí đỏ (bí ngô)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"}],"instructions_raw":"Bồ câu làm sạch, băm nhuyễn. Hạt sen tách bỏ tim (nếu có), rửa sạch, luộc chín, tán nhuyễn. Bí đỏ gọt vỏ, bỏ hột, rửa sạch, luộc chín, tán nhuyễn. Hòa tan bột gạo, bồ câu với nước, bắc lên bếp khuấy đều cho đến khi sôi, tắt bếp. Thêm bí đỏ, hạt sen khuấy đều. Thêm dầu thực vật khuấy đều. Thêm dầu ăn vào khuấy đều","nutrition":{"kcal":180.8,"protein_g":6.1,"fat_g":7.6,"carbs_g":22},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00spt8m193run3bw","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bí đỏ (bí ngô)","unlisted_ingredient_phrase:dau thuc","unlisted_ingredient_phrase:dau thuc vat","unlisted_ingredient_phrase:hat sen","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:thuc vat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ 9-24 tháng","id":"mon_bot_nha_nau_cho_tre_9_24_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"9-24 tháng","id":"9_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv010ut8m1b4dsvyz3#variant-1","name":"Bún riêu cua","detail_name":"Bún riêu cua","category":"Món nước","age_group":null,"serving":{"raw":"246 g / Tô vừa","quantity_value":246,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bún tươi","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Chả quế heo (lợn)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cua đồng","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hoa chuối","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sơ chế nguyên liệu Đậu hũ cắt thành những khối vuông nhỏ và mang đi chiên vàng. Hành lá rửa sạch, phần lá cắt khúc, phần đầu băm nhuyễn. Cà chua rửa sạch, cắt miếng vừa ăn, xào sơ chín. Ngò rửa sạch, cắt khúc. Hành tím, tỏi bỏ vỏ, băm nhuyễn. Rau ăn kèm rửa sạch và để ráo. Chế biến cua đồng Cua ngâm nước khoảng 1 – 2 giờ để loại bỏ hết đất cát, rửa lại nhiều lần cho thật sạch. Lột yếm cua, mai cua để riêng. Dùng muỗng nạo lấy phần gạch cua cho vào chén, ướp với một ít tiêu xay, hạt nêm. Mai cua đem đi xay nhuyễn. Nấu nước dùng và làm riêu cua Cho cua vừa xay ở bước trên vào một cái âu lớn rồi hòa với ít nước, dùng tay bóp nhẹ cho thịt cua tan vào nước. Dùng ray lọc nước cua trước khi cho vào nồi. Cứ thế lặp đi lặp lại hai bước này đến khi bạn thấy lượng nước đã đủ để nấu bún và trong âu chỉ còn lại vỏ cua cứng ráp là được. Nêm 2 muỗng canh mắm tôm, 1 muỗng cà phê hạt nêm vào nồi nước cua vừa lọc rồi đặt lên bếp đun ở lửa vừa. Chú ý không để lửa to quá, gạch cua rất dễ bị cháy hoặc trào ra ngoài. Khuấy đều tay để riêu cua kết lại và vớt ra tô để riêng. Tiếp tục cho cà chua đã xào sơ 1 vào nồi nước cua, nêm nếm lại cho vừa ăn rồi cứ tiếp tục đun với lửa nhỏ. Nấu bún riêu cua Dùng chảo vừa xào cà chua phi thơm hành tím băm nhuyễn, sau đó cho phần gạch cua đã chuẩn bị ở bước 1 vào đảo đều và tắt bếp. Phần này bạn có thể cho luôn vào nồi nước riêu cua để tạo màu hoặc cho riêng vào từng tô khi ăn đều được. Nếu cho gạch cua xào vào nồi nước dùng, bạn chỉ cần nấu thêm 3 – 5 phút là được. Trước khi tắt bếp, bạn cho giấm bỗng vào, tùy theo khẩu vị của bạn mà có thể cho ít hoặc nhiều. Trong món bún riêu cua của người miền Bắc thường cho thêm giấm bỗng vào để tạo ra vị chua thanh dịu dàng và mùi thơm đặc trưng. Cho BÚN, hành, riêu cua, chả, đậu hủ vào tô. Chan nước dùng lên trên và thêm ít ngò, tiêu xay là bạn đã có món BÚN RIÊU CUA vô cùng hấp dẫn, chuẩn vị, ăn kèm với đĩa rau sống và chấm với mắm tôm là ngon tuyệt vời.","nutrition":{"kcal":221.3,"protein_g":14.5,"fat_g":13,"carbs_g":12.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv010ut8m1b4dsvyz3","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Chanh","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mam tom","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc khoang"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw014bt8m1ghwa80kw#variant-1","name":"Cá chim chiên","detail_name":"Cá chim chiên","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"42 g / Dĩa nhỏ","quantity_value":42,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá chim","q