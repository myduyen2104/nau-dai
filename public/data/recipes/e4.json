quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt heo rửa sạch, xay nhuyễn .Cà chua rửa sạch, bỏ hạt, cắt hạt lựu nhỏ . Trứng cút luộc, bóc vỏ Tỏi bó vỏ, băm nhuyễn . Cho thịt xay, tỏi, gia vị vào tô, trộn đều. Lấy 1 cái đĩa lớn, thoa một lớp dầu ăn lên bề mặt đĩa để khi hấp thịt không bị dính. Sau đó lấy hỗn hợp thịt ở trên viên thành những viên tròn vừa ăn, nhét quả trứng cút vào chính giữa viên thịt xay, xếp thịt viên lên đĩa, thực hiện đến khi hết thịt. Cho thịt vào hấp khoảng 10 phút cho chín. Bắc chảo lên bếp, phi thơm tỏi. Tiếp đó cho cà chua vào đảo kỹ, rồi cho phần sốt cà chua và phần nước khi hấp thịt vào cùng. Nêm nếm vừa ăn, cho những viên thịt đã hấp chín vào đảo đều, đun nhỏ lửa cho thịt ngấm sốt và đến khi nước sốt sền sệt là được. Tắt bếp, cho thịt ra đĩa cùng với nước sốt sau đó rắc xíu hành lá, rau mùi lên trên là được.","nutrition":{"kcal":412.5,"protein_g":19.3,"fat_g":35.4,"carbs_g":4.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05m9t8m1dawdsk9v","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:sot ca chua","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"}]