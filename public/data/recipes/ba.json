"id":"18_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01g5t8m16cudu1ym#variant-1","name":"Canh bắp cải nấu tôm","detail_name":"Canh bắp cải nấu tôm","category":"Món canh từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"59.5 g / Chén","quantity_value":59.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cải bắp/bắp cải","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Tôm rửa sạch, bóc vỏ, bỏ đầu, lấy chỉ đen. Bắp cải bỏ phần cùi, sau đó cắt thành những sợi nhỏ theo chiều dọc. Ngâm bắp cải trong nước muối loãng khoảng 5 phút, rửa bắp cải qua nhiều lần nước cho thật sạch, rồi vớt ra rổ và để ráo nước. Bắc nồi lên bếp, cho dầu ăn vào phi thơm hành tím, cho tôm vào đảo đều rồi thêm nước vào đun sôi. Sau 5 phút, nước canh sôi cho toàn bộ bắp cải vào và nấu thêm 3 phút. Nêm gia vị vừa ăn. Tắt bếp.","nutrition":{"kcal":31.6,"protein_g":1.8,"fat_g":1.1,"carbs_g":3.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01g5t8m16cudu1ym","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món canh từ 3-4 tuổi","id":"mon_canh_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01zut8m10vgbrv02#variant-1","name":"Chả lụa kho","detail_name":"Chả lụa kho","category":"Món mặn 25-35 tháng tuổi","age_gr