ients":[{"name":"Bầu","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Thịt lợn rửa sạch, cắt lát mỏng. Cho thịt vào một cái bát, ướp muối, hạt nêm để 15 phút. Bắp cải, cắt miếng nhỏ, rửa sạch và để ráo nước. Cà rốt gọt vỏ, cắt mỏng vừa ăn. Đặt chảo lên bếp, đun nóng dầu ăn. Cho thịt đã ướp vào chảo xào, chỉ xào chín tới độ 80%. Sau đó cho bắp cải, vào xào cùng, nếu thấy quá khô thì bạn cho một chút nước vào và đảo đều. Nêm nếm lại gia vị lần nữa cho vừa ăn. Để bắp cải nhanh chín bạn có thể đậy vung trong vài phút. Nhưng đừng để lâu quá, bắp cải sẽ bị nhũn Cho ra đĩa ăn với cơm nóng rất ngon","nutrition":{"kcal":59.1,"protein_g":1.3,"fat_g":3.4,"carbs_g":6.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00m2t8m17g72xj5h","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Bầu","title_ingredient_not_mentioned:Bầu","unlisted_ingredient_phrase:bap cai"],"source_categories":[{"label":"Món xào","id":"mon_xao","kind":"food_category","baseLabel":"Món xào"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00qpt8m18yr4yrft#variant-1","name":"Bò lúc lắc","detail_name":"Bò lúc lắc","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"168.5 g / Dĩa nhỏ","quantity_value":168.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Ớt đỏ to","quanti