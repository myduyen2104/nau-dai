 rửa sạch, thái lát. Bắt chảo lên bếp, thêm dầu ăn vào phi thơm tỏi, thêm thịt bò vào xào chín rồi vớt ra. Tiếp tục xào cà chua, hành tây, cần tây, nêm gia vị vừa ăn. Bắt chảo lên bếp cho chút xíu dầu, cho bánh phở vào áp chảo khoảng 3 phút. Thêm nước sốt dầu hào, gia vị vào đảo đều. Thêm rau đã xào vào đảo đều, sau đó thêm thịt bò vào đảo đều. Thêm rau mùi lên trên, ăn kèm với tương ngô, tương ớt.","nutrition":{"kcal":304.6,"protein_g":11.5,"fat_g":8.8,"carbs_g":46},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03vot8m1xc09fc82","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:tuong ot"],"source_categories":[{"label":"Món khô 5 tuổi","id":"mon_kho_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7ge04n3t8m1zk5m7h6y#variant-1","name":"Sữa chua trái cây hạt chia","detail_name":"Sữa chua trái cây hạt chia","category":"Món khác","age_group":null,"serving":{"raw":"190 g","quantity_value":190,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"NutiMilk Sữa chua ăn có đường - NutiFood","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Táo tây","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dâu tây","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hạt chia","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":184.8,"protein_g":5.5,"fat_g":5.9,"carbs_g":28},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7ge04n3t8m1zk5m7h6y","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món khác","id":"mon_khac","kind":"food_category","baseLabel":"Món khác"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05eut8m1j8a34aav#variant-1","name":"Trứng gà chiên cà chua","detail_name":"Trứng gà chiên cà chua","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"60 g / Dĩa nhỏ","quantity_value":60,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cà chua rửa sạch, cắt hạt lựu. Hành lá lột sạch, rửa cắt nhỏ. Trứng gà đập tách vỏ cho vào tô, đánh đều với gia vị và hành lá cắt nhỏ. Đầu hành đập dập cho vào chảo dầu nóng phi thơm, sau đó trút cà chua vào xào, nêm ít gia vị, tiếp theo đỗ trứng vào, chiên đến khi trứng chín vàng đều thì tắt bếp.","nutrition":{"kcal":87.5,"protein_g":4.1,"fat_g":7.5,"carbs_g":1.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05eut8m1j8a34aav","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:o trung","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7ry05omt8m1alhhm2gl#variant-1","name":"Vịt hầm cốm","detail_name":"Vịt hầm cốm","category":"Món mặn","age_group":null,"serving":{"raw":"90.5 g / Dĩa vừa","quantity_value":90.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cốm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Miến dong khô","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Vịt làm sạch, xát muối trong và ngoài vịt, rửa lại cho sạch, đểráo. Thịt nạc dăm rửa sạch băm nhỏ, ướp nước mắm + tiêu + hành bằm. Nấm hương, nấm mèo ngâm mềm rửa sạch, bỏ chân, băm nhỏ. Hạt sen luộc chín mềm, bỏ tim sen. Miến ngâm mềm, vớt ráo, băm nhỏ. Trộn đều thịt nạc + hạt sen + nấm hương + nấm mèo + cốm + miến, nêm thêm chút nước mắm + đường, trộn thật đều Dồn hỗn hợp trên vào bụng vịt cho vừa căng rồi dùng chỉ may lại Hành lá, rau ngò, rứa sạch xắt nhỏ Bắc chảo nóng, cho dầu vào, phi hanh thơm, cho vịt vào chiên sơ. Cho vịt vào nồi, đổ nước vào sâm sấp, nấu cho đến khi vịt mềm, nước cạn bớt, nêm lại vừa ăn, lấy vịt để ra đĩa sâu lòng. Hòa bột năng với chút nước lã, đổ vào nồi nước vịt, quậy đều, cho nước sền sệt, cho hành lá vào nhắc đổ lên mình vịt, bên trên rắc tiêu + rau ngò. Món này ăn nóng mới nóng","nutrition":{"kcal":247.4,"protein_g":11.6,"fat_g":15.6,"carbs_g":15.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7ry05omt8m1alhhm2gl","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Gừng tươi","ingredient_not_mentioned_by_name:Tỏi ta","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nac dam","unlisted_ingredient_phrase:rau ngo","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"}]