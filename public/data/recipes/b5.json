uantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cua bế","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"}],"instructions_raw":"Cua rửa sạch, luộc chín, gỡ thịt, tán nhuyễn. Cà rốt gọt vỏ, rửa sạch, luộc chín, tán nhuyễn. Hòa tan bột gạo với nước, bắc lên bếp khuấy đều đến khi sôi, thêm cà rốt vào nấu chín, thêm thịt cua vào khuấy đều. Tắt bếp. Thêm dầu thực vật vào khuấy đều.","nutrition":{"kcal":174.9,"protein_g":6.2,"fat_g":7.3,"carbs_g":21.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00v8t8m14jufhr2d","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:dau thuc","unlisted_ingredient_phrase:dau thuc vat","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:thuc vat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ 9-24 tháng","id":"mon_bot_nha_nau_cho_tre_9_24_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"9-24 tháng","id":"9_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00xpt8m1amtsnlie#variant-1","name":"Bún cà ri tôm","detail_name":"Bún cà ri tôm","category":"Món nước 18-35 tháng","age_group":"18-35 tháng","serving":{"raw":"158.5 g / Tô nhỏ","quantity_value":158.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Khoai lang","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước cốt dừa, đóng hộp","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Cary bột","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sả rửa sạch 1 cây băm nhỏ, 1 cây đập dập rồi cắt khúc. Tỏi cũng bóc vỏ rồi băm nhỏ. Khoai lang gọt vỏ, thái miếng vuông vừa ăn, ngâm vào bát nước muối pha loãng để khoai khỏi thâm. Cà rốt, hành tây bạn cũng thái miếng cỡ miếng khoai lang. Rau húng quế nhặt rửa sạch. Tôm rửa sạch, bóc vỏ, bỏ đầu, lấy chỉ lưng và bụng. Sau đó rửa sạch lại một lần nữa rồi để ráo nước. Tiếp theo ướp tôm với 1 chút tỏi và sả băm nhỏ, một ít hạt nêm, gia vị, ớt bột và 1 gói cà ri. Để khoảng 10 phút sau đó cho khoai vào chảo rán hơi vàng các mặt (hoặc chỉ cần se các mặt), sau đó gắp ra đĩa. Cho sả và tỏi vào phi thơm lên, cho tôm vào xào qua. Đổ khoảng 1 bát con nước vào nồi tôm, đun sôi sau đó bạn cho khoai và cà rốt vào nồi. Đun sôi hỗn hợp trong vài phút rồi cho hành tây và nước cốt dừa vào. Nêm thêm hạt nêm, gia vị và đun sôi thêm vài phút nữa rồi thả rau húng quế vào. Cuối cùng cho cà ri tôm ra bát, ăn cùng cơm, bánh mì hay bún đều rất ngon.","nutrition":{"kcal":206.9,"protein_g":8,"fat_g":6.8,"carbs_g":29},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00xpt8m1amtsnlie","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh mi","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:rau hung"],"source_categories":[{"label":"Món nước 18-35 tháng","id":"mon_nuoc_18_35_thang","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"18-35 tháng","id":"18_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01x5t8m1uy0o3wx3#variant-1","name":"Canh su su nấu tôm","detail_name":"Canh su su nấu tôm","category":"Món canh","age_group":null,"serving":{"raw":"134.5 g / Chén","quantity_value":134.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Su su","quantity_raw":"120 g","quantity_value":120,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Su su gọt vỏ, rửa sạch, cắt đôi, bỏ hạt trắng bên trong nếu có, cắt miếng vừa ăn. Tôm rửa sạch bóc vỏ, giã nát trộn với ít gia vị Bắt nồi lên bếp, thêm dầu ăn vào phi thơm hành, cho tôm vào đảo đều. Cho nước lọc vào, cho su su vào nấu cho mềm cùng 1 chút nước mắm. Nấu tầm 15 phút cho su su mềm hẳn. Trong khi chờ su su mềm thì cắt bỏ đầu hành, rửa sạch và cắt khúc ngắn khoảng 0.5-1 cm. Khi su su đã mềm như ý thì cho hành vào và tắt bếp. Đảo đều và tắt bếp.","nutrition":{"kcal":45.7,"protein_g":2.8,"fat_g":1.3,"carbs_g":5.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01x5t8m1uy0o3wx3","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_nam