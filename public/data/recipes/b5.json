ra bát để riêng. Pha nước trộn nộm: Bạn lấy đường, nước mắm, tương ớt, ớt và giấm( nước cốt chanh). Hòa tan phần nguyên liệu trên bạn sẽ được nước trộn nộm vừa miệng. Cho các nguyên liệu gồm hoa chuối, hành tây, mực, rau răm nước sốt vào bát to, trộn đều lên. Trộn tất cả nguyên liệu đã chuẩn bị với nhau. Khi dùng món mực, bạn bày ra dĩa chan nước mắm ngọt cùng đậu phộng rang và hành phi lên trên mặt món ăn. Nên dùng gỏi mực ống hoa chuối với bánh tráng hoặc bánh phồng tôm.","nutrition":{"kcal":122.4,"protein_g":6.4,"fat_g":5.5,"carbs_g":12.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02x0t8m1rm5edobs","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:banh phong","unlisted_ingredient_phrase:banh phong tom","unlisted_ingredient_phrase:banh trang","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:phan nguyen","unlisted_ingredient_phrase:phan nguyen lieu","unlisted_ingredient_phrase:phong tom","unlisted_ingredient_phrase:ruou trang","unlisted_ingredient_phrase:tuong ot","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món luộc","id":"mon_luoc","kind":"food_category","baseLabel":"Món luộc"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02zyt8m18cf6b2ti#variant-1","name":"Hoành thánh chiên và sốt ngò","detail_name":"Hoành thánh chiên và sốt ngò","category":"Món khô","age_group":null,"serving":{"raw":"196 g / Dĩa","quantity_value":196,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":[{"name":"Lá hoành thánh (thành phần nguyên liệu có trứng)","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Tôm biển"