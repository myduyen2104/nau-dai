 vào, đun sôi lại lần nữa nêm lại nước cho vừa ăn rồi tắt bếp.","nutrition":{"kcal":84.6,"protein_g":5.6,"fat_g":5.2,"carbs_g":5.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01wit8m198o36jm1","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01wxt8m1b5ocs0ks#variant-1","name":"Canh su su nấu thịt nạc","detail_name":"Canh su su nấu thịt nạc","category":"Món canh 5 tuổi","age_group":"5 tuổi","serving":{"raw":"74.5 g / Chén","quantity_value":74.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Su su","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":63,"protein_g":2.6,"fat_g":4.6,"carbs_g":2.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01wxt8m1b5ocs0ks","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu0275t8m15vtiful2#variant-1","name":"Cháo thịt bò cà rốt phômai","detail_name":"Cháo thịt bò cà rốt phômai","category":"Cháo 7-8 tháng tuổi","age_group":"7-8  tháng","serving":{"raw":"59 g / Chén","quantity_value":59,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Pho mát","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"4 g","quantity_value":4,"quantity_unit":"g"}],"instructions_raw":"* Thịt bò cắt bỏ gân trắng, rửa sạch, băm nhuyễn. * Cà rốt gọt vỏ, rửa sạch. Đem đi luộc đến khi mềm, vớt ra để nguội, tán nhuyễn * Hòa tan thịt bò với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng, bắc lên bếp khuấy đều cho đến khi sôi, thêm cà rốt vào cho sôi lại. Sau đó cho phô mai vào. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":145.4,"protein_g":5.3,"fat_g":6.2,"carbs_g":17.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu0275t8m15vtiful2","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Pho mát","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:pho mai"],"source_categories":[{"label":"Cháo 7-8 tháng tuổi","id":"chao_7_8_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"7-8  tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo038xt8m1ltsfsk7m#variant-1","name":"Lươn kho nghệ","detail_name":"Lươn kho nghệ","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"66 g / Dĩa nhỏ","quantity_value":66,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Lươn","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Nghệ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Lươn làm hết nhớt, rửa sạch để ráo, xắt khúc khoảng 4 cm. Ướp thịt lươn với gia vị. Nghệ củ gọt vỏ, xắt sợi. Hành củ bóc vỏ, rửa sạch, băm nhuyễn Cho nồi lên bếp, đổ dầu vào, bật bếp, phi thơm hành, cho gừng vào đảo qua. Cho lươn vào, đảo đều rồi cho nước vào. Nêm gia vị rồi đun nhỏ lửa tới khi lươn chín, nước gần cạn thì tắt bếp, xếp lươn ra đĩa ăn cùng cơm trắng.","nutrition":{"kcal":102.8,"protein_g":9.4,"fat_g":3.8,"carbs_g":8.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oo038xt8m1ltsfsk7m","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03bit8m15jo8r7jn#variant-1","name":"Mì bò kho","detail_name":"Mì bò kho","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"249 g / Tô vừa","quantity_value":249,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Mì sợi khô","quantity_raw":"110 g","quantity_value":110,"quantity_unit":"g"},{"name":"Thịt bò loại 2","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch với nước lạnh sau đó ta đổ một ít rượu trắng vào chén, cho thêm vài lát gừng tươi hòa đều rồi xoa khắp các miếng thịt bò để khỏang 5 phút, rồi rửa lại bằng nước sạch. – Để ráo bớt nước rồi ta trụng qua một lượt bằng nước sôi giúp khử bớt mùi hôi của thịt bò. – Tiếp theo ta xắt thịt bò thành từng miếng nhỏ, tốt nhất ta nên cắt theo khối hình vuông hay chữ nhật. - Ướp thịt bò với các gia vị vừa ăn. Cà rốt gọt vỏ ngoài rồi rửa sạch, 1 củ xắt khúc dài chừng 5cm rồi những khúc này ta bổ làm đôi hay làm 4 tùy ý. – Sả lột bỏ lớp vỏ ngoài cùng, chặt bỏ phần gốc, rửa sạch rồi dùng cán dao đập dập. – Gừng tươi, hành tím, tỏi rửa sạch băm nhỏ. Rau ngò, húng quế nhặt sạch, để riêng vào rổ cho ráo nước. – Hoa hồi và vỏ quế cho vào chảo rao sơ qua để dậy mùi thơm. Đặt một chiếc nồi nhỏ lên trên bếp cho dầu ăn vào bật lửa vừa để đun nóng dầu rồi trút hành tỏi và gừng vừa băm nhỏ vào phi thơm. – Sau đó ta đổ thịt bò đã ướp xong vào đảo đều tay, rồi cho thêm 2 muỗng nhỏ màu dầu điều để món hủ tiếu bò kho có màu đẹp mắt. Khi thấy thịt bò săn lại thì cho sả và đổ một lượng nước lọc sao cho xâm xấp mặt thịt, rồi thả hoa hồi và quế vừa rang vào nồi. – Khi nào thịt chín mềm thì ta dùng vá vớt hoa hồi, quế và sả ra ngoài, rồi nêm thêm một chút hạt nêm cho vừa khẩu vị. – Ta đổ chừng 3 muỗng nhỏ bột năng vào cái tô nước lọc sau đó trút từ từ vào nồi bò kho, vừa đổ vừa khuấy đều tay rồi cho cà rốt xắt khúc vào đun thêm chừng 10 phút nữa thì tắt bếp. - Mì sợi trụng qua nước sôi, giũ thật ráo cho vào tô, sau đó múc nước bò kho vào thêm một ít tiêu bột, ngò gai ngắt thành từng khúc ngắn, húng quế vặt những lá vừa ăn cho vào tô.","nutrition":{"kcal":601.2,"protein_g":25.8,"fat_g":15.4,"carbs_g":90.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03bit8m15jo8r7jn","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:bot ngo","unlisted_ingredient_phrase:gung tuoi","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hu tieu","unlisted_ingredient_phrase:ngo gai","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:rau ngo","unlisted_ingredient_phrase:ruou trang","unlisted_ingredient_phrase:uop thit","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03ewt8m1idlivlix#variant-1","name":"Mì thịt bò","detail_name":"Mì thịt bò","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"293 g / Tô vừa","quantity_value":293,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Mì sợi khô","quantity_raw":"110 g","quantity_value":110,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name