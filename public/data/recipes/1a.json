ịt cá săn lại và vàng đều. Cho tiếp nước màu và nước lọc vào rồi để lửa nhỏ, kho tới khi nước cạn bớt. Giai đoạn này bạn nêm thêm nước mắm, đường cho vừa ăn. Có thể cho thêm ớt trái vào cho có thêm vị cay cay.Món cá hú kho tiêu hoàn thành phải có màu sắc bắt mắt, mùi thơm phưng phức. Thịt cá hú ngấm đều gia vị, vừa có vị đậm đà và pha lẫn vị cay nồng nơi đầu lưỡi của tiêu và ớt.","nutrition":{"kcal":175.8,"protein_g":14.9,"fat_g":11.2,"carbs_g":4.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw0174t8m1a3097ogg","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá mỡ/cá hú/cá basa","ingredient_not_mentioned_by_name:Hành củ tươi","ingredient_not_mentioned_by_name:Hành lá (hành hoa)","title_ingredient_not_mentioned:Cá mỡ/cá hú/cá basa","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nho kho","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc mau"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw019st8m1ddt04t1z#variant-1","name":"Cá ngừ kho thơm","detail_name":"Cá ngừ kho thơm","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"147 g / Dĩa nhỏ","quantity_value":147,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá ngừ","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Dứa ta (thơm)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Ớt khô bột","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cá mua về rửa sạch, cắt khoanh. Dứa gọt vỏ bỏ mắt rửa sạch, cắt khúc vừa ăn. Tỏi ta, hành củ tươi bóc vỏ rửa sạch bằm nhuyễn. Hành lá rửa sạch bỏ rễ, cắt nhỏ. Bắc chảo dầu nóng chiên sơ cá. Đặt 1 cái nồi cho đường và nước vào đun sôi nhỏ lửa đến khi đường có màu vàng cánh gián thì tắt bếp. Tiếp theo đó xếp cá và dứa vào nồi cùng với hành củ tươi và tỏi ta đã băm nhuyễn vào cùng. Sau đó nêm gia vị vừa ăn, kho cá trên lửa nhỏ đến khi cá có màu nâu thì cho thêm ớt bột và hành lá vào và tắt bếp. Múc cá ra dĩa rắc thêm ít tiêu lên bề mặt.","nutrition":{"kcal":142.1,"protein_g":17.4,"fat_g":5.3,"carbs_g":6.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw019st8m1ddt04t1z","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá ngừ","ingredient_not_mentioned_by_name:Nước mắm cá","title_ingredient_not_mentioned:Cá ngừ","unlisted_ingredient_phrase:uong co"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01bzt8m1n9xqldt8#variant-1","name":"Cá thu chiên","detail_name":"Cá thu chiên","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"72 g / Dĩa nhỏ","quantity_value":72,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá thu","quant