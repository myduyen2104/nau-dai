t nêm Knorr","quantity_raw":"1.5 g","quantity_value":1.5,"quantity_unit":"g"}],"instructions_raw":"Hến rửa sạch để ráo. Sả rửa sạch băm nhỏ. Tỏi lột vỏ rửa sạch băm nhuyễn. Đặt 1 cái chảo lên bếp phi thơm tỏi, sau đó cho sả vào xào sơ, rồi cho hến vào xào đều cùng gia vị cho đến khi hến chín thì tắt bếp rồi rắc thêm tiêu lên mặt rồi tắt bếp.","nutrition":{"kcal":147.7,"protein_g":7.2,"fat_g":8.2,"carbs_g":11.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02z6t8m1rb3wme16","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Sả cây","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Hạt nêm Knorr"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6os03uut8m1ws4ey9sb#variant-1","name":"Ốc bươu xào sả ớt","detail_name":"Ốc bươu xào sả ớt","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"139.5 g / Dĩa nhỏ","quantity_value":139.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Ốc bươu","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sửa sạch ốc bươu tươi sống, ngâm ốc trong nước (nước cơm càng tốt) khoảng 2 giờ. Sau đó, luộc chín ốc bươu, tách lấy thịt ốc, bỏ vỏ. Đập dập sả, cắt xéo. Rửa sạch ớt, hành lá, cắt nhỏ. Làm nóng dầu ăn, cho sả đảo đều. Cho thịt ốc bươu vào, đảo đều 2 phút nêm nếm gia vị cho vừa ăn. Cuối cùng, cho ớt, hành lá vào, đảo đều thêm 1 phút thì tắt bếp.","nutrition":{"kcal":155.4,"protein_g":11.5,"fat_g":5.9,"carbs_g":14.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6os03uut8m1ws4ey9sb","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Sả cây","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03vtt8m1mrc5ltnx#variant-1","name":"Phở áp chảo thịt bò","detail_name":"Phở áp chảo thịt bò","category":"Món khô từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"443 g / Dĩa vừa","quantity_value":443,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"250 g","quantity_value":250,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cần tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"12 g","quantity_value":12,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tương ớt","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu hào maggi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, thái lát mỏng, ướp gia vị. Cà chua rửa sạch, cắt múi cau. Cần tây cắt gốc, rửa sạch, cắt khúc vừa ăn. Hành tây gọt vỏ, rửa sạch, thái lát. Bắt chảo lên bếp, thêm dầu ăn vào phi thơm tỏi, thêm thịt bò vào xào chín rồi vớt ra. Tiếp tục xào cà chua, hành tây, cần tây, nêm gia vị vừa ăn. Bắt chảo lên bếp cho chút xíu dầu, cho bánh phở vào áp chảo khoảng 3 phút. Thêm nước sốt dầu hào, gia vị vào đảo đều. Thêm rau đã xào vào đảo đều, sau đó thêm thịt bò vào đảo đều. Thêm rau mùi lên trên, ăn kèm với tương ngô, tương ớt.","nutrition":{"kcal":594,"protein_g":22.8,"fat_g":15.6,"carbs_g":92.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03vtt8m1mrc5ltnx","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món khô từ 8-18 tuổi","id":"mon_kho_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72m0459t8m1128ekd7j#variant-1","name":"ROHTO N14 CHAY - Đậu hủ kho tương hột","detail_name":"ROHTO N14 CHAY - Đậu hủ kho tương hột","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"171.2 g","quantity_value":171.2,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Đậu phụ (đậu hũ)","quantity_raw":"100 g","quantity_value":100,"quant