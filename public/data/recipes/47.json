,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hẹ lá","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":284.1,"protein_g":11.7,"fat_g":14.8,"carbs_g":26},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02zit8m1hrygdbrc","quality_status":"unmatched","warnings":["duplicate_listing_row_occurrence","instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"catalog_capture_unmatched_to_detail"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i0305t8m1m6qtfelv#variant-1","name":"Hoành thánh tôm thịt","detail_name":"Hoành thánh tôm thịt","category":"Món nước 5 tuổi","age_group":"5 tuổi","serving":{"raw":"156.3 g / Tô nhỏ","quantity_value":156.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Lá hoành thánh (thành phần nguyên liệu có trứng)","quantity_raw":"45 g","quantity_value":45,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Sơ chế nguyên liệu Xương heo mua về rửa sạch, cho vào ngâm với nước muối loãng để khử bớt mùi. Tiếp đến vớt ra trụng với nước sôi trong khoảng 2-3 phút cho xương sạch, không còn dính máu. Rồi vớt ra để ráo nước. Củ cải trắng rửa sạch gọt vỏ, cắt khúc to. Hành tím bóc vỏ, rửa sạch, chừa lại 3 củ để nguyên. Còn lại thái thành lát mỏng hoặc cho vào máy xay tỏi ớt xay nhuyễn. Hành lá, hẹ lá, nhặt sạch, thái nhỏ Rau sà lách nhặt, rửa sạch để ráo. Thịt heo rửa với nước muối và rửa sạch lại với nước lạnh để ráo, băm nguyễn Tôm rửa sạch, bóc vỏ, bỏ đầu, băm nhuyễn Giá rửa rồi để ráo nước. Hầm xương heo với củ quả Bắc nồi lên bếp cho vào 4 lít nước đun sôi, rồi cho xương heo và 1 củ cải trắng cắt khúc to và 2 củ hành tím, ít muối vào hầm cùng. Bật lửa nhỏ hầm trong 1 tiếng. Khi hầm nhớ vớt bọt để nước dùng trong hơn. Làm nhân hoành thánh Cho hành tím băm nhuyễn vào tô , 1 ít hành lá băm nhuyễn, muối, bột nêm, đường, tiêu xay cùng với thịt bằm và tôm bằm rồi trộn đều. Xào thịt bằm tôm Bắc chảo lên bếp cho dầu ăn đun nóng rồi phi thơm hành tím. Sau đó vớt hành ra lọc hành và dầu để riêng. Tiếp đến cho hành phi vào tô thịt bằm khi nãy, nêm thêm dầu hành vừa phi đảo đều cho thịt thấm vị. Làm hoành thánh Múc muỗng nhân thịt tôm cho vào giữa lá hoành thánh, rồi túm các góc miếng bột lại để bọc kín phần nhân. Sau đó xoắn nhẹ đầu giúp nhân không bị rơi ra bên ngoài. Lần lượt làm như vậy cho đến khi hết sạch nhân và lá hoành thánh. Nếu còn nhân dư thì bạn hãy nặn thành từng viên tròn nhé. Nấu nước dùng hoành thánh Nồi hầm xương heo khi nãy bạn hãy nêm nếm lại cho vừa ăn. Rồi cho nốt phần củ cải trắng còn lại vào nấu cùng cho đến khi củ cải trắng chín tới. Hoành thánh thì khi nào ăn bạn hãy cho vào nấu khoảng 5-10 phút để giữ được độ nóng, ăn liền sẽ ngon hơn. Món này khi ăn có thể rắc thêm chút hành phi vàng, ít hành ngò thái nhỏ và chút tiêu xay, giá, rau xà lách để tăng phần hấp dẫn.","nutrition":{"kcal":326.3,"protein_g":13.9,"fat_g":15.2,"carbs_g":33.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i0305t8m1m6qtfelv","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Cà rốt","unlisted_ingredient_phrase:an lien","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:rau sa lach","unlisted_ingredient_phrase:sa lach","unlisted_ingredient_phrase:trang con","unlisted_ingredient_phrase:voi nuoc","unlisted_ingredient_phrase:xuong heo"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i0315t8m1bhw2zqbp#variant-1","name":"Hủ tiếu xào","detail_name":"Hủ tiếu xào","category":"Món khô","age_group":null,"serving":{"raw":"365.5 g / Dĩa","quantity_value":365.5,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":[{"name":"Hủ tiếu khô","quantity_raw":"56 g","quantity_value":56,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Mực tươi","quantity_raw":"54 g","quantity_value":54,"quantity_unit":"g"},{"name":"Gan heo (lợn)","quantity_raw":"29 g","quantity_value":29,"quantity_unit":"g"},{"name":"Dạ dày heo (lợn)","quantity_raw":"18.5 g","quantity_value":18.5,"quantity_unit":"g"},{"name":"Bì heo (lợn)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Lòng gà (cả bộ)","quantity_raw":"35 g",