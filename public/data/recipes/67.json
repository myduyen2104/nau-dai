nh lại thì dừng lại. Không nên đổ ngay cùng 1 lúc sẽ dễ bị đặc quá nhé. Sau cùng từ từ đổ trứng đánh tan vào khấy theo 1 chiều để tạo vân cho đẹp. Bạn có thể lọc chỉ lấy lòng trắng trứng cho vào thì tạo vân trắng sẽ đẹp hơn. Nấu đến khi nồi súp chuyển màu trong cho thêm trứng cút vào rồi tắt bếp, múc ra chén, rắc rau mùi, tiêu bột, ớt tùy ý lên và thưởng thức","nutrition":{"kcal":181.9,"protein_g":7.7,"fat_g":7.5,"carbs_g":20.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04y6t8m1pyjh13n6","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gừng tươi","ingredient_not_mentioned_by_name:Hành lá (hành hoa)","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Xì dầu","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:heo nac","unlisted_ingredient_phrase:long trang","unlisted_ingredient_phrase:long trang trung","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:o trung","unlisted_ingredient_phrase:pha voi","unlisted_ingredient_phrase:pha voi nuoc","unlisted_ingredient_phrase:thit heo nac","unlisted_ingredient_phrase:trang trung","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước 6-7 tuổi","id":"mon_nuoc_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh0569t8m129z67dnh#variant-1","name":"Thịt heo kho củ cải","detail_name":"Thịt heo kho củ cải","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"90 g / Dĩa nhỏ","quantity_value":90,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"30 g