n, bạn dùng tay bóp nhẹ vào thân tôm để chỉ tôm chìa ra ngoài một chút rồi dùng tay rút bỏ. Sau đó rửa sạch tôm, để ráo. Dưa leo mua về, các bạn rửa thật sạch, sau đó cắt 2 đầu. Cho vào nước muối pha loãng, ngâm khoảng 15 phút rồi xả sạch. Chẻ dưa làm đôi, loại bỏ phần ruột. Dùng dao bào dưa thành các lát mỏng, ngâm ngay vào nước đá lạnh có pha một chút muối để dưa được giòn và xanh Cà rốt rửa sạch, gọt vỏ sau đó bào sợi, cho vào ngâm nước đá cùng với dưa leo. Bắc chảo lên bếp. Chờ cho chảo nóng các bạn cho toàn bộ phần tôm đã sơ chế vào, rim cùng với muối đến khi tôm chín thì tắt bếp. Cho vào cối đường, tỏi, ớt, giã nhuyễn. Kế đến cho tiếp vào cối nước mắm, tương ớt, nước cốt chanh. Khuấy đều Trộn tôm, dưa leo, cà rốt lại với nhau rồi chan đều nước mắm vô. Sau đó, trộn đều tất cả lên. Cho rau mùi, hành phi vào và trộn đều lần nữa, cho thêm ít vừng ran là đã hoàn thành món gỏi dưa leo tôm thịt rồi đấy.","nutrition":{"kcal":130.4,"protein_g":5.8,"fat_g":6.7,"carbs_g":12.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02xet8m1m94l8jrp","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:tom thit","unlisted_ingredient_phrase:tuong ot","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03kst8m1pe7wg2ta#variant-1","name":"Miến xào tôm thịt","detail_name":"Miến xào tôm thịt","category":"Món khô từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"275.5 g / Dĩa","quantity_value":275.5,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":