0,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Cà chua rửa sạch cắt múi cau. Tỏi băm nhuyễn Rau muống rửa sạch với nước muối ngắt cọng già, giữ cọng non và lá. Tôm rửa sạch ướp với gia vị Nồi vừa nóng cho dầu ăn và phi tỏi cho thơm. Tiếp theo cho tôm vào. Và cà chua vào xào để có màu đỏ đẹp mắt. Me cho vào nước nóng để me ra nước sau đó dùng rây lọc cho phần nước me vào nồi. Cho thêm ít nước lọc vào rồi đổ phần nước trong nồi vào phần me lấy nước lặp lại 4-5 lần. Nêm nếm gia vị theo khẩu vị gia đình. Và cho rau muống vào nấu sôi lên thì tắt bếp, múc ra tô cho rau mùi vào.","nutrition":{"kcal":49.1,"protein_g":1.8,"fat_g":2.2,"carbs_g":5.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01mpt8m1j06rfsdo","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:rau muong","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh chay 8-18 tuổi","id":"mon_canh_chay_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh chay"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01ret8m1lwt9vqg0#variant-1","name":"Canh mít non nấu tôm","detail_name":"Canh mít non nấu tôm","category":"Món canh 5 tuổi","age_group":"5 tuổi","serving":{"raw":"64.5 g / Chén","quantity_value":64.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Mít non","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Mít gọt vỏ, bỏ cùi, ngâm trong nước chanh pha loãng trong vòng 15 phút cho bớt mủ và không bị thâm đen. Sau đó rửa lại với nước sạch rồi thái miếng vừa ăn. Nếu là mua mít bào sẵn chỉ cần rửa sạch. Tôm bóc vỏ, bỏ đầu, rút chỉ đen, chà sơ qua với muối rồi rửa sạch, để ráo. Hoặc có thể để nguyên vỏ, chỉ bỏ đầu, rửa sạch, giã thô. Cho dầu ăn vào nồi đun nóng, phi thơm hành củ đã đập dập. Cho tôm vào xào săn. Bắt nồi lên cho nước vào nấu sôi, nước sôi thì cho mít vào nấu chín. Tắt bếp cho hành lá vào.","nutrition":{"kcal":33.6,"protein_g":3,"fat_g":1.4,"carbs_g":5.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01ret8m1lwt9vqg0","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hanh cu","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02cit8m1spq9fxuw#variant-1","name":"Chè hạt sen củ năng","detail_name":"Chè hạt sen củ năng","category":"Chè","age_group":null,"serving":{"raw":"300 g / Chén","quantity_value":300,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Củ dong","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Nước lọc","quantity_raw":"120 g","quantity_value":120,"quantity_unit":"g"}],"instructions_raw":"Củ năng gọt vỏ, rửa sạch Hạt sen tách bỏ tim, rủa sạch, ngâm trong nước. Cho hạt hạt sen vào nồi, thêm nước vào nấu cho đến khi hạt sen mềm thì cho đường và củ năng vào nấu sôi đều khoảng 5 phút rồi tắt bếp. Trong lúc nước sôi cho lá dứa vào cho chè thơm hơn, Để chè nguội và cho vào tủ lạnh ăn cho mát.","nutrition":{"kcal":330.1,"protein_g":6.2,"fat_g":0.3,"carbs_g":75.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02cit8m1spq9fxuw","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Củ dong","ingredient_not_mentioned_by_name:Nước lọc","unlisted_ingredient_phrase:trong nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Chè","id":"che","kind":"food_category","baseLabel":"Chè"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02j8t8m1y22qf7mo#variant-1","name":"Đậu cô ve (đậu que) xào thịt bò","detail_name":"Đậu cô ve (đậu que) xào thịt bò","category":"Món xào 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"76.5 g / Dĩa vừa","quantity_value":76.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Đậu cô ve","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, cắt thành miếng mỏng, bản to,ướp với hạt nêm, nước tương và một ít dầu ăn rồi để trong vòng 15 – 20 phút cho thịt bò ngấm gia vị. Đậu que nhặt rồi bẻ khúc ngắn khoảng 2 lóng tay. Rửa sạch rồi trụng qua nước sôi có ngâm chút muối. Chuẩn bị một chiếc chảo vừa, đun sôi 1 muỗng dầu ăn, cho hành tây vào sơ cho đến khi thấy thịt bò trong lại thì cho thịt bò vào xào chung cho đến khi thịt bò săn lại. Ch thịt bò ra chén và tiếp tục sử dụng chảo đó để đun sôi dầu rồi phi thơm tỏi, cho đậu vào xào, nêm nếm gia vị vừa ăn. Xào đều tay cho đậu chín tới rồi cho thịt bò vừa xào lúc nãy vào , đảo đều rồi tắt bếp.","nutrition":{"kcal":255.7,"protein_g":15.2,"fat_g":6.3,"carbs_g":35},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02j8t8m1y22qf7mo","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nuoc tuong"],"source_categories":[{"label":"Món xào 8-18 tuổi","id":"mon_xao_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02u1t8m1qam0wogd#variant-1","name":"Gà rô ti","detail_name":"Gà rô ti","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"93.5 g / Dĩa nhỏ","quantity_value":93.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt gà công nghiệp, đùi","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước dừa non tươi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Gà rửa sạch, để ráo, cắt miếng vừa ăn, ướp gia vj trong 30 phút. Tỏi bóc vỏ, rửa sạch, sau đó băm nhuyễn. Bắc một cái chảo lên bếp và cho lượng dầu ăn vừa phải vào, sau khi dầu nóng thì cho đùi gà đã ướp vào, chiên sơ với lửa lớn đến khi gà hơi vàng, sau đó gắp ra. Đổ phần dầu đã chiên và chừa lại 1 ít dầu, sau đó cho tỏi đã băm nhuyễn vào và phi đến khi vàng thơm. Cho phần nước xốt vào và đảo đều lên.Tiếp theo cho đùi gà vào và trở đều để gà thấm gia vị. Vặn lửa nhỏ, và cho nước dừa vào và đậy nắp lại, nấu gà trong 30 phút. Gà chín, tắt bếp, nước xốt sẽ sền sệt và gà sẽ có màu vàng thơm.","nutrition":{"kcal":146.6,"protein_g":11.2,"fat_g":9.1,"carbs_g":5.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02u1t8m1qam0wogd","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt gà công nghiệp, đùi","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Hạt tiêu"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02v6t8m12dm9eqde#variant-1","name":"gan heo xào","detail_name":"gan heo xào","category":"Món mặn","age_group":null,"serving":{"raw":"140 g / Dĩa nhỏ","quantity_value":140,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Gan heo (lợn)","quantity_raw":"130 g","quantity_value":130,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quant