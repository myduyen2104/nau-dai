[{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00sht8m13i2rr3o3#variant-1","name":"Bông hẹ xào tỏi","detail_name":"Bông hẹ xào tỏi","category":"Món xào 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"111.2 g / Dĩa vừa","quantity_value":111.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Bông hẹ","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Bông hẹ rửa sạch để ráo nước, cắt thành những khúc dài vừa ăn. – Thịt bò rửa sạch, thái lát mỏng, cho hạt nêm, muối vào thịt bò rồi trộn đều lên để khoảng 15 – 20 phút – Đun nóng dầu ăn, cho bông hẹ đã sơ chế vào trong chảo xào, cho thêm 1 chút hạt nêm vào rồi xào cho đến khi bông hẹ vừa chín tới thì tắt bếp rồi cho bông hẹ xào ra đĩa. – Dùng chảo xào bông hẹ cho thêm dầu vào trong chảo đun nóng, cho số thịt bò đã ướp vào trong chảo xào lửa to và đảo thật đều tay để thịt bò chín đều và không bị ra nước. . Khi thịt bò vừa chín tới, tắt bếp, cho thịt bò lên trên đĩa bông hẹ vừa xào.","nutrition":{"kcal":76.2,"protein_g":2.2,"fat_g":5.2,"carbs_g":7.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00sht8m13i2rr3o3","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:thit bo"],"source_categories":[{"label":"Món xào 8-18 tuổi","id":"mon_xao_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01qjt8m1ilzehjgg#variant-1","name":"Canh khoai sọ ninh thịt vịt","detail_name":"Canh khoai sọ ninh thịt vịt","categor