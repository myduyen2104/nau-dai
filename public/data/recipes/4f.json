ty_unit":"g"},{"name":"Đậu trắng hạt (đậu tây)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Sườn heo cắt miếng 3cm, ướp với gia vị để thấm 45 phút. Khoai tây, cà rốt gọt vỏ, rửa sạch cắt khối 2cm. Cà chua bỏ hạt, bằm nhuyễn. Tỏi băm nhỏ. Đậu ngâm qua đêm hoặc ngâm cho đến khi hạt đậu nở gấp đôi. Rửa lại sạch, để ráo. Cho dầu ăn vào chảo, chiên sơ sườn. Xào cà chua: Tiếp tục cho tỏi vào phi vàng, cho cà chua vào xào chung cho đến khi cà chua mềm. Hầm hỗn hợp sườn đậu cà chua: Cho hỗn hợp cà chua vào nồi, cho sườn, đậu, cà rốt, khoai tây vào. Đổ nước dùng vào. Ninh cho đến khi cà rốt, khoai tây và đậu trắng mềm hẳn. Múc sườn nấu đậu ra tô, dùng với cơm hoặc bánh mì.","nutrition":{"kcal":140.3,"protein_g":5.5,"fat_g":10.2,"carbs_g":7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04v8t8m1btdcqj1t","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh mi","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:suon heo"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_eviden