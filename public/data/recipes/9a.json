 đến khi tôm chuyển sang màu cam. Cuối cùng là cho phô mai vào chảo, đậy nắp và đun thêm 3 - 5 phút cho phô mai tan hết ra là món ăn hoàn thành.","nutrition":{"kcal":114.5,"protein_g":10.5,"fat_g":6.2,"carbs_g":3.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh059st8m1ld454ws5","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bơ thực vật","ingredient_not_mentioned_by_name:Pho mát","ingredient_not_mentioned_by_name:Rượu vang trắng (cồn 9.5 g)","ingredient_not_mentioned_by_name:Bột bắp (bột ngô vàng)","unlisted_ingredient_phrase:mai dang","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:pho mai","unlisted_ingredient_phrase:pho mai dang","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh05aat8m1c3c0anvg#variant-1","name":"Tôm chiên giòn","detail_name":"Tôm chiên giòn","category":"Món mặn","age_group":null,"serving":{"raw":"115.3 g / Dĩa vừa","quantity_value":115.3,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Tôm đồng","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bột mì","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Tôm rửa sạch để ráo. Trộn đều hỗn hợp gồm trứng và bột bắp cùng gia vị. Bắt chảo dầu nóng để