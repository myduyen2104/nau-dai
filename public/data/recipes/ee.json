_value":1.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Gà mua về rửa sạch, chặt nhỏ ướp gia vị trong 20 phút. Gừng cạo vỏ rửa sạch, thái sợi. Hành củ , tỏi lột vỏ rửa sạch băm nhuyễn. Hành lá rửa sạch bỏ rể, cắt nhỏ. Bắt 1 cái nồi lên bếp cho đường và nước vào nấu nhỏ lửa cho đường chảy hết và chuyển sang màu cánh gián sau nó tắt bếp. Xếp gà và hành tỏi băm vào nồi cho thêm gia vị vào kho nhỏ lửa đến khi gà chín thì cho gừng cắt sợi vào cùng hành lá vào, kế tiếp nêm nếm gia vị cho vừa ăn rồi tắt bếp rắc 1 ít tiêu lên bề mặt.","nutrition":{"kcal":197.6,"protein_g":18.3,"fat_g":11.9,"carbs_g":4.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02svt8m1ltdg0mdn","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt gà công nghiệp, đùi","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Ớt khô bột","ingredient_not_mentioned_by_name:Nước mắm cá"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03hqt8m1e9nw6yyp#variant-1","name":"Mì ý xào thịt xông khói","detail_name":"Mì ý xào thịt xông khói","category":"Món khô từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"238 g / Dĩa vừa","quantity_value":238,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Mì Spaghetti, khô","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo muối xông khói","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cải bắp/bắp cải","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quan