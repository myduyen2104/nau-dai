 và có mùi thơm của rượu. Vớt thịt ra rồi làm khô thịt bằng cách để miếng thịt lên giấy thấm hoặc vải the. Đun dầu sôi, cho thịt vào rán vàng đều. Lọc nước ướp thịt ra 1 tô khác, rồi cho các loại rau, vào chảo thịt đã chiên vàng, bắc lên bếp nấu khoảng 5-6 phút, nêm gia vị vừa ăn thêm một ít bột và đảo đều nhanh tay. Đổ nước rượu ướp thịt và 1 ít nước lã vào chảo thịt. Đậy kín hầm lửa nhỏ chừng 2 giờ.","nutrition":{"kcal":77,"protein_g":6.8,"fat_g":3.2,"carbs_g":5.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00q2t8m1eh25i3kl","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:thit va","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00s0t8m1yacxihlb#variant-1","name":"Bò xào lá lốt","detail_name":"Bò xào lá lốt","category":"Món mặn","age_group":null,"serving":{"raw":"127.5 g / Dĩa nhỏ","quantity_value":127.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Lá lốt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính