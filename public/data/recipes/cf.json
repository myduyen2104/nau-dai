 lọc vào (lượng nước canh bao nhiêu thì tuỳ bạn muốn) Tiếp tục bỏ phần cọng cải vào nấu đến khi nước sôi (vì phần cọng cải lâu chín hơn). Khi nước sôi thì tiếp tục bỏ lá cải vào. Nấu thêm 10p nữa thì nêm nếm gia vị cho vừa miệng rồi tắt bếp. Ko nên nấu quá lâu sẽ làm nhừ cải và cải sẽ chuyển màu vàng nhìn ko đẹp mắt","nutrition":{"kcal":74.2,"protein_g":4.2,"fat_g":4.7,"carbs_g":4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01kut8m1np3bqjky","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:nuoc loc"],"source_categories":[{"label":"Món canh 8-18 tuổi","id":"mon_canh_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01mvt8m1brymptcx#variant-1","name":"Canh chua rau muống nấu tôm","detail_name":"Canh chua rau muống nấu tôm","category":"Món canh 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"122.2 g / Chén","quantity_value":122.2,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau muống","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Cà chua rửa sạch cắt múi cau. Tỏi băm nhuyễn Rau muống rửa sạch với nước muối ngắt cọng già, giữ cọng non và lá. Tôm rửa sạch ướp với gia vị Nồi vừa nóng cho dầu ăn và phi tỏi cho thơm. Tiếp theo cho tôm vào. Và cà chua vào xào để có màu đỏ đẹp mắt. Me cho vào nước nóng để me ra nước sau đó dùng rây lọc cho phần nước me vào nồi. Cho thêm ít nước lọc vào rồi đổ phần nước trong nồi vào phần me lấy nước lặp lại 4-5 lần. Nêm nếm gia vị theo khẩu vị gia đình. Và cho rau muống vào nấu sôi lên thì tắt bếp, múc ra tô cho rau mùi vào.","nutrition":{"kcal":61.2,"protein_g":6.3,"fat_g":0.6,"carbs_g":7.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01mvt8m1brymptcx","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh 8-18 tuổi","id":"mon_canh_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01qnt8m16mwuraqi#variant-1","name":"Canh khoai từ","detail_name":"Canh khoai từ","category":"Món canh 5 tuổi","age_group":"5 tuổi","serving":{"raw":"42.5 g / Chén","quantity_value":42.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Củ từ","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":62.6,"protein_g":1.6,"fat_g":2.8,"carbs_g":8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01qnt8m16mwuraqi","quality_status":"missing_at_source","warnings":["instructions_missing_from_