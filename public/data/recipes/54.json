nings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Mì sợi khô","ingredient_not_mentioned_by_name:Nấm hương tươi","unlisted_ingredient_phrase:bo vien","unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc tuong"],"source_categories":[{"label":"Món nước chay từ 8-18 tuổi","id":"mon_nuoc_chay_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước chay"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03fft8m1tyeumyl8#variant-1","name":"Mì thịt heo, trứng cút","detail_name":"Mì thịt heo, trứng cút","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"237.5 g / Tô nhỏ","quantity_value":237.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Mì sợi khô","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Mỡ lợn nước","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Cần ta","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hẹ lá","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sơ chế Thịt nạc chân giò cạo sạch lông, rửa sạch với muối. Mì sợi trụng qua nước sối, để ráo Các loại rau ăn kèm rửa sạch, để ráo. Nấu nước dùng Xương heo chần qua nước sôi, rửa sạch rồi cho vào nồi nước lạnh ninh lấy nước dùng cùng với thịt chân giò. Phi hành thơm vào nồi và đổ nước hầm xương vào. Sau đó thịt chân giò mềm vớt ra cắt lát mỏng. Trứng cút luộc chín, bóc vỏ. Xếp mì ra bát, cho thịt chân giò, trứng cút vào,. Chan nước dùng rồi rắc hành, mùi, hạt tiêu lên trên và thưởng thức. ăn kèm với rau","nutrition":{"kcal":558.4,"protein_g":20.6,"fat_g":23,"carbs_g":67.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03fft8m1tyeumyl8","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Mỡ lợn nước","ingredient_not_mentioned_by_name:Cần ta","ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:chan gio","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:trung cut","unlisted_ingredient_phrase:xuong heo"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03w3t8m11sncd22p#variant-1","name":"Phở bò (tái) Bình dân","detail_name":"Phở bò (tái) Bình dân","category":"Món nước","age_group":null,"serving":{"raw":"318.5 g / Tô vừa","quantity_value":318.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau ngổ","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau húng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Xương rửa sạch cho lên ninh cùng 1 chút muối. Nếu là xương bò thì nên nướng qua xương, sau đó luộc qua, đổ nước đầu đi rồi mới ninh tiếp. Ninh xương tối thiểu 6 tiếng (tối đa 12 tiếng) sẽ cho món nước dùng rất ngon. Có thể làm từ tối hôm trước, cho xương vào ninh để hôm sau có nồi nước dùng ngon. Bước 2: - Gừng, hành khô, quế, hồi, thảo quả nướng rồi đập dập, tất cả cho vào ninh cùng nồi nước xương. Khi gần được thì thêm 1 củ hành tây vào đun cùng tiếp. Khi nước dùng đã ninh xong thì thêm hạt nêm vừa ăn (chú ý hớt bỏ bọt trong quá trình ninh xương). Bước 3: Bắp bò rửa sạch, thái miếng vừa ăn. Hành, mùi tàu, rau mùi/húng rửa sạch, cắt ngắn. Bánh phở chần qua nước sôi. Bước 4: Tất cả xếp vào bát, chan nước dùng, thêm chanh, ớt là có bát phở xịn sò tại gia. Lưu ý nước dùng phải sôi ùng ục để thịt bò chín được nhé.","nutrition":{"kcal":406.9,"protein_g":17.2,"fat_g":12.3,"carbs_g":58.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03w3t8m11sncd22p","quality_status":"needs_review","warnings":["duplicate_ingredient_names","method_me