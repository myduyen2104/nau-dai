 trong 30 phút. Tôm rửa sạch, bóc vỏ băm nhỏ. Cà chua rửa sạch, cắt nhỏ. Tỏi lột vỏ rửa sạch băm nhỏ. Hành lá rửa sạch bỏ rể, cắt nhỏ. Đặt chảo dầu nóng, phi thơm hành tỏi , kế tiếp cho cà chua vào xào đều. Kế đến cho thịt xay vào xào đều cùng với gia vị cho thịt chín đều.Rồi cho tôm vào xào tiếp. Cuối cùng cho đậu hủ vào xào chín, rắc lên mặt tiêu và hành lá. Rắc lên mặt tiêu và hành lá rồi tắt bếp .","nutrition":{"kcal":308.1,"protein_g":21.3,"fat_g":21.9,"carbs_g":6.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02mat8m1i18oz5kr","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Hạt nêm Knorr"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i0314t8m1wfedtcnu#variant-1","name":"Hủ tiếu xào","detail_name":"Hủ tiếu xào","category":"Món khô","age_group":null,"serving":{"raw":"328 g / Dĩa vừa","quantity_value":328,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Hủ tiếu khô","quantity_raw":"90 g","quantity_value":90,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Mực tươi","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Gan heo (lợn)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dạ dày heo (lợn)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cải xanh","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","