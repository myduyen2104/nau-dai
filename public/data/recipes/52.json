3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01pit8m14u1ignj1#variant-1","name":"Canh khoai củ thịt bằm","detail_name":"Canh khoai củ thịt bằm","category":"Món canh 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"112.3 g / Chén","quantity_value":112.3,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Khoai tây","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Su su","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Khoai tây, cà rốt gọt vỏ sạch sẽ, rửa sạch sẽ để ráo. Thịt cắt miếng nhỏ, băm nhuyễn ướp với gia vị. Bắc nồi lên cho dầu ăn vào phi thơm với tỏi băm, cho thịt vào xào săn lại, đổ nước vào nồi Nước sôi cho khoai tây, cà rốt, vào nấu sôi lên lần nữa vớt sạch bọt. Nấu cho đến khi tất cả chín, nêm nếm lại cho vừa khẩu vị của gia đình.","nutrition":{"kcal":105.7,"protein_g":3.5,"fat_g":4.6,"carbs_g":12.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01pit8m14u1ignj1","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 8-18 tuổi","id":"mon_canh_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02c9t8m1jk7lyg8h#variant-1","name":"Chè đậu ván","detail_name":"Chè đậu ván","category":"Chè","age_group":null,"serving":{"raw":"117 g / Ly","quantity_value":117,"quantity_unit":"g","portion_label":"Ly"},"ingredients":[{"name":"Đậu ván","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Đậu ván rửa sạch, nhặt bỏ hạt hỏng, ngâm nước qua đêm, bóc vỏ. Cho cùi dừa đã nạo vào nồi nhỏ, thêm bột năng, đường và muối vào, đun lửa nhỏ và khuấy đều đến khi nước cốt dừa sệt lại thì để nguội. Cho đậu vào nồi đun đến khi hạt đậu chín nhừ thì cho đường, muối và lá nếp vào. Đun đến khi chè đậu sôi (10 phút) thì hạ lửa đun liu riu trong 20 phút cho đậu mềm. Khi đậu chín mềm, thêm bột năng khuấy với ít nước đổ vào nồi chè khuấy đều, sau đó cho nước cốt dừa vào nồi. Điều chỉnh lượng đường phù hợp với khẩu vị gia đình. Múc chè ra bát ,cho nước cốt dừa lên trên và thưởng thức","nutrition":{"kcal":281.4,"protein_g":2.6,"fat_g":9,"carbs_g":47.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02c9t8m1jk7lyg8h","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Chè","id":"che","kind":"food_category","baseLabel":"Chè"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02d6t8m14wq62exl#variant-1","name":"Chè trôi nước","detail_name":"Chè trôi nước","category":"Chè","age_group":null,"serving":{"raw":"139.5 g / Chén","quantity_value":139.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bột gạo nếp","quantity_raw":"52 g","quantity_value":52,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"22 g","quantity_value":22,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Vừng (đen, trắng)","quantity_raw":"3.5 g","quantity_value":3.5,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"\"Bước 1: Rửa sạch đậu xanh. Sau đó ngâm khoảng từ 5-6 tiếng để cho đậu xanh nở ra hết, sau đó vớt ra rửa lại và để ráo. Hòa tan nước với đường, khuấy đều và đun sôi trên bếp. Trong lúc đun sôi nước đường, lấy gừng (đã bỏ sạch vỏ) thái lát vào nồi đang đun, 1 – 2 phút sau thấy mùi gừng tỏa khắp nồi thì tắt bếp. Hấp chín đậu xanh. Tiếp đến, xay nhuyễn cho thật mịn phần đậu xanh đã được hấp chín. Cho đậu xanh đã nhuyễn vào cùng với nước, muối và cuối cùng là đường, đảo đều lên sao cho đậu xanh dính vào nhau. Sau đó vo viên lại từng phần nhỏ để làm nhân bánh. Trộn bột nếp với nước ấm, nhào đến khi bột không còn dính trên tay. Chia nhỏ bột ra từng phần và vo tròn lại. Lúc này cho đậu xanh vào chính giữa bột bánh, nặn thật khéo để làm sao cho nhân không rơi ra ngoài. Đun sôi nước và cho những phần bánh đã làm vào trong nồi. Luộc bánh cho đến khi thấy chúng nổi lên trên mặt nước thì vớt ra. Nhanh tay cho những phần bánh đã luộc chín vào nước đá lạnh để chúng không dính lại với nhau. Sau đó, múc bánh đã chín vào chén nước cốt dựa, rắc ít đậu phộng và thưởng thức.","nutrition":{"kcal":528.4,"protein_g":11.3,"fat_g":12,"carbs_g":93.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02d6t8m14wq62exl","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Vừng (đen, trắng)","unlisted_ingredient_phrase:au phong","unlisted_ingredient_phrase:bot banh","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:nuoc uong","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Chè","id":"che","kind":"food_category","baseLabel":"Chè"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02imt8m1etadta0a#variant-1","name":"Cua sốt me","detail_name":"Cua sốt me","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"107.5 g / Dĩa nhỏ","quantity_value":107.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cua bế","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Cua biển rửa sạch, để ráo, luộc chín, gỡ lấy thịt. Hành củ tươi bóc vỏ rửa sạch, bằm nhỏ. Hành lá rửa sạch bỏ rể, cắt nhỏ. Me hòa chung với nước ấm. Bắt chảo lên bếp, thêm một ít dầu ăn, cho hành củ đã băm nhỏ vào phi thơm. Cho cua vào xào chín nêm nếm gia vị vừa ăn. Cuối cùng cho nước me vào nêm nếm lại vừa ăn rồi tắt bếp rắc lên bề mặt 1 ít tiêu.","nutrition":{"kcal":152,"protein_g":14.4,"fat_g":5.5,"carbs_g":11.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02imt8m1etadta0a","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Quả me chua","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02plt8m1ys39tjsk#variant-2","name":"Đùi gà chiên chay","detail_name":"Đùi gà chiên chay","category":"Món chay","age_group":null,"serving":{"raw":"77 g / Dĩa vừa","quantity_value":77,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Tàu hủ ky tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Bột mì","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Sả lấy phần củ dài. Phi thơm sả cùng dầu ăn. Tàu hủ ky đem rửa sạch, lau khô nước và ướp tiêu, bột nêm, nước tương rồi để trong 10 phút cho thấm gia vị. Đem tàu hủ ky đã tẩm ướp gia vị chiên sơ và vớt ra để ráo dầu.Ướp thêm vào tàu hủ ky bột bắp, bột nêm, sả băm rồi để 30 phút cho thấm.Cắt tàu hủ ky thành những miếng nhỏ, lấy miếng tàu hủ cuốn vào phần đầu to của cọng sả sao cho nhìn giống như đùi gà. Đem đùi gà chiên vàng rồi vớt ra sắp đùi gà ra đĩa.","nutrition":{"kcal":176.5,"protein_g":9.4,"fat_g":14.6,"carbs_g":2.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02plt8m1ys39tjsk","quality_status":"unmatched","warnings":["duplicate_listing_row_occurrence","identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","unlisted_ingredient_phrase:bap bot","unlisted_ingredient_phrase:bot bap","unlisted_ingredient_phrase:bot bap bot","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:nuoc tuong","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món chay","id":"mon_chay","kind":"food_category","baseLabel":"Món chay"}],"source_age_group":null,"source_tag_evidence_status":"catalog_capture_unmatched_to_detail"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02z4t8m1o00hone1#variant-1","name":"Hến xào sả","detail_name":"Hến xào sả","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"114 g / Dĩa nhỏ","quantity_value":114,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Hến","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Hến sau khi đã rửa sạch, luộc hến với nước sôi và nhanh chóng vớt ra cho hến vào tô nước lạnh để tránh làm hến bị teo. Bạn rửa sạch sả sau đó băm nhỏ, tỏi bóc vỏ, băm nhỏ. Ướp hến Bạn cho thịt hến ra đĩa sau đó cho gia vị, trộn đều ướp khoảng 15 - 20 phút. Bạn cho sả ra dĩa, thêm chút gia vị. Bạn làm nóng chảo cho 1 muỗng canh dầu ăn vào, phi thơm tỏi băm. Tiếp tục bạn cho sả đã ướp gia vị vào xào đều trên lửa vừa khoảng 4 - 5 phút cho sả săn lại là được rồi bạn tắt bếp. Đun nóng dầu, phi thơm tỏi băm. Bạn tiếp tục cho hến đã ướp gia vị vào xào đều khoảng 4 - 5 phút, sau đó bạn cho phần sả ớt đã xào vào chảo hến, bạn tiếp tục xào đào đều khoảng 3 - 4 phút cho cạn hết nước, bạn nêm nếm lại cho vừa ăn rồi tắt bếp.","nutrition":{"kcal":101.5,"protein_g":4.6,"fat_g":5.8,"carbs_g":8.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02z4t8m1o00hone1","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Sả cây","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo0387t8m1n7nhz7fy#variant-1","name":"LH-C2-Sandwich thịt nướng phô mai","detail_name":"LH-C2-Sandwich thịt nướng phô mai","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"122 g","quantity_value":122,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Ba rọi rút sườn","quantity_raw":"29 g","quantity_value":29,"quantity_unit":"g"},{"name":"Thịt heo nạc dăm","quantity_raw":"24.5 g","quantity_value":24.5,"quantity_unit":"g"},{"name":"Phô mai dạng lát Teama 200g/12 lát","quantity_raw":"16 g","quantity_value":16,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"13.3 g","quantity_value":13.3,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"9 g","quantity_value":9,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"1.7 g","quantity_value":1.7,"quantity_unit":"g"},{"name":"Bánh mì Sandwich lạt, dạng lát","quantity_raw":"18 g","quantity_value":18,"quantity_unit":"g"},{"name":"Sốt Mayonnaise","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":314.6,"protein_g":4.7,"fat_g":12.4,"carbs_g":11.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oo0387t8m1n7nhz7fy","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03h4t8m18za2dbzr#variant-1","name":"Mì xào thịt gà","detail_name":"Mì xào thịt gà","category":"Món khô","age_group":null,"serving":{"raw":"292 g / Dĩa vừa","quantity_value":292,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Mì sợi khô","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt gà ta","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Ớt vàng to","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Ớt xanh to","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cần tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Đun sôi một nồi nước. Thả mì vào chần, khuấy sơ cho sợi mì tơi. Khi mì đã tơi và mềm thì vớt ra, xả nước lạnh khoảng 30 - 45s. Xóc mì cho ráo. Để ở nhiệt độ phòng cho mì khô bớt. Thịt gà ta rửa sạch, ướp gia vị. Cà rốt gọt vỏ, rửa sạch, thái sợi. Ớt vàng, ớt xanh, ớt đỏ rửa sạch thái sợi. Cần tây, rau mùi rửa sạch, cắt khúc vừa ăn. Bắt chảo lên bếp, thêm dầu vào phi thơm tỏi, xào thịt gà chín tới, thêm cà rốt, ớt vàng, ớt xanh, ớt đỏ vào đảo đều. Thêm gia vị vừa ăn. Thêm mỳ sợi vào đảo đều. Rắc ngò lên trên.","nutrition":{"kcal":613,"protein_g":27.4,"fat_g":18.3,"carbs_g":85.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03h4t8m18za2dbzr","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:kho bot"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03ozt8m1j4qbn50e#variant-1","name":"Nấm sốt dầu hào","detail_name":"Nấm sốt dầu hào","category":"Món chay","age_group":null,"serving":{"raw":"139.5 g / Dĩa vừa","quantity_value":139.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Nấm mỡ (nấm tây)","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi tây (cả lá)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu hào maggi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu tương (đậu nành)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":"\"Rửa sạch nấm qua nước và cắt bỏ gốc. Thái nấm và chân nấm thành miếng vừa ăn. Bắc chảo lên bếp, cho dầu ăn vào cho tới khi nóng lên thì cho tỏi băm vào xào cho thơm. Chỉnh lửa sang lửa to vừa để tỏi thơm và không bị cháy. Thấy mùi tỏi thơm rồi thì cho nấm vào, rồi tra dầu hào, xì dầu và nước (nếu cần). Đảo đều lên rồi lấy vụng đậy lại xào trong khoảng 3- 5 phút. Thỉnh thoảng mở ra đảo và kiểm tra. Nếu thấy lượng 