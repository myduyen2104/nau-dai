ành tây bóc vỏ, cắt hạt lựu nhỏ, cho vào tô trứng gà Đổ đều một lớp trứng mỏng lên mặt chảo. Khi trứng hơi chín, nhẹ nhàng cuộn trứng lại. Khi cuộn còn khoảng 5cm thì đẩy miếng trứng về góc chảo. Tiếp tục đổ thêm một lớp trứng nữa, đè lên 5cm trứng dư của lớp cũ. Khi trứng bắt đầu hơi đông lại, tiếp tục cuộn, để dư 5cm rồi lại đẩy miếng trứng về góc chảo. Làm tương tự cho đến hết. Sau khi trứng chín, để nguội khoảng 5 phút rồi cắt trứng thành miếng vừa ăn. Ăn kèm với kim chi cải thảo cũng rất ngon.","nutrition":{"kcal":72.2,"protein_g":3.6,"fat_g":5.6,"carbs_g":2.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05dtt8m1vh7dzat2","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà ta (35g/quả)","ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:cai thao","unlisted_ingredient_phrase:kim chi"],"source_categories":[{"label":"Món mặn 18-24 tháng tuổi","id":"mon_man_18_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"18-24 tháng","id":"18_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05fqt8m15usda1qy#variant-1","name":"Trứng gà chiên hàu","detail_name":"Trứng gà chiên hàu","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"133.5 g / Dĩa vừa","quantity_value":133.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Hàu","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity