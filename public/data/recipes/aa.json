g nữa. Bánh mì cắt dọc bỏ bớt phần ruột, cán phẳng. Đậu hũ cắt theo chiều dọc dày 1.5cm. Trải vỏ bánh mì ngửa mặt trong ra, phết phần hỗn hợp vừa làm đều lên. Tiếp tục đắp lớp đậu phụ lên trên cùng. Gói chặt lại bằng lá chuối cho các phần dính đều nhau và đem hấp chừng 20 phút. Sau khi lấy ra thì để nguội rồi gỡ lá chuối ra. Hòa xì dầu, bột nêm, muối, đường và tiêu rồi dùng cọ quét đều lên mặt bánh mì. Để hơi khô rồi cắt thành từng thớ dài như miếng thịt quay thường.Cho từng miếng thịt vào áp chảo lần lượt các mặt. Lưu ý áp chảo phần mặt bánh mì trước sao cho mặt bánh mì vàng giòn như màu da của thịt quay.Cắt miếng vuông vừa ăn. Thành phẩm phải có da màu vàng cam, giòn đều. Lớp giả mỡ trong và hơi dai. Các lớp dính với nhau không bị rời rạc.","nutrition":{"kcal":248,"protein_g":9.5,"fat_g":13.6,"carbs_g":21.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh0586t8m1kyb90w7x","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tàu hủ ky khô","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món chay","id":"mon_chay","kind":"food_category","baseLabel":"Món chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"}]