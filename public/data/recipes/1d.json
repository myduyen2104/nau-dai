g0p4qu00u7t8m1swcjk4hv","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ 9-24 tháng","id":"mon_bot_nha_nau_cho_tre_9_24_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"9-24 tháng","id":"9_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv010it8m1hpe57zob#variant-1","name":"Bún ốc nấu chuối xanh đậu phụ","detail_name":"Bún ốc nấu chuối xanh đậu phụ","category":"Món nước 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"316.8 g / Tô nhỏ","quantity_value":316.8,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Ốc bươu","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"chuối xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Lá lốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tía tô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá (loại đặc biệt)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Ốc bươu ngâm, rửa sạch, luộc chín. Để nguội sau đó dùng nỉa lấy thịt ốc, bỏ phần đuôi. Thịt ba rọi rửa sạch cắt miếng nhỏ vừa ăn. Chuối xanh lột vỏ ngâm với chút mẻ hoặc chanh cho chuối không bị đen, cắt quả chuối làm ba khoanh mỗi khoanh chẻ làm đôi là được. Đậu hũ cắt miếng vuông khoảng 2cm, chiên vàng đều. Lá lốp + lá tía tô cắt khúc khoảng 1cm. Hành tím bằm phi vàng thơm cho ốc và thịt ba rọi vào xào cho săn chín nêm ít cơm mẻ, mắm tôm, bột ngọt xào tiếp cho thấm. Nêm thêm nước dùng hoặc nước trắng cũng được ( khoảng 1 lít ). Nấu chung với chuối, chín đều nêm thêm lần nữa theo khẩu vị sao cho có vị chua chua vừa và sự đậm đà của mắm tôm hòa quyện chung là được. Ăn chung với bún.","nutrition":{"kcal":377.1,"protein_g":14.8,"fat_g":10.4,"carbs_g":56.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv010it8m1hpe57zob","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Hạt tiêu","title_ingredient_not_mentioned:Đậu phụ (đậu hũ)","unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:mam tom","unlisted_ingredient_phrase:nuoc dung"],"source_categories":[{"label":"Món nước 6-7 tuổi","id":"mon_nuoc_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw0142t8m1eskzqyp7#variant-1","name":"Cá chép chưng tương","detail_name":"Cá chép chưng tương","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"111.5 g / Dĩa nhỏ","quantity_value":111.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá chép","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Miến dong khô","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đậu tương (đậu nành)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Cần tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cá chép mua về rửa sạch, ướp gia vị 30 phút. Mộc nhĩ, miến dong ngâm nước cho mềm cắt khúc vừa ăn. Cần tây rửa sạch bỏ gốc cắt khúc vừa ăn. Cà chua rửa sạch cắt vừa ăn. Hành tây lột vỏ rửa sạch cắt múi cau. Hành lá bỏ rễ rửa sạch cắt nhỏ. Đậu tương dầm nhuyễn. Bắt lên bếp 1 cái chảo phi thơm hành tỏi băm cùng với dầu ăn sau đó cho thêm đậu tương vào xào chun với 1 chút nước để lửa sôi bùng lên tắt bếp. Chuẩn bị 1 cái chảo khác cho cá vào chiên vàng đều trở cá chín đều 2 mặt. Cho hành lá mộc nhỉ, miếng dong và chảo cá đảo đều trên lửa nhỏ. Tiếp theo là cho phần đậu tương đã xào vào chảo cá để nhỏ lửa cho chín kỹ nếm nếm cho vừa ăn. Cuối cùng cho hành tây và hành lá vào đảo đều tắt bếp. Múc cá ra dĩa rắc lên cá 1 chút tiêu và cần tây là có thể dùng được.","nutrition":{"kcal":147.4,"protein_g":13.1,"fat_g":6.2,"carbs_g":10.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw0142t8m1eskzqyp7","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_ph