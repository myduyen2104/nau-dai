":{"label":"18-24 tháng","id":"18_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01d2t8m1xetuy3v1#variant-1","name":"Cá trê chiên","detail_name":"Cá trê chiên","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"37 g / Dĩa nhỏ","quantity_value":37,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá trê","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Cá mua về rửa sạch cá với muối , để ráo. Tỏi băm nhuyễn. Đặt chảo lên bếp cho dầu ăn vào, kế tiếp thả cá vào chiên cho chín vàng đều trở cá cho chín 2 mặt. Pha hỗn hợp nước mắm gồm tỏi băm, chanh, đường nước mắm và nước sôi để nguội đánh tan hỗn hợp trên. Sau cùng vớt cá ra dĩa là dùng được.","nutrition":{"kcal":83.5,"protein_g":5.1,"fat_g":6.6,"carbs_g":1.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01d2t8m1xetuy3v1","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá trê","title_ingredient_not_mentioned:Cá trê","unlisted_ingredient_phrase:hon hop"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01gtt8m16vxbob4n#variant-1","name":"Canh bí đao nấu thịt heo","detail_name":"Canh bí đao nấu thịt heo","category":"Món canh từ 18-24 tháng tuổi","age_group":"18-24 tháng","serving":{"raw":"31.2 g / Chén","quantity_value":31.2,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bí đao (bí xanh)","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Bí đao gọt vỏ, rửa sạch cắt miếng vừa ăn - Thịt rửa sạch băm nhuyễn, ướp gia vị vừa ăn - Bật bếp, cho dầu ăn vào nồi đun nóng. Khi dầu đã nóng, bạn cho hành khô băm nhỏ vào phi thơm lên rồi đổ thịt băm đã ướp gia vị vào đảo đều. - Khi thịt săn bạn đổ vào nồi nước và đun sôi lên. Khi nước sôi thì vặn lửa nhỏ lại, sau đó cho bí xanh vào nấu chín, nêm nếm lại gia vị cho vừa ăn.","nutrition":{"kcal":32.6,"protein_g":1.2,"fat_g":2.8,"carbs_g":0.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01gtt8m16vxbob4n","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh từ 18-24 tháng tuổi","id":"mon_canh_tu_18_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"18-24 tháng","id":"18_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qy01i1t8m1kp6h0szn#variant-1","name":"Canh bông hẹ đậu hủ trắng","detail_name":"Canh bông hẹ đậu hủ trắng","category":"Món canh 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"51.5 g / Chén","quantity_value":51.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bông hẹ","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Đậu hũ cắt miếng vừa ăn, bông hẹ rửa sạch cắt khúc vừa ăn. Thịt rửa sạch, xay nhuyễn ướp với gia vị. Bắt nồi lên, cho dầu vào phi thơm với tỏi băm, cho thịt vào xào đến khi thịt săn lại Cho nước vào nấu sôi, sau đó cho đậu hũ vào trước rồi tới bông hẹ. Để canh sôi lên, nêm nếm gia vị vừa ăn tắt lửa. Múc ra tô, rắc thêm ít tiêu lên mặt.","nutrition":{"kcal":29.1,"protein_g":1.9,"fat_g":1.6,"carbs_g":2.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qy01i1t8m1kp6h0szn","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 25-35 tháng tuổi","id":"mon_canh_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qy01ift8m1wzms4lax#variant-1","name":"Canh cà chua trứng gà","detail_name":"Canh cà chua trứng gà","category":"Món canh 5 tuổi","age_group":"5 tuổi","serving":{"raw":"74.5 g / Chén","quantity_value":74.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cà chua","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Hành lá rửa sạch, cắt nhỏ. Cà chua bỏ cuống, rửa sạch, bổ múi cau. Hành khô bóc vỏ ngoài, cắt lát mỏng. Trứng gà đập vào chén, dùng đũa đánh bông lên. Bắc nồi lên bếp, phi thơm hành khô với dầu ăn rồi cho cà chua vào đảo cho mềm. Khi cà chua chín mềm, cho nước một lượng vừa ăn vào nồi rồi đun sôi, nêm gia vị và khuấy nhẹ để gia vị tan đều. Sau đó, trút nhẹ trứng từ trong chén vào nồi, dùng đũa khuấy theo vòng tròn thật nhẹ nhàng và đều tay. Đồng thời hạ nhỏ lửa, nấu sôi thêm khoảng 2-3 phút cho trứng chín hẳn thì tắt bếp. Cuối cùng cho hành lá cắt nhỏ vào nồi, múc canh ra tô.","nutrition":{"kcal":33.7,"protein_g":1.7,"fat_g":1.9,"carbs_g":2.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qy01ift8m1wzms4lax","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01pnt8m11e6xa93t#variant-1","name":"Canh khoai mỡ nấu thịt heo","detail_name":"Canh khoai mỡ nấu thịt heo","category":"Món canh 5 tuổi","age_group":"5 tuổi","serving":{"raw":"39.5 g / Chén","quantity_value":39.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Khoai mỡ (củ cái)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Chuẩn bị nguyên liệu: Khoai mỡ gọt vỏ rửa sạch thái mỏng băm nhỏ, rau mùi tàu, rau thơm rửa sạch, cắt nhỏ. Thịt heo bằm ướp gia vị . Bắt nồi lên bếp, cho dầu ăn vào phi thơm với hành tím. Tiếp theo cho thịt