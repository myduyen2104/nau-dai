quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Đậu hũ rửa sạch, để ráo, cắt thành khối vuông nhỏ vừa ăn. Hành , tỏi làm sạch, băm nhỏ. Thịt rửa sạch, để ráo rồi cắt miếng mỏng vừa ăn. Ướp thịt với gia vị, hành và tỏi băm. Đảo đều cho thịt thấm gia vị. Ướp thịt khoảng 30 - 40 phút. Bắc chảo lên bếp, bật bếp lửa vừa, cho đậu vào chiên ngập dầu. Chiên cho đậu vàng đều các mặt thì vớt ra, để ráo bớt dầu. Bắc nồi lên bếp, cho dầu ăn vào nồi, làm nóng dầu với lửa vừa rồi cho phần hành băm còn lại vào phi thơm. Khi hành vàng thơm thì vớt hành cho vào tô thịt, trộn đều lên. Cho tiếp vào nồi đường, nấu lửa vừa và đảo đều cho đường tan ra, có màu vàng nâu đẹp mắt thì giảm lửa nhỏ nhất, cho phần tỏi băm còn lại vào phi thơm. Cho thịt đã ướp vào xào săn lại, cho thêm nước vào nồi cho nước xấp xấp thịt. Kho thịt được khoảng 15 phút, nước bắt đầu cạn và thịt sắp chín thì cho đậu hũ vào, đảo đều. Tắt bếp.","nutrition":{"kcal":152.5,"protein_g":10.6,"fat_g":9.9,"carbs_g":5.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02lkt8m18flmifh5","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:noi lam","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02nkt8m1q9rmcw2s#variant-1","name":"Đậu 