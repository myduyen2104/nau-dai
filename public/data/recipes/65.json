ptured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw018yt8m1j6p0z70y#variant-1","name":"Cá lóc xào măng","detail_name":"Cá lóc xào măng","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"66 g / Dĩa nhỏ","quantity_value":66,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá quả (cá lóc)","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Măng tre","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cá lóc rửa sạch với muối cho hết nhớt, phi lê thành từng miếng nhỏ vừa ăn, ướp gia vị trong 10 phút. Măng tre rửa sạch luộc với muối rồi cắt khúc vừa ăn. Hành củ lột vỏ rửa sạch, băm nhuyễn. Hánh lá rửa sạch, bỏ rể, cắt nhỏ. Cho dầu ăn vào chảo chiên sơ cá rồi vớt ra dĩa. Gặn bớt dầu cho hành đã băm nhuyễn vào vào thơm cho tiếp măng vào xào. Cuối cùng cho tiếp cá vào xào đến khi chín kỹ nêm nếm gia vị vừa ăn, cho thêm hành lá đã cắt nhỏ vào rồi tắt bếp múc cá và măng ra dĩa rắc lên trên mặt 1 ít tiêu.","nutrition":{"kcal":77.7,"protein_g":4.4,"fat_g":5.6,"carbs_g":2.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw018yt8m1j6p0z70y","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01ddt8m1924zqlf6#variant-1","name":"Cá trê nướng dầm nước mắm","detail_name":"Cá trê nướng dầm nước mắm","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"59 g / Dĩa nhỏ","quantity_value":59,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá trê","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cá mua về rửa sạch cá với muối , để ráo. Đem đi nướng. Pha hỗn hợp nước mắm gồm tỏi băm, chanh, đường, gừng nước mắm và nước sôi để nguội đánh tan hỗn hợp trên. Sau cùng vớt cá ra dĩa là dùng được.","nutrition":{"kcal":95.1,"protein_g":8.5,"fat_g":6,"carbs_g":1.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01ddt8m1924zqlf6","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá trê","title_ingredient_not_mentioned:Cá trê","unlisted_ingredient_phrase:hon hop","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01oqt8m1x2gwwrx9#variant-1","name":"Canh hẹ cà chua đậu hủ","detail_name":"Canh hẹ cà chua đậu hủ","category":"Món canh chay 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"171.5 g / Chén","quantity_value":171.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Hẹ lá","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Cà chua thái múi cau. Giá đỗ nhặt rửa sạch. Hẹ, cần tàu cắt khúc. Đậu hũ xắt miếng vuông. Bắc nồi lên bếp, cho nước vào cùng với muối, hạt nêm, đường, nấu sôi dưới lửa lớn.Sau đó, bạn cho đậu hũ, cà chua, hẹ, cần tàu vào, vặn nhỏ lửa lại nấu chín nguyên liệu. Khi canh hẹ đậu hũ cà chua gần chín, nếm thử vị xem vừa ăn chưa và bổ sung hợp lý xong tắt bếp là hoàn thành món ăn.\"","nutrition":{"kcal":48.9,"protein_g":3.9,"fat_g":1.4,"carbs_g":5.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01oqt8m1x2gwwrx9","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nguyen lieu","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh chay 8-18 tuổi","id":"mon_canh_chay_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh chay"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt020yt8m1gqldtz4j#variant-1","name":"Cháo thập cẩm","detail_name":"Cháo thập cẩm","category":"Món nước 5 tuổi","age_group":"5 tuổi","serving":{"raw":"153.5 g / Tô nhỏ","quantity_value":153.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hạt sen khô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cà rốt, khoai tây các bạn gọt vỏ rữa sạch sau đó cắt thành hạt lựu. Nấm rơm cắt bỏ gốc, ngâm muối, rửa sạch, để ráo. Hạt sen khô ngâm nước ấm cho hạt mềm. Thịt heo nạc, rửa với muối sau đó rửa sạch lại với nước, để ráo, băm thịt nhỏ, ướp gia vị vừa ăn. Gạo các bạn vo sạch sau đó đổ nước và cho hạt sen, thịt heo băm vào cùng bắt lên bếp. Khi thấy gạo nở bung đều, hạt sen mềm rồi thì tiếp tục phi gốc hành thơm sau đó cho cà rốt, khoai tây, nấm rơm đảo cho thơm rồi đổ vào nồi cháo Nấu sôi đến khi các loại rau củ vừa chín tới, nêm nếm lại, tắt bếp và cho hành ngò và tiêu vào. Cuối cùng các bạn tắt bếp nêm gia vị vừa ăn, cho vào tí tiêu cùng hành poa-rô lá và ngò cho thơm nhé!","nutrition":{"kcal":386,"protein_g":12.6,"fat_g":18.9,"carbs_g":42.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt020yt8m1gqldtz4j","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:heo nac","unlisted_ingredient_phrase:thit heo nac","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"lab