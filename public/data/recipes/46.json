êm hành ngò, ngò gai xắt nhỏ. Ăn kèm bún sợi nhỏ, rau sống.","nutrition":{"kcal":600.5,"protein_g":23.8,"fat_g":16.6,"carbs_g":89.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00xbt8m1wbi8qzu0","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Cà chua","ingredient_not_mentioned_by_name:Hoa chuối","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:ngo gai","unlisted_ingredient_phrase:nguyen chat","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:nuoc mam","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw018gt8m19exctoya#variant-1","name":"Cá lóc nướng trui","detail_name":"Cá lóc nướng trui","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"138 g / Dĩa nhỏ","quantity_value":138,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá quả (cá lóc)","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Bánh đa nem/ Bánh tráng","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Bún tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Khế","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"chuối xanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":