com","kind":"food_category","baseLabel":"Cơm"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02l3t8m168qlt6fm#variant-1","name":"Đậu hũ kho nấm rơm","detail_name":"Đậu hũ kho nấm rơm","category":"Món mặn","age_group":null,"serving":{"raw":"121 g / Dĩa nhỏ","quantity_value":121,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Đậu phụ chiên","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Nấm rơm cắt chân rửa sạch để ráo. Tỏi ta lột vỏ rửa sạch, băm nhỏ. Hành lá bỏ rể, rửa sạch, cắt nhỏ. Đặt 1 cái nồi lên bếp phi thơm tỏi cùng dầu ăn. Kế tiếp cho nấm vào xào đều , cho tiếp đậu hủ và gia vị vào kho nhỏ lửa. Cuối cùng nêm nếm lại cho vừa ăn rồi tắt bếp, rắc thêm tiêu và hành lá lên mặt.","nutrition":{"kcal":152.9,"protein_g":12.1,"fat_g":9.1,"carbs_g":6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02l3t8m168qlt6fm","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02wrt8m1izrs4scp#variant-1","name":"Gỏi gà xé","detail_name":"Gỏi gà xé","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"113.3 g / Dĩa vừa","quantity_value":113.3,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt gà ta","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"Thịt gà sau khi mua về bạn dùng muối xát đều lên da để khử mùi hôi hiệu quả. Sau đó, rửa lại với 3 lần nước sạch. Chuẩn bị một âu nước lạnh nhỏ. Bóc vỏ hành tây, rửa sạch rồi thái thành sợi mỏng và cho hết vào âu nước lạnh ngâm trong khoảng 15 – 20 phút cho bớt mùi hăng. Rau răm nhặt những lá non rồi mang rửa sạch và vớt ra rổ để ráo nước. Tỏi bóc lớp vỏ khô bên ngoài rồi dùng dao băm nhuyễn Đậu phụng mang đi rang chín đều. Sau đó, xa vỏ và cho vào cối giã nhỏ vừa phải, đừng mịn quá. Cà rốtgọt vỏ, rửa sạch, cắt sợi nhuyễn. Bạn pha nước chấm: nước cốt chanh, nước mắm, đường, nước trắng, ớt, tỏi băm nhuyễn. Nhớ trộn đều cho các nguyên liệu quyện đều vào nhau nhé. Gà sau khi sơ chế xong, bạn mang luộc chín. Sau đó, vớt ra để ráo nước, đợi nguội rồi xé sợi. Chuẩn bị một âu sạch. Tiến hành cho lần lượt các nguyên liệu vào chung, gồm: thịt gà xé sợi, hành tây, cà rốt, rau răm đã được sơ chế. Rưới nước chấm vào âu nguyên liệu ở bước 2 rồi trộn đều và để yên khoảng 15 phút cho nước chấm thấm đều vào nguyên liệu. Cuối cùng, bạn rắc đậu phụng đập nhỏ và một ít tiêu xay lên trên rồi dọn ra dĩa, trang trí tùy thích và mời mọi người thưởng thức.","nutrition":{"kcal":141.7,"protein_g":9.1,"fat_g":6.3,"carbs_g":12.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02wrt8m1izrs4scp","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phộng (lạc hạt)","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc cot","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03l2t8m1fhs9o7cc#variant-1","name":"Mít kho chay","detail_name":"Mít kho chay","category":"Món chay","age_group":null,"serving":{"raw":"159 g / Dĩa vừa","quantity_value":159,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Mít non","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước tương MAGGI Đậu Nành Đậm Đặc - NESTLÉ","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Mít non để nguyên trái cho vào luộc. Mít sau khi chín, để nguội rồi cắt thành từng khoanh rồi đem chiên chín, sau đó cắt vỏ thì mít sẽ không bị dính mủ và khi kho sẽ có màu đẹp. Sau đó xếp mít đã chiên vào nồi đã cho rau răm.Cho hạt nêm, nước tương, ớt cắt làm đôi, tương ớt. Đậy nắp lại, để lửa liu riu khoảng 20 phút, thỉnh thoảng trở mít cho thấm đều và nêm vừa cho vừa ăn.","nutrition":{"kcal":81.5,"protein_g":3.5,"fat_g":3.5,"carbs_g":17.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03l2t8m1fhs9o7cc","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:rau ram","unlisted_ingredient_phrase:tuong ot","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món chay","id":"mon_chay","kind":"food_category","baseLabel":"Món chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tv00aet8m1863luw07#variant-1","name":"Phở bò sốt vang","detail_name":"Phở bò sốt vang","category":"Món nước 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"259.5 g / Tô nhỏ","quantity_value":259.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Thịt bò loại 2","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Rượu vang đỏ (cồn 9.5 g)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"- Bước 1: Thịt bò chần qua nước sôi rồi rửa sạch, sau đó đem thái miếng vuông (nên thái to một chút vì khi nấu thịt sẽ bị ngót đi). - Bước 2: Ướp thịt với bột nghệ, gia vị và rượu vang. -Bước 3: Phi thơm tỏi với bơ, cho thịt bò vào xào qua. Nêm thêm chút gia vị, đảo đều, sau đó đổ nước vào nồi, đun sôi. -Bước 4: Cà chua thái miếng vào. Xào chín mềm cà rồi dùng thìa dằm cho cà nhuyễn ra. - Bước 5: Trút cà chua vừa xào nhuyễn vào nồi thịt bò, thêm lá nguyệt quế, 1 mẩu gừng đập dập, quế và hồi đã rửa sạch vào. Đun sôi khoảng vài phút rồi hạ lửa ninh liu riu. - Bước 6: Khi thịt bò đã chín nhừ thì cho tương cà vào, nêm thêm chút hạt nêm, đảo đều. Thả hành hoa và rau mùi thái nhỏ vào rồi tắt bếp. Bước 7: Chần bánh phở qua nước sôi, chia bánh phở vào từng bát tô rồi múc thịt bò sốt vang chan lên bát bánh phở.","nutrition":{"kcal":360.2,"protein_g":13.5,"fat_g":9.9,"carbs_g":54.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tv00aet8m1863luw07","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Chanh","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:tuong ca","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món nước 6-7 tuổi","id":"mon_nuoc_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gi05aft8m1gxlkm588#variant-1","name":"Tôm hấp nước dừa","detail_name":"Tôm hấp nước dừa","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"143.5 g / Dĩa nhỏ","quantity_value":143.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Tôm đồng","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Nước dừa non tươi","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Tôm cho vào rổ, sả dưới vòi nước cho vỏ sạch. Vớt ra rổ để ráo bớt nước. Dừa tươi, chọn trái lớn, chặt lấy nước. Cho vào nồi. Tiếp đến cho tôm vào cùng. Hấp tôm không cần quá nhiều nước, chi cần ngập đến khoảng 1/2 so với lượng tôm trong nồi là được. Khi hấp đậy kín nắp nồi. Khi thấy tôm phía dưới nồi bắt đầu đỏ, thì cầm 2 quai nồi, xóc đều tôm lên cho phần trên chín đều. Tôm đỏ sậm màu là được. Đổ tôm qua 1 cái rổ, bỏ phần nước dừa. Ăn khi tôm còn nóng và nhớ chấm kèm muối tiêu chanh đã pha nha.","nutrition":{"kcal":87,"protein_g":15,"fat_g":1.5,"carbs_g":3.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05aft8m1gxlkm588","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:sam mau","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gi05dvt8m14vctdq4z#variant-1","name":"Trứng chiên hành tây cuộn","detail_name":"Trứng chiên hành tây cuộn","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"65 g / Dĩa nhỏ","quantity_value":65,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng gà ta (35g/quả)","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cho trứng gà, gia vị vào tô, đánh tan. Hành tây bóc vỏ, cắt hạt lựu nhỏ, cho vào tô trứng gà Đổ đều một lớp trứng mỏng lên mặt chảo. Khi trứng hơi chín, nhẹ nhàng cuộn trứng lại. Khi cuộn còn khoảng 5cm thì đẩy miếng trứng về góc chảo. Tiếp tục đổ thêm một lớp trứng nữa, đè lên 5cm trứng dư của lớp cũ. Khi trứng bắt đầu hơi đông lại, tiếp tục cuộn, để dư 5cm rồi lại đẩy miếng trứng về góc chảo. Làm tương tự cho đến hết. Sau khi trứng chín, để nguội khoảng 5 phút rồi cắt trứng thành miếng vừa ăn. Ăn kèm với kim chi cải thảo cũng rất ngon.","nutrition":{"kcal":94.7,"protein_g":5.5,"fat_g":7.2,"carbs_g":2.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05dvt8m14vctdq4z","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà ta (35g/quả)","ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:cai thao","unlisted_ingredient_phrase:kim chi","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05k9t8m119nmwt4z#variant-1","name":"Vịt kho gừng","detail_name":"Vịt kho gừng","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"66.5 g / Dĩa nhỏ","quantity_value":66.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Vịt rửa sạch, để ráo, chặt miếng vừa ăn, ướp gia vị trong 15 phút. Hành củ, gừng rửa sạch, băm nhuyễn. Bật bếp, chỉnh lửa nhỏ vừa và cho chảo chống dính lên bếp, chờ cho chảo nóng thì bạn cho 2 muỗng đường vào, đảo đều tay cho đến khi đường tan ra và chuyển thành màu nâu. Tiếp theo, bạn cho thêm nước vào, khuấy đều tay và đun sôi. Đun tiếp cho đến khi nước màu sánh và sệt lại thì bắc chảo xuống.Bạn cho nước màu vào nồi vịt, trộn đều và cho lên bếp để đun sôi. Khi vịt sôi, bạn dùng đũa đảo đều, chỉnh lửa nhỏ liu riu, cho hành củ, gừng vào và mở nắp để đun cho đến khi thịt vịt săn, chắc thịt, còn nước kho thì sệt và sánh lại là được. Bạn nêm nếm lại cho vừa miệng là có thể tắt bếp.","nutrition":{"kcal":155.4,"protein_g":7.5,"fat_g":11.8,"carbs_g":5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05k9t8m119nmwt4z","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:nuoc mau","identical_recipe_content_on_distinct_source_urls"],"sour