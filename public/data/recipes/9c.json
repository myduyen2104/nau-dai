","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cà chua rửa sạch, bổ múi cau. Lấy cải chua ra rửa cho bớt mặn. Sau đó cắt cải chua khúc nhỏ vừa ăn cho vào nồi thêm nước đun sôi, cho cà chua vào. Khi nước sôi nhẹ thì mình nêm nếm gia vị. Điều chỉnh sao cho nước canh có vị chua chua mặn mặn là được. Thịt bò thái lát mỏng và ướp với gia vị. Sau đó bắt chảo và phi tỏi với dầu cho vàng và vớt tỏi ra. Bỏ thịt bò đã ướp vào xào sơ với dầu tỏi cho thơm. Tắt bếp nồi canh và đổ thịt bò vào khuấy đều. Sau đó bỏ luôn phần tỏi đã phi vào trong nồi canh sẽ làm cho canh thơm ngon hơn.","nutrition":{"kcal":30.5,"protein_g":2.6,"fat_g":1.4,"carbs_g":2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01met8m1xtjeez0a","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01xzt8m1m5r7ftmw#variant-1","name":"Canh súp lơ xanh nấu tôm","detail_name":"Canh súp lơ xanh nấu tôm","category":"Món canh từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"57.5 g / Chén","quantity_value":57.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Súp lơ xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Ngâm súp lơ với 1 ít muối, sau đó rửa sạch lại bằng nước lạnh thông thường. Phần bông dùng dao tách lần lượt từng nhánh, phần thân gọt lớp vỏ cứng bên ngoài sau đó cắt miếng vừa ăn. Tôm rửa sạch, lột sạch vỏ, sau đó tách đầu tôm để riêng. Giã nhuyễn phần thân để phần nước canh được ngọt hơn. Tiếp theo phi thơm hành tím cùng với đầu tôm và thân tôm giã nhuyễn. Nêm một ít hạt nêm vào xào chung. Khi tôm đã chín đều thì cho nước vào nấu sôi. Khi nước sôi, bạn hớt bớt phần bọt để cho nước canh được trong hơn. Nêm nếm gia vị cho vừa ăn. Cuối cùng cho súp lơ đã cắt vào nấu cho đến khi sôi lại, sôi được thêm 2 phút thì tắt bếp rồi rắc thêm một ít tiêu.","nutrition":{"kcal":32.6,"protein_g":2.4,"fat_g":1.2,"carbs_g":3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01xzt8m1m5r7ftmw","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Súp lơ xanh","ingredient_not_mentioned_by_name:Dầu thực vật","title_ingredient_not_mentioned:Súp lơ xanh","unlisted_ingredient_phrase:hat nem"],"source_categories":[{"label":"Món canh từ 3-4 tuổi","id":"mon_canh_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02f2t8m1nsqiu1do#variant-1","name":"Chim cút chiên bơ tỏi","detail_name":"Chim cút chiên bơ tỏi","category":"Món mặn","age_group":null,"serving":{"raw":"76.5 g / Dĩa nhỏ","quantity_value":76.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Chim cút (thịt và da)","quantity_raw":"55 g","quantity_value":55,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"nam