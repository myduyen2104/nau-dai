ại. Khi nước dùng vừa sôi, thêm vào nồi phần cà chua xào hạ nhỏ lửa và đun thêm 10 phút, nêm gia vị vừa ăn. Cuối cùng cho bún, mãng riêu tôm, hành, ngò, tiêu và chan nước vào ăn kèm với rau.","nutrition":{"kcal":443.6,"protein_g":20.9,"fat_g":9.7,"carbs_g":68.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv011gt8m1wluuk99m","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Hoa chuối","ingredient_not_mentioned_by_name:Chanh","unlisted_ingredient_phrase:cai trang","unlisted_ingredient_phrase:cu cai trang","unlisted_ingredient_phrase:ham nuoc","unlisted_ingredient_phrase:ham nuoc dung","unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:toi xay","unlisted_ingredient_phrase:xuong ga","unlisted_ingredient_phrase:xuong heo"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw014at8m19qnzace4#variant-1","name":"Cá chim chiên","detail_name":"Cá chim chiên","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"36 g / Dĩa nhỏ","quantity_value":36,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá chim","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"4 g","quantity_value":4,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"ins