:null,"serving":{"raw":"134 g / Dĩa nhỏ","quantity_value":134,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bò loại 2","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Dưa cải bẹ","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch thái mỏng ướp gia vị trong 20 phút. Dưa cải bẹ rửa sạch cắt nhỏ. Cà chua rửa sạch cắt vừa ăn. Rau mùi rửa sạch bỏ gốc, cắt nhỏ. Đặt chảo lên bếp phi thơm tỏi cùng dầu ăn, cho thêm thịt bò vào xào vừa chín tới xúc ra dĩa. Dùng chiếc chảo đó cho thêm dầu vào xào cùng cà chua và dưa cải bẹ cho thơm nêm nếm gia vị vừa ăn cho thịt bò đã xào chín vào đảo nhanh tay. Cuối cùng tắt bếp xúc ra dĩa rắc thêm chút tiêu và rau mùi lên mặt.","nutrition":{"kcal":144.7,"protein_g":8.7,"fat_g":9.4,"carbs_g":6.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tz00rrt8m1bc5qeov1","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv011nt8m1o4wxomch#variant-1","name":"Bún thang","detail_name":"Bún thang","category":"Món nước 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"182.3 g / Tô nhỏ","quantity_value":182.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"120 g","quantity_value":120,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Trứng vịt (55g/quả)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tôm khô","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Thịt gà công nghiệp, lườn","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Gừng đã rửa sạch đem nướng cho đến khi nào chín và có mùi thơm. Bước 2: Cho gà vào nồi luộc, đến khi sôi thì cho một chút gia vị 1 muỗng hạt nêm, 1/2 muỗng đường, 1 muỗng cafe muối và hành khô, gừng đã nướng thơm vào, hạ nhỏ lửa để gà chín bên trong. Sau khi vớt ra để nguội Sau, bạn dùng tay xé sợi vừa ăn và để riêng. Bước 3: Xương heo cho vào nồi đun sôi với nước, sau đó đổ hết nước đó đi, cho ra vào nước lạnh rửa sạch vụn xương. Sau đó đổ xương vào nồi nước luộc gà ninh nhừ (khoảng 2 – 3 tiếng) để làm nước dùng. Bước 4: Trong khi ninh xương để nấu nước dùng, bạn bật một bên bếp khác lên, cho chảo chống dính lên bếp. Khi chảo nóng già thì cho tôm khô vào rang thơm rồi cho ra đĩa. Bước 5: Cho dầu ăn vào tráng đều mặt chảo, cho bát trứng đã đánh vào rán sao cho thật mỏng. Đến chi chín cho trứng ra đĩa, đợi trứng nguội thì thái thành sợi nhỏ. Bước 6: Khi nồi nước ninh xương đun được khoảng 50 phút đến 1 tiếng, thì cho tôm khô đã rang, đường phèn, hạt nêm, muối và chút nước mắm vào, khuấy đều. Tiếp tục ninh thêm 1 hoặc 2 tiếng nữa thì nêm nếm lại gia vị cho vừa miệng, cho hành lá và rau răm xắt nhỏ vào, rồi tắt bếp. Bước 7: Bún đem trần qua với nước, xếp các loại nhân lên trên rồi chan nước dùng vào là xong. Nếu ai có thể ăn được mắm tôm thì bạn cho ½ thìa cafe mắm tôm lên trên.","nutrition":{"kcal":288.4,"protein_g":12.6,"fat_g":11,"carbs_g":35.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv011nt8m1o4wxomch","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt gà công nghiệp, lườn","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mam tom","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:rau ram","unlisted_ingredient_phrase:uong phen","unlisted_ingredient_phrase:voi nuoc","unlisted_ingredient_phrase:xuong heo"],"source_categories":[{"label":"Món nước 3-4 tuổi","id":"mon_nuoc_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01cjt8m1in46eetq#variant-1","name":"Cá thu kho thịt ba chỉ","detail_name":"Cá thu kho thịt ba chỉ","category":"Món mặn","age_group":null,"serving":{"raw":"67.5 g / Dĩa nhỏ","quantity_value":67.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá thu","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quanti