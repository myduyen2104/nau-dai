[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tw00ekt8m1hq8c4gbq#variant-1","name":"Bánh cuốn","detail_name":"Bánh cuốn","category":"Món khô","age_group":null,"serving":{"raw":"231 g / Dĩa","quantity_value":231,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":"Bột bánh cuốn thêm một chút xíu muối, thêm nước vào khuấy đều cho đến khi bột tan hoàn toàn. Bắc chảo lên bếp mở lửa vừa, thêm dầu ăn vào chảo, phi thơm hành tím, khi hành thơm vàng bạn vớt ra chén 1 nửa để ăn kèm. Cho tiếp thịt xay, nấm mèo, hạt nêm vào, xào khoảng 4 - 5 phút cho đến khi thịt chín, nêm nếm lại cho vừa ăn thì tắt bếp. Bắc chảo lên bếp mở lửa vừa, quét dầu ăn lên mặt chảo, đổ một vá bột vào chảo, lắc nhẹ để bột dàn mỏng đều, đậy nắp lại. Sau 20 - 25 giây khi bánh đã chín, bạn đổ bánh ra mâm sạch (đã phết dầu) rồi nhanh tay đổ bột vào chảo để làm mẻ bánh thứ 2. Trên chiếc bánh đã được đổ ra, bạn múc một muỗng canh nhân thịt lên, trải đều thịt và cuốn lại. Lặp lại cho tới khi hết bột. Dưa leo rửa sạch, cắt thành những thanh nhỏ, ngắn khoảng 1 lóng tay. Rau thơm rửa sạch, cắt nhỏ, chả lụa cắt miếng nhỏ khoảng 1 lóng tay, giá trụng với nước sôi khoảng 2 phút cho chín. Xếp bánh cuốn, rau thơm, dưa leo, chả lụa, hành phi ra đĩa và chấm với nước mắm pha, ăn ngay khi còn nóng bạn nhé.","nutrition":{"kcal":511.4,"protein_g":16.1,"fat_g":18.5,"carbs_g":71.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00ekt8m1hq8c4gbq","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:bot banh","unlisted_ingredient_phrase:cha lua","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mam pha","unlisted_ingredient_phrase:nuoc mam pha","unlisted_ingredient_phrase:rau thom","unlisted_ingredient_phrase:thit va","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00nxt8m11jq34ii0#variant-1","name":"BBGP-3-5Y-Canh cải xanh thịt băm","detail_name":"BBGP-3-5Y-Canh cải xanh thịt băm","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"36.4 g","quantity_value":36.4,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Cải xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Khoai mỡ gọt vỏ rửa sạch sẽ, cắt khúc vừa ăn hoặc nạo nhỏ. Tôm khô rửa sạch, ngâm mềm. Bắt nồi lên bếp cho dầu vào phi thơm hành, cho tôm khô vào đảo đều rồi thêm nước vào nấu sôi, cho phần khoai mỡ vào nấu chín. Nêm nêm gia vị vừa ăn, cho rau nêm vào rồi tắt bếp.","