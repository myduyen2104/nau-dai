uantity_value":130,"quantity_unit":"g"},{"name":"Dứa ta (thơm)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Ớt khô bột","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cá mua về rửa sạch, cắt khoanh. Dứa gọt vỏ bỏ mắt rửa sạch, cắt khúc vừa ăn. Tỏi ta, hành củ tươi bóc vỏ rửa sạch bằm nhuyễn. Hành lá rửa sạch bỏ rễ, cắt nhỏ. Bắc chảo dầu nóng chiên sơ cá. Đặt 1 cái nồi cho đường và nước vào đun sôi nhỏ lửa đến khi đường có màu vàng cánh gián thì tắt bếp. Tiếp theo đó xếp cá và dứa vào nồi cùng với hành củ tươi và tỏi ta đã băm nhuyễn vào cùng. Sau đó nêm gia vị vừa ăn, kho cá trên lửa nhỏ đến khi cá có màu nâu thì cho thêm ớt bột và hành lá vào và tắt bếp. Múc cá ra dĩa rắc thêm ít tiêu lên bề mặt.","nutrition":{"kcal":189.5,"protein_g":28.2,"fat_g":5.5,"carbs_g":7.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw019vt8m1nqdweq29","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá ngừ","ingredient_not_mentioned_by_name:Nước mắm cá","title_ingredient_not_mentioned:Cá ngừ","unlisted_ingredient_phrase:uong co"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category