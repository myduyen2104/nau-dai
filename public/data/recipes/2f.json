[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tx00gzt8m1gdxl9u62#variant-1","name":"Bánh mì cà ri Gà","detail_name":"Bánh mì cà ri Gà","category":"Món nước 18-35 tháng","age_group":"18-35 tháng","serving":{"raw":"104.1 g / Tô nhỏ","quantity_value":104.1,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh mì","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt gà ta","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Khoai lang","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cary bột","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước cốt dừa, đóng hộp","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước dừa non tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"Thịt gà rửa sạch và khử mùi bằng cách chà muối lên mình gà, chà thêm một ít gừng giã nhuyễn lên nữa. Sau cùng rửa lại với nước sạch rồi dùng giấy nến hoặc khăn ăn sạch thấm cho ráo nước. Sau khi rửa thịt gà xong thì chặt ra thành miếng nhỏ. Tuy nhiên cũng đừng chặt vụn quá vì như thế dễ làm cho gà trong lúc hầm bị nát. Khi đó thì ăn sẽ không còn ngon nữa. Hành tím thái nhỏ, tỏi đập dập, sả cây đập dập rồi thái nhỏ. Ướp gà Cho gà vào tô ướp gia vị vừa ăn Tiếp theo đó thì bạn trút tất cả tỏi, hành tím, sả băm vừa mới thái nhỏ ở bước trên vào cùng. Thời gian ướp trung bình là 3 tiếng. Nếu không có nhiều thời gian bạn có thể ướp 2 tiếng và nếu có nhiều thời gian hơn thì lý tưởng nhất là ướp 4 – 5 tiếng. Cà rốt và khoai tây thái miếng. Đối với món cà ri thì bạn nên thái to một chút. Luộc cà rốt và khoai tây chín nhưng không quá mềm. Vớt ra và để cho ráo nước. Nấu cà ri Cho một lớp dầu ăn mỏng vào nồi to. Khi dầu đã nóng, bạn cho thịt gà đã ướp và đảo sơ cho nóng rồi cho nước dừa vào. Hầm thịt gà với nước dừa khoảng 30 phút thì cho các loại củ vào hầm cùng. Nếu bạn thấy nước quá cạn thì có thể cho thêm một chút nước ấm nhưng tốt nhất vẫn là nên cho thêm nước dừa. Khi mà thịt gà đã chín thì bạn hạ nhỏ lửa lại, hầm thêm chút nữa cho nước cà ri sắc và thật thấm, đậm vị thì tắt bếp.","nutrition":{"kcal":202.4,"protein_g":8.9,"fat_g":8.4,"carbs_g":23.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tx00gzt8m1gdxl9u62","quality_status":"needs_review","warnings":["duplicate_listing_row_occurrence","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Cary bột","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:khoai tay","unlisted_ingredient_phrase:tuong nhat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 18-35 tháng","id":"mon_nuoc_18_35_thang","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"18-35 tháng","id":"18_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00lft8m14zwmpmff#variant-1","name":"Bắp cải xào tôm","detail_name":"Bắp cải xào tôm","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"84.5 g / Dĩa nhỏ","quantity_value":84.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cải bắp/bắp cải","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Tôm rửa sạch, bóc vỏ, cho vào tô, ướp gi vị Bắp cải, cắt miếng nhỏ, rửa sạch và để ráo nước. Cà rốt gọt vỏ, cắt mỏng vừa ăn. Đặt chảo lên bếp, đun nóng dầu ăn. Cho tôm đã ướp vào chảo xào, chỉ xào chín tới độ 80%. Sau đó cho bắp cải, vào xào cùng, nếu thấy quá khô thì bạn cho một chút nước vào và đảo đều. Nêm nếm lại gia vị lần nữa cho vừa ăn. Để bắp cải nhanh chín bạn có thể đậy vung trong vài phút. Nhưng đừng để lâu quá, bắp cải sẽ bị nhũn Cho ra đĩa ăn với cơm nóng rất ngon","nutrition":{"kcal":62.1,"protein_g":3.1,"fat_g":3.3,"carbs_g":5.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00lft8m14zwmpmff","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00y6t8m1v2l1h0wk#variant-1","name":"Bún chả cá","detail_name":"Bún chả cá","category":"Món nước 5 tuổi","age_group":"5 tuổi","serving":{"raw":"268.5 g / Tô nhỏ","quantity_value":268.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"120 g","quantity_value":120,"quantity_unit":"g"},{"name":"Chả cá basa","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cá thu","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dứa ta (thơm)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cá làm sạch và để ráo nước, lóc lấy phần thịt nạc, phần còn lại để nấu nước dùng. – Các loại rau ngâm nước muối loãng, rửa sạch, để ráo nước. Cà chua bổ múi cau. Thơm gọt vỏ, cắt miếng vừa ăn. Hành tím nướng 3 – 4 củ để bỏ vào nước dùng cho thơm, còn lại băm nhuyễn, tỏi băm nhuyễn, hành lá cắt nhuyễn. Nấu nước dùng – Bạn dùng phần xương, đầu cá để nấu nước dùng cùng với hành tím nướng. Để nước dùng trong, thơm, không có mùi tanh của cá, bạn nên chần sơ xương và đầu cá với nước sôi trước đó. – Khi nước dùng sôi lên bạn bắt đầu nhỏ lửa và đun liu riu. Khi thấy đầu cá, xương cá chín nhừ thì lọc lấy nước, châm thêm nước vào nồi, cho thơm vào rồi đun sôi lại lần nữa thì nêm nếm cho vừa ăn. Làm cá dầm – Ướp cá thu cùng tiêu, nước mắm, bột ngọt, gừng, một ít rượu và đem hấp trong 30 phút là được Pha nước mắm chấm – Làm nước chấm bằng cách cho tỏi băm, ớt cắt lát và nước mắm ngon vào chén, trộn đều. Lưu ý, không thêm đường để nước mắm giữ được vị ngon nguyên chất. Trình bày và thưởng thức – Xếp bún ra tô, cho chả cá hấp, chiên và cá dầm lên trên rồi chan nước dùng vào và thưởng thức cùng rau sống. Thêm chút nước mắm sẽ làm món ăn thêm đậm đà.","nutrition":{"kcal":304,"protein_g":12.9,"fat_g":10.1,"carbs_g":40.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00y6t8m1v2l1h0wk","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giá đậu xanh","unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:nguyen chat","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv0113t8m1bj89t2hx#variant-1","name":"Bún riêu ốc","detail_name":"Bún riêu ốc","category":"Món nước 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"241.3 g / Tô nhỏ","quantity_value":241.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"120 g","quantity_value":120,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tiết heo (lợn) luộc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cua đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ốc bươu","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Cua đồng tách mai, rửa sạch ( gạch cua ở trong mai khều bỏ riêng) giã nhuyễn thân cua hoặc xay, đổ nước và muối và hạt nêm ( có thể bỏ muối từ lúc giã thì giã sẽ đỡ văng) khấy đều cho tan thịt cua, lọc bằng rá hoặc lưới bỏ bã đi, gạn lấy nước bỏ cặn ở đáy, để trong xoong 15 phút cho lắng xuống và bật bếp nấu lửa thật nhỏ, không đảo, không quấy trong khi nấu. Khi thấy riêu cua nổi lên trên mặt nước thành tảng thì mở lửa lớn hơn chút cho đủ sôi rồi tắt bếp Đậu phụ cắt khoảng 2 cm x 4cm, cho dầu ăn vào chảo, đun nóng dầu cho đậu phụ vào rán ( chiên) cho vàng. Làm ốc: lấy dao nhỏ cắt miếng chắn ở miệng ốc rồi dùng ngón tay nhấn vào miệng ốc cho ruột ốc tụt vào trong làm đứt những màng bám của ruột vào vỏ ốc, cho qua thau (chậu nhỏ) để khoảng 10 phút thì cầm vỏ ốc vảy cho ruột ốc bung ra, trường hợp chưa bung thì phải dùng nĩa nhỏ khêu lấy ra. Sau đó dùng dao nhọn loại nhỏ để bóc tách phần màu đen mà mềm ở phần ruột ốc đó là chất thải bỏ đi. Vắt 1 -2 quả chanh lấy nước cho vào để 1 phút rồi bóp đều và rửa, bỏ thêm 8 muỗng dấm ngâm 2 phút rối rửa sạch cho hết nhớt. Mỗi ruột ốc thái làm 2 hoặc để nguyên tuỳ con lớn hay nhỏ, cho vào 1 tô lớn ướp với nước bột nghệ và bột nêm cùng 1 chút nước mắm, khoảng 20 phút. Thái mỏng 4 củ hành khô cho vào chảo dầu nóng phi vàng thì đổ ốc vào xào đảo nhanh tay khoảng3 - 4 phút cho ốc vừa chín tới thì đổ ra đĩa. Cho dầu vào chảo xào chín gạch cua rồi gạn nước ốc trả lại chảo và đỗ dấm vào nấu sôi rồi đổ ra tô để riêng. Khi chuẩn bị ăn cho sườn vào lại nước dùng nấu cho nóng, khi sôi thì cho đậu phụ chiên vào luôn, rồi lấy cà chua mỗi quả bổ dọc làm 6 miếng ( bổ cau) cho vào nước chờ nấu sôi 1 phút là dùng chan vào tô bún được. Cho bún chần nước sôi (trụng nóng) cho vào tô đủ ăn, vớt đậu phụ nóng, vớt một miếng riêu cua bỏ vào, cho ốc và 4- 5 muỗng dấm đã nấu sôi cùng gạch cua- tuỳ khẩu vị thích chua nhiều hay ít, cuối cùng cho nước dùng đang sôi vào cho ngập cái trong tô, ăn kèm với giá.","nutrition":{"kcal":271.5,"protein_g":10.5,"fat_g":8.8,"carbs_g":38.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv0113t8m1bj89t2hx","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Ốc bươu","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 3-4 tuổi","id":"mon_nuoc_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"