2,"quantity_unit":"g"}],"instructions_raw":"Bồ câu rửa sạch để ráo, ướp gia vị trong 20 phút. Cà rốt rửa sạch gọt vỏ, cắt vừa ăn. Hạt sen tươi rửa sạch để ráo. Táo tàu khô ngâm nước cho nở. Hành củ, tỏi ta lột vỏ, rửa sạch cắt nhỏ. Đặt chảo nóng chiên chim hơi vàng rồi vớt ra để ráo dầu. Kế tiếp phi thơm hành tơi trong 1 cái nồi cùng với dầu ăn, sau đó cho chim đã chiên vào đảo đều. Cho nước dừa non vào cùng với cà rốt, hạt sen, táo tàu, hầm trên lửa nhỏ trong 30 phút. Sau cùng khi chim đã mềm thì nêm nếm gia vị lại cho vừa ăn rồi múc ra tô là có thể dùng được.","nutrition":{"kcal":84.8,"protein_g":4,"fat_g":6,"carbs_g":3.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02eot8m1m8lxusj4","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Gừng tươi"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02l9t8m14sz0l8up#variant-1","name":"Đậu hũ kho thịt","detail_name":"Đậu hũ kho thịt","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"51 g / Dĩa nhỏ","quantity_value":51,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Đậu phụ chiên","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_r