e_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02wqt8m1qvon596o#variant-1","name":"Gỏi gà xé","detail_name":"Gỏi gà xé","category":"Món xào 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"113.3 g / Dĩa vừa","quantity_value":113.3,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt gà ta","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"Thịt gà sau khi mua về bạn dùng muối xát đều lên da để khử mùi hôi hiệu quả. Sau đó, rửa lại với 3 lần nước sạch. Chuẩn bị một âu nước lạnh nhỏ. Bóc vỏ hành tây, rửa sạch rồi thái thành sợi mỏng và cho hết vào âu nước lạnh ngâm trong khoảng 15 – 20 phút cho bớt mùi hăng. Rau răm nhặt những lá non rồi mang rửa sạch và vớt ra rổ để ráo nước. Tỏi bóc lớp vỏ khô bên ngoài rồi dùng dao băm nhuyễn Đậu phụng mang đi rang chín đều. Sau đó, xa vỏ và cho vào cối giã nhỏ vừa phải, đừng mịn quá. Cà rốtgọt vỏ, rửa sạch, cắt sợi nhuyễn. Bạn pha nước chấm: nước cốt chanh, nước mắm, đường, nước trắng, ớt, tỏi băm nhuyễn. Nhớ trộn đều cho các nguyên liệu quyện đều vào nhau nhé. Gà sau khi sơ chế xong, bạn mang luộc chín. Sau đó, vớt ra để ráo nước, đợi nguội rồi xé sợi. Chuẩn bị một âu sạch. Tiến hành cho lần lượt các nguyên liệu vào chung, gồm: thịt gà xé sợi, hành tây, cà rốt, rau răm đã được sơ chế. Rưới nước chấm vào âu nguyên liệu ở bước 2 rồi trộn đều và để yên khoảng 15 phút cho nước chấm thấm đều vào nguyên liệu. Cuối cùng, bạn rắc đậu phụng đập nhỏ và một ít tiêu xay lên trên rồi dọn ra dĩa, trang trí tùy thích và mời mọi người thưởng thức.","nutrition":{"kcal":141.7,"protein_g":9.1,"fat_g":6.3,"carbs_g":12.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02wqt8m1qvon596o","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phộng (lạc hạt)","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc cot","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào 8-18 tuổi","id":"mon_xao_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03wdt8m1ei5obxym#variant-1","name":"Phở bò chín đặc biệt","detail_name":"Phở bò chín đặc biệt","category":"Món nước","age_group":null,"serving":{"raw":"399 g / Tô lớn","quantity_value":399,"quantity_unit":"g","portion_label":"Tô lớn"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"170 g","quantity_value":170,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":