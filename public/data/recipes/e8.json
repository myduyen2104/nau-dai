_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, cắt miếng vừa ăn ướp gia vị. Tất cả trộn đều để khoảng 30 phút cho thấm. Đậu trắng rửa sạch. Cà rốt, khoai tây gọt vỏ rửa sạch cắt hạt lựu. Hành lá bỏ rễ, rửa sạch, băm nhuyễn phần thân, phần lá cắt nhỏ. Tỏi bóc vỏ, băm nhuyễn. Cà chua rửa sạch, bỏ hạt, cắt hạt lựu nhỏ Bắc chảo, phi thơm hành, tỏi băm, cho thịt bò lên xào săn rồi cho cà chua lên xào thêm vài phút, cho nước sôi ,hầm thịt bò khoảng 30 phút thì cho đậu trắng, cà rốt, khoai tây lên hầm đến khi đậu, cà rốt, khoai tây, thịt bò mềm thì nêm nếm cho vừa ăn, thêm hành lá, rau mùi, tắt bếp.","nutrition":{"kcal":98.2,"protein_g":7.8,"fat_g":4.3,"carbs_g":7.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00qut8m165hwsmsm","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:rau mui"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00tnt8m1hqtytg6c#variant-1","name":"Bột đậu hũ, cà chua, khoai tây","detail_name":"Bột đậu hũ, cà chua, khoai tây","category":"Món bột nhà nấu cho trẻ từ 7-8 tháng","age_group":"7-8 tháng","serving":{"raw":"75 g / Chén","quantity_value":75,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Cà chua rửa sạch, gọt vỏ, bỏ hạt, băm nhuyễn. Khoai tây gọt vỏ, rửa sạch, luộc chín, tán nhuyễn. Đậu phụ tán nhuyễn. Hòa tan bột gạo với nước, bắc lên bếp khuấy đều cho đến khi sôi, thêm đậu phụ, cà chua vào nấu chín rồi thêm khoai tây vào khuấy đều, tắt bếp. Thêm dầu ăn vào khuấy đều.","nutrition":{"kcal":157.6,"protein_g":4.9,"fat_g":6.7,"carbs_g":19.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00tnt8m1hqtytg6c","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ từ 7-8 tháng","id":"mon_bot_nha_nau_cho_tre_tu_7_8_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"7-8 tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw019qt8m1yva4l2bu#variant-1","name":"Cá ngừ kho thơm","detail_name":"Cá ngừ kho thơm","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"83 g / Dĩa nhỏ","quantity_value":83,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá ngừ","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dứa ta (thơm)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cá mua về rửa sạch, cắt khoanh. Dứa gọt vỏ bỏ mắt rửa sạch, cắt khúc vừa ăn. Tỏi ta, hành củ tươi bóc vỏ rửa sạch bằm nhuyễn. Bắc chảo dầu nóng chiên sơ cá. Đặt 1 cái nồi cho đường và nước vào đun sôi nhỏ lửa đến khi đường có màu vàng cánh gián thì tắt bếp. Tiếp theo đó xếp cá và dứa vào nồi cùng với hành củ tươi và tỏi ta đã băm nhuyễn vào cùng. Sau đó nêm gia vị vừa ăn, kho cá trên lửa nhỏ đến khi cá có màu nâu thì cho thêm ớt bột và hành lá vào và tắt bếp.","nutrition":{"kcal":88.6,"protein_g":10.9,"fat_g":3.2,"carbs_g":4.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw019qt8m1yva4l2bu","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá ngừ","ingredient_not_mentioned_by_name:Nước mắm cá","title_ingredient_not_mentioned:Cá ngừ","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:uong co","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01ayt8m1nq2acjzq#variant-1","name":"Cà pháo mắm tôm","detail_name":"Cà pháo mắm tôm","category":"Món luộc 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"104 g / Dĩa vừa","quantity_value":104,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cà pháo","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đu đủ xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Mắm tôm đặc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cà pháo rửa sạch, cắt đôi, ngâm muối, phơi cho ráo nước. Đu đủ xanh gọt vỏ, rửa sạch, cắt lát, phơi héo. Dưa leo rửa sạch, bỏ hạt, cắt lát vừa ăn, phơi hơi héo. Trộn cà pháo, đu đủ, dưa leo với mắm tôm pha tỏi ớt. Để cho ngấm khoảng 30 phút là có thể dùng được.","nutrition":{"kcal":42.7,"protein_g":1.9,"fat_g":0.1,"carbs_g":8.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01ayt8m1nq2acjzq","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Chanh","unlisted_ingredient_phrase:pha toi","unlisted_ingredient_phrase:pha toi ot","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món luộc 8-18 tuổi","id":"mon_luoc_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món luộc"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01dat8m1wqifj9ov#variant-1","name":"Cá trê chiên","detail_name":"Cá trê chiên","category":"Món mặn","age_group":null,"serving":{"raw":"92 g / Dĩa vừa","quantity_value":92,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cá trê","quantity_raw":"75 g","quantity_value":75,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cá trê sau khi mua về thì rửa với nước, chà xát cá với một ít chanh và muối để làm sạch hết phần nhớt, sau đó rửa lại với nước sạch, rồi để cá thật ráo nước. Với món cá trê chiên này, sẽ ngon hơn khi bạn dùng cá trê vàng để chiên đấy.Chanh thì bạn cắt thành từng miếng để lấy vắt lấy nước cốt chanh.Bắc một cái chảo dầu lên bếp cùng với một ít muối để khi cho cá vào sẽ không bị văng, khi dầu đã nóng lên thì cho cá trê vào, chiên ở lửa vừa cho cá vàng đều.Khi chiên bạn nên để cá vàng đều 1 mặt rồi mới trở cá, để cá không bị nát và ngon hơn","nutrition":{"kcal":223.2,"protein_g":12.6,"fat_g":18.9,"carbs_g":1.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01dat8m1wqifj9ov","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Tỏi ta","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01l4t8m1dbpmw7oi#variant-1","name":"Canh cải soong nấu thịt heo","detail_name":"Canh cải soong nấu thịt heo","category":"Món canh từ 18-24 tháng tuổi","age_group":"18-24 tháng","serving":{"raw":"31.5 g / Chén","quantity_value":31.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cải soong","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Mua rau về nhặt, rửa rau cải soong với nước lã rồi ngâm trong nước muối pha loãng khoảng 20 phút sau đó các bạn vớt ra rổ để ráo nước. Lấy lá băm nhuyễn Thịt rửa sạch băm nhuyễn. Cho dầu ăn hành tím vào nồi phi thơm lên cho thịt bằm vào đảo qua rồi cho một tí muối vào. Cho nước vào đun sôi, khi đã chín thịt các bạn cho rau vào nêm nếm lại gia vị, đợi canh sôi là có thể tắt bếp.","nutrition":{"kcal":34.1,"protein_g":1.6,"fat_g":2.8,"carbs_g":0.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01l4t8m1dbpmw7oi","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh từ 18-24 tháng tuổi","id":"mon_canh_tu_18_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"18-24 tháng","id":"18_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01p4t8m1zefx1i15#variant-1","name":"Canh hẹ nấu nghêu","detail_name":"Canh hẹ nấu nghêu","category":"Món canh","age_group":null,"serving":{"raw":"130.47 g / Chén","quantity_value":130.47,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Hẹ lá","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Hến","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.47 g","quantity_value":0.47,"quantity_unit":"g"}],"instructions_raw":"Hẹ mua về rửa sạch rồi đem cắt thành khúc dài khoảng 3 đốt tay. Nghêu ngâm nước, rửa sạch, hấp sơ cho nghêu mở nắp, cạy lấy thịt nghêu. Bắc nồi nước lên bếp, khi nước sôi thì cho thịt nghêu vào đun sôi, nêm nếm gia vị vừa ăn Khi nước sôi lại thì cho hẹ vào, nấu khoảng 2 phút nữa thì tắt bếp và rắc ít tiêu lên.","nutrition":{"kcal":34.5,"protein_g":3.6,"fat_g":0.4,"carbs_g":4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01p4t8m1zefx1i15","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Hến","ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh","id":"mon_canh","kind":"food_category","baseLabel":"Món canh"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01yct8m1tr4w8hky#variant-1","name":"Cao lầu","detail_name":"Cao lầu","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"293.5 g / Tô vừa","quantity_value":293.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Mì sợi khô","quantity_raw":"110 g","quantity_value":110,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hoa chuối","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau húng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nghệ, khô, bột","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"12 g","quantity_value":12,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sơ chế nguyên liệu – Cao lầu khô ngâm với nước nóng 2 – 3h cho mềm, sau đó vớt ra rổ. – Thịt nạc mua về bạn ngâm với nước muối pha loãng 15 phút rồi rửa sạch với nước. Thái thịt thành những miếng lớn. – Tỏi khô bóc vỏ, đập đập. – Húng lủi, rau cải con nhặt gốc, rửa sạch, để ráo. – Giá đỗ rửa sạch, để ráo. Ướp thịt – Thịt sau khi thái miếng lớn, bạn dùng tay bóp muối rồi cho đường, ngũ vị hương, hạt nêm vào trộn đều để ướp thịt. – Thời gian ướp thịt từ 1 – 2 tiếng, sau đó bạn cho nước tương, tỏi đập dập vào thịt, trộn đều. Chiên thịt – Bắc chảo lên bếp với chút dầu ăn, khi dầu nóng, bạn cho thịt vào chiên đều hai mặt. – Đổ nước ướp thịt vào chảo nấu sôi, đậy nắp rồi đun lửa nhỏ liu riu, khoảng 15 phút thì lật thịt lại cho thịt thấm gia vị. – Sau khi đun khoảng 1 tiếng, bạn chắt nước thịt trong chảo sang nồi khác để làm nước chan. – Phần thịt còn lại bạn đảo liên tục cho tới khi thịt ráo nước, khô lại thì tắt bếp. – Gắp thịt ra, đợi nguội rồi cắt lát mỏng vừa ăn. Nấu nước chan cao lầu Phần nước thịt chắt ra bạn có thể nêm chút nước vào nấu và nêm nếm gia vị vừa ăn/ Đặc điểm của món cao lầu là ăn khô nên phần nước chan rất ít, nước chan phải có vị đậm đà. Thành phẩm cao lầu – Nấu một nồi nước sôi trên bếp, cho giá đỗ vào trụng sơ rồi vớt ra để ráo. – Cho mì vào nồi nước sôi, đảo đều khoảng 1 phút là có thể sử dụng. – Cho giá đỗ trụng xuống đấy tô, thêm sợi cao lầu, trên cùng xếp các miếng thịt, chan chút nước dùng và thêm vài miếng ram chiên cùng chút ớt bột là có ngay món cao lầu hoàn chỉnh.","nutrition":{"kcal":752.2,"protein_g":26.8,"fat_g":30.9,"carbs_g":93.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01yct8m1tr4w8hky","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Hoa chuối","ingredient_not_mentioned_by_name:Hành lá (hành hoa)","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc tuong","unlisted_ingredient_phrase:o trung","unlisted_ingredient_phrase:uop thit","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evi