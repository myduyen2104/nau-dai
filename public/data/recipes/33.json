tiêu","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Thịt heo rửa sạch ướp gia vị. Dứa gọt vỏ bỏ mắt, rửa sạch cắt vừa ăn. Ớt đỏ, ớt vàng, ớt xanh rửa sạch cắt vừa ăn. Tỏi ta lột vỏ rửa sạch băm nhuyễn. Bắt 1 chảo nóng phi thơm tỏi, cho thêm thịt vào xào đều cùng gia vị, tiếp thep cho dấm vào nêm vừa ăn. Đến khi thịt mềm cho thêm ớt và dứa đã cắt vừa ăn vào nấu chín đều tất cả . Sau đó pha bột bắp với nước sôi để nguội cho vào chảo thịt. Sau cùng tắt bếp rắc thêm tiêu lên bề mặt.","nutrition":{"kcal":342.9,"protein_g":15.2,"fat_g":27.8,"carbs_g":8.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh058dt8m186nzh4yw","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giấm","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"}]