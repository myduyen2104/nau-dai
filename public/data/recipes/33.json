u đó cho phần tôm đã ướp vào, đảo nhanh tay. Đến khi tôm hơi săn lại thì cho 1 lượng nước vừa đủ vào nồi. Đợi cho nước sôi, hớt bọt trong nồi bỏ ra ngoài. Sau đó cho mồng tơi vào, nêm nếm gia vị cho vừa ăn. Đợi thêm tầm 3 phút cho rau mồng tơi chín thì tắt bếp.","nutrition":{"kcal":37.1,"protein_g":2.5,"fat_g":1.1,"carbs_g":4.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01rjt8m1grogfsdl","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Hến","title_ingredient_not_mentioned:Hến","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nau canh","unlisted_ingredient_phrase:nguyen lieu"],"source_categories":[{"label":"Món canh","id":"mon_canh","kind":"food_category","baseLabel":"Món canh"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01v7t8m1ijpqweiv#variant-1","name":"Canh rau má nấu thịt heo","detail_name":"Canh rau má nấu thịt heo","category":"Món canh 5 tuổi","age_group":"5 tuổi","serving":{"raw":"67.5 g / Chén","quantity_value":67.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau má, má mơ","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc vai","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":51.4,"protein_g":2.9,"fat_g":2.8,"carbs_g":3.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01v7t8m1ijpqweiv","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi"