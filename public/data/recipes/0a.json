m 4 phần. Làm hỗn hợp chạo tôm Cho tôm đã xay trộn với thịt heo giã nhuyễn và hỗn hợp bột năng, hành lá, cà rốt xắt nhỏ, lòng trắng trứng gà. Rắc gia vị hạt nêm, muối, đường, hạt tiêu vừa đủ, trộn đều để tôm ngấm gia vị và bột. Ướp hỗn hợp trong ngăn mát tủ lạnh khoảng 30-40 phút. Tạo hình món chạo tôm Lấy hỗn hợp chạo tôm ra. Thoa ít dầu lên tay để dễ dàng viên hỗn hợp tôm xay thành từng nắm nhỏ. Múc một muỗng hỗn hợp chạo tôm vào lòng bàn tay, viên tròn rồi tán mỏng đều, đặt thanh mía vào chính giữa và nén chặt tay để khi nướng không bị bung ra. Đắp chạo tôm bao quanh thanh mía sao cho hỗn hợp thịt bọc kín 2/3 thanh mía và dày khoảng hơn 1cm. Nướng chạo tôm bọc mía","nutrition":{"kcal":72.6,"protein_g":7.7,"fat_g":2.3,"carbs_g":5.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bv029st8m1d51nvcpn","quality_status":"needs_review","warnings":["duplicate_listing_row_occurrence","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i032ft8m1e0830g6y#variant-1","name":"Hủ tíu thịt heo","detail_name":"Hủ tíu thịt heo","category":"Món nước","age_group":null,"serving":{"raw":"292 g / Tô nhỏ","quantity_value":292,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Hủ tiếu khô","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Cải thìa/cải t