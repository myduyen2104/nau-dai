ntity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cải bắp/bắp cải","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bắp cải rửa sạch, cắt nhỏ vừa ăn. Thịt heo nạc rửa sạch, băm nhuyễn, ướp gia vị. Bắt nổi lên bếp, thêm dầu ăn vào, dầu nóng thêm hành vào phi thơm, cho thịt vào đảo đều rồi thêm nước vào nấu sôi. Thêm bắp cải vào nấu chín, nêm gia vị vừa ăn. Thêm hành lá vào rồi tắt bếp.","nutrition":{"kcal":85.2,"protein_g":3.9,"fat_g":4.6,"carbs_g":7.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01g1t8m1ljf4fyjx","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:heo nac","unlisted_ingredient_phrase:thit heo nac"],"source_categories":[{"label":"Món canh","id":"mon_canh","kind":"food_category","baseLabel":"Món canh"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qy01h9t8m1nwaior0t#variant-1","name":"Canh bí đỏ","detail_name":"Canh bí đỏ","category":"Món canh chay 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"85.5 g / Chén","quantity_value":85.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bí đỏ (bí ngô)","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường cát","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Bí đỏ gọt vỏ, bỏ hạt, rửa sạch, cắt miếng vừa ăn. Đậu phộng đã bóc vỏ ngâm 1-2 tiếng, rửa sạch và giã nhỏ. Đặt nồi nước lên bếp, lần lượt cho đậu phộng, đậu hũ và bí đỏ vào nồi. Đến khi đậu phộng mềm, bí đỏ chín thì cho rau mùi tàu vào và nêm nếm gia vị vừa miệng thì tắt bếp, đổ ra tô là có thể thưởng thức.","nutrition":{"kcal":35.3,"protein_g":0.3,"fat_g":0.1,"carbs_g":8.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qy01h9t8m1nwaior0t","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bí đỏ (bí ngô)","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:au phong"],"source_categories":[{"label":"Món canh chay 8-18 tuổi","id":"mon_canh_chay_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh chay"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02c4t8m1quoa0q19#variant-1","name":"Chè đậu đỏ bánh lọt","detail_name":"Chè đậu đỏ bánh lọt","category":"Chè (18 tháng trở lên)","age_group":"18 tháng","serving":{"raw":"105 g / Ly","quantity_value":105,"quantity_unit":"g","portion_label":"Ly"},"ingredients":[{"name":"Đậu đen (hạt)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":"-Đậu đỏ đãi sạch, nhặt bỏ những hạt nổi. Ngâm khoảng 2 tiếng trước khi ninh. Dừa nạo ngâm trong nước ấm 10 phút rồi vắt lấy nước cốt. Phần bã dừa bạn đổ vào nước nóng tiếp tục lọc 1 lần nữa để lấy nước dão. Phần nước này dùng để nấu chè. Cho đậu vào nồi , đổ nước dừa dão đã chuẩn bị ở trên vào ngập và ninh đậu. Khi nồi chè sôi được khoảng 5 phút, thì tắt bếp, để ủ Để nồi chè ở chế độ ủ khoảng 15 phút thì bật lại sang chế độ nấu để chè sôi lại. Tiếp tục ninh khoảng 15 phút. Sau khi hạt đỗ đã chín mềm, vớt hết đậu ra một cái nồi khác và để lại nước đậu đỏ trong nồi. Bột năng nhồi với nước lá dứa xay đã sôi. Vò sợi thành bánh lọt Đảo đều đường với đậu rồi đun lên cho đến khi đường tan hết thì cho bánh lọt vào tắt bếp. Tiếp đó, trút hạt đậu trở lại nồi nước, nêm thêm đường cho vừa khẩu vị. Lấy chè ra chén, rắc lên một ít dừa khô, 1 thìa nước cốt dừa, 1 ít đậu phộng giã nhỏ, 1 giọt dầu chuối trộn đều và thưởng thức","nutrition":{"kcal":391.7,"protein_g":8.5,"fat_g":9.5,"carbs_g":68},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02c4t8m1quoa0q19","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:au phong","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Chè (18 tháng trở lên)","id":"che_18_thang_tro_len","kind":"age_scoped_food_category","baseLabel":"Chè"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02i1t8m16rl7lnjw#variant-1","name":"cơm-thịt bò-rau luộc","detail_name":"cơm-thịt bò-rau luộc","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"195 g","quantity_value":195,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Gạo lứt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt bò, lưng, nạc","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cải soong","quantit