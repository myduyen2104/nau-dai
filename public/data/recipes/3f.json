[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tx00kot8m15gvmnt1k#variant-1","name":"Bánh ướt","detail_name":"Bánh ướt","category":"Món khô","age_group":null,"serving":{"raw":"203 g / Dĩa nhỏ","quantity_value":203,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Bánh tôm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nem chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau húng","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Bột bánh ướt thêm một chút xíu muối, thêm nước vào khuấy đều cho đến khi bột tan hoàn toàn. Bắc chảo lên bếp mở lửa vừa, thêm dầu ăn vào chảo, phi thơm hành tím, khi hành thơm vàng bạn vớt ra chén 1 nửa để ăn kèm. Bắc chảo lên bếp mở lửa vừa, quét dầu ăn lên mặt chảo, đổ một vá bột vào chảo, lắc nhẹ để bột dàn mỏng đều, đậy nắp lại. Sau 20 - 25 giây khi bánh đã chín, bạn đổ bánh ra mâm sạch (đã phết dầu) rồi cuốn bánh lại, nhanh tay đổ bột vào chảo để làm mẻ bánh thứ 2. Dưa leo rửa sạch, cắt thành những thanh nhỏ, ngắn khoảng 1 lóng tay. Rau thơm rửa sạch, cắt nhỏ, chả lụa cắt miếng nhỏ khoảng 1 lóng tay, giá trụng với nước sôi khoảng 2 phút cho chín. Xếp bánh ướt rau thơm, dưa leo, chả lụa, bánh tôm, nem chua, hành phi ra đĩa và chấm với nước mắm pha, ăn ngay khi còn nóng bạn nhé.","nutrition":{"kcal":452.9,"protein_g":16.7,"fat_g":13,"carbs_g":68},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tx00kot8m15gvmnt1k","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh uot","unlisted_ingredient_phrase:bot banh","unlisted_ingredient_phrase:cha lua","unlisted_ingredient_phrase:mam pha","unlisted_ingredient_phrase:nuoc mam pha","unlisted_ingredient_phrase:rau thom","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw018kt8m12464kf8y#variant-1","name":"Cá lóc phù dung","detail_name":"Cá lóc phù dung","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"64 g / Dĩa nhỏ","quantity_value":64,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá quả (cá lóc)","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cải xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"\"Nấm hương ngâm mềm thái chỉ. Cuống cải thái chỉ chần chín để riêng. Cá rứa sạch,thái miếng mỏng, ướp với muối, đường, hạt nêm. \"Trộn đều cá, nấm, rau hành với trứng, nêm đủ gia vị thành một hỗn hợp. Cho dầu ăn vào chảo,múc từng thìa hỗn hợp trên đổ vào chảo rán vàng. Khi cá và rau chín lấy ra đĩa. Làm xốt sánh mượt dội lên đĩa cá. Cách làm xốt: cho nước dùng vào chảo nêm đủ muối,đường, dầu vừng và bột dong lọc ,đun sôi đều là được.\"","nutrition":{"kcal":76.3,"protein_g":5.6,"fat_g":4.1,"carbs_g":4.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw018kt8m12464kf8y","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc dung"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01z0t8m18dq0vrsa#variant-1","name":"Chả cá thu chiên sốt cà","detail_name":"Chả cá thu chiên sốt cà","category":"Món mặn","age_group":null,"serving":{"raw":"132.5 g / Dĩa vừa","quantity_value":132.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cá thu","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1.5 g","quantity_value":1.5,"quantity_unit":"g"}],"instructions_raw":"Cá thu rửa sạch, lấy phần thịt xay nhuyễn, ướp gia vị, trộn đều, vo viên nhỏ vừa ăn. Cà chua rửa sạch, bỏ hạt băm nhuyễn Hành, tỏi bóc vỏ, băm nhuyễn Đun nóng dầu, cho chả cá vào chiên vàng đều các mặt, vớt ra đĩa. Phi vàng hành tỏi băm, cho cà chua vào đảo đều, nêm nếm gia vị, cho chả cá chiên vào, nấu lửa nhỏ trong 5 phút, tắt bếp","nutrition":{"kcal":205,"protein_g":15.5,"fat_g":13.4,"carbs_g":6.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01z0t8m18dq0vrsa","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu0243t8m13scmwd0e#variant-1","name":"Cháo ếch hạt sen mồng tơi","detail_name":"Cháo ếch hạt sen mồng tơi","category":"Cháo 9-12 tháng tuổi","age_group":"9-12 tháng","serving":{"raw":"77 g","quantity_value":77,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Ếch ( thịt đùi)","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Rau mồng tơi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"}],"instructions_raw":"* Ếch làm sạch, rửa với muối và chanh, sau đó rửa sạch dưới vòi nước. Lọc lấy phần thịt ếch, băm nhuyễn. * Hạt sen rửa sạch, tách bỏ tim sen, luộc với 1 chén nước cho đến khi hạt sen mềm, vớt ra để nguội rồi tán nhuyễn. Rau mông tơi chọn lá non, mềm, rửa sạch, lấy lá băm nhuyễn.