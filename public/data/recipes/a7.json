ge_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72n04eat8m1kjactmnj#variant-1","name":"Sâm bổ lượng","detail_name":"Sâm bổ lượng","category":"Chè (18 tháng trở lên)","age_group":"18 tháng","serving":{"raw":"154 g / Ly","quantity_value":154,"quantity_unit":"g","portion_label":"Ly"},"ingredients":[{"name":"Thạch","quantity_raw":"27 g","quantity_value":27,"quantity_unit":"g"},{"name":"Rong biển tươi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nho khô, sẫm màu, không hạt","quantity_raw":"12 g","quantity_value":12,"quantity_unit":"g"},{"name":"Củ sen","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Thạch dừa","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nhãn khô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hạt sen khô","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"},{"name":"Hạt bo bo (Ý dĩ)","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"},{"name":"Táo tàu khô","quantity_raw":"6 g","quantity_value":6,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"}],"instructions_raw":"\" Ngâm bo bo với nước sôi qua đêm (4 đến 5 giờ) cho nở mềm rồi bắc lên bếp luộc với nước khoảng 15 phút cho chín mềm. Đổ bo bo ra rổ rửa sạch với nước lạnh để bo bo không dính vào nhau. Củ sen gọt vỏ cắt lát mỏng khoảng 1cm, củ năng gọt vỏ, cắt làm đôi nếu củ quá to, đem cả 2 rửa sạch. Cho củ sen, củ năng vào nồi đun cùng với nước ở lửa vừa. Khi nước sôi hạ lửa nhỏ, hầm khoảng 10 phút để củ sen và củ năng vừa chín tới.Ngâm hạt sen ngâm với nước ấm 20 phút rồi cho vào nồi luộc mềm cùng nước. Đổ hạt sen cùng với nước luộc vào nồi chè, thêm đường phèn vào rồi khuấy đều cho đường tan. Tiếp tục nấu 10 phút nữa cho các nguyên liệu ngấm đường. Thêm nhãn nhục ngâm mềm và táo tàu ngâm nở vào. Nấu tiếp 5 phút thì cho phổ tai đã ngâm mềm vào nồi, khuấy đều rồi nhắc xuống.Múc bo bo vào ly, thêm sâm và đá nhuyễn vào rồi thưởng thức ly sâm bổ lượng mát lạnh, tuyệt ngon do chính tay mình nấu nha.\"","nutrition":{"kcal":358.4,"protein_g":6.4,"fat_g":1,"carbs_g":83.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72n04eat8m1kjactmnj","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Thạch","ingredient_not_mentioned_by_name:Rong biển tươi","ingredient_not_mentioned_by_name:Thạch dừa","ingredient_not_mentioned_by_name:Đậu xanh (đậu tắt)","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc khoang","unlisted_ingredient_phrase:uong phen","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Chè (18 tháng trở lên)","id":"che_18_thang_tro_len","kind":"age_scoped_food_category","baseLabel":"Chè"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04wvt8m1r5xgpwkw#variant-1","name":"Súp gà nấu nấm","detail_name":"Súp gà nấu nấm","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"93.3 g / Tô nhỏ","quantity_value":93.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ngô bắp tươi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt gà công nghiệp, lườn","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Lòng trắng trứng gà","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm hương tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw"