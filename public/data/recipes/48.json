:{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01kmt8m1qo2xwae2#variant-1","name":"Canh cải ngọt thịt heo","detail_name":"Canh cải ngọt thịt heo","category":"Món canh từ 18-24 tháng tuổi","age_group":"18-24 tháng","serving":{"raw":"46.5 g / Chén","quantity_value":46.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cải ngọt","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Cải ngọt : rửa sạch, lấy lá cắt nhuyễn Thịt heo băm nhuyễn Bắt nồi lên bếp, cho dầu ăn và bỏ thịt băm vào xào 5p. Sau đó cho nước lọc vào (lượng nước canh bao nhiêu thì tuỳ bạn muốn) Khi nước sôi thì tiếp tục bỏ lá cải vào. Nấu thêm 10p nữa thì nêm nếm gia vị cho vừa miệng rồi tắt bếp. Ko nên nấu quá lâu sẽ làm nhừ cải và cải sẽ chuyển màu vàng nhìn ko đẹp mắt","nutrition":{"kcal":35.4,"protein_g":1.6,"fat_g":2.8,"carbs_g":1.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01kmt8m1qo2xwae2","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nuoc loc"],"source_categories":[{"label":"Món canh từ 18-24 tháng tuổi","id":"mon_canh_tu_18_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"18-24 tháng","id":"18_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01lst8m1b20v9ide#variant-1","name":"Canh cải xanh nấu cá thác lác","detail_name":"Canh cải xanh nấu cá thác lác","category":"Món canh 25-35 tháng tuổi","age_group":"25-35 tháng","serving