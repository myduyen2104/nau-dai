[{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00txt8m1ycfl6sba#variant-1","name":"Bột ếch, cà rốt","detail_name":"Bột ếch, cà rốt","category":"Món bột nhà nấu cho trẻ từ 7-8 tháng","age_group":"7-8 tháng","serving":{"raw":"65 g / Chén","quantity_value":65,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Ếch ( thịt đùi)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Cà rốt gọt vỏ, rửa sạch, luộc chín, tán nhuyễn. Ếch làm sạch, lọc lấy phần thịt, băm nhuyễn. Hòa tan bột gạo, thịt ếch với nước, bắc lên bếp khuấy đều cho đến khi sôi. Thêm cà rốt vào khuấy đều, tắt bếp. Để bột nguội dần thêm phô mai, dầu ăn vào khuấy đều.","nutrition":{"kcal":144.4,"protein_g":5.6,"fat_g":5.3,"carbs_g":18.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00txt8m1ycfl6sba","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:pho mai","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ từ 7-8 tháng","id":"mon_bot_nha_nau_cho_tre_tu_7_8_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"7-8 tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00y3t8m13u1pyha2#variant-1","name":"Bún chả","detail_name":"Bún chả","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"524.5 g / Tô vừa","quantity_value":524.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bún tươi","quantity_raw":"300 g","quantity_value":300,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc vai","quantity_raw":"90 g","quantity_value":90,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đu đủ xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt ba chỉ rửa sạch thái mỏng Thịt nạc vai rửa sạch xay hoặc băm nhỏ Đu đủ xanh ,cà rốt gọt vỏ Rau ăn kèm rửa sạch, để ráo. Cách làm bún chả: Hành củ và tỏi băm thật nhuyễn. =Sả băm nhỏ,cho chút nước vào máy xay sinh tố xay nhỏ,lọc lấy nước cốt. Cho thịt xay và thịt ba chỉ thái mỏng vào hai bát. Ướp thịt trong vòng 1h để thịt ngấm (cách tốt nhất là nên ướp thịt qua đêm là ngon nhất). Sau khi chuẩn bị đem thịt ra nướng có thêm một bí quyết là vắt vào nửa quả chanh để thịt nướng mềm hơn. Lúc chờ thịt thì mọi người nên làm phần dưa góp và nước chấm: Dưa góp: đu đủ xanh, cà rốt xắt hoa thái mỏng, cho một chút muối vào đảo đều, đến khi tiết ra nước thì chắt bỏ phần nước đó đi rồi rửa sạch để ráo. Trộn đu đủ xanh, cà rốt với:chút muối, dấm, ớt, đường, tỏi băm, nêm nếm chua cay, mặn ngọt là được. Cách pha nước chấm: các bạn dùng đơn vị là một cái bát nhỏ ăn cơm, đong 1,5 bát nước, 3 thìa canh đường(thìa ăn phở), 1/2 bát nước mắm, một quả chanh, chút hạt tiêu, tỏi, ớt băm nhỏ, nêm nếm cho vừa ăn. Cách nướng chả: Có thể nướng bằng bếp than, lò nướng. Chả vê nhẹ thành hình tròn ấn hơi dẹt chút. Sếp thịt và chả ra vỉ hoặc khay nướng, khi nướng thỉnh thoảng phết chút dầu ăn lên, khi nào chả gần vàng thì phết chút mật ông cho thịt và chả vàng óng nhé nhưng nhớ ít thôi không lại bị đắng. Khi chuẩn bị ăn thì đun phần nước chấm lên nhưng chỉ hơi âm ấm nhé, chan nước chấm với thịt và chả, thêm dưa góp và bún.","nutrition":{"kcal":836.9,"protein_g":26.4,"fat_g":41.8,"carbs_g":89.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00y3t8m13u1pyha2","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:chua cay","unlisted_ingredient_phrase:hanh cu","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:mat ong","unlisted_ingredient_phrase:nem chua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:thit ba","unlisted_ingredient_phrase:thit nuong","unlisted_ingredient_phrase:thit va","unlisted_ingredient_phrase:uop thit","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00yxt8m1ywsw2nly#variant-1","name":"Bún giấm cá","detail_name":"Bún giấm cá","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"586.5 g / Tô vừa","quantity_value":586.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bún tươi","quantity_raw":"300 g","quantity_value":300,"quantity_unit":"g"},{"name":"Cá chép","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Thì là","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cá chép làm sạch với muối và chanh và để ráo nước, lóc lấy phần thịt nạc, phần còn lại để nấu nước dùng. – Các loại rau ngâm nước muối loãng, rửa sạch, để ráo nước. Cà chua bổ múi cau. Hành tím nướng 3 – 4 củ để bỏ vào nước dùng cho thơm, còn lại băm nhuyễn, tỏi băm nhuyễn, hành lá, thì là cắt nhuyễn. Nấu nước dùng – Bạn dùng phần xương, đầu cá để nấu nước dùng cùng với hành tím nướng. Để nước dùng trong, thơm, không có mùi tanh của cá, bạn nên chần sơ xương và đầu cá với nước sôi trước đó. – Khi nước dùng sôi lên bạn bắt đầu nhỏ lửa và đun liu riu. Khi thấy đầu cá, xương cá chín nhừ thì lọc lấy nước, châm thêm nước vào nồi rồi đun sôi lại lần nữa thì nêm nếm cho vừa ăn. – Ướp cá chép cùng tiêu, nước mắm, bột ngọt, gừng, một ít rượu và đem hấp trong 30 phút là được Pha nước mắm chấm – Làm nước chấm bằng cách cho tỏi băm, ớt cắt lát và nước mắm ngon vào chén, trộn đều. Lưu ý, không thêm đường để nước mắm giữ được vị ngon nguyên chất. Trình bày và thưởng thức – Xếp bún ra tô, cho cá chép vào, thì là, hành lá lên trên rồi chan nước dùng vào và thưởng thức cùng rau sống. Thêm chút nước mắm sẽ làm món ăn thêm đậm đà.","nutrition":{"kcal":589.2,"protein_g":25.4,"fat_g":14,"carbs_g":91.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00yxt8m1ywsw2nly","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giá đậu xanh","unlisted_ingredient_phrase:bo