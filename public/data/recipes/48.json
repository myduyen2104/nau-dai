.food/mon-an/cmrg0p7gi05cut8m1ptn80vg5","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05nft8m1wizjo8es#variant-1","name":"Xôi gấc","detail_name":"Xôi gấc","category":"Xôi","age_group":null,"serving":{"raw":"175 g / Dĩa vừa","quantity_value":175,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Gạo nếp cái","quantity_raw":"119.5 g","quantity_value":119.5,"quantity_unit":"g"},{"name":"Gấc","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Gạo nếp cho ra thau, đổ nước ấm ngập mặt gạo và đậu. Ngâm trong vòng 4-5 tiếng (hoặc trước khi đi ngủ ngâm gạo đỗ, sáng hôm sau nấu), tùy theo nếu có thời gian, còn nếu không thì 3 tiếng cũng được. Trái gấc bạn bổ đôi, sau đó dùng muỗng nạo lấy thịt gấc cho vào chén sạch. Tiếp theo, bạn cho một ít rượu trắng vào chén gấc, đeo bao tay vào và bóp nhẹ nhàng để tách thịt ra khỏi hạt. Lúc này, bạn loại bỏ phần hạt đen đi và giữ lại thịt gấc đỏ để nấu cùng với nếp thành món xôi gấc. Gạo nếp sau khi ngâm và gấc đã tách thịt, bạn trộn nếp và gấc vào với nhau, thêm 1 chút muối. Trộn nhẹ nhàng và đều tay cho đến khi nếp được nhuộm một màu đỏ au bóng bẩy của gấc. Cho nước sôi và nước cốt dừa vào xâm xấp mặt gạo và gấc đã trộn đều vào nồi cơm điện, bật nút nấu chín. Sau khi cạn nước nồi cơm điện sẽ chuyển qua chế độ hâm nóng bạn cứ để như vậy khoảng 10 phút thì bật lại nút nấu. Nồi cơm điện sẽ chuyển qua chế độ nấu lần 2. Bạn để như vậy 30 phút sau thì xôi chín.","nutrition":{"kcal":590.4,"protein_g":12,"fat_g":13.8,"carbs_g":104.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05nft8m1wizjo8es","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:ruou trang","unlisted_ingredient_phrase:xoi gac"],"source_categories":[{"label":"Xôi","id":"xoi","kind":"food_category","baseLabel":"Xôi"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"}]