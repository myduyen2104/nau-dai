value":1,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cá thác lác mua về nêm chút gia vị, chút tiêu cho vào cối quết đến khi dẻo lại (để khỏi dính cối trước khi quết cho vào cối tí dầu ăn). Sau khi quết xong thì bỏ thì là đã thái nhuyễn vào trộn đều. Cà chua rửa sạch. Một quả băm nhuyễn. Hai quả còn lại cắt múi cau. Cho một tí dầu ăn vào nồi, phi hành cho thơm. Sau đó cho phần cà chua băm nhuyễn vào xào cho ra màu. Đổ nước vào nấu sôi khoảng 70 độ thì lấy muỗng phết cá thác lác miếng vừa ăn bỏ vào nồi nước. Đến khi sôi bùng khoảng 5 phút thì cho phần cà chua cắt múi cau vào. Để khoảng 2 phút nữa thì hạ lửa, cho chút nước mắm, nêm nếm vừa ăn sau đó tắt bếp và bỏ phần hành lá cùng rau mùi đã thái còn lại vào.","nutrition":{"kcal":39.7,"protein_g":2.4,"fat_g":2.3,"carbs_g":2.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qy01i7t8m1fm78j8m3","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01n9t8m1lue5oa4z#variant-1","name":"Canh đu đủ xanh nấu sườn heo","detail_name":"Canh đu đủ xanh nấu sườn heo","category":"Món canh từ 18-24 tháng tuổi","age_group":"18-24 tháng","serving":{"raw":"36.5 g / Chén","quantity_value":36.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đu đủ xanh","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Sườn heo (lợn)","quantity_ra