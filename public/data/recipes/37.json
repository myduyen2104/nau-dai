bs_g":4.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05jot8m1gclekjnh","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:uop thit","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05nmt8m1jdo8e6u9#variant-1","name":"Xôi lá cẩm","detail_name":"Xôi lá cẩm","category":"Xôi (18 tháng trở lên)","age_group":"18 tháng","serving":{"raw":"162.5 g / Dĩa nhỏ","quantity_value":162.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Gạo nếp cái","quantity_raw":"107.5 g","quantity_value":107.5,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"16 g","quantity_value":16,"quantity_unit":"g"},{"name":"Vừng (đen, trắng)","quantity_raw":"4.5 g","quantity_value":4.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"14 g","quantity_value":14,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Lá cẩm rửa sạch, chọn phần lá tươi nấu với lửa lớn sau đó lặt những lá còn tươi cho vào rổ để mang đi nấu trong nước với lửa lớn sau đó hạn nhỏ lửa nấu trong 10-15 phút đến khi nước chuyển sang màu đỏ tím. Lọc lấy phần nước lá cẩm. Gạo nếp vo sạch rồi để ráo nước, ngâm với nước lá cẩm khoảng 2 tiếng. Đậu xanh rửa sạch, cho vào nồi luộc chín. Đậu chín vớt ra và trộn đều với đường và tán nhuyễn. Chắc bỏ phần nước cho ráo rồi đem đi hấp trên xửng hấp, khi xôi chín rưới nước cốt dừa lên và đảo đều để xôi không bị nhão. Xôi chín thì múc ra đĩa, cho đậu xanh hấp chín lên trên, thêm cùi dừa nạo, và vừng rang lên trên là thưởng thức.","nutrition":{"kcal":588.2,"protein_g":14.9,"fat_g":11.3,"carbs_g":106.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05nmt8m1jdo8e6u9","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Xôi (18 tháng trở lên)","id":"xoi_18_thang_tro_len","kind":"age_scoped_food_category","baseLabel":"Xôi"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"}]