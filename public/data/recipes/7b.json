cmrg0p4qu00tft8m152tqs3h0","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Pho mát","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:pho mai","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ từ 7-8 tháng","id":"mon_bot_nha_nau_cho_tre_tu_7_8_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"7-8 tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00xrt8m1uq2g6ykk#variant-1","name":"Bún cà ri tôm","detail_name":"Bún cà ri tôm","category":"Món nước 5 tuổi","age_group":"5 tuổi","serving":{"raw":"261.5 g / Tô nhỏ","quantity_value":261.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"120 g","quantity_value":120,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Khoai lang","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nước cốt dừa, đóng hộp","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cary bột","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sả rửa sạch 1 cây băm nhỏ, 1 cây đập dập rồi cắt khúc. Tỏi cũng bóc vỏ rồi băm nhỏ. Khoai lang gọt vỏ, thái miếng vuông vừa ăn, ngâm vào bát nước muối pha loãng để khoai khỏi thâm. Cà rốt, hành tây bạn cũng thái miếng cỡ miếng khoai lang. Rau húng quế nhặt rửa sạch. Tôm rửa sạch, bóc vỏ, bỏ đầu, lấy chỉ lưng và bụng. Sau đó rửa sạch lại một lần nữa rồi để ráo nước. Tiếp theo ướp tôm với 1 chút tỏi và sả băm nhỏ, một ít hạt nêm, gia vị, ớt bột và 1 gói cà ri. Để khoảng 10 phút sau đó cho khoai vào chảo rán hơi vàng các mặt (hoặc chỉ cần se các mặt), sau đó gắp ra đĩa. Cho sả và tỏi vào phi thơm lên, cho tôm vào xào qua. Đổ khoảng 1 bát con nước vào nồi tôm, đun sôi sau đó bạn cho khoai và cà rốt vào nồi. Đun sôi hỗn hợp trong vài phút rồi cho hành tây và nước cốt dừa vào. Nêm thêm hạt nêm, gia vị và đun sôi thêm vài phút nữa rồi thả rau húng quế vào. Cuối cùng cho cà ri tôm ra bát, ăn cùng cơm, bánh mì hay bún đều rất ngon.","nutrition":{"kcal":303.4,"protein_g":13.8,"fat_g":8.3,"carbs_g":44},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00xrt8m1uq2g6ykk","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh mi","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:rau hung"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw018ut8m1409b28z6#variant-1","name":"Cá lóc xào hành nấm","detail_name":"Cá lóc xào hành nấm","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"142 g / Dĩa nhỏ","quantity_value":142,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredient