t":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Hẹ mua về rửa sạch rồi đem cắt thành khúc dài khoảng 3 đốt tay. Đậu hũ mua về đem cắt thành các miếng vuông vừa ăn khoảng 2 đốt tay, sau đó đem ngâm trong nước khoảng 2 phút rồi để ráo nước. Thịt heo rứa sạch, băm nhuyễn, ướp gia vị, Bắc nồi nước lên bếp, khi nước sôi thì cho thịt băm, đậu hũ vào, nêm nếm gia vị vừa ăn Khi nước sôi lại thì cho hẹ vào, nấu khoảng 2 phút nữa thì tắt bếp và rắc ít tiêu lên.","nutrition":{"kcal":80.5,"protein_g":6.4,"fat_g":4.8,"carbs_g":2.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01oxt8m1j0b39eqx","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nuoc khoang","unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món canh 8-18 tuổi","id":"mon_canh_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01z1t8m1k2h1bc9s#variant-1","name":"Chả chay","detail_name":"Chả chay","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"100 g","quantity_value":100,"quantity_unit":"g","portion_label":null},"ingredients":null,"instructions_raw":null,"nutrition":{"kcal":244,"protein_g":0,"fat_g":0,"carbs_g":0},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01z1t8m1k2h1bc9s","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","instructions_missing_from_detail","listing_count_not_visible_in_detail"],"integrity_findings":[