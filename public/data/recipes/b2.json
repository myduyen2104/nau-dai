i kim chi cải thảo cũng rất ngon.","nutrition":{"kcal":94.2,"protein_g":6.5,"fat_g":7.1,"carbs_g":1.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05g6t8m1ly56agok","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:cai thao","unlisted_ingredient_phrase:kim chi"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05gbt8m1tfuqj6qs#variant-1","name":"Trứng gà luộc","detail_name":"Trứng gà luộc","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"157 g / Phần 3 trứng","quantity_value":157,"quantity_unit":"g","portion_label":"Phần 3 trứng"},"ingredients":[{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Đun nước sôi, cho trứng vào luộc trong 10 phút. Cho trứng ra nước lạnh, bóc vỏ. Cho tỏi, đường vào chén, giả nát, cho nước mắm, nước lọc, nước cốt chanh, nêm nếm vừa ăn","nutrition":{"kcal":208.5,"protein_g":19.4,"fat_g":12.3,"carbs_g":5.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05gbt8m1tfuqj6qs","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_fi