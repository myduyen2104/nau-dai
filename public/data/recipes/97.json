ổ thêm nước lọc vào nồi. Việc cho nước vào nồi canh măng chua có thể điều chỉnh nhiều ít tùy vào lượng người ăn để cho sao phù hợp nhất. Sau đó, đun sôi nồi nước với lửa vừa. Trong lúc đun sôi nước thì trụng sơ bún qua nước sôi rồi vớt ra rửa lại với nước lạnh. Sau cùng, bỏ đậu hũ vừa xắt nhỏ vào nấu cùng khoảng 5 phút, thêm đầu hành thái nhỏ, chút ớt tiêu vào làm đậm vị đảo đều rồi tắt bếp. Cho bún ra tô rồi bỏ cái vào trước, sau đó múc nước dùng vào. Thưởng thức kèm với rau thơm","nutrition":{"kcal":610.8,"protein_g":26.6,"fat_g":16.1,"carbs_g":89.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00zst8m1zkjq9zro","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tàu hủ ky khô","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:chua co","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước- chay","id":"mon_nuoc_chay","kind":"food_category","baseLabel":"Món nước- chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw0195t8m1lefceon1#variant-1","name":"Cá mòi kho chay","detail_name":"Cá mòi kho chay","category":"Món chay","age_group":null,"serving":{"raw":"179 g / Dĩa vừa","quantity_value":179,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Hoa chuối","quantity_raw":"132 g","quantity_value":132,"quantity_unit":"g"},{"name":"Tàu hủ ky khô","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw"