rửa sạch rồi băm nhuyễn cho vào thit chay ướp, lấy một ít phần tỏi cắt nhỏ để phi với dầu Cho đường, muối, bột nêm, xì dầu, dầu hào, dầu ăn, tiêu, sả bằm, tỏi băm nhuyễn, đường vào thịt chay và trộn đều ướp.Cho thịt chay vào trong cái khay lót giấy bạc vào trong lò nướng hoặc chiên dầu. Nướng tới khi thấy thịt trở thành màu vàng nâu đều 2 mặt là được. Bày bún vào tô, cho rau thơm, dưa leo, tỏi vào mắm.","nutrition":{"kcal":454.9,"protein_g":13.1,"fat_g":13.8,"carbs_g":70.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv012ot8m1tx55qby6","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:dau hao","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô- chay","id":"mon_kho_chay","kind":"food_category","baseLabel":"Món khô- chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01bit8m1k81qhg8h#variant-1","name":"Cà rốt luộc","detail_name":"Cà rốt luộc","category":"Món luộc 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"120 g / Dĩa vừa","quantity_value":120,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":null,"instructions_raw":"Cà rốt rửa sạch, gọt vỏ . Đặt nồi nước luộc trong 10 phút, tắt bếp vớt ra dĩa","nutrition":{"kcal":56.4,"protein_g":1.9,"fat_g":0.3,"carbs_g":11.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01bit8m1k81qhg8h","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","listing_count_not_visible_in_detail"],"integrity_findings":[],"source_categories":[{"label":"Món luộc 8-18 tuổi","id":"mon_luoc_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món luộc"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01o3t8m19u0zxngq#variant-1","name":"Canh gà lá giang","detail_name":"Canh gà lá giang","category":"Món canh từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"22.5 g / Chén","quantity_value":22.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Thịt gà ta","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Lá me","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau ngổ","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Gà đem rửa sạch với nước muối loãng, chặt miếng vừa ăn, để ráo nước. Ướp gà với một chút gia vị ... khoảng 15 phút cho thấm gia vị. Bó lá giang ngắt lấy phần lá, rửa sạch, vớt ra rổ, vò nhẹ cho dập. Cho 1 chút dầu vào nồi đun nóng sau đó cho tỏi băm vào phi vàng, tiếp đến cho phần thịt gà đã ướp và đảo đều tay cho thịt săn lại. Thịt gà đã săn, cho 1 lượng nước lọc vừa ăn vào nồi đun lửa lớn cho sôi. Thịt gà sôi khoảng 1-2 phút, cho lá giang vào đun sôi lần nữa, nêm nếm lại gia vị cho vừa ăn là được.","nutrition":{"kcal":32,"protein_g":2.5,"fat_g":2.3,"carbs_g":0.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01o3t8m19u0zxngq","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Rau ngổ","unlisted_ingredient_phrase:gia vi bo","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh từ 3-4 tuổi","id":"mon_canh_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01wyt8m1u8l5bqh1#variant-1","name":"Canh su su nấu thịt nạc","detail_name":"Canh su su nấu thịt nạc","categ