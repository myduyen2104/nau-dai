g_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01jzt8m1z599f3ah#variant-1","name":"Canh cải cúc nấu thịt bò","detail_name":"Canh cải cúc nấu thịt bò","category":"Món canh 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"112.2 g / Chén","quantity_value":112.2,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Tần ô/cải cúc","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Rau cải cúc nhặt kỹ sau đó rửa sạch, cắt khúc vừa ăn. Bước 2: Thịt bò rửa thật sạch, để ráo, thái miếng, băm nhỏ. Ướp thịt bò với 1 chút gia vị và trộn đều.ướp chừng 15 phút cho thịt bò ngấm gia vị. Bước 3: Bắc nồi lên bếp, cho dầu ăn vào chảo, làm nóng và phi thơm tỏi. Tiếp đến cho thịt bò vào đảo săn. Bước 4: Đổ vào nồi xào thịt bò khi nãy nước vào đun sôi, cho thịt bò vào, nêm nếm gia vị cho vừa ăn rồi rau cải cúc vào và đun sôi lại và tắt bếp.","nutrition":{"kcal":42.4,"protein_g":3.7,"fat_g":1.4,"carbs_g":3.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01jzt8m1z599f3ah","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món canh 8-18 tuổi","id":"mon_canh_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01lgt8m1wu8vqqnm#variant-1","name":"Canh cải thảo nấu thịt bò","detail_name":"Canh cải thảo nấu thịt bò","category":"Món canh 6-7 tuổi","age_group":"6-7 tuổi","se