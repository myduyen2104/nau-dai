ail"],"integrity_findings":[],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04xjt8m1czrsgk20#variant-1","name":"Súp lơ xanh xào thịt bò","detail_name":"Súp lơ xanh xào thịt bò","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"79.5 g / Dĩa nhỏ","quantity_value":79.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Súp lơ xanh","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Súp lơ rửa sạch, cắt miếng vừa ăn. Thịt bò rửa sạch, thái mỏng rồi ướp gia vị. Đun nóng dầu, rồi cho súp lơ vào xào chín tới. Cho tiếp thịt bò vào xào nhanh tay trên lửa lớn để thịt chín vừa đủ độ, không bị dai. Nêm lại gia vị lần cuối cho vừa ăn. Xúc ra đĩa, thêm vào 1 chút hạt tiêu và ăn nóng với cơm.","nutrition":{"kcal":58.9,"protein_g":3.1,"fat_g":3.4,"carbs_g":4.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04xjt8m1czrsgk20","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Súp lơ xanh","ingredient_not_mentioned_by_name:Muối","title_ingredient_not_mentioned:Súp lơ xanh","unlisted_ingredient_phrase:hat tieu"],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04y2t8m1ap33mgcs#variant-1","name":"Súp óc heo","detail_name":"Súp óc heo","category":"Món nước","age_group":null,"serving":{"raw":"92.6 g / Tô nhỏ","quantity_value":92.6,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ngô bắp tươi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Óc heo (lợn)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc mông","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Trứng cút (10g/quả)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"Nấu nước dùng xương ống Xương ống luộc qua rồi rửa sạch cho hết chất bẩn. Ninh xương khoảng 1 giờ rồi chắt lấy 1 lít nước dùng làm nước súp. Sơ chế nguyên liệu Bắp mỹ: rửa sạch, tách hạt. Thịt heo nạc mua về rửa sạch, băm nhuyễn. Óc heo rửa sạch để ráo. Bột năng pha với nước Nước dùng sôi, cho bắp mỹ vào sau đó cho gia vị vào nêm nếm vừa ăn. Tiếp theo cho óc heo vào. Tiếp đến cho bột năng vào, chú ý là đổ từ từ, đến khi thấy nồi súp sánh lại thì dừng lại. Không nên đổ ngay cùng 1 lúc sẽ dễ bị đặc quá nhé. Sau cùng từ từ đổ trứng đánh tan vào khấy theo 1 chiều để tạo vân cho đẹp. Bạn có thể lọc chỉ lấy lòng trắng trứng cho vào thì tạo vân trắng sẽ đẹp hơn. Nấu đến khi nồi súp chuyển màu