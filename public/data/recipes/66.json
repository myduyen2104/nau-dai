[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tx00i7t8m1oef8bfp3#variant-1","name":"Bánh mì thịt (Ổ vừa)","detail_name":"Bánh mì thịt (Ổ vừa)","category":"Món khô","age_group":null,"serving":{"raw":"340 g / Ổ vừa","quantity_value":340,"quantity_unit":"g","portion_label":"Ổ vừa"},"ingredients":[{"name":"Bánh mì","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc vai","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Ruốc thịt heo (lợn)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"}],"instructions_raw":"Cà rốt, củ cải gọt vỏ, rửa sạch, bào sợi, ngâm chua ngọt. Giò lụa thái lát mỏng, cắt sợi, Dưa leo rửa sạch cắt lát mỏng. Hành lá, rau mùi rửa sạch, để ráo. Cắt đôi ruột bánh mì sau đó phết ba tê, thêm dưa chuột, giò lụa, Thịt heo quay, nước tương, dăm bông vào, sau đó thêm rau chua củ cải, cà rốt vào, thêm hành lá rau mùi vào kẹp bánh mì lại và thưởng thức.","nutrition":{"kcal":581.3,"protein_g":28,"fat_g":28.8,"carbs_g":52.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tx00i7t8m1oef8bfp3","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:chua ngot","unlisted_ingredient_phrase:dam bong","unlisted_ingredient_phrase:heo quay","unlisted_ingredient_phrase:ngam chua","unlisted_ingredient_phrase:ngam chua ngot","unlisted_ingredient_phrase:nuoc tuong","unlisted_ingredient_phrase:oi ruot"],