g đỏ tán đều. Dùng chảo dầu chiên vàng tôm. Gạn bớt dầu phi thơm tỏi sau đó cho trứng muối vào xào đều cùng gia vị. Cuối cùng cho tôm vào đảo đều cho thấm gia vị và tắt bếp có thể dùng được.","nutrition":{"kcal":146.2,"protein_g":17.2,"fat_g":6.9,"carbs_g":4.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05clt8m1n7w09yfs","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gi05d4t8m1kzxnm631#variant-1","name":"Tôm xào hạt điều","detail_name":"Tôm xào hạt điều","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"103 g / Dĩa vừa","quantity_value":103,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Tôm đồng","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Hạt điều","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Tôm rửa sạch để ráo. Dùng 1 chảo dầu cho tôm vào xào cùng gia vị đến khi tôm chín cho hạt điều vào nêm lại gia vị cho vừa ăn, tắt bếp rắc tiêu lên bề mặt là có thể thưởng thức.","nutrition":{"kcal":206.4,"protein_g":17.5,"fat_g":13.4,"carbs_g":4.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05d4t8m1kzxnm631","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gi05dxt8m1s281rrjl#variant-1","name":"Trứng chiên hành tây cuộn","detail_name":"Trứng chiên hành tây cuộn","category":"Món mặn","age_group":null,"serving":{"raw":"136 g / Dĩa vừa","quantity_value":136,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Hành tây","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Lòng trắng trứng gà","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"}],"instructions_raw":"Cho trứng gà, gia vị vào tô, đánh tan. Hành tây bóc vỏ, cắt hạt lựu nhỏ, cho vào tô trứng gà Đổ đều một lớp trứng mỏng lên mặt chảo. Khi trứng hơi chín, nhẹ nhàng cuộn trứng lại. Khi cuộn còn khoảng 5cm thì đẩy miếng trứng về góc chảo. Tiếp tục đổ thêm một lớp trứng nữa, đè lên 5cm trứng dư của lớp cũ. Khi trứng bắt đầu hơi đông lại, tiếp tục cuộn, để dư 5cm rồi lại đẩy miếng trứng về góc chảo. Làm tương tự cho đến hết. Sau khi trứng chín, để nguội khoảng 5 phút rồi cắt trứng thành miếng vừa ăn. Ăn kèm với kim chi cải thảo cũng rất ngon.","nutrition":{"kcal":104.3,"protein_g":11,"fat_g":5.1,"carbs_g":4.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05dxt8m1s281rrjl","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Lòng trắng trứng gà","unlisted_ingredient_phrase:cai thao","unlisted_ingredient_phrase:kim chi"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captur