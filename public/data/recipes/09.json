 cà ri thì bạn nên thái to một chút. Luộc cà rốt và khoai tây chín nhưng không quá mềm. Vớt ra và để cho ráo nước. Nấu cà ri Cho một lớp dầu ăn mỏng vào nồi to. Khi dầu đã nóng, bạn cho thịt gà đã ướp và đảo sơ cho nóng rồi cho nước dừa vào. Hầm thịt gà với nước dừa khoảng 30 phút thì cho các loại củ vào hầm cùng. Nếu bạn thấy nước quá cạn thì có thể cho thêm một chút nước ấm nhưng tốt nhất vẫn là nên cho thêm nước dừa. Khi mà thịt gà đã chín thì bạn hạ nhỏ lửa lại, hầm thêm chút nữa cho nước cà ri sắc và thật thấm, đậm vị thì tắt bếp.","nutrition":{"kcal":202.4,"protein_g":8.9,"fat_g":8.4,"carbs_g":23.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tx00gzt8m1gdxl9u62","quality_status":"unmatched","warnings":["duplicate_listing_row_occurrence","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Cary bột","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:khoai tay","unlisted_ingredient_phrase:tuong nhat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 18-35 tháng","id":"mon_nuoc_18_35_thang","kind":"food_category","baseLabel":"Món nước 18-35 tháng"}],"source_age_group":null,"source_tag_evidence_status":"catalog_capture_unmatched_to_detail"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tx00kct8m1ihf5gg1p#variant-1","name":"Bánh tiêu (34g/ cái bé)","detail_name":"Bánh tiêu (34g/ cái bé)","category":"Bánh (3 tuổi trở lên)","age_group":"3 tuổi","serving":{"raw":"34 g / Cái","quantity_value":34,"quantity_unit":"g","portion_label":"Cái"},"ingredients":null,"instructions_raw":null,"nutrition":{"kcal":108.1,"protein_g":1.3,"fat_g":3.1,"carbs_g":18.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tx00kct8m1ihf5gg1p","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","instructions_missing_from_detail","listing_count_not_visible_in_detail"],"integrity_findings":[],"source_categories":[{"label":"Bánh (3 tuổi trở lên)