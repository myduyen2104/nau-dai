},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Vịt làm sạch, lọc thịt ở cổ, cánh, chân và xương sống đem giần kỹ rồi băm nhuyễn cho thịt nạc vai vào băm lẫn, nêm vừa mắm, muối, hạt tiêu trộn kỹ cho dẻo quánh rồi viên thành từng viên nhỏ. Phần thịt còn lại cho vào nước luộc chín, vớt ra để nguội chặt miếng bày dĩa. Măng thái mỏng, luộc chín vớt ra để ráo. Hành hoa nhặt rửa sạch,thái nhỏ,phần gốc và lá để riêng.\" Cho dầu vào chảo đun nóng già,phi thơm hành bỏ măng vào đảo đều.Nêm mắm muối cho ngấm đều vào măng rồi trút sang nồi nước luộc thịt vịt đun sôi, thả các thịt viên chín,nêm vừa mắm,muối rồi thả hành hoa. Lúc ăn lấy bún vào bát to, chan xáo măng ngập bún. Ăn với thịt vịt luộc, chấm nước mắm chanh ớt tỏi.\"","nutrition":{"kcal":446.1,"protein_g":16.7,"fat_g":20.2,"carbs_g":49.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv012xt8m1k3n652rg","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Rau muống","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:nac vai","unlisted_ingredient_phrase:nuoc mam"],"source_categories":[{"label":"Món nước 6-7 tuổi","id":"mon_nuoc_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01l6t8m1nue90i22#variant-1","name":"Canh cải soong nấu thịt heo","detail_name":"Canh cải soong nấu thịt heo","category":"Món canh từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"62.5 g / Chén","quantity_value":62.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cải soong","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"