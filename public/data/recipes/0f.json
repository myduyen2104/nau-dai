antity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Thịt nạc rửa sạch cắt mỏng, băm nhuyễn, ướp gia vị vừa đủ. Rau dền nhặt lấy phần ăn được, rửa sạch. Nấm rơm rửa sạch, cắt đôi. Bắt nồi lên bếp, phi thơm hành, cho thịt vào đảo đều, sau đó cho nước vào nấu sôi, nước sôi cho nấm rơm, mướp vào nấu chín. Nêm gia vị vừa ăn.","nutrition":{"kcal":46.9,"protein_g":2.9,"fat_g":3.2,"carbs_g":1.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01t2t8m1qpzrkf1o","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 25-35 tháng tuổi","id":"mon_canh_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01uat8m1c520iosq#variant-1","name":"Canh rau dền đỏ nấu thịt heo","detail_name":"Canh rau dền đỏ nấu thịt heo","category":"Món canh 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"81.8 g / Chén","quantity_value":81.8,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau giền đỏ","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Thịt nạc rửa sạch cắt mỏng, băm nhuyễn, ướp gia vị vừa ăn Rau dền lặt rửa sạch Bắt nồi lên cho dầu ăn vào phi thơm với tỏi băm, cho thịt vào xào sơ, thịt săn lại. Nấu nước sôi cho rau dền vào, nước sôi lần nữa nếm lại cho vừa ăn. Tắt bếp","nutrition":{"kcal":81.6,"protein_g":4.4,"fat_g":4.7,"carbs_g":5.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01uat8m1c520iosq","qualit