uantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thịt heo rửa sạch, xay nhuyễn. Cà chua rửa sạch, bỏ hạt, cắt hạt lựu nhỏ. Mộc nhĩ ngâm mềm, rửa sạch, cắt nhỏ. Trứng cút luộc chín, bóc vỏ. Tỏi bóc vỏ băm nhuyễn. Cho thịt xay, mộc nhĩ, gia vị vào 1 tô lớn, trộn đều. Múc 1 muỗng canh hỗn hợp vừa ướp bọc lấy trứng cút, để hở 1 đầu trứng cho đẹp. Làm lần lượt đến hết trứng cút. Cho viên thịt vào xửng, hấp cách thủy khoảng 10-15 phút cho thịt chín. Đun nóng dầu, phi thơm tỏi băm, cho cà chua vào, đảo đều. Khi cà chua chín nhừ, nêm nếm gia vị vừa ăn, cho thịt viên đã hấp vào ninh thêm 2 -3 phút là được.","nutrition":{"kcal":154,"protein_g":6.9,"fat_g":11.9,"carbs_g":5.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05met8m1dyn907ra","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:au trung","unlisted_ingredient_phrase:hon hop"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]