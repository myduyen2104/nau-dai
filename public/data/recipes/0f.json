 chú ý là đổ từ từ, đến khi thấy nồi súp sánh lại thì dừng lại. Không nên đổ ngay cùng 1 lúc sẽ dễ bị đặc quá nhé. Sau cùng từ từ đổ trứng đánh tan vào khấy theo 1 chiều để tạo vân cho đẹp. Bạn có thể lọc chỉ lấy lòng trắng trứng cho vào thì tạo vân trắng sẽ đẹp hơn. Nấu đến khi nồi súp chuyển màu trong thì tắt bếp, múc ra chén, rắc rau mùi, , tiêu bột, ớt tùy ý lên và thưởng thức","nutrition":{"kcal":147.3,"protein_g":7.3,"fat_g":4,"carbs_g":20.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04w9t8m1zbsvb25l","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt bò loại 2","ingredient_not_mentioned_by_name:Hành lá (hành hoa)","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Xì dầu","unlisted_ingredient_phrase:bo vien","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:long trang","unlisted_ingredient_phrase:long trang trung","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:o trung","unlisted_ingredient_phrase:pha voi","unlisted_ingredient_phrase:pha voi nuoc","unlisted_ingredient_phrase:trang trung","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05g7t8m112pct7ab#variant-1","name":"Trứng gà luộc","detail_name":"Trứng gà luộc","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"82 g / Dĩa nhỏ","quantity_value":82,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"75 g","quantity_value":75,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"