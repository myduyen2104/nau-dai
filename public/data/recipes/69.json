m rửa sạch, bóc vỏ, ướp gia vị trong 15 phút Đậu que nhặt rồi bẻ khúc ngắn khoảng 2 lóng tay. Rửa sạch rồi trụng qua nước sôi có ngâm chút muối. Cà rốt gọt vỏ, rửa sạch, cắt sợi vừa ăn. Chuẩn bị một chiếc chảo vừa, đun sôi 1 muỗng dầu ăn, cho tôm vào xào sơ. Cho tôm ra chén và tiếp tục sử dụng chảo đó để đun sôi dầu rồi phi thơm tỏi, cho đậu, cà rốt vào xào, nêm nếm gia vị vừa ăn. Xào đều tay cho đậu, cà rốt chín tới rồi cho tôm xào lúc nãy vào , đảo đều rồi tắt bếp.","nutrition":{"kcal":140.1,"protein_g":7.8,"fat_g":3.6,"carbs_g":19.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02jgt8m1r77c0zdw","quality_status":"complete","warnings":[],"integrity_findings":[],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02jvt8m1fmz7mfl7#variant-1","name":"Đậu đũa xào","detail_name":"Đậu đũa xào","category":"Món luộc 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"99.53 g / Dĩa vừa","quantity_value":99.53,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Đậu đũa","quantity_raw":"95 g","quantity_value":95,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3.02 g","quantity_value":3.02,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1.51 g","quantity_value":1.51,"quantity_unit":"g"}],"instructions_raw":"Đậu đũa mua về rửa sạch với nước. tước sơ, sau đó cắt từng đoạn vừa ăn. Đặt nồi nước sôi kỹ thả đậu vào luộc đậu trong 10 phút. sau đó vớt đậu ra dĩa để nguội.","nutrition":{"kcal":92.5,"protein_g":5.9,"fat_g":3.3,"carbs_g":9.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02jvt8m1fmz7mfl7","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_n