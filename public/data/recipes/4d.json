ổ ngay cùng 1 lúc sẽ dễ bị đặc quá nhé. Sau cùng từ từ đổ trứng đánh tan vào khấy theo 1 chiều để tạo vân cho đẹp. Nấu đến khi nồi súp chuyển màu trong thì tắt bếp, múc ra chén, rắc rau mùi, ttiêu bột, ớt tùy ý lên và thưởng thức","nutrition":{"kcal":157.9,"protein_g":7.4,"fat_g":4.2,"carbs_g":22.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04xtt8m1kkk6ehon","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Hành lá (hành hoa)","ingredient_not_mentioned_by_name:Xì dầu","ingredient_not_mentioned_by_name:Dầu mè","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:o trung","unlisted_ingredient_phrase:pha voi","unlisted_ingredient_phrase:pha voi nuoc","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước 3-4 tuổi","id":"mon_nuoc_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05f0t8m11y1x439y#variant-1","name":"Trứng gà chiên cua bể","detail_name":"Trứng gà chiên cua bể","category":"Món mặn 18-24 tháng tuổi","age_group":"18-24 tháng","serving":{"raw":"40 g / Dĩa nhỏ","quantity_value":40,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Cua bế","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cua rửa sạch, đem đi luộc chín, gở thịt cua Hà