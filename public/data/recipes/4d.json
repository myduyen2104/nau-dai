oup":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt020jt8m1xavfkzd0#variant-1","name":"Chả trứng chưng chay","detail_name":"Chả trứng chưng chay","category":"Món chay","age_group":null,"serving":{"raw":"95 g / Dĩa nhỏ","quantity_value":95,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Miến dong khô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Ngâm nước ấm mộc nhĩ, miến, nấm hương. Thái nhỏ miến và mộc nhĩ nấm hương xào sơ với dầu ăn, tán nhuyễn đậu phụ, trộn chung với hỗn hợp ở trên, cho từ từ bột năngvào trộn thành hỗn hợp nhuyễn mịn, nêm vừa miệng. Chuẩn bị hỗn hợp vào khuôn và hấp 20 phút. Nên ăn cùng cơm","nutrition":{"kcal":126.1,"protein_g":9.8,"fat_g":5.3,"carbs_g":9.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt020jt8m1xavfkzd0","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nam huong","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món chay","id":"mon_chay","kind":"food_category","baseLabel":"Món chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu025rt8m1fdmuhbr5#variant-1","name":"Cháo lươn rau ngót","detail_name":"Cháo lươn rau ngót","category":"Cháo 7-8 tháng tuổi","age_group":"7-8  tháng