0,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Cà chua rửa sạch cắt múi cau. Tỏi băm nhuyễn Rau muống rửa sạch với nước muối ngắt cọng già, giữ cọng non và lá. Tôm rửa sạch ướp với gia vị Nồi vừa nóng cho dầu ăn và phi tỏi cho thơm. Tiếp theo cho tôm vào. Và cà chua vào xào để có màu đỏ đẹp mắt. Me cho vào nước nóng để me ra nước sau đó dùng rây lọc cho phần nước me vào nồi. Cho thêm ít nước lọc vào rồi đổ phần nước trong nồi vào phần me lấy nước lặp lại 4-5 lần. Nêm nếm gia vị theo khẩu vị gia đình. Và cho rau muống vào nấu sôi lên thì tắt bếp, múc ra tô cho rau mùi vào.","nutrition":{"kcal":49.1,"protein_g":1.8,"fat_g":2.2,"carbs_g":5.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01mot8m1zowhos7x","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:rau muong","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh chay","id":"mon_canh_chay","kind":"food_category","baseLabel":"Món canh chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01nst8m190qdrs98#variant-1","name":"Canh đu đủ xanh nấu tôm","detail_name":"Canh đu đủ xanh nấu tôm","category":"Món canh","age_group":null,"serving":{"raw":"114.5 g / Chén","quantity_value":114.5,"quantity_unit":"g","por