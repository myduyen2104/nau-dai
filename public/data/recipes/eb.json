uctions_raw":null,"nutrition":{"kcal":41.3,"protein_g":2.9,"fat_g":1.3,"carbs_g":4.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01uet8m11oumqk2w","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu025st8m1sias07uq#variant-1","name":"Cháo lươn rau ngót","detail_name":"Cháo lươn rau ngót","category":"Cháo 9-12 tháng tuổi","age_group":"9-12 tháng","serving":{"raw":"77 g / Chén","quantity_value":77,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Lươn","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Rau ngót","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"}],"instructions_raw":"* Lươn rửa sạch, khử mùi bằng nước cốt chanh hoặc nước vo gạo cho đến khi hết nhớt, đem đi luộc, gỡ lấy thịt, băm nhuyễn. * Rau ngót rửa sạch, lấy lá băm nhuyễn. * Hòa tan lươn với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng, bắc lên bếp khuấy đều cho đến khi sôi, thêm rau ngót vào cho sôi lại. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":191,"protein_g":7.6,"fat_g":7.6,"carbs_g":22.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu025st8m1sias07uq","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc mam"],"source_categories":[{"label":"Cháo 9-12 tháng tuổi","id":"chao_9_12_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"9-12 tháng","id":"9_12_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu027it8m13m1nmdlp#variant-1","name":"Cháo thịt gà","detail_name":"Cháo thịt gà","category":"Món nước","age_group":null,"serving":{"raw":"92.5 g / Tô nhỏ","quantity_value":92.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"45 g","quantity_value":45,"quantity_unit":"g"},{"name":"Thịt gà ta","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hạt sen khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Khoai tây gọt vỏ rửa sạch sau đó cắt thành hạt lựu. Nấm rơm cắt bỏ gốc, ngâm muối, rửa sạch, để ráo. Hạt sen khô ngâm nước ấm cho hạt mềm. Thịt gà nên chọn ức gà, rửa với muối sau đó rửa sạch lại với nước, để ráo, xé sợi, ướp gia vị vừa ăn. Gạo các bạn vo sạch sau đó đổ nước và cho hạt sen, thịt gà sợi vào cùng bắt lên bếp. Khi thấy gạo nở bung đều, hạt sen mềm rồi thì tiếp tục phi gốc hành thơm sau đó cho khoai tây, nấm rơm đảo cho thơm rồi đổ vào nồi cháo Nấu sôi đến khi các loại rau củ vừa chín tới, nêm nếm lại, tắt bếp và cho hành ngò và tiêu vào. Cuối cùng các bạn tắt bếp nêm gia vị vừa ăn, cho vào tí tiêu cùng hành poa-rô lá và ngò cho thơm nhé!","nutrition":{"kcal":245.4,"protein_g":9.2,"fat_g":5.5,"carbs_g":40},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu027it8m13m1nmdlp","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrit