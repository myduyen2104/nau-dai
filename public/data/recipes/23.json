 thức.","nutrition":{"kcal":446.4,"protein_g":15.9,"fat_g":12.5,"carbs_g":68.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00cnt8m1wd5tq3o8","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Mỡ lợn nước","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:bot tron","unlisted_ingredient_phrase:chua ngot","unlisted_ingredient_phrase:ngam chua","unlisted_ingredient_phrase:ngam chua ngot","unlisted_ingredient_phrase:nhan tom"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00q6t8m10kn5ue7e#variant-1","name":"Bò hầm rượu vang","detail_name":"Bò hầm rượu vang","category":"Món mặn","age_group":null,"serving":{"raw":"92 g / Dĩa nhỏ","quantity_value":92,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bò loại 2","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Thịt thái vuông cạnh khoảng 3cm. Cà rốt, khoai tây cắt khoanh tròn. Tất cả trộn chung vào 1 cái thố, đổ rượu vào trộn