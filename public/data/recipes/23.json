nhỏ","quantity_value":107.6,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Tôm đồng","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Ớt vàng to","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Ớt xanh to","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"Tôm rửa sạch để ráo. Ớt xanh , ớt đỏ, ớt vàng rửa sạch cắt vừa ăn. Đặt 1 chảo dầu lên bếp xào đều ớt cùng dầu ăn, sau đó cho tôm vào xào chín nêm gia vị vừa ăn rồi tắt bếp rắc thêm ít tiêu lên bề mặt.","nutrition":{"kcal":104.3,"protein_g":9.8,"fat_g":6,"carbs_g":3.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05ctt8m1b1yn06t2","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05ejt8m1rm2absq9#variant-1","name":"Trứng gà chiên","detail_name":"Trứng gà chiên","category":"Món mặn 18-24 tháng tuổi","age_group":"18-24 tháng","serving":{"raw":"40 g / Dĩa nhỏ","quantity_value":40,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Trứng gà đập ra tô, thêm nước mắm, gia vị khuấy đều. Làm nóng dầu ăn trong chảo, đổ hỗn hợp trứng gà vào, chiên chín 2 mặt. Tráng đều chảo để trứng thật mỏng. Gấp 2 mép trứng lại với nhau. Lật ngược lại, chiên thêm 20 giây. Cho món ăn ra đĩa.","nutrition":{"kcal":72.3,"protein_g":4.5,"fat_g":5.9,"carbs_g":0.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05ejt8m1rm2absq9","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","unlisted_ingredient_phrase:hon hop"],"source_categories":[{"label":"Món mặn 18-24 tháng tuổi","id":"mon_man_18_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"18-24 tháng","id":"18_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05m6t8m1codapp0v#variant-1","name":"Xíu mại nhồi trứng cút","detail_name":"Xíu mại nhồi trứng cút","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"78 g / Dĩa nhỏ","quantity_value":78,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Trứng cút (10g/quả)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thịt heo rửa sạch, xay nhuyễn .Cà chua rửa sạch, bỏ hạt, cắt hạt lựu nhỏ . Trứng cút luộc, bóc vỏ Tỏi bó vỏ, băm nhuyễn . Cho thịt xay, tỏi, gia vị vào tô, trộn đều. Lấy 1 cái đĩa lớn, thoa một lớp dầu ăn lên bề mặt đĩa để khi hấp thịt không bị dính. Sau đó lấy hỗn hợp thịt ở trên viên thành những viên tròn vừa ăn, nhét quả trứng cút vào chính giữa viên thịt xay, xếp thịt viên lên đĩa, thực hiện đến khi hết thịt. Cho thịt vào hấp khoảng 10 phút cho chín. Bắc chảo lên bếp, phi thơm tỏi. Tiếp đó cho cà chua vào đảo kỹ, rồi cho phần sốt cà chua và phần nước khi hấp thịt vào cùng. Nêm nếm vừa ăn, cho những viên thịt đã hấp chín vào đảo đều, đun nhỏ lửa cho thịt ngấm sốt và đến khi nước sốt sền sệt là được. Tắt bếp, cho thịt ra đĩa cùng với nước sốt sau đó rắc xíu hành lá, rau mùi lên trên là được.","nutrition":{"kcal":216.6,"protein_g":9.7,"fat_g":18.2,"carbs_g":3.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05m6t8m1codapp0v","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:sot ca chua","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]