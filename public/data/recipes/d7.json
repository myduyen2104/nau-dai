":"30 g / Dĩa nhỏ","quantity_value":30,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bồ câu ra ràng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Bồ câu rửa sạch, để ráo ướp gia vị trong 30 phút. Nấm hương rửa sạch, ngâm nước cho nở, cắt bỏ chân nấm. Hành củ tươi và tỏi ta gọt vỏ rửa sạch cắt nhỏ. Gừng rửa sạch cạo vỏ rồi cắt sợi. Nấm hương ngâm nở, rửa sạch, băm nhỏ rồi trộn lẫn với gia vị cho vừa ăn. Đem hỗn hợp này nhồi vào chim, khâu kín . Đun mỡ nóng già, rán qua chim, cho vào nồi cùng với số nấm còn lại, thêm nước, om nhỏ lửa. Gần chín thì nêm lại cho vừa ăn. Bày chim vào bát to hoặc đĩa sâu lòng, rác hạt tiêu, ăn nóng.","nutrition":{"kcal":83.1,"protein_g":4.4,"fat_g":6.1,"carbs_g":2.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02e0t8m1yigfz91w","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:hon hop"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02kyt8m1puwnjypb#variant-1","name":"Đậu hũ kho nấm rơm","detail_name":"Đậu hũ kho nấm rơm","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"65 g / Dĩa nhỏ","quantity_value":65,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Đậu phụ chiên","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Nấm rơm chẻ làm 2, sau đó cho nấm vào nước muối pha loãng ngâm trong 5 phút, vớt ra để ráo. Đậu hũ cắt làm 4, cũng có thể cắt nhỏ hơn tùy theo sở thích nhưng không quá nhỏ xào sẽ bị nát Cho dầu ăn vào chảo, cho phần tỏi băm vào phi thơm, sau đó cho nấm rơm vào xào trên lửa lớn đến khi nấm rơm săn lại, cho gia vị vào xào cho nấm thấm gia vị. Cho đậu hũ vào xào và đảo đều để đậu hũ được thấm gia vị, cho thêm vào nước, gia vị, đảo đều và kho trong vài phút để nguyên liệu chín và nước hơi cạn thì tắt bếp.","nutrition":{"kcal":88.4,"protein_g":5.6,"fat_g":5.9,"carbs_g":3.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02kyt8m1puwnjypb","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:nguyen lieu","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02qct8m14xvoo6i2#variant-1","name":"Ếch hấp gừng","detail_name":"Ếch hấp gừng","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"104 g / Dĩa nhỏ","quantity_value":104,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Ếch ( thịt đùi)","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc mông","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Các bước thực hiện món Ếch hấp gừng Ếch lột da, bỏ ruột, rửa sạch, chặt làm tư, lọc hết xương ướp hành tỏi, nước gừng (giã nhỏ vắt lấy nước), đường, muối bóp đều, để ngấm. Nấm hương ngâm rửa sạch, chẻ mỗi tai làm đôi. Thịt nạc vai thái mỏng to bằng hai ngón tay. Lấy bát to, xếp vòng tròn quanh bát, cứ 1 miếng thịt ếch, 1 miếng nấm hương, lại đến 1 miếng thịt lợn, xếp vài lớp như vậy, xong đặt bát vào quả hấp, nếm mắm, muối vừa ăn đem hấp chín. Khi ăn, tưới mỡ nước lên trên, rắc hạt tiêu, điểm rau mùi, ăn nóng.","nutrition":{"kcal":198.9,"protein_g":20,"fat_g":11.1,"carbs_g":5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02qct8m14xvoo6i2","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nac vai","unlisted_ingredient_phrase:nuoc uong","unlisted_ingredient_phrase:rau mui"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_cat