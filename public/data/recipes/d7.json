0.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Tép gạo","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bạc hà (dọc mùng)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu bắp","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Giá, đậu bắp, cà chua và rau mùi tàu, rau thơm mua về rửa sạch, vẩy ráo nước. Đậu bắp bạn cắt thành từng lát chéo mỏng. Cà chua bỏ cuống, chẻ múi cau. Tép cắt bỏ phần đầu tới ngang mắt, cắt bỏ chân, rửa sạch nhiều lần nước rồi cho ra rổ để ráo. Đầu tiên, bạn dầm me với nước nóng, lấy phần nước cốt me. Sau đó, bắc nồi, cho ít dầu để phi thơm tỏi, rồi thêm nước vào. Nêm vào 1 chút gia vị, và nước me. Khi nước sôi cho tôm vào, vớt bọt rồi cho phần cà chua, đậu bắp, bạc hà vào, rồi nêm lại vừa ăn. Trông thấy rau củ vừa chín thì tắt bếp cho giá và rau mùi tàu, rau thơm cắt nhỏ vào là xong.","nutrition":{"kcal":28.7,"protein_g":2.2,"fat_g":1.2,"carbs_g":2.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01mwt8m12qonvnk7","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bạc hà (dọc mùng)","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:voi nuoc","id