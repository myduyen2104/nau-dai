[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00r2t8m172dg3e9a#variant-1","name":"Bò nấu ragu","detail_name":"Bò nấu ragu","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"73 g / Dĩa nhỏ","quantity_value":73,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu hà lan (hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch cắt khúc vừa ăn ướp gia vị khoảng 30 phút. Cà chua rửa sạch cắt nhuyễn. Khoai tây, cà rốt gọt vỏ cắt khúc vừa ăn. Đậu hà lan rửa sạch để ráo. Rau mùi rửa sạch, bỏ gốc, cắt nhỏ. Đặt nồi lên bếp cho thêm dầu ăn vào phi thơm tỏi, cho tiếp cà chua vào xào chín, tiếp đến cho thịt bò vào xào săn. Sau khi thịt bò săn cho nước vào hầm đến khi thịt bò chín mềm. Cho tiếp cà rốt, khoai tây, đậu hà lan vào nấu chín mềm, nêm nếm gia vị cho vừa ăn. Cuối cùng quậy bột bắp với nước lạnh cho vào nồi, để sôi kỹ tắt bếp. Cuối cùng múc ra tô để rau mùi lên trên và có thể dùng được.","nutrition":{"kcal":90,"protein_g":9.1,"fat_g":3.6,"carbs_g":5.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00r2t8m172dg3e9a","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00y2t8m1xpxyrxki#variant-1","name":"Bún chả","detail_name":"Bún chả","category":"Món nước","age_group":null,"serving":{"raw":"523.5 g / Tô vừa","quantity_value":523.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bún tươi","quantity_raw":"300 g","quantity_value":300,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc vai","quantity_raw":"90 g","quantity_value":90,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đu đủ xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt ba chỉ rửa sạch thái mỏng Thịt nạc vai rửa sạch xay hoặc băm nhỏ Đu đủ xanh ,cà rốt gọt vỏ Rau ăn kèm rửa sạch, để ráo. Cách làm bún chả: Hành củ và tỏi băm thật nhuyễn. =Sả băm nhỏ,cho chút nước vào máy xay sinh tố xay nhỏ,lọc lấy nước cốt. Cho thịt xay và thịt ba chỉ thái mỏng vào hai bát. Ướp thịt trong vòng 1h để thịt ngấm (cách tốt nhất là nên ướp thịt qua đêm là ngon nhất). Sau khi chuẩn bị đem thịt ra nướng có thêm một bí quyết là vắt vào nửa quả chanh để thịt nướng mềm hơn. Lúc chờ thịt thì mọi người nên làm phần dưa góp và nước chấm: Dưa góp: đu đủ xanh, cà rốt xắt hoa thái mỏng, cho một chút muối vào đảo đều, đến khi tiết ra nước thì chắt bỏ phần nước đó đi rồi rửa sạch để ráo. Trộn đu đủ xanh, cà rốt với:chút muối, dấm, ớt, đường, tỏi băm, nêm nếm chua cay, mặn ngọt là được. Cách pha nước chấm: các bạn dùng đơn vị là một cái bát nhỏ ăn cơm, đong 1,5 bát nước, 3 thìa canh đường(thìa ăn phở), 1/2 bát nước mắm, một quả chanh, chút hạt tiêu, tỏi, ớt băm nhỏ, nêm nếm cho vừa ăn. Cách nướng chả: Có thể nướng bằng bếp than, lò nướng. Chả vê nhẹ thành hình tròn ấn hơi dẹt chút. Sếp thịt và chả ra vỉ hoặc khay nướng, khi nướng thỉnh thoảng phết chút dầu ăn lên, khi nào chả gần vàng thì phết chút mật ông cho thịt và chả vàng óng nhé nhưng nhớ ít thôi không lại bị đắng. Khi chuẩn bị ăn thì đun phần nước chấm lên nhưng chỉ hơi âm ấm nhé, chan nước chấm với thịt và chả, thêm dưa góp và bún.","nutrition":{"kcal":836.9,"protein_g":26.4,"fat_g":41.8,"carbs_g":89.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00y2t8m1xpxyrxki","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:chua cay","unlisted_ingredient_phrase:hanh cu","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:mat ong","unlisted_ingredient_phrase:nem chua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:thit ba","unlisted_ingredient_phrase:thit nuong","unlisted_ingredient_phrase:thit va","unlisted_ingredient_phrase:uop thit","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv0131t8m1dlgoj7hf#variant-1","name":"Bún xáo vịt","detail_name":"Bún xáo vịt","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","servin