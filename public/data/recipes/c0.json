ion":{"kcal":81.8,"protein_g":5.9,"fat_g":4.5,"carbs_g":4.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01cmt8m1ey8so84p","quality_status":"needs_review","warnings":["duplicate_listing_row_occurrence","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá thu","ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Bột dong lọc","ingredient_not_mentioned_by_name:Đường kính","title_ingredient_not_mentioned:Cá thu"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01p5t8m1vv7qj6f6#variant-1","name":"Canh khổ qua hầm chay","detail_name":"Canh khổ qua hầm chay","category":"Món canh chay","age_group":null,"serving":{"raw":"114.5 g / Chén","quantity_value":114.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Khổ qua (mướp đắng)","quantity_raw":"64 g","quantity_value":64,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Bún khô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"12 g","quantity_value":12,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Khổ qua cắt bỏ, đem cắt mỗi trái thành khoanh tròn kích thước bằng nhau. Móc bỏ ruột và hạt bên trong khổ qua. Đun sôi 1 nồi nước, cho khổ qua vào luộc sơ 2 phút sau đó vớt ra xả ngay vào nước lạnh. Nấm rơm rửa sạch, cắt nhỏ. Mộc nhĩ ngâm trong nước ấm rồi lấy ra băm nhỏ. Trộn nhân nhồi khổ qua gồm Đậu hũ trắng bóp nhuyễn, chắt nước, Nấm băm nhuyễn, Hành ba rô cùng tiêu và Hạt nêm chay nấm hương, sau đó nhồi nhân vào khổ qua, dùng tay ém chặt. Đun sôi 1l nước, sau đó nhẹ nhàng thả từng khoanh khổ qua vào nồi, nấu trong 20 phút, khi khổ qua đã mềm, nêm gia vị với Muối, Đường và Hạt nêm chay nấm hương, khuấy đều rồi tắt bếp","nutrition":{"kcal":80.2,"protein_g":4.6,"fat_g":4.2,"carbs_g":6.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01p5t8m1vv7qj6f6","quality_status":"needs_review","warnings":["duplicate_identical_catalog_metadata","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nam huong","unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món canh chay","id":"mon_canh_chay","kind":"food_category","baseLabel":"Món canh chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01vjt8m1cyhfycoe#variant-1","name":"Canh rau muống nấu tôm","detail_name":"Canh rau muống nấu tôm","category":"Món canh 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"114.2 g / Chén","quantity_value":114.2,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau muống","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Nhặt rau muống cho sạch, rửa rau hai ba lần cho sạch rồi cắt thành khúc nhỏ nhỏ cho dễ ăn. Tôm lột vỏ ướp chút hạt nêm và chút hành tím cho thơm. Bắt nồi lên, hành phi thơm với dầu ăn xong cho tôm vào xào sơ cho đến khi tôm ngả màu đỏ đẹp Cho vào mấy chén nước sạch (bao nhiêu người ăn thì cho bấy nhiêu chén nước) nước sôi cho rau muống vào, cho sôi lại khoảng 5 phút thêm hành lá vào là xong","nutrition":{"kcal":46.1,"protein_g":5.1,"fat_g":1.4,"carbs_g":3.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01vjt8m1cyhfycoe","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hat nem"],"source_categories":[{"label":"Món canh 8-18 tuổi","id":"mon_canh_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01xdt8m1hu6vju1k#variant-1","name":"Canh súp lơ trắng nấu thịt heo","detail_name":"Canh súp lơ trắng nấu thịt heo","category":"Món canh từ 18-24 tháng tuổi","age_group":"18-24 tháng","serving":{"raw":"36.5 g / Chén","quantity_value":36.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Súp lơ trắng","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Đầu tiên, cắt súp lơ thành từng miếng vừa ăn, rửa sạch để ráo Thịt rửa sạch, băm nhuyễn, ướp gia vị Bắt nồi lên, cho nước vào đun sôi. Nước sôi cho thịt vào Khi nước sôi lần nữa, cho súp lơ vào, tất cả đều chín nêm gia vị vừa miệng. Vớt bọt và tắt bếp.","nutrition":{"kcal":48.6,"protein_g":2.7,"fat_g":3.6,"carbs_g":1.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01xdt8m1hu6vju1k","quality_status":"needs_review","warnings":["recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Súp lơ trắng","ingredient_not_mentio