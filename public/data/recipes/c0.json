ột sạch vỏ tôm rồi dùng tay hoặc dao để kéo bỏ phần chỉ trên lưng tôm. Sau đó rửa lại với nước muối pha loãng để khử mùi tanh của tôm. Rửa lại với nước sạch một lần nữa và để cho tôm ráo nước. Sơ chế các nguyên liệu khác Bạn tiến hành sơ chế các nguyên liệu khác như sau: Phô mai dạng thỏi: bào thành từng sợi nhỏ. Tỏi: bỏ vỏ rồi cắt chúng thành từng lát mỏng. Làm tôm sốt phô mai Đầu tiên, bắc chảo lên bếp rồi cho bơ lạt vào đun cho chảy. Cho thêm phần tỏi cắt lát vào và phi cho thơm. Tiếp theo, bạn cho phần tôm vào chảo, thêm muối và tiêu rồi trộn đều chúng. Sau đó, xào cho đến khi tôm chuyển sang màu cam. Cuối cùng là cho phô mai vào chảo, đậy nắp và đun thêm 3 - 5 phút cho phô mai tan hết ra là món ăn hoàn thành.","nutrition":{"kcal":194.6,"protein_g":24.1,"fat_g":8.3,"carbs_g":4.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh059wt8m1xqc6ilqd","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bơ thực vật","ingredient_not_mentioned_by_name:Pho mát","ingredient_not_mentioned_by_name:Rượu vang trắng (cồn 9.5 g)","ingredient_not_mentioned_by_name:Bột bắp (bột ngô vàng)","unlisted_ingredient_phrase:mai dang","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:pho mai","unlisted_ingredient_phrase:pho mai dang","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gi05c4t8m1ellpt18x#variant-1","name":"Tôm sốt cà","detail_name":"Tôm sốt cà","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"167.6 g / Dĩa nhỏ","quantity_value":167.6,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Tôm đồn