a vị vừa ăn và đun trên lửa nhỏ cho đến khi đậu chín thì tắt bếp rắc lên bề mặt 1 chút tiêu và hành lá.","nutrition":{"kcal":118.9,"protein_g":6.8,"fat_g":7.4,"carbs_g":6.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02kjt8m1pvev2c0a","quality_status":"needs_review","warnings":["duplicate_listing_row_occurrence","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03e9t8m1uf57me62#variant-1","name":"Mì Quảng gà","detail_name":"Mì Quảng gà","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"684.5 g / Tô vừa","quantity_value":684.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Mì quảng tươi","quantity_raw":"220 g","quantity_value":220,"quantity_unit":"g"},{"name":"Thịt gà ta","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hoa chuối","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau kinh giới","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tía tô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Bánh đa nem/ Bánh tráng","quantity_raw":"10 g","quantity_v