á sống hoặc trụng bên dưới tùy sở thích. Múc nước dùng đã nấu cho vào tô, thêm poa-rô đã phi thơm, tàu hũ ky, hành, ngò rí, ớt, một chút tiêu, chanh… tùy theo sở thích.","nutrition":{"kcal":462.7,"protein_g":19.2,"fat_g":12.1,"carbs_g":69.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i030wt8m1gnmkrw1m","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","unlisted_ingredient_phrase:banh canh","unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:chien gion","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:tu nhien"],"source_categories":[{"label":"Món nước- chay","id":"mon_nuoc_chay","kind":"food_category","baseLabel":"Món nước- chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i0326t8m11e5xhl3c#variant-1","name":"Hủ tíu Nam Vang","detail_name":"Hủ tíu Nam Vang","category":"Món nước","age_group":null,"serving":{"raw":"300.5 g / Tô vừa","quantity_value":300.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Hủ tiếu khô","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Lòng heo/lợn (ruột non)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Gan heo (lợn)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tim heo (lợn)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cần tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"