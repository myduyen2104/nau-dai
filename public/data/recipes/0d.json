huẩn bị ướp vịt Dùng nước ướp vừa pha xoa lên mình vịt. Hành tây, cà rốt bạn gọt sạch vỏ rửa sạch và thái lát mỏng. Bước 4: Nướng vịt Cho vịt vào lò nướng để nướng, bạn cũng có thể dùng lò nướng hoặc dùng bếp than hoa Cứ nướng khoảng 20 phút bạn lại tưới một lớp nước ướp lên vịt để món ăn không bị khô. Làm như vậy khoảng 3 lần là thịt vịt sẽ chín tới và da vàng giòn. Khi vịt chín vàng đều là được. Bước 5: Hoàn thành Chặt vịt thành những miếng vừa ăn cho đều, đẹp mắt rồi xếp ra đĩa và trang trí cùng với cà rốt hành tây.","nutrition":{"kcal":82.6,"protein_g":4.8,"fat_g":5.5,"carbs_g":3.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05kqt8m1s1ovw8t7","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:ruou trang","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"}]