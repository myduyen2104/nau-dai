n nhừ thì cho tương cà vào, nêm thêm chút hạt nêm, đảo đều. Thả hành hoa và rau mùi thái nhỏ vào rồi tắt bếp. Bước 7: Chần bánh phở qua nước sôi, chia bánh phở vào từng bát tô rồi múc thịt bò sốt vang chan lên bát bánh phở.","nutrition":{"kcal":313.3,"protein_g":12.6,"fat_g":9.8,"carbs_g":44.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tv00adt8m10uz6vdif","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Chanh","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:tuong ca","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72m043rt8m16eorhqgg#variant-1","name":"ROHTO N10 CHAY - Rau củ xào thập cẩm","detail_name":"ROHTO N10 CHAY - Rau củ xào thập cẩm","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"157 g","quantity_value":157,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Ngô bao tử/bắp non","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm mỡ (nấm tây)","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":120,"protein_g":4.6,"fat_g":7.4,"carbs_g":9.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72m043rt8m16eorhqgg","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":