category":"Món mặn","age_group":null,"serving":{"raw":"152.6 g / Dĩa nhỏ","quantity_value":152.6,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Tôm đồng","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Nước cốt dừa, đóng hộp","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"},{"name":"Cary bột","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"\"Tôm lột vỏ chừa đuôi,chẻ lưng rút chỉ đen.Chiên sơ. Cà rốt gọt vỏ, rửa sạch, cắt khúc Khoai tây gọt vỏ, rửa sạch, cắt cục Hành tây chẻ dọc theo củ. Ớt chuông rửa sạch, cắt khúc Sả ớt,hành tỏi băm nhỏ. Dừa nạo vắt lấy nước cốt,còn lại lấy nước dảo để riêng. \"Bắc chảo cho sả, hành, tỏi,ớt khô phi vàng. Cho bột cà ri, tôm xào cho thấm. Chế nước dảo dừa vào nấu sôi. Cho cà rốt, khoai tây, ớt chuông nêm vừa ăn. Đổ hành tây, nước cốt dừa vào bắc xuống. Món này dùng với bún hoặc bánh mì.\"","nutrition":{"kcal":159.4,"protein_g":19.2,"fat_g":6.1,"carbs_g":7.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05b1t8m1k9ks3sb8","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_ment