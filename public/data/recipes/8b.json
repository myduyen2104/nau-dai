roup":"18 tháng","serving":{"raw":"81 g / Dĩa nhỏ","quantity_value":81,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Măng tre","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Mực tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Mực tươi rửa sạch, cắt khoanh. Măng tươi khi mua về dùng dao cắt thành lát mỏng. Luộc măng với nước sôi nhiều lần và mỗi lần luộc phải xả lại bằng nước sạch cho đến khi măng mềm và bớt chất đắng thì vớt ra để ráo. Hành lá rửa sạch, phần thân băm nhuyễn, phần lá cắt nhỏ Bắc chảo lên bếp, cho vào chảo dầu ăn rồi đợi dầu nóng, sau đó cho thêm hành băm nhuyễn vào phi thơm. Tiếp theo, cho vào chảo phần mực đã được sơ chế, bột ngọt, hạt nêm, đường vào rồi xào cho đến khi mực săn lại thì để ra tô. Cho vào chảo thêm canh dầu ăn và hành băm nhuyễn vào phi thơm. Sau đó cho phần măng tươi đã được sơ chế cùng bột ngọt, hạt nêm, đường, nước mắm vào rồi đảo đều lên khoảng 3 phút cho măng được thấm vị. Tiến hành cho phần mực xào trước đó vào và đảo đều hỗn hợp rồi cho thêm 2 quả ớt và 2 nhánh hành lá băm nhỏ. Đảo đều cho đến khi các nguyên liệu hòa trộn vào nhau rồi nếm nếm gia vị cho vừa miệng, tắt bếp và cho món ăn ra đĩa.","nutrition":{"kcal":60.9,"protein_g":2.7,"fat_g":3.2,"carbs_g":5.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03b3t8m1upuf0spo","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc"],"source_ca