ients":[{"name":"Hủ tiếu khô","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Đậu tương (đậu nành)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm hương tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bột mì","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Củ cải và cà rốt cho vào nồi, nấu lấy nước dùng. Hủ tiếu trụng nước sôi, để ráo. Nấm rơm cắt bỏ chân, ngâm nước muối loãng, rửa sạch. Đậu hũ chiên vàng, để nguội, cắt miếng vuông cạnh 3cm. Cà rốt gọt vỏ, rửa sạch, chẻ làm tư, cắt khúc, khúc nhỏ chẻ đôi hoặc tỉa hoa lá tuỳ thích, củ kiệu bằm nhỏ. Bắt chảo dầu sôi, cho kiệu bằm phi thơm, kế cho nấm rơm, đậu hũ, cà rốt và bột cà ri vào xào độ 10 phút, nêm vừa ăn. Cho nước dùng vào nổi, bắc lên bếp nấu sôi, cho chút muối, tiêu, đường, bột ngọt, nước tương cho vừa ăn, trút hỗn hợp đã xào vào, đun sôi lại thêm bột mì pha loãng, nếm vừa ăn là được. Đun đến khi sệt lại, trình bày bò kho chay cùng hủ tiếu và thưởng thức.","nutrition":{"kcal":428.8,"protein_g":18.1,"fat_g":11.5,"carbs_g":63.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i031mt8m1znp771g5","quality_status":"needs_review","warnings":["method_mentions_known