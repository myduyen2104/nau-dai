1","name":"Canh đu đủ xanh nấu sườn heo","detail_name":"Canh đu đủ xanh nấu sườn heo","category":"Món canh 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"93.8 g / Chén","quantity_value":93.8,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đu đủ xanh","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Sườn heo (lợn)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Đu đủ gọt vỏ rửa sạch cắt lát mỏng. Sườn heo rửa sạch, chần qua với nước sôi. Bắc nồi lên bếp với dầu ăn phi thơm hành tím cho sườn heo lên xào săn rồi thêm một tô nước. Nấu nhừ sườn rồi cho đủ đủ vào nấu cho mềm đu đủ, nêm gia vị vừa ăn rồi tắt bếp. Thêm hành ngò lên trên.","nutrition":{"kcal":67.5,"protein_g":4.2,"fat_g":3.6,"carbs_g":4.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01ndt8m14ib6hwoe","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Đu đủ xanh","ingredient_not_mentioned_by_name:Muối","title_ingredient_not_mentioned:Đu đủ xanh","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh 6-7 tuổi","id":"mon_canh_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01wat8m1zvx4mx6g#variant-1","name":"Canh rong biển nấu đậu hũ thịt bằm","detail_name":"Canh rong biển nấu đậu hũ thịt bằm","category":"Món canh 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"21.5 g / Chén","quantity_value":21.5,"qu