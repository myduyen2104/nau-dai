_label":"Tô vừa"},"ingredients":[{"name":"Bún tươi","quantity_raw":"300 g","quantity_value":300,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Trứng vịt (55g/quả)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Tôm khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Thịt gà công nghiệp, lườn","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Gừng đã rửa sạch đem nướng cho đến khi nào chín và có mùi thơm. Bước 2: Cho gà vào nồi luộc, đến khi sôi thì cho một chút gia vị 1 muỗng hạt nêm, 1/2 muỗng đường, 1 muỗng cafe muối và hành khô, gừng đã nướng thơm vào, hạ nhỏ lửa để gà chín bên trong. Sau khi vớt ra để nguội Sau, bạn dùng tay xé sợi vừa ăn và để riêng. Bước 3: Xương heo cho vào nồi đun sôi với nước, sau đó đổ hết nước đó đi, cho ra vào nước lạnh rửa sạch vụn xương. Sau đó đổ xương vào nồi nước luộc gà ninh nhừ (khoảng 2 – 3 tiếng) để làm nước dùng. Bước 4: Trong khi ninh xương để nấu nước dùng, bạn bật một bên bếp khác lên, cho chảo chống dính lên bếp. Khi chảo nóng già thì cho tôm khô vào rang thơm rồi cho ra đĩa. Bước 5: Cho dầu ăn vào tráng đều mặt chảo, cho bát trứng đã đánh vào rán sao cho thật mỏng. Đến chi chín cho trứng ra đĩa, đợi trứng nguội thì thái thành sợi nhỏ. Bước 6: Khi nồi nước ninh xương đun được khoảng 50 phút đến 1 tiếng, thì cho tôm khô đã rang, đường phèn, hạt nêm, muối và chút nước mắm vào, khuấy đều. Tiếp tục ninh thêm 1 hoặc 2 tiếng nữa thì nêm nếm lại gia vị cho vừa miệng, cho hành lá và rau răm xắt nhỏ vào, rồi tắt bếp. Bước 7: Bún đem trần qua với nước, xếp các loại nhân lên trên rồi chan nước dùng vào là xong. Nếu ai có thể ăn được mắm tôm thì bạn cho ½ thìa cafe mắm tôm lên trên.","nutrition":{"kcal":590.5,"protein_g":27.3,"fat_g":14.9,"carbs_g":86.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv011tt8m147z5mwb4","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt gà công nghiệp, lườn","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mam tom","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:rau ram","unlisted_ingredient_phrase:uong phen","unlisted_ingredient_phrase:voi nuoc","unlisted_ingredient_phrase:xuong heo"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw016wt8m1mn2wbu97#variant-1","name":"Cá hú/ cá basa kho cà","detail_name":"Cá hú/ cá basa kho cà","category":"Món mặn","age_group":null,"serving":{"raw":"140.5 g / Dĩa vừa","quantity_value":140.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cá mỡ/cá hú/cá basa","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"