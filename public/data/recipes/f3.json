food_category","baseLabel":"Món canh"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu0246t8m1wgo72o7y#variant-1","name":"Cháo ếch hạt sen rau muống","detail_name":"Cháo ếch hạt sen rau muống","category":"Cháo 9-12 tháng tuổi","age_group":"9-12 tháng","serving":{"raw":"82 g / Chén","quantity_value":82,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Ếch ( thịt đùi)","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"}],"instructions_raw":"* Ếch làm sạch, rửa với muối và chanh, sau đó rửa sạch dưới vòi nước. Lọc lấy phần thịt ếch, băm nhuyễn. * Hạt sen rửa sạch, tách bỏ tim sen, luộc với 1 chén nước cho đến khi hạt sen mềm, vớt ra để nguội rồi tán nhuyễn. Rau muống rửa sạch, lấy lá băm nhuyễn. * Hòa tan thịt ếch với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng , bắc lên bếp khuấy đều cho đến khi sôi, thêm hạt sen và rau muống vào nấu chín. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":185.8,"protein_g":8.1,"fat_g":7.6,"carbs_g":21.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu0246t8m1wgo72o7y","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Cháo 9-12 tháng tuổi","id":"chao_9_12_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"9-12 tháng","id":"9_12_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02mmt8m1pyyaam9d#variant-1","name":"Đậu hũ nước đường","detail_name":"Đậu hũ nước đường","category":"Chè (18 tháng trở lên)","age_group":"18 tháng","serving":{"raw":"63 g / Chén","quantity_value":63,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đậu tương (đậu nành)","quantity_raw":"17 g","quantity_value":17,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bột gạo tẻ","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"\" Đậu nành mua về bỏ những hạt hư, rửa sạch lại đem ngâm từ 6 đến 8 tiếng trước lúc nấu. Sau đó, rửa lại một lần nữa rồi vớt ra rỗ cho ráo. Cho đậu nành vào máy xay sinh tố cùng nước. Chuẩn bị một túi vải để lọc bã đậu nành. Gừng cạo vỏ, cắt lát mỏng. Lá dứa rửa sạch buộc lại thành 2 bó. Nấu sữa đậu nành. Lấy chén nhỏ cho ít sữa đậu nành cùng bột gạo đã chuẩn bị vào khuấy cho tan bột. Bắt nồi lên cho sữa đậu nành vào nấu với lửa vừa. Trong quá trình này, bạn liên tục khuấy đều để phần sữa dưới không bị cháy. Khi sữa sôi nhe, cho nước bột gạo vừa làm vào. Tiếp tục đảo đều và cho muối vào. Đến khi sôi tắt bếp. Đông tàu hũ Chuẩn bị một cái thau to và tô để vừa vào thau để ủ nước ấm. Cho vào thêm đường nho và nước lọc vào tô. Dùng muỗng khuấy cho đường tan và tráng đều nước đường xung quanh tô. Nhanh tay cho sữa đậu nành đã nấu vào, hớt bọt bong bóng trên mặt sữa bỏ. Đổ nước sôi vào thau khoảng hơn nửa tô. Để yêu vị trí tô sữa khoảng 30 phút để đông thành tàu hũ. Chuẩn bị nước đường Trong thời gian đợi tàu hũ đông, chuẩn bị tiếp nước đường. Bắt nồi lên cho đường thốt nốt, nước lọc, gừng cắt lát vào nấu sôi. Tiếp tục cho trân châu bột năng và lá dứa vào. Nấu khoảng 5 phút thì tắt bếp. Thưởng thức Cho tàu hủ vào chén, thêm nước đường gừng, trân châu cùng nước cốt dừa vào và ăn nóng hay lạnh đều ngon.\"","nutrition":{"kcal":250.1,"protein_g":6.6,"fat_g":6.7,"carbs_g":40.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02mmt8m1pyyaam9d","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc uong","unlisted_ingredient_phrase:sua au nanh"],"source_categories":[{"label":"Chè (18 tháng trở lên)","id":"che_18_thang_tro_len","kind":"age_scoped_food_category","baseLabel":"Chè"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02mxt8m15ds0vyar#variant-1","name":"Đậu hũ sốt nấm đông cô","detail_name":"Đậu hũ sốt nấm đông cô","category":"Món chay","age_group":null,"serving":{"raw":"138 g","quantity_value":138,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Đậu phụ (đậu hũ)","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Nấm hương tươi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước tương MAGGI Đậu Nành Đậm Đặc - NESTLÉ","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu hào maggi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường cát","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":123.3,"protein_g":12.7,"fat_g":5.6,"carbs_g":5.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02mxt8m15ds0vyar","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món chay","id":"mon_chay","kind":"food_category","baseLabel":"Món chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02t1t8m1kzwmlrer#variant-1","name":"Gà kho nấm hương","detail_name":"Gà kho nấm hương","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"51 g / Dĩa nhỏ","quantity_value":51,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt gà công nghiệp, đùi","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Đùi gà góc tư mua về đem rửa với nước muối loãng hoặc dùng chanh chà xát thịt gà để khử mùi hôi. Sau đó rửa lại với nước sạch. Dùng dao chặt gà thành từng khúc vừa ăn và khứa xéo nhẹ lên thịt gà để dễ thấm gia vị hơn. Ướp thịt gà với hạt nêm, nước mắm, hành băm. Đảo đều và ướp gà từ 10 - 15 phút để gà thấm gia vị. Nấm hương khô đem ngâm với nước ấm khoảng 30 phút, sau đó vớt ra rửa và vò nấm dưới vòi nước sạch nhiều lần cho sạch cát, cắt bỏ phần chân nấm. Hành củ bóc vỏ, băm nhuyễn. Bắc nồi hoặc chảo lên bếp, cho vào dầu ăn, đường. Dùng đũa đảo đều với lửa vừa để đường không bị cháy. Đảo đều tay đến khi đường tan ra và có màu vàng nâu đẹp mắt là được. Khi nước đường đã lên màu đẹp mắt, cho gà vào xào đều tay cho gà áo đều lớp nước đường. Tiếp tục cho phần nấm hương khô vào xào cho đến khi gà và nấm săn lại. Cho vào nồi nước lọc rồi cho tiếp các loại rau củ đã sơ chế vào, trộn đều cho các nguyên liệu thấm gia vị. Kho gà với lửa nhỏ đến khi nước kho sánh cạn lại thì tắt bếp là hoàn thành.","nutrition":{"kcal":93.2,"protein_g":7.7,"fat_g":5.8,"carbs_g":2.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02t1t8m1kzwmlrer","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc uong","unlisted_ingredient_phrase:uop thit","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02zet8m1lzny6ecv#variant-1","name":"Hoa lý xào chay","detail_name":"Hoa lý xào chay","category":"Món xào chay","age_group":null,"serving":{"raw":"176.5 g / Dĩa vừa","quantity_value":176.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Hoa lý","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Nhặt sạch hoa thiên lý, ngâm hoa thiên lý trong nước lạnh rồi rửa sạch và để ráo nước. Đậu phụ nướng cắt miếng vừa ăn. Chần qua hoa thiên lý với nước sôi. Đặt chảo lên bếp, làm nóng chảo với dầu ăn rồi cho hành tỏi băm nhuyễn vào phi thơm. Cho hoa thiên lý xào vào, nêm nếm sao cho hợp khẩu vị. Đảo nhanh và đều tay rồi cho đậu phụ, mùi tàu cùng một chút hạt tiêu vào rồi