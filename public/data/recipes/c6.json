n khi đậu chín thì tắt bếp rắc lên bề mặt 1 chút tiêu và hành lá.","nutrition":{"kcal":248.9,"protein_g":15.8,"fat_g":15.3,"carbs_g":12.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02knt8m1z7xbzlik","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hon hop"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo035ct8m1raj9kdnq#variant-1","name":"LH-C1-Bánh ướt nem chả bò","detail_name":"LH-C1-Bánh ướt nem chả bò","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"340 g","quantity_value":340,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Thịt heo nạc dăm","quantity_raw":"39 g","quantity_value":39,"quantity_unit":"g"},{"name":"Mọc sống","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giò bò","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Chả giò nhân tôm thịt Vissan","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"9 g","quantity_value":9,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"19 g","quantity_value":19,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"24 g","quantity_value":24,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"6 g","quantity_value":6,"quantity_unit":"g"},{"name":"Bánh ướt","quantity_raw":"130 g","quantity_value":130,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"4 g","quantity_value":4,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"