s://dinhduong2598.food/mon-an/cmrg0p7ry05olt8m1hz03rc8c#variant-1","name":"Vịt hầm cốm","detail_name":"Vịt hầm cốm","category":"Món mặn","age_group":null,"serving":{"raw":"66.5 g / Dĩa nhỏ","quantity_value":66.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cốm","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Miến dong khô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Vịt làm sạch, xát muối trong và ngoài vịt, rửa lại cho sạch, đểráo. Thịt nạc dăm rửa sạch băm nhỏ, ướp nước mắm + tiêu + hành bằm. Nấm hương, nấm mèo ngâm mềm rửa sạch, bỏ chân, băm nhỏ. Hạt sen luộc chín mềm, bỏ tim sen. Miến ngâm mềm, vớt ráo, băm nhỏ. Trộn đều thịt nạc + hạt sen + nấm hương + nấm mèo + cốm + miến, nêm thêm chút nước mắm + đường, trộn thật đều Dồn hỗn hợp trên vào bụng vịt cho vừa căng rồi dùng chỉ may lại Hành lá, rau ngò, rứa sạch xắt nhỏ Bắc chảo nóng, cho dầu vào, phi hanh thơm, cho vịt vào chiên sơ. Cho vịt vào nồi, đổ nước vào sâm sấp, nấu cho đến khi vịt mềm, nước cạn bớt, nêm lại vừa ăn, lấy vịt để ra đĩa sâu lòng. Hòa bột năng với chút nước lã, đổ vào nồi nước vịt, quậy đều, cho nước sền sệt, cho hành lá vào nhắc đổ lên mình vịt, bên trên rắc tiêu + rau ngò. Món này ăn nóng mới nóng","nutrition":{"kcal":174.4,"protein_g":7.4,"fat_g":10.5,"carbs_g":13},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7ry05olt8m1hz03rc8c","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Gừng tươi","ingredient_not_mentioned_by_name:Tỏi ta","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nac dam","unlisted_ingredient_phrase:rau ngo","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05k8t8m1ko5nfv9a#variant-1","name":"Vịt kho gừng","detail_name":"Vịt kho gừng","category":"Món mặn","age_group":null,"serving":{"raw":"66.5 g / Dĩa nhỏ","quantity_value":66.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Vịt rửa sạch, để ráo, chặt miếng vừa ăn, ướp gia vị trong 15 phút. Hành củ, gừng rửa sạch, băm nhuyễn. Bật bếp, chỉnh lửa nhỏ vừa và cho chảo chống dính lên bếp, chờ cho chảo nóng thì bạn cho 2 muỗng đường vào, đảo đều tay cho đến khi đường tan ra và chuyển thành màu nâu. Tiếp theo, bạn cho thêm nước vào, khuấy đều tay và đun sôi. Đun tiếp cho đến khi nước màu sánh và sệt lại thì bắc chảo xuống.Bạn cho nước màu vào nồi vịt, trộn đều và cho lên bếp để đun sôi. Khi vịt sôi, bạn dùng đũa đảo đều, chỉnh lửa nhỏ liu riu, cho hành củ, gừng vào và mở nắp để đun cho đến khi thịt vịt săn, chắc thịt, còn nước kho thì sệt và sánh lại là được. Bạn nêm nếm lại cho vừa miệng là có thể tắt bếp.","nutrition":{"kcal":155.4,"protein_g":7.5,"fat_g":11.8,"carbs_g":5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05k8t8m1ko5nfv9a","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:nuoc mau","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"}]