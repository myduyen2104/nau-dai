[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tw00f7t8m1yf7puxxl#variant-1","name":"Bánh đa tôm thịt","detail_name":"Bánh đa tôm thịt","category":"Món nước 5 tuổi","age_group":"5 tuổi","serving":{"raw":"221.5 g / Tô nhỏ","quantity_value":221.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh đa cua tươi","quantity_raw":"130 g","quantity_value":130,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt heo rửa sạch, tôm rửa sạch. Chần thịt heo qua nước sôi và rửa lại lần nữa. Tôm hấp và bóc vỏ, bỏ chân. Phần vỏ, đầu và chân tôm giã và lọc lấy nước. Thịt cho vào nồi ninh nhỏ lửa. Bánh đa ngâm nước cho mềm, vớt ra rổ để ráo. Cà chua rửa sạch, bổ múi cau. Phi thơm hành khô với dầu ăn, cho cà chua vào xào sơ, nêm 1 thìa bột canh. Khi nồi nước dùng sôi, gạn phần nước trong cùng nước lọc tôm với lượng vừa đủ ăn, cho cà chua vào đun khoảng 3-4 phút, nêm gia vị vừa miệng. Bánh đa chần vào nước sôi, sau đó cho vào bát xếp tôm, thịt , ít hành, răm lên trên. Từ từ chan nước dùng vào ăn kèm với rau.","nutrition":{"kcal":363.4,"protein_g":12.4,"fat_g":15,"carbs_g":46.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00f7t8m1yf7puxxl","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bánh đa cua tươi","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_