uantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Bí đỏ (bí ngô)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đậu tương (đậu nành)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":301,"protein_g":15.5,"fat_g":8.2,"carbs_g":41.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72n04gbt8m13a5x0fz9","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh056rt8m1lm0dnrq1#variant-1","name":"Thịt heo kho trứng cút","detail_name":"Thịt heo kho trứng cút","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"54 g / Dĩa nhỏ","quantity_value":54,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Trứng cút (10g/quả)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"4 g","quantity_value":4,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Trứng cút luộc chín, ngâm nước lạnh rồi bóc vỏ. Thịt heo rửa sạch, chần sơ qua nước sôi. Sau đó xả qua nước lạnh cắt bỏ phần da rồi thái miếng vừa ăn. Hành củ, tỏi bóc vỏ, băm nhuyễn. Hành lá bỏ rễ, rứa sạch, cắt nhỏ Bắc chảo lên bếp cho đường, dầu vào thắng nước màu với lửa hơi thấp. Khi nước đường có màu vàng hơi nâu thì cho hết tỏi, hành tím vào xào thơm. Cho thịt vào xào săn 5 phút với tất cả các gia vị phía trên. Cuối cùng cho nước lạnh cùng trứng cút vào rim nhỏ lửa cho đến khi nước sốt hơi cạn thịt tứa mỡ. Nêm gia vị cho vừa ăn là tắt bếp. Cho hành lá vào đảo đều.","nutrition":{"kcal":157.9,"protein_g":6.9,"fat_g":13.1,"carbs_g":3.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh056rt8m1lm0dnrq1","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:nuoc mau","unlisted_ingredient_phrase:nuoc uong","unlisted_ingredient_phrase:nuoc uong co","unlisted_ingredient_phrase:uong co"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh057vt8m16twqhu31#variant-1","name":"Thịt heo quay","detail_name":"Thịt heo quay","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"37 g / Dĩa nhỏ","quantity_value":37,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Rượu trắng (cồn 39 g)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Rửa sạch thịt, thấm khô. Cho thịt vào khay nướng có lót sẵn 1 lớp giấy bạc, mặt da quay lên trên, chà xát rượu trắng vào thịt (không chà xát vào da). Trộn đều trong chén. Ướp thịt ba chỉ với hỗn hợp gia vị, cho vào tủ lạnh để khoảng 12-24 giờ. Dùng chổi quết đều giấm lên phần bì thịt ba chỉ, rắc đều muối lên trên. Cho thịt vào lò, chỉ nhiệt độ nướng heo quay ở 200 độ C trong khoảng 90 phút. Lấy thịt ra khỏi lò nướng, cho giá đỡ trong lò xuống vị trí thấp nhất, bỏ hết muối trên bì ra, mở giấy bạc rồi lấy thịt đặt lên giá trong lò. Nướng thêm 10-15 phút. Thịt heo quay chín, lấy ra, để nguội, cắt thành từng miếng vừa ăn.","nutrition":{"kcal":130.5,"protein_g":6.2,"fat_g":10.6,"carbs_g":1.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh057vt8m16twqhu31","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:heo quay","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05hnt8m1h4atn27j#variant-1","name":"Trứng vịt luộc","detail_name":"Trứng vịt luộc","category":"Món mặn","age_group":null,"serving":{"raw":"87 g / Dĩa nhỏ","quantity_value":87,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng vịt (55g/quả)","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Đun nước sôi, cho trứng vào luộc trong 10 phút. Cho trứng ra nước lạnh, bóc vỏ. Cho tỏi, đường vào chén, giả nát, cho nước mắm, nước lọc, nước cốt chanh, nêm nếm vừa ăn","nutrition":{"kcal":148.1,"protein_g":10.6,"fat_g":9.6,"carbs_g":4.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05hnt8m1h4atn27j","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng vịt (55g/quả)","title_ingredient_not_mentioned:Trứng vịt (55g/quả)","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc loc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05jxt8m17x9hpbim#variant-1","name":"Vịt hấp xí muội","detail_name":"Vịt hấp xí muội","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"49 g / Dĩa nhỏ","quantity_value":49,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Rượu trắng (cồn 39 g)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"1. Chuẩn bị - Vịt làm sạch - Gừng giã nát ngâm với rượu trắng chà xát ngoài da vịt để 10 - 15 phút, rửa vịt lại thật sạch. - Xí muội tán nhuyễn. - Tương hột vắt nước rồi lấy hột bằm nhuyễn, rồi lại trộn với nước tương hột. - Trộn chung: xí muội, tương hột, hành tỏi bằm nhỏ, cọng hành lá đập dập cắt khúc 3cm, muối, tiêu, đường, bột ngọt. - Ướp 2/3 hỗn hợp trên vào bụng vịt, may lại. Ướp chút muối ngoài da vịt. 2. Chế biến - Chiên vịt: bắc chảo dầu nóng phi tỏi cho thơm, cho vịt vào chiên sơ rồi vớt ra. - Hấp vịt: để vịt vào mâm nhôm, ướp thêm 1/3 hỗn hợp tương, xí muội, gia vị... ngoài da vịt. Cho mâm vịt vào xửng hấp độ 1 giờ, khi thịt vịt mềm là được. 3. Trình bày - Mổ bụng vịt , trút nước trong thịt ra, rồi chặt miếng vừa ăn, sắp vào dĩa theo dạng vịt nằm, rưới nước sốt lên thịt vịt.","nutrition":{"kcal":120.2,"protein_g":5.7,"fat_g":8.6,"carbs_g":3.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05jxt8m17x9hpbim","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc tuong","unlisted_ingredient_phrase:tuong hot","unlisted_ingredient_phrase:vit bac","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 t