","nutrition":{"kcal":203.3,"protein_g":16.1,"fat_g":11.6,"carbs_g":8.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00qzt8m19rj7hvc9","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00vht8m1k9w3nt10#variant-1","name":"Bột thịt gà, bông cải xanh, cà rốt","detail_name":"Bột thịt gà, bông cải xanh, cà rốt","category":"Món bột nhà nấu cho trẻ từ 7-8 tháng","age_group":"7-8 tháng","serving":{"raw":"65 g / Chén","quantity_value":65,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt gà công nghiệp, đùi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Súp lơ xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Thịt gà rửa sạch, bỏ da băm nhuyễn. Súp lơ xanh rửa sạch, băm nhuyễn. Cà rốt gọt vỏ, rửa sạch, luộc chín tán nhuyễn. Hòa tan bột gạo với thịt gà với nước, bắc lên bếp khuấy đều đến khi sôi, thêm súp lơ xanh vào nấu chín, thêm cà rốt vào khuấy đều. Tắt bếp. Thêm dầu thực vật vào khuấy đều.","nutrition":{"kcal":153,"protein_g":5.4,"fat_g":6.5,"carbs_g":18.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00vht8m1k9w3nt10","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:dau thuc","unlisted_ingredient_phrase:dau thuc vat","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:thuc vat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ từ 7-8 tháng","id":"mon_bot_nha_nau_cho_tre_tu_7_8_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"7-8 tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv010nt8m1qdgfuzca#variant-1","name":"Bún riêu chay","detail_name":"Bún riêu chay","category":"Món nước- chay","age_group":null,"serving":{"raw":"435 g / Tô nhỏ","quantity_value":435,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"200 g","quantity_value":200,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Đậu tương (đậu nành)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Đậu phụ tươi rửa sạch, để ráo, cắt thành từng miếng vuông vừa ăn. Bóp nhuyễn đậu phụ tươi, thêm canh tương đậu nành, muối, đường và trộn đều. Cà chua rửa sạch, cắt múi cau. Các loại rau ăn kèm, làm sạch, để ráo. Hành ba rô rửa sạch, phần đầu đập dập, phần lá cắt nhỏ.Chuẩn bị chảo dầu nóng, trút đậu phụ non đã cắt miếng vuông vào chiên vàng rồi vớt ra đĩa. Đặt chảo lên bếp, đun nóng một ít màu dầu điều, phi thơm đầu hành.Cho lần lượt cà chua, củ cải trắng, một chút hành boa rô đã sơ chế vào xào chín cùng 1 ít muối, đường, xào đều tay. Tiếp tục dùng lại chảo đó, đun nóng ít dầu, cho đậu phụ đã bóp nát vào xào chung với một ít muối. Xào khoảng 5 – 7 phút, tiếp tục cho bột mì vào, đảo đều. Bột mì có tác dụng kết dính để khi đun sẽ tạo thành mảng riêu nổi lên bề mặt. Khi thấy rau củ quả hầm đã chín mềm, tiến hành vớt bỏ bã, lọc lại nước dùng.Sau đó, cho hỗn hợp rau củ đã xào cùng đậu phụ chiên vào và nấu khoảng 15 phút. Nêm vào nồi nước dùng một ít giấ, dùng muỗng múc từng muôi hỗn hợp đậu phụ riêu cua thả vào nồi nước dùng, đun lửa nhỏ để mảng riêu đậu phụ nổi lên bề mặt. Nêm nếm lại gia vị cho vừa ăn, thêm một ít hành boa rô cắt nhỏ vào và tắt bếp. Khi ăn, bạn gắp một ít bún vào tô lớn, chan nước dùng có lẫn cà chua, đậu phụ, nấm các loại và múc một ít riêu đậu phụ, rắc thêm một ít hành boa rô, rau mùi cắt nhỏ. Dùng nóng với các loại rau ăn kèm.","nutrition":{"kcal":446.7,"protein_g":19.6,"fat_g":11.6,"carbs_g":66.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv010nt8m1qdgfuzca","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nấm rơm","unlisted_ingredient_phrase:cai trang","unlisted_ingredient_phrase:cu cai trang","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:rau mui"],"source_categories":[{"label":"Món nước- chay","id":"mon_nuoc_chay","kind":"food_category","baseLabel":"Món nước- chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw017st8m1khlp7jwe#variant-1","name":"Cá lóc hấp rượu vang trắng","detail_name":"Cá lóc hấp rượu vang trắng","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"99.1 g / Dĩa nhỏ","quantity_value":99.1,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá quả (cá lóc)","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Rượu vang trắng (cồn 9.5 g)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Thì là","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi tây (cả lá)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"\"Cá làm sạch, khía vài nhát hai bên thân cá, ướp muối tiêu cho thấm. Tỏi tây bỏ bớt lá, cắt khúc dài, chẻ làm tư. Cà rốt tỉa theo tỏi tây.\" Cho rượu vang vào nồi đun sôi, nêm đủ muối, bỏ tỏi tây và cà rốt vào trước, cho cá vào sau. Đun đều lửa, trở cá vài ba lần. Cá chín, tỏi tây và cà rốt cũng chín.Vớt cá ra đĩa hình bầu dục, bày cà rốt, cá, rắc thìa là lên cá. Dội nước cá lên là được. Món này dùng nóng vắt thêm chanh.\"","nutrition":{"kcal":74.8,"protein_g":6.7,"fat_g":4,"carbs_g":2.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw017st8m1khlp7jwe","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá quả (cá lóc)","ingredient_not_mentioned_by_name:Thì là","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Dầu mè","title_ingredient_not_mentioned:Cá quả (cá lóc)","unlisted_ingredient_phrase:bau duc"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuo