roup":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01mgt8m1vnlc8ci8#variant-1","name":"Canh chua dưa cải thịt bò","detail_name":"Canh chua dưa cải thịt bò","category":"Món canh 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"74.8 g / Chén","quantity_value":74.8,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dưa cải bẹ","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Cà chua rửa sạch, bổ múi cau. Lấy cải chua ra rửa cho bớt mặn. Sau đó cắt cải chua khúc nhỏ vừa ăn cho vào nồi thêm nước đun sôi, cho cà chua vào. Khi nước sôi nhẹ thì mình nêm nếm gia vị. Điều chỉnh sao cho nước canh có vị chua chua mặn mặn là được. Thịt bò thái lát mỏng và ướp với gia vị. Sau đó bắt chảo và phi tỏi với dầu cho vàng và vớt tỏi ra. Bỏ thịt bò đã ướp vào xào sơ với dầu tỏi cho thơm. Tắt bếp nồi canh và đổ thịt bò vào khuấy đều. Sau đó bỏ luôn phần tỏi đã phi vào trong nồi canh sẽ làm cho canh thơm ngon hơn.","nutrition":{"kcal":47.3,"protein_g":5,"fat_g":1.8,"carbs_g":2.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01mgt8m1vnlc8ci8","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 6-7 tuổi","id":"mon_canh_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01nat8m1x1n7bjkr#variant-1","name":"Canh đu đủ xanh nấu sườn heo","detail_name":"Canh đu đủ xanh nấu sườn heo","category":"Món canh 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"56.5 g / Chén","quantity_value":56.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đu đủ xanh","quantity_raw":"45 g","quantity_value":45,"quantity_unit":"g"},{"name":"Sườn heo (lợn)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Đu đủ gọt vỏ rửa sạch cắt lát mỏng. Sườn heo rửa sạch, chần qua với nước sôi. Bắc nồi lên bếp với dầu ăn phi thơm hành tím cho sườn heo lên xào săn rồi thêm một tô nước. Nấu nhừ sườn rồi cho đủ đủ vào nấu cho mềm đu đủ, nêm gia vị vừa ăn rồi tắt bếp.","nutrition":{"kcal":40.8,"protein_g":2.2,"fat_g":2.3,"carbs_g":3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01nat8m1x1n7bjkr","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Đu đủ xanh","ingredient_not_mentioned_by_name:Muối","title_ingredient_not_mentioned:Đu đủ xanh","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh 25-35 tháng tuổi","id":"mon_canh_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01o7t8m1679ffw0z#variant-1","name":"Canh gà lá giang","detail_name":"Canh gà lá giang","category":"Món canh 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"222.2 g / Chén","quantity_value":222.2,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Thịt gà ta","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Lá me","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Gà đem rửa sạch với nước muối loãng, chặt miếng vừa ăn, để ráo nước. Ướp gà với một chút gia vị ... khoảng 15 phút cho thấm gia vị. Bó lá giang ngắt lấy phần lá, rửa sạch, vớt ra rổ, vò nhẹ cho dập. Cho 1 chút dầu vào nồi đun nóng sau đó cho tỏi băm vào phi vàng, tiếp đến cho phần thịt gà đã ướp và đảo đều tay cho thịt săn lại. Thịt gà đã săn, cho 1 lượng nước lọc vừa ăn vào nồi đun lửa lớn cho sôi.","nutrition":{"kcal":277.5,"protein_g":24.7,"fat_g":18.3,"carbs_g":3.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01o7t8m1679ffw0z","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Rau muống","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:gia vi bo","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh 8-18 tuổi","id":"mon_canh_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02gqt8m1azxvqjqg#variant-1","name":"Cơm chiên chay","detail_name":"Cơm chiên chay","category":"Cơm","age_group":null,"serving":{"raw":"411 g / Dĩa vừa","quantity_value":411,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"90 g","quantity_value":90,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Nấm hương tươi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đậu trắng hạt (đậu tây)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu cô ve","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Cà chua, dưa leo rửa sạch, cắt lát mỏng. Hành lá bỏ gốc, rửa sạch, cắt nhỏ. Hành tím lột vỏ, rửa sạch rồi cắt lát mỏng. Đậu cô ve tướt xơ, rửa sạch, cắt hạt lựu. Đậu hũ cắt lát dài chiên vàng, cắt hạt lựu. Cà rốt gọt vỏ, rửa sạch, cắt lạt lượu. Nấm hương rửa sạch, cắt hạt lượu. Cho các nguyên liệu trên chần qua nước sôi. Đậu tây ngâm mềm, luộc chín. Bắc chảo lên bếp, thêm dầu ăn vào, dầu nóng thêm hành tím vào phi thơm, cho đậu cô ve, cà rốt, nấm hương, đậu hũ ư, đậu tây vào đảo đều rồi cho cơm vào, đảo đều với lửa vừa khoảng 5 phút cho hạt cơm săn lại. Nêm thêm hạt nêm và nước mắm vào. Tiếp tục trộn đều đến khi hạt tơi rời, khô lại hoàn toàn thì bạn cho hành lá cắt nhỏ vào, nêm nếm lại gia vị cho vừa ăn rồi tắt bếp.","nutrition":{"kcal":730.2,"protein_g":32.4,"fat_g":16.6,"carbs_g":113.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02gqt8m1azxvqjqg","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc mam"],"source_categories":[{"label":"Cơm","id":"com","kind":"food_category","baseLabel":"Cơm"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02xft8m1wt84ksch#variant-1","name":"Gỏi xoài tôm khô","detail_name":"Gỏi xoài tôm khô","category":"Món luộc","age_group":null,"serving":{"raw":"121.2 g / Dĩa vừa","quantity_value":121.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Xoài sống","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Tôm khô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Tôm khô rửa qua nước cho sạch. Ngâm tôm vào nước ấm cho mềm, sau 15 phút vớt ra để ráo. Có thể dùng chày giã nhẹ để khi xào tôm gia vị sẽ thấm tốt hơn. Xoài xanh rửa sạch gọt vỏ, sau đó ngâm ngay vào nước đá lạnh. Dùng dao cắt tỉa hoặc nạo nhỏ để sắt xoài thành từng sợi như thái chỉ. Bỏ tất cả vào thố để tạm trong ngăn mát tủ lạnh. Các loại rau thơm nhặt sạch và sắt nhỏ 3-4cm. Tỏi bóc vỏ sắt thật nhuyễn, ớt bỏ hạt cũng bằm nhuyễn để một bên. Tiếp tục lấy nước mắm và đường theo tỉ lệ thích hợp (vì còn phụ thuộc vào nguyên liệu nhiều hay ít) hòa cùng ít nước nguội, khuấy cho tan đều rồi nếm thử. Vừa khẩu vị mới cho tỏi ớt vào. Lấy một củ hành bóc vỏ đập dập cho vào chảo dầu nóng. Hành phi thơm, trút tôm vào đảo nhanh tay, gia giảm thêm chút mắm chút đường cho tôm thêm hương vị. Thấy tôm săn lại thì tắt bếp. Bắc lên bếp một chiếc chảo khác, đun nóng cho đậu phộng vào đảo đều tay. Đậu chín vớt ra ngoài cho nguội rồi sát vỏ, bỏ vào cối giã nhỏ. Sử dụng một chiếc thố hoặc thau to để trộn gỏi xoài tôm khô, sử dụng trực tiếp thố xoài đang để trong tủ lạnh cũng được. Trút tôm khô vừa xào vào, rưới nước mắm cho đều. Nguyên liệu của món này không lo bị mềm nên lúc này có thể bóp mạnh tay cho gia vị thấm đều. Sau đó, cho rau thơm vào trộn đều. Dùng chiếc đĩa có lòng lớn để bày gỏi ra, không quên trang trí thêm hoa ớt kèm đậu phộng rang.","nutrition":{"kcal":138,"protein_g":8.9,"fat_g":3.7,"carbs_g":18.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02xft8m1wt84ksch","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Chanh","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:au phong","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:rau thom","unlisted_ingredient_phrase:xao tom","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món luộc","id":"mon_luoc","kind":"food_category","baseLabel":"Món luộc"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03o7t8m19abri90l#variant-1","name":"N12 CHAY - Heo quay chay","detail_name":"N12 CHAY - Heo quay chay","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"70.4 g","quantity_value":70.4,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Tàu hủ ky tươi","quantity_raw":"50 g","qua