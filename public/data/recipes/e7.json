ed_ingredient_phrase:thuc vat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món bột nhà nấu cho trẻ từ 7-8 tháng","id":"mon_bot_nha_nau_cho_tre_tu_7_8_thang","kind":"age_scoped_food_category","baseLabel":"Món bột nhà nấu cho trẻ"}],"source_age_group":{"label":"7-8 tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01dlt8m1xynm5dwy#variant-1","name":"Cá trê om sốt thịt","detail_name":"Cá trê om sốt thịt","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"41 g / Dĩa nhỏ","quantity_value":41,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá trê","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cá mua về rửa sạch cá với muối , để ráo. Cắt khúc Nấm hương khô ngâm nước nóng, cắt bỏ chân, rửa sạch, cắt nhỏ băm nhuyễn. Gừng, hành củ bóc vỏ, rửa sạch, băm nhuyễn. Trộn hỗn hợp: thịt heo xay, nấm hương, ít gừng và ít hành băm và ướp với các loại gia vị. Cá trê đem đi chiên vàng. Bắc chảo dầu nóng phi hành, tỏi và gừng cho thơm, đỗ hỗn hợp thịt heo vào xào thơm, cho nước xâm xấp vào, nêm nếm gia vị vừa ăn. Sau đó cho cá trê vào đun lửa nhỏ đến khi nước gia vị thấm vào cá.","nutrition":{"kcal":106.7,"protein_g":6.3,"fat_g":8,"carbs_g":2.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01dlt8m1xy