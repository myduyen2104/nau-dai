antity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Sườn heo cắt miếng 3cm, ướp với gia vị để thấm 45 phút. Khoai tây, cà rốt gọt vỏ, rửa sạch cắt khối 2cm. Cà chua bỏ hạt, bằm nhuyễn. Tỏi băm nhỏ. Đậu ngâm qua đêm hoặc ngâm cho đến khi hạt đậu nở gấp đôi. Rửa lại sạch, để ráo. Cho dầu ăn vào chảo, chiên sơ sườn. Xào cà chua: Tiếp tục cho tỏi vào phi vàng, cho cà chua vào xào chung cho đến khi cà chua mềm. Hầm hỗn hợp sườn đậu cà chua: Cho hỗn hợp cà chua vào nồi, cho sườn, đậu, cà rốt, khoai tây vào. Đổ nước dùng vào. Ninh cho đến khi cà rốt, khoai tây và đậu trắng mềm hẳn. Múc sườn nấu đậu ra tô, dùng với cơm hoặc bánh mì.","nutrition":{"kcal":355.6,"protein_g":16.1,"fat_g":27.8,"carbs_g":10.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04vdt8m15gnw8930","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Rau mùi","ingredient_not_mentioned_by_name:Hành lá (hành hoa)","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh mi","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:suon heo"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.foo