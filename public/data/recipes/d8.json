ên sơ, sau đó vớt bò khô và đậu hủ ra đĩa để ráo dầu. Củ cải và cà rốt đem gọt sạch vỏ cắt thành từng khúc. Các gia vị gồm quế, đinh hương, thảo quả, ớt băm rang vàng, hạt màu điều cho vào túi lọc để nấu nước dùng. Cho thịt bò chay, gói gia vị phở bò chay vào xào chung, tiếp đến cho thêm nước dừa và nước dùng vào đun sôi, cho thêm túi gia vị vào nấu chung. Sau khi nước sôi cho tiếp củ cải vào nấu thêm 10 phút, thêm nấm rơm và đậu hủ vào nồi nấu thêm một lúc. Cuối cùng nêm thêm muối, đường, hạt nêm vào cho vừa miệng. Lấy bánh phở đem trụng qua nước sôi, rồi cho vào tô, xếp đậu phụ và hành tây lên trên, sau đó chan thêm nước dùng và rắc thêm một chút tiêu, thưởng thức ngay khi còn nóng.","nutrition":{"kcal":450.1,"protein_g":17.8,"fat_g":12.3,"carbs_g":68.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03w8t8m1n85pcvlo","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu tương (đậu nành)","ingredient_not_mentioned_by_name:Bột mì","ingredient_not_mentioned_by_name:Rau thơm","ingredient_not_mentioned_by_name:Rau mùi tàu/ Ngò gai","ingredient_not_mentioned_by_name:Rau ngổ","ingredient_not_mentioned_by_name:Rau húng","ingredient_not_mentioned_by_name:Tương ngô","ingredient_not_mentioned_by_name:Chanh","unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:thit bo","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:tui loc"],"source_categories":[{"label":"Món nước chay từ 8-18 tuổi","id":"mon_nuoc_chay_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước chay"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72m044et8m1hut95a6h#variant-1","name":"ROHTO N12 BÚN MẮM","detail_name":"ROHTO N12