ity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sả rửa sạch 1 cây băm nhỏ, 1 cây đập dập rồi cắt khúc. Tỏi cũng bóc vỏ rồi băm nhỏ. Khoai lang gọt vỏ, thái miếng vuông vừa ăn, ngâm vào bát nước muối pha loãng để khoai khỏi thâm. Cà rốt, hành tây bạn cũng thái miếng cỡ miếng khoai lang. Rau húng quế nhặt rửa sạch. Tôm rửa sạch, bóc vỏ, bỏ đầu, lấy chỉ lưng và bụng. Sau đó rửa sạch lại một lần nữa rồi để ráo nước. Tiếp theo ướp tôm với 1 chút tỏi và sả băm nhỏ, một ít hạt nêm, gia vị, ớt bột và 1 gói cà ri. Để khoảng 10 phút sau đó cho khoai vào chảo rán hơi vàng các mặt (hoặc chỉ cần se các mặt), sau đó gắp ra đĩa. Cho sả và tỏi vào phi thơm lên, cho tôm vào xào qua. Đổ khoảng 1 bát con nước vào nồi tôm, đun sôi sau đó bạn cho khoai và cà rốt vào nồi. Đun sôi hỗn hợp trong vài phút rồi cho hành tây và nước cốt dừa vào. Nêm thêm hạt nêm, gia vị và đun sôi thêm vài phút nữa rồi thả rau húng quế vào. Cuối cùng cho cà ri tôm ra bát, ăn cùng cơm, bánh mì hay bún đều rất ngon.","nutrition":{"kcal":582.5,"protein_g":24.5,"fat_g":15.6,"carbs_g":87.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00xvt8m1uv8nmd7p","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh mi","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:rau hung","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv011it8m171joxpgr#variant-1","name":"Bún riêu tôm","detail_name":"Bún riêu tôm","category":"Món nước","age_group":null,"serving":{"raw":"580.5 g / Tô vừa","quantity_value":580.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bún tươi","quantity_raw":"300 g","quantity_value":300,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Trứng vịt (55g/quả)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hoa chuối","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sơ chế nguyên liệu Tôm mua lột vỏ, rửa sạch, Xay tôm cho nhuyễn Cho toàn bộ phần hành tím, tỏi xay nhuyễn, quả trứng vịt và phần tôm xay nhuyễn vào một tô lớn. Nêm một ít bột nêm, đường. Đảo và quết đều tay và để cho phần chả thấm gia vị trong khoảng 20 phút. Nấu nước dùng Bắc nồi lên bếp, cho vào nồi 2.5 lít nước. Thêm tiếp vào nồi phần xương heo (hoặc xương gà), hành tây và củ cải trắng cắt khúc, 1 muỗng cà phê muối, 1 muỗng cà phê hạt nêm. Đậy nắp và nấu sôi, sau khi nước dùng sôi, các bạn hạ nhỏ lửa và hầm nước dùng khoảng 45 phút - 1 giờ. Khi ninh nước dùng được khoảng 1 giờ, các bạn tiến hành vớt xương gà, hành tây và củ cải ra ngoài. Xào cà chua Bắc chảo lên bếp, cho hảnh tỏi và dầu màu điều vào phi thơm. Khi hành tỏi đã dậy mùi, các bạn cho cà chua vào chảo, nêm nước mắm, đường và xào cà đến khi vừa chín tới thì tắt bếp. Cho chả vào nước dùng Kế đến, dùng muỗng cho từng viên chả tôm vào nồi. Vặn lửa to, nấu cho đến khi chả chín và nước dùng sôi trở lại. Khi nước dùng vừa sôi, thêm vào nồi phần cà chua xào, hạ nhỏ lửa và đun thêm 10 phút, nêm gia vị vừa ăn. Cuối cùng cho bún, mảng riêu tôm, hành, ngò, tiêu và chan nước vào ăn kèm với rau.","nutrition":{"kcal":606.6,"protein_g":28.6,"fat_g":14.5,"carbs_g":90.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv011it8m171joxpgr","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Hoa chuối","ingredient_not_mentioned_by_name:Chanh","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:cai trang","unlisted_ingredient_phrase:cu cai trang","unlisted_ingredient_phrase:ham nuoc","unlisted_ingredient_phrase:ham nuoc dung","unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:toi xay","unlisted_ingredient_phrase:xuong ga","unlisted_ingredient_phrase:xuong heo","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv011st8m15033rnnv#variant-1","name":"Bún thang","detail_name":"Bún thang","category":"Món nước","age_group":null,"serving":{"raw":"568.5 g / Tô vừa","quantity_value":568.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bún tươi","quantity_raw":"300 g","quantity_value":300,"quantity_unit":"g"},{"name":"Giò lụa","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Tôm khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Thịt gà công nghiệp, lườn","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Lòng trắng trứng gà","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Gừng đã rửa sạch đem nướng cho đến khi nào chín và có mùi thơm. Bước 2: Cho gà vào nồi luộc, đến khi sôi thì cho một chút gia vị 1 muỗng hạt nêm, 1/2 muỗng đường, 1 muỗng cafe muối và hành khô, gừng đã nướng thơm vào, hạ nhỏ lửa để gà chín bên trong. Sau khi vớt ra để nguội Sau, bạn dùng tay xé sợi vừa ăn và để riêng. Bước 3: Xương heo cho vào nồi đun sôi với nước, sau đó đổ hết nước đó đi, cho ra vào nước lạnh rửa sạch vụn xương. Sau đó đổ xương vào nồi nước luộc gà ninh nhừ (khoảng 2 – 3 tiếng) để làm nước dùng. Bước 4: Trong khi ninh xương để nấu nước dùng, bạn bật một bên bếp khác lên, cho chảo chống dính lên bếp. Khi chảo nóng già thì cho tôm khô vào rang thơm rồi cho ra đĩa. Bước 5: Cho dầu ăn vào tráng đều mặt chảo, cho bát trứng đã đánh vào rán sao cho thật mỏng. Đến chi chín cho trứng ra đĩa, đợi trứng nguội thì thái thành sợi nhỏ. Bước 6: Khi nồi nước ninh xương đun được khoảng 50 phút đến 1 tiếng, thì cho tôm khô đã rang, đường phèn, hạt nêm, muối và chút nước mắm vào, khuấy đều. Tiếp tục ninh thêm 1 hoặc 2 tiếng nữa thì nêm nếm lại gia vị cho vừa miệng, cho hành lá và rau răm xắt nhỏ vào, rồi tắt bếp. Bước 7: Bún đem trần qua với nước, xếp các loại nhân lên trên rồi chan nước dùng vào là xong. Nếu ai có thể ăn được mắm tôm thì bạn cho ½ thìa cafe mắm tôm lên trên.","nutrition":{"kcal":584.9,"protein_g":33.7,"fat_g":11.4,"carbs_g":87},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv011st8m15033rnnv","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt gà công nghiệp, lườn","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mam tom","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:rau ram","unlisted_ingredient_phrase:uong phen","unlisted_ingredient_phrase:voi nuoc","unlisted_ingredient_phrase:xuong heo"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qy01hit8m1dy3hszjd#variant-1","name":"Canh bí đỏ nấu thịt heo","detail_name":"Canh bí đỏ nấu thịt heo","category":"Món canh từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"60.5 g / Chén","quantity_value":60.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bí đỏ (bí ngô)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g",