https://dinhduong2598.food/mon-an/cmrg0p5bv02b1t8m17eeatuga","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Trứng gà ta (35g/quả)","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:o trung"],"source_categories":[{"label":"Cháo 9-12 tháng tuổi","id":"chao_9_12_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"9-12 tháng","id":"9_12_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02dqt8m1olkdtrzu#variant-1","name":"Chim bồ câu nhồi cốm hấp","detail_name":"Chim bồ câu nhồi cốm hấp","category":"Món mặn","age_group":null,"serving":{"raw":"76.5 g / Dĩa vừa","quantity_value":76.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt bồ câu ra ràng","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Chả heo (lợn)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cốm","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cách làm: Bước 1: Bồ câu đem làm sạch, bỏ đầu đi và rút xương. Trước tiên bạn thực hiện xẻ dọc một đường ở giữa lưng con bồ câu, rồi dọc theo xương lưng dùng dao cắt phần xương sống ra khỏi thịt. Bạn dùng tay đẩy xương cánh, xương đùi lòi ra rồi cắt từ từ. Bước 2: Cà rốt đem đi thái nhỏ, phần hạt sen cần luộc chín mềm. Để hạt sen nhanh chín, trước khi luộc, bạn chú ý ngâm với nước ấm. Nâm hương ngâm nước nóng, cắt đuôi, thái mỏng, băm nhuyễn Bước 3: Cho cốm, hạt sen , nấm hương vào thịt lợn xay, ướp gia vị, nhồi vào thân chim bồ câu rồi đem hấp chín trong tủ nấu cơm khoảng 10 phút, sau đó dùng dây buộc cho thật chặt thân chim rồi đem rán vàng. Bước 4: Khi chim bồ câu chín, bạn đem thái khoanh.","nutrition":{"kcal":203.3,"protein_g":7.7,"fat_g":14.8,"carbs_g":10.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02dqt8m1olkdtrzu","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gừng tươi","ingredient_not_mentioned_by_name:Hành củ tươi","ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02e2t8m1nneh1ymq#variant-1","name":"chim bồ câu om nấm","detail_name":"chim bồ câu om nấm","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"41 g / Dĩa nhỏ","quantity_value":41,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bồ câu ra ràng","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành c