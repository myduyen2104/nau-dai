ity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cá nạc/cá thác lác","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Bắp cải tách từng lá rửa sạch, cắt bỏ gân, ngâm nước muối, trụng sơ với nước muối sau đó vớt ra để ráo. Tôm bóc vỏ rửa sạch băm nhuyễn, trộn chung với cá thác lác, ướp gia vị. Mộc nhĩ ngâm mềm rồi cắt nhỏ trộn chung với thịt tôm cá. Lá hành trụng sơ với nước nóng. Lấy bắp cải cuộn thịt tôm cá bên trong và cột lại bằng lá hành. Bắt nồi nước lên bếp đun sôi, cho bắp cải đã cuộn vào nấu cho bắp cải và thịt bên trong vừa chín tới. Nêm gia vị vừa ăn.","nutrition":{"kcal":60.7,"protein_g":5,"fat_g":1.3,"carbs_g":7.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01frt8m1vadzo2d8","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01mbt8m1j526cbt5#variant-1","name":"Canh chua chay","detail_name":"Canh chua chay","category":"Món canh chay","age_group":null,"serving":{"raw":"81.5 g / Chén","quantity_value":81.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đậu phụ chiên","quantity_raw":"6 g","quantity_value":6,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bạc hà (dọc mùng)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đậu bắp","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Đổ me ra bát, thêm nước sôi vào, chần me cho tan, sau đó lọc bỏ bã và giữ lại phần nước cốt me. Cà chua rửa sạch, cắt múi cau. Tước bỏ vỏ dọc mùng. Rửa sạch đậu bắp và dọc mùng, cắt lát xéo. Đậu phụ non rửa sạch, cắt khoanh tròn. Đun nóng một muỗng dầu ăn để phi đầu hành ba rô. Cho cà chua vào xào chín trong 3 phút, sau đó thêm thơm và nêm nếm vừa ăn.Đổ 2 - 3 bát nước vào nồi đang nấu, đun sôi, thêm nước cốt me và đun tiếp 10 phút nữa. Cho thêm đậu bắp và đun 5 phút. Cuối cùng, cho đậu phụ non và dọc mùng vào, đun lửa nhỏ, nêm nếm lại cho thật vừa miệng rồi thêm rau mùi và tắt bếp.","nutrition":{"kcal":38.1,"protein_g":2.5,"fat_g":1.5,"carbs_g":4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01mbt8m1j526cbt5","quality_status":"needs_review","warnings":["duplicate_identical_catalog_metadata","identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nuoc cot","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh chay","id":"mon_canh_chay","kind":"food_category","baseLabel":"Món canh chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01uct8m1rrtgtdq1#variant-1","name":"Canh rau dền đỏ nấu thịt heo","detail_name":"Canh rau dền đỏ nấu thịt heo","category":"Món canh","age_group":null,"serving":{"raw":"112.5 g / Chén","quantity_value":112.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau giền đỏ","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Rau dền, nhặt bỏ phần gốc già, lá vàng rồi đem rửa với nước muối cho sạch. Hành tím ta lột vỏ, băm nhỏ. Thịt heo mua về ta đem rửa sạch với nước, dùng dao băm thật nhỏ và cho ra bát hoặc có thể mua thịt heo xay sẵn. Tiếp đến, bạn cho gia vị vào bát, trộn đều lên để ướp thịt heo. Ướp khoảng 10 phút cho thấm vị. Đầu tiên đặt nồi lên bếp, cho dầu ăn vào nồi sau đó cho hành vào phi thơm lên. Tiếp đến ta cho thịt băm vào đảo săn lại rồi đổ nước vào nấu sôi lên. Khi nước sôi bạn cho rau dền vào nấu khoảng 4-5 phút cho rau chín, trong khi nấu ta nêm nếm gia vị cho vừa miệng sau đó tắt bếp.\"","nutrition":{"kcal":95.7,"protein_g":5.4,"fat_g":4.8,"carbs_g":7.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01uct8m1rrtgtdq1","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:uop thit","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh","id":"mon_canh","kind":"food_category","baseLabel":"Món canh"}],"source_age_group":null,"source_ta