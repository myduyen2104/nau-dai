 lên trên, chan thêm nước lèo, rắc một ít hành, ngò cắt nhỏ và hạt tiêu xay. Cho thêm vào vài lát chả chiên, thịt heo, nặn tí chanh, ăn kèm với mắm tôm, đĩa rau sống đã chuẩn bị.","nutrition":{"kcal":424.6,"protein_g":12.7,"fat_g":18.8,"carbs_g":51.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv0104t8m12r3ocyep","quality_status":"unmatched","warnings":["duplicate_listing_row_occurrence","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Cà rốt","unlisted_ingredient_phrase:gio song","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:mam tom","unlisted_ingredient_phrase:nam meo","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc ngot"],"source_categories":[{"label":"Món nước 6-7 tuổi","id":"mon_nuoc_6_7_tuoi","kind":"food_category","baseLabel":"Món nước 6-7 tuổi"}],"source_age_group":null,"source_tag_evidence_status":"catalog_capture_unmatched_to_detail"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01gnt8m1rgsqku4x#variant-1","name":"Canh bầu nấu tôm","detail_name":"Canh bầu nấu tôm","category":"Món canh 5 tuổi","age_group":"5 tuổi","serving":{"raw":"74.5 g / Chén","quantity_value":74.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bầu","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Tôm cắt đầu đuôi, rửa sạch, lột vỏ. Cho tôm vào cối với một chút gia vị rồi giả dập. Bầu gọt vỏ, rửa sạch, cắt lát mỏng. Bắt nồi lên cho dầu vào phi hành cho thơm. Cho tôm vào xào sơ Cho nước vào, nước sôi đổ tôm lên chờ sôi lại cho bầu lên, canh vừa sôi