":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i031jt8m1cyg899bg#variant-1","name":"Hủ tíu bò kho","detail_name":"Hủ tíu bò kho","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"270 g / Tô vừa","quantity_value":270,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Hủ tiếu khô","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt bò loại 2","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch với nước lạnh sau đó ta đổ một ít rượu trắng vào chén, cho thêm vài lát gừng tươi hòa đều rồi xoa khắp các miếng thịt bò để khỏang 5 phút, rồi rửa lại bằng nước sạch. – Để ráo bớt nước rồi ta trụng qua một lượt bằng nước sôi giúp khử bớt mùi hôi của thịt bò. – Tiếp theo ta xắt thịt bò thành từng miếng nhỏ, tốt nhất ta nên cắt theo khối hình vuông hay chữ nhật. - Ướp thịt bò với các gia vị vừa ăn. Cà rốt gọt vỏ ngoài rồi rửa sạch, 1 củ xắt khúc dài chừng 5cm rồi những khúc này ta bổ làm đôi hay làm 4 tùy ý. – Sả lột bỏ lớp vỏ ngoài cùng, chặt bỏ phần gốc, rửa sạch rồi dùng cán dao đập dập. – Gừng tươi, hành tím, tỏi rửa sạch băm nhỏ. Rau ngò, húng quế nhặt sạch, để riêng vào rổ cho ráo nước. – Hoa hồi và vỏ quế cho vào chảo rao sơ qua để dậy mùi thơm. Đặt một chiếc nồi nhỏ lên trên bếp cho dầu ăn vào bật lửa vừa để đun nóng dầu rồi trút hành tỏi và gừng vừa băm nhỏ vào phi thơm. – Sau đó ta đổ thịt bò đã ướp xong vào đảo đều tay, rồi cho thêm 2 muỗng nhỏ màu dầu điều để món hủ tiếu bò kho có màu đẹp mắt. Khi thấy thịt bò săn lại thì cho sả và đổ một lượng nước lọc sao cho xâm xấp mặt thịt, rồi thả hoa hồi và quế vừa rang vào nồi. – Khi nào thịt chín mềm thì ta dùng vá vớt hoa hồi, quế và sả ra ngoài, rồi nêm thêm một chút hạt nêm cho vừa khẩu vị. – Ta đổ chừng 3 muỗng nhỏ bột năng vào cái tô nước lọc sau đó trút từ từ vào nồi bò kho, vừa đổ vừa khuấy đều tay rồi cho cà rốt xắt khúc vào đun thêm chừng 10 phút nữa thì tắt bếp. - Hủ tiếu trụng qua nước sôi, giũ thật ráo cho vào tô, sau đó múc nước bò kho vào thêm một ít tiêu bột, ngò gai ngắt thành từng khúc ngắn, húng quế vặt những lá vừa ăn cho vào tô.","nutrition":{"kcal":591.3,"protein_g":23.8,"fat_g":15,"carbs_g":91},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i031jt8m1cyg899bg","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:bot ngo","unlisted_ingredient_phrase:gung tuoi","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:ngo gai","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:rau ngo","unlisted_ingredient_phrase:ruou trang","unlisted_ingredient_phrase:uop thit","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03gst8m10wjex8d8#variant-1","name":"Mì xào giòn","detail_name":"Mì xào giòn","category":"Món khô","age_group":null,"serving":{"raw":"328 g / Dĩa vừa","quantity_value":328,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Mì sợi khô","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Gan heo (lợn)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Mực tươi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cải xanh","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Đun sôi một nồi nước. Thả mì vào chần, khuấy sơ cho sợi mì tơi. Khi mì đã tơi và mềm thì vớt ra, xả nước lạnh khoảng 30 - 45s. Xóc mì cho ráo. Để ở nhiệt độ phòng cho mì khô bớt. Mực sơ chế, làm sạch, cắt miếng vừa ăn. Tôm bóc vỏ, bỏ đầu, bỏ chỉ đen, ướp muối, hạt tiêu. Thịt nạc và tim, cật thái thành miếng vừa ăn. Súp lơ rửa sạch, tách nhỏ, chần qua nước sôi. Hành tây, cà chua rửa sạnh bổ múi cau. Cải ngọt, cần tây rửa sạch, cắt khúc ngắn vừa ăn. Cà rốt gọt vỏ, thái lát mỏng. Cho dầu vào chảo, đợi thật nóng, cho mì vào chiên vàng, vớt ra đĩa cho ráo dầu. Tiếp tục thêm dầu ăn và cho hành tây vào xào thơm, cho tiếp thịt, tim, cật, mực, tôm vào xào cho săn. Nêm hạt nêm, dầu hào, xì dầu, hạt tiêu vào cho vừa ăn. Cho tiếp các loại rau củ vào xào cùng, cho thêm nước dùng gà. Thấy các nguyên liệu vừa chín tới, quậy bột năng đều với nước dùng, đổ từ từ để tạo độ sánh cho món xào. Nêm lại cho vừa ăn, thêm dầu mè, tắt bếp. Đổ hỗn hợp vừa xào này lên trên vắt mì đã chiên giòn, rắc thêm ít tiêu, trang trí với vài cọng ngò. Và thưởng thức ngay.","nutrition":{"kcal":707.7,"protein_g":30.2,"fat_g":26.2,"carbs_g":89.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03gst8m10wjex8d8","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gan heo (lợn)","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:ca chua","unlisted_ingredient_phrase:cai ngot","unlisted_ingredient_phrase:can tay","unlisted_ingredient_phrase:chien gion","unlisted_ingredient_phrase:dau hao","unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:kho bot","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô","id":"mon_kho","kind":"food_category","baseLabel":"Món khô"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03kct8m1l76j6ngo#variant-1","name":"Miến xào cua tay cầm","detail_name":"Miến xào cua tay cầm","category":"Món khô","age_group":null,"serving":{"raw":"322 g / Dĩa","quantity_value":322,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":[{"name":"Miến dong khô","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Cua ghẹ","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw