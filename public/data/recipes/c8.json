,"age_group":"6-7 tuổi","serving":{"raw":"125.2 g / Dĩa vừa","quantity_value":125.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Khế","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"chuối xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Kiệu muối","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ngó sen","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Thịt bò bạn chọn mua loại tươi ngon, đem rửa sạch rồi thái mỏng ngang thớ để thịt không bị dai. Khế rửa sạch, cắt bỏ các gân và viền bên ngoài. Chuối gọt vỏ.Ngó sen rứa sạch, cắt khúc 2-3 cm. Chuẩn bị một tô nước lọc và vắt nửa quả chanh vào để sẵn. Sau đó thái mỏng chuối và khế bỏ ngay vào tô nước chanh ngâm chung với ngó sen cho không bị thâm và bớt chát. Cà rốt gọt vỏ, rửa sạch, thái sợi rồi cho vào ngâm cùng chuối và khế. Dưa chuột rửa sạch, cắt vừa ăn Hành tây lột vỏ, rửa sạch, bổ dọc làm đôi rồi thái ngang. Rau thơm nhặt rửa sạch, để ráo nước rồi thái nhỏ. Tỏi bóc vỏ, băm nhỏ. Ớt sừng rửa sạch, lọc bỏ hạt, băm nhỏ. Đậu phộng rang chín giòn, tách vỏ và đập dập. Chuẩn bị một chén sạch, pha các nguyên liệu gia vị: nước cốt chanh, nước mắm, đường kính, nước lọc, tỏi, ớt băm. Khuấy đều cho tan hết. Cho thịt bò thái mỏng vào tô, sau đó thêm vào tỏi băm, tiêu, dầu ăn vào đảo đều rồi để ướp khoảng 3 phút. Bắc chảo lên bếp cho nón rồi đổ thịt bò đã ướp vào xào tái là được. Dùng thố lớn hoặc thau sạch lần lượt cho khế, chuối xanh, ngó sen, cà rốt (sau khi vớt ra để ráo nước), thịt bò đã xào, nước xốt trộn gỏi vào. Trộn đều nhẹ nhàng rồi tiếp tục cho thêm dưa chuột, hành tây, rau thơm, đậu phộng rang đập dập, tiêu vào trộn tiếp cho đều các nguyên liệu là xong. Trình bày ra đĩa thưởng thức.","nutrition":{"kcal":139.9,"protein_g":7.2,"fat_g":6.1,"carbs_g":14.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02wft8m18m5dbe9u","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Kiệu muối","ingredient_not_mentioned_by_name:Giấm","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc loc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6on033ct8m1jigap45b#variant-1","name":"Khổ qua (mướp đắng) xào trứng","detail_name":"Khổ qua (mướp đắng) xào trứng","category":"Món xào","age_group":null,"serving":{"raw":"171.5 g / Dĩa vừa","quantity_value":171.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Khổ qua (mướp đắng)","quantity_raw":"140 g","quantity_value":140,"quantity_unit":"g"},{"name":"Trứng vịt (55g/quả)","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Mướp đắng rửa sạch, bổ đôi bỏ ruôt thái lát mỏng đều ngâm nước đá 5 đến 10 phút vớt ra để ráo (để tạo độ giòn, xanh) trước khi xào. Mướp đắng thái mỏng, ướp gia vị để 5 phút, hành củ thái nhỏ phi thơm, đổ mướp đắng vào đảo đều 2 phút. Trứng đánh đều, cho 1 chút nước mắm Đổ trứng vào đảo đều để trứng quện vào mướp đắng ( 3 đến 5 phút) là được","nutrition":{"kcal":113.9,"protein_g":4.5,"fat_g":8.3,"carbs_g":6.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6on033ct8m1jigap45b","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng vịt (55g/quả)","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Muối","title_ingredient_not_mentioned:Trứng vịt (55g/quả)","unlisted_ingredient_phrase:hanh cu","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:o trung"],"source_categories":[{"label":"Món xào","id":"mon_xao","kind":"food_category","baseLabel":"Món xào"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03d3t8m1ixsumupe#variant-1","name":"Mì hoành thánh xá xíu","detail_name":"Mì hoành thánh xá xíu","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"258 g / Tô vừa","quantity_value":258,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Mì sợi khô","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Lá hoành thánh (thành phần nguyên liệu có trứng)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hẹ lá","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"6 g","quantity_value":6,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Xương ống, thịt nạc dăm rửa sạch với muối, trụng sơ qua nước sôi, để ráo. Rau giá các loại rửa sạch, để ráo. Nấu nước lèo cho mì hoành thánh xá xíu: cho vào nồi xương ống (đã trụng qua nước sôi), hành củ tươi nướng và 2 lít nước, hầm 40 phút để xương ra chất ngọt, nêm nếm gia vị theo khẩu vị từng gia đình. Thịt nạc dăm dùng nĩa châm nhiều lần vào thịt để khi ướp gia vị được thấm đều hơn. Ướp thịt với xốt thịt nướng xá xíu 30 phút cho thịt thấm gia vị. Làm nóng 2 muỗng canh dầu ăn, cho 10gr tỏi, 10gr hành tím vào phi thơm. Sau đó gắp thịt đã ướp vào, thêm 300ml nước dừa tươi rồi đun sôi. Sau đó hạ lửa nhỏ, rim liu riu đến khi nước sốt cạn lại. Trong lúc rim thường xuyên tưới sốt lên trên miếng thịt để thịt thấm đều gia vị. Sau khi rim cạn nước gắp thịt vào khay đem nướng 20 phút ở 180 độ C. Sau đó cắt thành lát mỏng. Trộn nhân hoành thánh gồm thịt băm, hành tím băm, tiêu và gia vị. Lấy vỏ hoành thánh bọc nhân lại bên trong thành những khối hình đồng tiền như hình. Đun sôi nước, cho hoành thánh vào luộc 3 phút đến khi hoành thánh chín, nổi lên mặt nước thì vớt ra. Mì tươi trụng qua nước sôi, gắp mì ra tô, xếp xen kẻ hoành thánh, xá xíu, rau giá lên trên, chế nước lèo vào, ăn cùng với rau giá.","nutrition":{"kcal":672.5,"protein_g":25.1,"fat_g":26,"carbs_g":84.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03d3t8m1ixsumupe","quality_status":"needs_review","warnings":["duplicate_identical_catalog_metadata","identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:nac dam","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:thit nuong","unlisted_ingredient_phrase:uop thit","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03pdt8m1apu56e9o#variant-1","name":"Nem cua bể","detail_name":"Nem cua bể","category":"Món mặn","age_group":null,"serving":{"raw":"88.8 g / Dĩa nhỏ","quantity_value":88.8,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cua bế","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Tôm biển","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Nấm hương tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Miến dong khô","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Củ đậu","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Bánh đa nem/ Bánh tráng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cua luộc chín gỡ lấy thịt. Tôm bóc vỏ, bỏ đẩu, băm nhuyễn. Nấm hương cắt sợi, băm nhỏ. Mộc nhĩ, miến dong ngâm mềm, cắt nhỏ. Củ đậu gọt vỏ, cắt sợ, băm nhỏ. Cho các nguyên liệu trên vào một cái bát, cho trứng, hạt nêm vào trộn đều để làm nhân bánh. Trải bánh đa ra dĩa, thấm ít nước cho bánh mềm, cho nhân vào bên trong bánh và gói lại. Bắt chảo dầu, đun nóng dầu và cho nem vào chiên giòn đều 2 mặt là vớt ra.","nutrition":{"kcal":157.9,"protein_g":10.1,"fat_g":6,"carbs_g":16.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6or03pdt8m1apu56e9o","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","ingredient_not_mentioned_by_name:Hành lá (hành hoa)","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:chien gion","unlisted_ingredient_phrase:nguyen lieu"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03rwt8m1dk9tnqw5#variant-1","name":"Nui xào bò","detail_name":"Nui xào bò","category":"Món khô 5 tuổi","age_group":"5 tuổi"