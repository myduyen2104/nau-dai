60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Vịt rửa sạch, để ráo, chặt miếng vừa ăn, ướp gia vị trong 15 phút. Hành củ, gừng rửa sạch, băm nhuyễn. Bật bếp, chỉnh lửa nhỏ vừa và cho chảo chống dính lên bếp, chờ cho chảo nóng thì bạn cho 2 muỗng đường vào, đảo đều tay cho đến khi đường tan ra và chuyển thành màu nâu. Tiếp theo, bạn cho thêm nước vào, khuấy đều tay và đun sôi. Đun tiếp cho đến khi nước màu sánh và sệt lại thì bắc chảo xuống.Bạn cho nước màu vào nồi vịt, trộn đều và cho lên bếp để đun sôi. Khi vịt sôi, bạn dùng đũa đảo đều, chỉnh lửa nhỏ liu riu, cho hành củ, gừng vào và mở nắp để đun cho đến khi thịt vịt săn, chắc thịt, còn nước kho thì sệt và sánh lại là được. Bạn nêm nếm lại cho vừa miệng là có thể tắt bếp.","nutrition":{"kcal":208.8,"protein_g":11.1,"fat_g":16.2,"carbs_g":5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05kat8m16tupw8mj","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:nuoc mau","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05kvt8m1ezrjyeoe#variant-1","name":"Vịt quay tiêu","detail_name":"Vịt quay tiêu","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"106.5 g / Dĩa nhỏ","quantity_value":106.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu hào maggi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Sơ chế thịt vịt Thịt vịt sau khi mua về, bạn rửa sạch với nước rồi khử mùi hôi. Bạn có thể khử mùi hôi cho vịt bằng rất nhiều cách: Trộn muối và giấm với nhau, dùng hỗn hợp này để bóp vịt cả bên trong lẫn ngoài; dùng chanh tươi chà xát lên thân vịt nhiều lần; bóp vịt với gừng giã nhuyễn hay rượu trắng,…. Cuối cùng, bạn rửa vịt lại với nước rồi để ráo, vịt đã sạch và hoàn toàn hết mùi hôi. Bước 2: Chuẩn bị nước ướp Nước ướp bạn pha theo tỷ lệ như sau: tiêu xay + hạt nêm + dầu hào + nước mắm Bước 3: Chuẩn bị ướp vịt Dùng nước ướp vừa pha xoa lên mình vịt. Hành tây, cà rốt bạn gọt sạch vỏ rửa sạch và thái lát mỏng. Bước 4: Nướng vịt Cho vịt vào lò nướng để nướng, bạn cũng có thể dùng lò nướng hoặc dùng bếp than hoa Cứ nướng khoảng 20 phút bạn lại tưới một lớp nước ướp lên vịt để món ăn không bị khô. Làm như vậy khoảng 3 lần là thịt vịt sẽ chín tới và da vàng giòn. Khi vịt chín vàng đều là được. Bước 5: Hoàn thành Chặt vịt thành những miếng vừa ăn cho đều, đẹp mắt rồi xếp ra đĩa và trang trí cùng với cà rốt hành tây.","nutrition":{"kcal":151.5,"protein_g":8.2,"fat_g":8.9,"carbs_g":9.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05kvt8m1ezrjyeoe","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:ruou trang","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]