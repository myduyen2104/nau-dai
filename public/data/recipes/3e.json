od_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03xot8m1ql43s9sq#variant-1","name":"Phở gà","detail_name":"Phở gà","category":"Món nước","age_group":null,"serving":{"raw":"448 g / Tô vừa","quantity_value":448,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"250 g","quantity_value":250,"quantity_unit":"g"},{"name":"Thịt gà ta","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau ngổ","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau húng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt gà sau khi đã rửa sạch chà xát với muối, sau đó cho vào nồi nước lạnh đun với lửa vừa. Khi luộc bỏ thêm gừng đập dập, hành tím và một ít muối. Rau giá ăn kèm rửa sạch, để ráo. Gà luộc sau khi sôi thì vặn nhỏ lửa, vớt bọt. Lưu ý luộc gà không nên chín quá, thịt gà dễ bị khô và mất ngọt. Để kiểm tra xem gà có chín chưa, bạn có thể dùng đũa xâm sâu vào phần thịt, nếu gà chín thì sẽ không thấy nước đỏ chảy ra. Sau khi gà chín thì vớt gà ra để nguội, bạn có thể thái miếng hoặc xé nhỏ thành sợi tùy thích. Phần xương gà sau khi đã rửa sạch thì cho vào nồi áp suất và đổ nước sôi vào hầm cho đến khi xương mềm và hết vị ngọt. Nếu không sợ béo, bạn có thể đổ nước luộc gà vừa luộc và bỏ thêm xương gà đã được tách thịt ở trên vào hầm chung. Cho túi vải gia vị đã buộc vào nồi, nêm nếm gia vị cho vừa ăn và khuấy đều đến khi gia vị hòa quyện hết. Hầm thêm khoảng 20 phút thì vớt túi gia vị đó ra. Sau đó, để lửa nhỏ liu riu cho nước nóng. Cho bánh phở đã trần vào tô, xếp thịt gà luộc lên trên. Khi ăn, rải hành lá và các loại rau thơm trang trí, chan nước lèo vào rồi ăn cùng rau sống hoặc quẩy sẽ rất ngon.","nutrition":{"kcal":608.9,"protein_g":24.4,"fat_g":16,"carbs_g":93.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03xot8m1ql43s9sq","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Chanh","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Tương ngô","unlisted_ingredient_phrase:xuong ga"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72n04fmt8m14g5y8lby#variant-1","name":"Sò điệp nướng phô mai","detail_name":"Sò điệp nướng phô mai","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"170 g / Dĩa vừa","quantity_value":170,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Sò điệp","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Pho mát","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bơ","quantity_ra