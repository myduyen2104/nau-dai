[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tw00ext8m1qvc2mxc1#variant-1","name":"Bánh đa cua","detail_name":"Bánh đa cua","category":"Món nước 5 tuổi","age_group":"5 tuổi","serving":{"raw":"211.3 g / Tô nhỏ","quantity_value":211.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh đa cua tươi","quantity_raw":"110 g","quantity_value":110,"quantity_unit":"g"},{"name":"Cua đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Sơ chế cua và thịt heo Thịt heo rửa sạch, cho vào nồi nước đun sôi khoảng 2 – 3 phút để cho ra các bọt bẩn. Sau đó đổ thịt ra rửa sạch với nước. Cho thịt vào nồi và đổ nước ngập thịt, nấu lửa nhỏ trong 30 – 40 phút. Có thể thả thêm vài củ hành khô (nướng xém vàng, bóc vỏ) cho thơm. Hòa cua xay với nửa bát to nước. Dùng tay khuấy và bóp nhẹ cho thịt cua hòa đều trong nước. Đặt rây lên nồi, nhẹ nhàng đổ bát cua qua rây, phần vỏ cứng sẽ được giữ lại. Dùng tay bóp phần vỏ này cho kiệt nước rồi đổ trở lại bát. Lặp lại thao tác bóp và lọc cua với nước như trên 1 – 2 lần nữa để lấy được sạch thịt cua, được phần nước lọc cua trong nồi riêng. Sơ chế các nguyên liệu khác Cà chua rửa sạch, bổ múi cau. Hành khô bóc vỏ, thái mỏng. Hành lá, mùi tàu nhặt và rửa sạch, thái nhỏ. Nếu dùng bánh đa khô thì các bạn ngâm qua với nước khoảng 5 phút cho bánh nở mềm, vớt ra để ráo. Với bánh đa tươi thì chỉ cần rửa qua với nước là được. Làm phần nước lọc cua Đổ từ từ nước lọc cua vào nồi, gạn bỏ phần cặn dưới đáy bát. Cho chút muối vào nồi, đun lửa vừa. Dùng đũa khuấy để thịt cua không bị xát đáy nồi, khi nước bắt đầu có vẩn đục của thịt cua nổi lên thì ngừng không khuấy nữa nếu không cua sẽ khó đóng bánh. Khi cua đã đóng thành tảng và nổi hoàn toàn trên mặt nước, dùng muôi vớt phần gạch cua này ra bát riêng. Nước dùng cua để lại. Chế biến nước dùng Vớt thịt heo ra khỏi nồi và cắt mỏng , đổ nước lọc cua vào nồi nước ninh xương. Đun sôi trở lại cho tiếp cà chua và đậu hủ chiên vào đun sôi, nêm hạt nêm. Cho bánh đa vào trụng sơ qua trong nồi nước sôi riêng khoảng 2 phút cho chín tới (không trụng vào nồi nước dùng vì sẽ làm đục và đặc nước). Vớt bánh đa ra và chia đều vào các bát. Xếp thịt heo, hành phi, hành mùi để ăn kèm, chan đều nước dùng vào bát.","nutrition":{"kcal":355.5,"protein_g":12.8,"fat_g":16.2,"carbs_g":41.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00ext8m1qvc2mxc1","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh a kho","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mui tau","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc khoang","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tx00kdt8m1sil881iw#variant-1