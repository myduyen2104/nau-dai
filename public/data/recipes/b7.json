oup":{"label":"7-8 tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00z4t8m1dd6vjyik#variant-1","name":"Bún khô xào nấm hương","detail_name":"Bún khô xào nấm hương","category":"Món khô 5 tuổi","age_group":"5 tuổi","serving":{"raw":"143 g / Dĩa nhỏ","quantity_value":143,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Bún khô","quantity_raw":"45 g","quantity_value":45,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc vai","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cải ngọt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Bún khô ngâm mềm, vớt để ráo nước. Cắt khúc vừa ăn. Nấm hương khô ngâm mềm, cắt lát. Cải ngọt bỏ gốc, rửa sạch, cắt khúc 4 cm. Cà rốt gọt vỏ, rửa sạch, bào sợi. Thịt heo nạc rửa sạch, băm nhuyễn, ướp gia vị vừa ăn. Bắt chảo lên bếp, thêm dầu, thêm hành tỏi băm phi thơm, rồi cho thịt heo vào đảo đều, thêm cà rốt, nấm hương, vào đảo đều rồi thêm cải ngọt vào xào chín. Thêm bún khô vào trộn đều, thêm gia vị vừa ăn đảo đều cho chín rồi tắt bếp.","nutrition":{"kcal":411.1,"protein_g":14,"fat_g":20.1,"carbs_g":44.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00z4t8m1dd6vjyik","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:heo nac","unlisted_ingredient_phrase:thit heo nac"],"source_categories":[{"label":"Món khô 5 tuổi","id":"mon_kho_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv0105t8m12gmnteou#variant-1","name":"Bún mọc","detail_name":"Bún mọc","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"368.5 g / Tô nhỏ","quantity_value":368.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"220 g","quantity_value":220,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Chả heo (lợn)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sơ chế nguyên liệu Thịt heo ngâm nước muối, rửa sạch, cắt lát mỏng vừa ăn. Củ cải trắng gọt vỏ, rửa sạch và cắt thành từng khúc ngắn dày khoảng 1cm. Hành, ngò cắt nhỏ. Chả chiên cắt khoanh tròn hoặc cắt lát xéo tùy thích. Cho 2 lít nước vào nồi và đặt lên bếp, cho miếng thịt heo vào và vài củ hành tím. Hầm cho thịt tiết nước ngọt. Chú ý hớt bọt thường xuyên để nước lèo không bị đục, nhìn trong ngon. Viên giò sống Nấm mèo cắt nhuyễn cho vào tô giò sống, thêm vào một ít hạt nêm, tiêu, đường và trộn đều. Sau đó lấy muỗng múc và vo thành viên, cho vào nồi nước lèo đang nấu. Thêm các nguyên liệu khác Cho củ cải trắng đã sơ chế vào nồi nước lèo. Nêm thêm các gia vị cho phù hợp với khẩu vị. Sau đó tắt bếp. Trình bày và thưởng thức Cho bún vào tô, sau đó múc giò mọc, củ cải cho lên trên, chan thêm nước lèo, rắc một ít hành, ngò cắt nhỏ và hạt tiêu xay. Cho thêm vào vài lát chả chiên, thịt heo, nặn tí chanh, ăn kèm với mắm tôm, đĩa rau sống đã chuẩn bị.","nutrition":{"kcal":547.7,"protein_g":16.4,"fat_g":24.3,"carbs_g":66.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv0105t8m12gmnteou","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:cai trang","unlisted_ingredient_phrase:cu cai trang","unlisted_ingredient_phrase:gio song","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:mam tom","unlisted_ingredient_phrase:nam meo","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc ngot"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01qkt8m1e3wasqh3#variant-1","name":"Canh khoai sọ ninh thịt vịt","detail_name":"Canh khoai sọ ninh thịt vịt","category":"Món canh 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"64.2 g / Chén","quantity_value":64.2,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Khoai sọ","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Thịt vịt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"\"Khoai sọ gọ