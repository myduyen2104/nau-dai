 kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bv02b0t8m1ukelg8b1#variant-1","name":"Cháo trứng gà cà rốt nấm rơm","detail_name":"Cháo trứng gà cà rốt nấm rơm","category":"Cháo 7-8 tháng tuổi","age_group":"7-8  tháng","serving":{"raw":"78 g / Chén","quantity_value":78,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Trứng gà ta (35g/quả)","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"* Trứng gà đập vỏ đỗ ra chén khuấy đều * Cà rốt gọt vỏ, rửa sạch đem đi luộc đến khi chín mềm, vớt ra để ráo, tán nhuyễn. Nấm rơm ngâm muối, rửa sạch, băm nhuyễn. * Cho 1/3 chén nước nguội vào nồi cùng 2/3 chén cháo trắng, dùng đũa đánh đều , bắc lên bếp khuấy đều cho đến khi sôi, cho nấm rơm và cà rốt vào, sau đó đổ trứng vào khuấy đều đến chín. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":150.6,"protein_g":5.7,"fat_g":6.4,"carbs_g":17.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bv02b0t8m1ukelg8b1","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Trứng gà ta (35g/quả)","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:o trung"],"source_categories":[{"label":"Cháo 7-8 tháng tuổi","id":"chao_7_8_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"7-8  tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02cut8m1d5nt0ftx#variant-1","name":"Chè nếp khoai mì","detail_name":"Chè nếp khoai mì","category":"Chè","age_group":null,"serving":{"raw":"120 g / Chén","quantity_value":120,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Khoai mì (củ sắn)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Vừng (đen, trắng)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Khoai mì rửa sạch, gọt sạch vỏ và thái miếng vừa ăn Ngâm khoai vào nước sạch khoảng 2 giờ đồng hồ. Sau đó vớt khoai ra và để ráo. (Nếu dị ứng khoai, thì hãy rửa khoai sơ qua với nước muối loãng, sau đó mới ngâm nước sạch nhé.). Sau khi sơ chế khoai mì xong, bạn cho khoai vào nồi, đặt lên bếp, cho vào đường cát trắng và nước. Đun khoai đến khi khoai chín thì tắt bếp. Dừa bạn nạo xong, cho vào túi vải, ngâm vào 500ml nước ấm và vắt lấy nước cốt. Sau đó bạn tiếp tục vắt lấy nước dão cốt dừa, cho vào nồi nếp nấu chung với nhau. Tiếp theo cách nấu chè khoai mì là cho phần khoai đã luộc vào nồi với nước, lá dưa vào nấu cùng, cho thêm một ít muối và nước cốt dừa, khuấy 1 ít bột năng đỗ vào khuấy đều , vừa nấu vừa dùng thìa khuấy nhẹ để các nguyên liệu không dính vào đáy nồi gây khét, tránh đụng khoai vỡ ra nát hết bạn nhé. Khi đã thấy khoai quyện vào nhau hài hòa thì tắt bếp đi bạn nhé. Dùng phần nước cốt dừa thắng lên, nêm thêm muối đường và một ít bột gạo, khi bạn ăn chè thì rưới lên cùng với mè rang bạn nhé.","nutrition":{"kcal":358.4,"protein_g":2.4,"fat_g":10.5,"carbs_g":63.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02cut8m1d5nt0ftx","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot gao","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:khoai so","unlisted_ingredient_phrase:me rang","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:uong cat","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Chè","id":"che","kind":"food_category","baseLabel":"Chè"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02hut8m13ik9766s#variant-1","name":"Cơm tấm sườn cốt lết","detail_name":"Cơm tấm sườn cốt lết","category":"Cơm","age_group":null,"serving":{"raw":"235 g / Dĩa vừa","quantity_value":235,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Cà chua, dưa leo rửa sạch, cắt lát mỏng. Cà rốt, củ cải, rửa sạch, bào sợi, ngâm chua ngọt. Gạo vo sạch nấu cơm. Sườn cốt lết rửa sạch, chần sơ thịt qua nước sôi, rửa lại, để ráo, ướp gia vị, trộn đều, bọc kín, cho vào tủ lạnh. Tiếp theo nướng từng lát thịt trên than hoa đến khi thịt chín vàng đều. Bạn có thể nướng thịt ở lò nướng, ở nhiệt độ 180 độ C, từ 30 – 45 phút, thỉnh thoảng bạn phết đều hỗn hợp nước sốt thịt lên bề mặt để thịt không bị khô. Hành lá bỏ gốc, rửa sạch, cắt nhỏ, phi thơm với dầu ăn. Nước mắm pha chung với chanh đường vừa ăn để tạo hỗn hợp nước chấm. Múc cơm ra dĩa , rưới mỡ hành đã phi lên và cho tiếp sườn lên mặt dĩa, rưới nước mắm pha lên, ăn kèm với cà chua, dưa chuột, cà rốt, củ cải ngâm chua ngọt.","nutrition":{"kcal":573.8,"protein_g":20.2,"fat_g":30.4,"carbs_g":55.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02hut8m13ik9766s","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:chua ngot","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:mam pha","unlisted_ingredient_phrase:ngam chua","unlisted_ingredient_phrase:ngam chua ngot","unlisted_ingredient_phrase:nuoc mam pha"],"source_categories":[{"label":"Cơm","id":"com","kind":"food_category","baseLabel":"Cơm"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02jdt8m14r9yinhm#variant-1","name":"Đậu cô ve (đậu que) xào thịt heo","detail_name":"Đậu cô ve (đậu que) xào thịt heo","category":"Món xào","age_group":null,"serving":{"raw":"85.5 g / Dĩa vừa","quantity_value":85.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đậu cô ve","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, cắt thành miếng mỏng, bản to,ướp với hạt nêm, nước tương và một ít dầu ăn rồi để trong vòng 15 – 20 phút cho thịt bò ngấm gia vị. Đậu que nhặt rồi bẻ khúc ngắn khoảng 2 lóng tay. Rửa sạch rồi trụng qua nước sôi có ngâm chút muối. Chuẩn bị một chiếc chảo vừa, đun sôi 1 muỗng dầu ăn, cho hành tây vào sơ cho đến khi thấy thịt bò trong lại thì cho thịt bò vào xào chung cho đến khi thịt bò săn lại. Ch thịt bò ra chén và tiếp tục sử dụng chảo đó để đun sôi dầu rồi phi thơm tỏi, cho đậu vào xào, nêm nếm gia vị vừa ăn. Xào đều tay cho đậu chín tới rồi cho thịt bò vừa xào lúc nãy vào , đảo đều rồi tắt bếp.","nutrition":{"kcal":324.1,"protein_g":17.2,"fat_g":13,"carbs_g":35.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02jdt8m14r9yinhm","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nuoc tuong","unlisted_ingredient_phrase:thit bo"],"source_categories":[{"label":"Món xào","id":"mon_xao","kind":"food_category","baseLabel":"Món xào"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02nut8m1c6h6zmc3#variant-1","name":"Dồi heo chiên","detail_name":"Dồi heo chiên","category":"Món mặn","age_group":null,"serving":{"raw":"95 g / Dĩa nhỏ","quantity_value":95,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Dồi heo (lợn)","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Bắt chảo lên bếp, cho dầu ăn vào đun nóng, cho dồi vào chiên vàng rồi vớt ra, cắt khoanh vừa ăn.","nutrition":{"kcal":146.4,"protein_g":10.2,"fat_g":10.7,"carbs_g":2.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02nut8m1c6h6zmc3","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Chanh","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02qwt8m1ohe200zd#variant-1","name":"Ếch tần hạt sen","detail_name":"Ếch tần hạt sen","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"50 g / Dĩa nhỏ","quantity_value":50,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Ếch ( thịt đùi)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Tôm khô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nghệ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"\"Gừng cạo, rửa sạch, giã nhỏ, trộn với rượu. Nghệ cạo vỏ, rửa sạch, giã nhỏ, cho vào 1 thìa nước. Ếch rửa sạch, rạch sống lưng, lột da, mổ bỏ ruột, rứa sạch, chặt mỗi con làm 7 miếng, tẩm rượu, gừng rồi bỏ gia vị vào bóp kỹ, ướp 15 phút. Hạt sen tươi luộc chín. Tôm khô bóc vỏ, rứa sạch, để ráo. Hành khô bóc vỏ, đập giập. \"Cho dầu vào chảo, đun nóng già, bỏ hành củ vào phi thơm, trút thịt ếch vào xào cho ngấm gia vị, cho tôm vào xào cùng, đảo đều, khi tôm chín mềm xúc ra bát. Múc ếch đã xào với tôm cho vào nồi nước dùng nấu với hạt sen, đun nhỏ lửa.Tần như vậy chừng 35-45 phút, thịt ếch và hạt sen chín nhừ, nước cạn sánh, nêm nếm lại vừa ăn là được. Múc tất cả ra bát.","nutrition":{"kcal":73.4,"protein_g":8,"fat_g":3.5,"carbs_g":2.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02qwt8m1ohe200zd","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:nuoc dung"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02sqt8m1dk26gkje#variant-1","name":"Gà kho hành gừng","detail_name":"Gà kho hành gừng","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"55 g / Dĩa nhỏ","quantity_value":55,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt gà công nghiệp, đùi","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Gà sau khi rửa sạch, các bạn chặt miếng nhỏ vừa ăn, ướp gia vị, trộn đều vào nhau, ướp trong vòng 15 phút. Hành củ bóc vỏ, băm nhuyễn. Hành lá nhặt sạch, cắt nhỏ. Gừng gọt vỏ, cắt sợi Bắc nồi, cho dầu ăn vào, đun đến nóng già, cho hành, gừng thái sợi vào phi thơm, hơi cháy 1 chút, cho 1 thìa nước mắm vào phi thơm cùng hành, gừng. Cho gà đã ướp vào xào cùng, đảo săn lên. Lưu ý đừng để lửa quá to, gà bị cháy sẽ khô, vị ngọt mềm trong gà cũng bị mất đi. Kho đến khi gà chín mềm, mùi hương ngào ngạt là được, nêm nếm thêm gia vị vừa ăn. Tắt bếp, trút gà ra đĩa.","nutrition":{"kcal":91.5,"protein_g":7.4,"fat_g":5.7,"carbs_g":2.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02sqt8m1dk26gkje","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt gà công nghiệp, đùi","ingredient_not_mentioned_by_name:Đường kính","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03z6t8m16igdcmgn#variant-1","name":"Phở xào thập cẩm","detail_name":"Phở xào thập cẩm","category":"Món khô từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"329 g / Dĩa nhỏ","quantity_value":329,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"170 g","quantity_value":170,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tim heo (lợn)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"