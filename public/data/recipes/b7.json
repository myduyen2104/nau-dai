rtion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Riềng","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Củ đậu","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sơ chế thịt vịt Vịt sau khi làm sạch lông, bỏ đi phần nội tạng không ăn được như lòng già rồi bạn mang vịt đi rửa sạch. Dùng muối hạt chà xát để khử mùi hôi vịt, sau đó rửa lại với nước. Thịt heo rửa với muối, sau đó rửa sạch lại với nước. Đem luộc sơ qua. Kế đến, dùng dao chặt vịt thành từng miếng vừa ăn. Sơ chế các nguyên liệu còn lại Mộc nhỉ ngâm nước nóng, cắt bỏ đầu, rửa sạch lại với nước lạnh, cắt khúc. Hành tím và tỏi bạn bóc vỏ, đập dập rồi băm nhỏ. Củ đậu bóc vỏ, rửa sạch, cắt miếng vừa ăn. Riềng gọt vỏ, rửa sạch rồi giã dập. Rau răm lặt lấy lá non và rửa sạch, để ráo. Ướp thịt vịt và thịt heo Ướp thịt vịt và thịt heo với hạt nêm, tiêu, đường, riềng giã dập, hành tím, tỏi băm nhỏ. Trộn đều để khoảng 30 phút cho thịt vịt thấm gia vị. Xào thịt vịt và thịt heo. Bắc chảo lên bếp, cho dầu vào chảo. Khi dầu nóng thì bạn cho hết phần hành tím, tỏi băm còn lại vào cùng 1 muỗng canh dầu màu điều. Phi đến khi hành, tỏi thơm thì cho toàn bộ thịt vịt, thịt heo vào chảo, để lửa vừa và xào khoảng 10 phút đến khi thịt vịt săn lại. Khi thịt vịt, thịt heo đã săn lại, thêm vào chảo nước cùng với giấm, hạt nêm, nước mắm. Sau đó cho củ đậu, mộc nhỉ vào om khoảng 40 phút để thịt vịt chín mềm và các nguyên liệu quyện vào nhau. Cuối cùng, bạn nêm nếm gia vị lại cho vừa ăn, thêm hành lá là có thể thưởng thức ngay.","nutrition":{"kcal":253.1,"protein_g":12.1,"fat_g":18.8,"carbs_g":8.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05kht8m1qwurlyda","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gừng tươi","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:rau ram","unlisted_ingredient_phrase:uop thit","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]