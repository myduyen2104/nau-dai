 mắm, dầu hào, đường vàng, bột canh rồi đảo đều cho thịt thấm gia vị. Hầm thịt vịt cùng hạt sen nấm đông cô Cho vào nồi thịt vịt nước dừa tươi, nấu sôi sau đó hạ lửa nhỏ, đậy nắp nồi hầm khoảng 45 - 60 phút, trong thời gian hầm bạn nhớ hớt bọt thường xuyên để nước hầm được trong. Tiếp đến, cho hạt sen, nấm hương vào đảo đều. Đậy nắp hầm thêm 15 phút nữa rồi nêm nếm lại cho vừa ăn, cuối cùng rắc thêm hành lá và tắt bếp.","nutrition":{"kcal":215.6,"protein_g":12.1,"fat_g":14.3,"carbs_g":10.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05l9t8m1w8izaz85","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot canh","unlisted_ingredient_phrase:dau hao","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:uop thit","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7ry05oet8m1vhgqq6mg#variant-1","name":"Yến mạch ngâm sữa chua qua đêm (Overnight oats)","detail_name":"Yến mạch ngâm sữa chua qua đêm (Overnight oats)","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"280 g","quantity_value":280,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Ngũ cốc yến mạch ăn liền","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Hạt chia","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"NutiMilk Sữa chua ăn có đường - NutiFood","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Sữa Tươi Tiệt Trùng Vị Tự Nhiên TH true M