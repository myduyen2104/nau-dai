rắng, trộn đều rồi tắt bếp.Xếp mì vắt ra tô, cho bò viên chay, tàu hủ chiên và múc nước dùng cùng ít nấm vào cùng. Cuối cùng nêm ít ngò cắt nhuyễn và tàu hủ ky chiên lên trên. Ăn kèm giá đỗ, rau.","nutrition":{"kcal":444.4,"protein_g":17.7,"fat_g":14.5,"carbs_g":61.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03blt8m1wkpz5h9h","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Mì sợi khô","ingredient_not_mentioned_by_name:Nấm hương tươi","unlisted_ingredient_phrase:bo vien","unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc tuong","unlisted_ingredient_phrase:tau hu ky"],"source_categories":[{"label":"Món nước- chay","id":"mon_nuoc_chay","kind":"food_category","baseLabel":"Món nước- chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03frt8m1lru1azri#variant-1","name":"Mì trứng trộn hải sản","detail_name":"Mì trứng trộn hải sản","category":"Món khô 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"134 g / Dĩa nhỏ","quantity_value":134,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Mì sợi khô","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Mực tươi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tôm biển","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cá quả (cá lóc)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu hà lan","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Tôm mua về rửa sạch, cắt bỏ bớt râu. Mực rửa sạch với muối, rửa lại thật sạch, cắt thành miếng vừa ăn. Cá lóc làm sạch, luộc chín. Hành tây thái múi cau, đậu hà lan cắt khúc vừa ăn. Cà rốt gọt vỏ, rửa sạch, bào sợi. Cho nước vào nồi, bật lửa, nước sôi thì cho tôm mực vào luộc. Đợi nước sôi lại khoảng 3 phút thì tắt lửa, vớt tôm mực ra để nguội. Tôm nguội thì bóc vỏ tôm, lấy đường chỉ đen trên lưng ra. Nước luộc tôm vẫn còn nóng thì cho hành tây và đậu hà lan, cà rốt vào trụng sơ qua với nước nóng. Vớt ra để ráo. Lấy nồi khác cho nước vào nấu sôi để luộc mì. Nước sôi thì cho mì vào luộc, bạn thấy nước sôi lại thì mì chín, vớt mì ra và để ráo. Lấy một chiếc dĩa lớn cho mì lên trên, sau đó xếp hành tây, đậu hà lan, cà rốt đã chần sơ qua lên trên sợi mì, sau cùng là tôm, mực, cá. Trang trí thêm vài cọng ngò rí cho đẹp mắt. Rưới ít nước sốt lên trên.","nutrition":{"kcal":266.2,"protein_g":12,"fat_g":7.9,"carbs_g":37.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6op03frt8m1lru1azri","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Xì dầu","unlisted_ingredient_phrase:bot rau","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô 3-4 tuổi","id":"mon_kho_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03oit8m14ovlp9mu#variant-1","name":"Nấm đông cô xào đậu