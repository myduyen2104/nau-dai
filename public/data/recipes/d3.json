urce_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02hyt8m167fb3x0n#variant-1","name":"Cơm tấm sườn cốt lết","detail_name":"Cơm tấm sườn cốt lết","category":"Cơm 18 tháng đến 18 tuổi","age_group":"18 tháng","serving":{"raw":"347 g / Dĩa vừa","quantity_value":347,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Cà chua, dưa leo rửa sạch, cắt lát mỏng. Cà rốt, củ cải, rửa sạch, bào sợi, ngâm chua ngọt. Gạo vo sạch nấu cơm. Sườn cốt lết rửa sạch, chần sơ thịt qua nước sôi, rửa lại, để ráo, ướp gia vị, trộn đều, bọc kín, cho vào tủ lạnh. Tiếp theo nướng từng lát thịt trên than hoa đến khi thịt chín vàng đều. Bạn có thể nướng thịt ở lò nướng, ở nhiệt độ 180 độ C, từ 30 – 45 phút, thỉnh thoảng bạn phết đều hỗn hợp nước sốt thịt lên bề mặt để thịt không bị khô. Hành lá bỏ gốc, rửa sạch, cắt nhỏ, phi thơm với dầu ăn. Nước mắm pha chung với chanh đường vừa ăn để tạo hỗn hợp nước chấm. Múc cơm ra dĩa , rưới mỡ hành đã phi lên và cho tiếp sườn lên mặt dĩa, rưới nước mắm pha lên, ăn kèm với cà chua, dưa chuột, cà rốt, củ cải ngâm chua ngọt.","nutrition":{"kcal":857.1,"protein_g":29.8,"fat_g":43.4,"carbs_g":87.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02hyt8m167fb3x0n","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:chua ngot","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:mam pha","unlisted_ingredient_phrase:ngam chua","unlisted_ingredient_phrase:ngam chua ngot","unlisted_ingredient_phrase:nuoc mam pha","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Cơm 18 tháng đến 18 tuổi","id":"com_18_thang_den_18_tuoi","kind":"food_category","baseLabel":"Cơm 18 tháng đến 18 tuổi"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02v9t8m1po8a83as#variant-1","name":"Giá hẹ xào thịt heo","detail_name":"Giá hẹ xào thịt heo","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"84.5 g / Dĩa nhỏ","quantity_value":84.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Giá đậu xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hẹ lá","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt mua về các bạn rửa sạch, để ráo. Thái thịt thành miếng mỏng, vừa ăn. Giá đỗ rửa sạch, để ráo. Giá hẹ nhặt rửa sạch, để ráo. Ướp thịt với: hạt nêm, trộn đều, để 20 phút cho ngấm gia vị. - Bắc chảo lên bếp, đun nóng dầu ăn, cho thịt vào xào. - Thịt chín tái cho giá, hẹ vào xào cùng, nêm nếm gia vị vừa ăn, đảo đều. - Khi giá, hẹ chín các bạn tắt bếp. Trút món xào ra đĩa, rắc tiêu xay lên trên. Dọn cùng cơm nóng và canh.","nutrition":{"kcal":86.7,"protein_g":4.3,"fat_g":6.7,"carbs_g":2.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02v9t8m1po8a83as","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02vmt8m19rxbgqct#variant-1","name":"Giá hẹ xào thịt heo","detail_name":"Giá hẹ xào thịt heo","category":"Món xào","age_group":null,"serving":{"raw":"191.5 g / Dĩa nhỏ","quantity_value":191.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Giá đậu xanh","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Hẹ lá","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"75 g","quantity_value":75,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":391.5,"protein_g":20.4,"fat_g":31.6,"carbs_g":6.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02vmt8m19rxbgqct","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món xào","id":"mon_xao","kind":"food_category","baseLabel":"Món xào"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6op03f1t8m1l0k8immt#variant-1","name":"Mì thịt heo","detail_n