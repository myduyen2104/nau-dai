[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tw00c4t8m1gn7d000v#variant-2","name":"Bánh bèo thập cẩm","detail_name":"Bánh bèo thập cẩm","category":"Món khô 5 tuổi","age_group":null,"serving":{"raw":"111 g / Dĩa nhỏ","quantity_value":111,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Bột gạo tẻ","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Bột gạo nếp","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tôm khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Mỡ lợn nước","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"}],"instructions_raw":"Pha hỗn hợp bột gạo tẻ, bột gạo nếp với nước theo tỷ lệ 1 bột : 2 nước, để bột nở khoảng 30 phút, khuấy đều trước khi làm bánh. Cho chén hấp lên xửng hấp, nồi hấp cho nước nhiều và lửa lớn, cho chén nóng đều thì đổ bột vào. Đậy nắp, hấp chín bánh, khi bánh chín vớt ra để nguội. Đậu xanh rửa sạch, ngâm mềm, luộc chín tán nhuyễn để làm nhân bánh bèo. Tôm khô rửa sạch, tán nhuyễn sấy khô rưới lên bánh. Tôm rửa sạch, ướp gia vị, xào chín. Hành lá rửa sạch, để ráo, cắt nhỏ làm mỡ hành. Cho nước sôi vào giữa lòng bột, trộn đều. Sau đó cho phần bột còn lại vào, dùng tay trộn đều cho đến khi bột dẻo, mịn. Bột đã nhào mịn, ngắt một phần nhỏ lăn trong rồi cán dẹt, cho một ít nhân tôm vào giữa gấp đôi miếng bột lại, vuốt chặt mép để giữ miếng bánh hình bán nguyệt. Luộc bánh: Bắt nồi nước lên đun sôi, cho thêm ít dầu ăn và muối, thả bánh vào luộc cho đến khi bánh nổi lên là đã chín. Vớt bánh ra thả vào ngay vào một bát nước nguội, sau đó vớt ra sếp lên đĩa rồi thoa một chút dầu ăn để bánh không bị dính vào nhau. Sắp bánh bèo, bánh bột lọc ra đĩa, thêm nhân đậu xanh lên bánh bèo, rưới tôm khô lên. Thêm mỡ hành, giò lụa, rau chua lên rồi chan nước mắm đã pha vào là thưởng thức.","nutrition":{"kcal":308.1,"protein_g":11.1,"fat_g":8.8,"carbs_g":46.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00c4t8m1gn7d000v","quality_status":"unmatched","warnings":["duplicate_listing_row_occurrence","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh tom","unlisted_ingredient_phrase:bot tron","unlisted_ingredient_phrase:gio lua","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:lam banh","unlisted_ingredient_phrase:nhan tom","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô 5 tuổi","id":"mon_kho_5_tuoi","kind":"food_category","baseLabel":"Món khô 5 tuổi"}],"source_age_group":null,"source_tag_evidence_status":"catalog_capture_unmatched_to_detail"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw016vt8m1n7qfmvht#variant-1","name":"Cá hú/ cá basa kho cà","detail_name":"Cá hú/ cá basa kho cà","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"140.5 g / Dĩa vừa","quantity_value":140.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cá mỡ/cá hú/cá basa","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_un