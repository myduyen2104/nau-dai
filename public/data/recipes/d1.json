_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, cắt miếng vuông. Ướp thịt bò với gia vị vừa đủ. Ớt chuông hành tây rửa sạch, cắt miếng vuông. Bắt chảo lên bếp cho tỏi vào phi thơm, cho ớt chuông, hành tây vào xào xơ, tiếp đến cho thịt bò vào đảo đều, xào lửa lớn, nêm gia vị vừa ăn rồi tắt bếp.","nutrition":{"kcal":102.7,"protein_g":11.3,"fat_g":5,"carbs_g":3.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00qot8m1js5vcyb6","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Ớt xanh to","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Xì dầu","unlisted_ingredient_phrase:uop thit","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00sgt8m1eg8ga37k#variant-1","name":"Bông hẹ xào thịt bò","detail_name":"Bông hẹ xào thịt bò","category":"Món xào","age_group":null,"serving":{"raw":"126.5 g / Dĩa vừa","quantity_value":126.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Bông hẹ","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Bông hẹ rửa sạch để ráo nước, cắt thành những khúc dài vừa ăn. – Thịt bò rửa sạch, thái lát mỏng, cho hạt nêm, muối vào thịt bò rồi trộn đều lên để khoảng 15 – 20 phút – Đun nóng dầu ăn, cho bông hẹ đã sơ chế vào trong chảo xào, cho thêm 1 chút hạt nêm vào rồi xào cho đến khi bông hẹ vừa chín tới thì tắt bếp rồi cho bông hẹ xào ra đĩa. – Dùng chảo xào bông hẹ cho thêm dầu vào trong chảo đun nóng, cho số thịt bò đã ướp vào trong chảo xào lửa to và đảo thật đều tay để thịt bò chín đều và không bị ra nước. . Khi thịt bò vừa chín tới, tắt bếp, cho thịt bò lên trên đĩa bông hẹ vừa xào.","nutrition":{"kcal":95.4,"protein_g":6.3,"fat_g":6,"carbs_g":6.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00sgt8m1eg8ga37k","quality_status":"complete","warnings":[],"integrity_findings":[],"source_categories":[{"label":"Món xào","id":"mon_xao","kind":"food_category","baseLabel":"Món xào"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qu00xit8m1azepxhz1#variant-1","name":"Bún cà ri gà","detail_name":"Bún cà ri gà","category":"Món nước 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"194.5 g / Tô nhỏ","quantity_value":194.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt gà ta","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Khoai lang","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nước cốt dừa, đóng hộp","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cary bột","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt gà rửa sạch và khử mùi bằng cách chà muối lên mình gà, chà thêm một ít gừng giã nhuyễn lên nữa. Sau cùng rửa lại với nước sạch rồi dùng giấy nến hoặc khăn ăn sạch thấm cho ráo nước. Sau khi rửa thịt gà xong thì chặt ra thành miếng nhỏ. Tuy nhiên cũng đừng chặt vụn quá vì như thế dễ làm cho gà trong lúc hầm bị nát. Khi đó thì ăn sẽ không còn ngon nữa. Hành tím thái nhỏ, tỏi đập dập, sả cây đập dập rồi thái nhỏ. Ướp gà Cho gà vào tô ướp gia vị vừa ăn Tiếp theo đó thì bạn trút tất cả tỏi, hành tím, sả băm vừa mới thái nhỏ ở bước trên vào cùng. Thời gian ướp trung bình là 3 tiếng. Nếu không có nhiều thời gian bạn có thể ướp 2 tiếng và nếu có nhiều thời gian hơn thì lý tưởng nhất là ướp 4 – 5 tiếng. Cà rốt và khoai tây thái miếng. Đối với món cà ri thì bạn nên thái to một chút. Luộc cà rốt và khoai tây chín nhưng không quá mềm. Vớt ra và để cho ráo nước. Nấu cà ri Cho một lớp dầu ăn mỏng vào nồi to. Khi dầu đã nóng, bạn cho thịt gà đã ướp và đảo sơ cho nóng rồi cho nước dừa vào. Hầm thịt gà với nước dừa khoảng 30 phút thì cho các loại củ vào hầm cùng. Nếu bạn thấy nước quá cạn thì có thể cho thêm một chút nước ấm nhưng tốt nhất vẫn là nên cho thêm nước dừa. Khi mà thịt gà đã chín thì bạn hạ nhỏ lửa lại, hầm thêm chút nữa cho nước cà ri sắc và thật thấm, đậm vị thì tắt bếp.","nutrition":{"kcal":286.3,"protein_g":10.6,"fat_g":10.6,"carbs_g":37.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qu00xit8m1azepxhz1","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Cary bột","ingredient_not_mentioned_by_name:Rau thơm","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:khoai tay","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:tuong nhat","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước 3-4 tuổi","id":"mon_nuoc_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv010ot8m1tqlpzmvu#variant-1","name":"Bún riêu chay","detail_name":"Bún riêu chay","category":"Món nước chay từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"434.5 g / Tô nhỏ","quantity_value":434.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"200 g","quantity_value":200,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Đậu tương (đậu nành)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Đậu phụ tươi, đậu phụ non rửa sạch, để ráo, đậu phụ non cắt thành từng miếng vuông vừa ăn, cho 2 thứ vào âu riêng. Bóp nhuyễn đậu phụ tươi, thêm canh tương đậu nành, muối, đường và trộn đều. Cà chua rửa sạch, cắt múi cau. Các loại rau ăn kèm, làm sạch, để ráo. Hành boa rô rửa sạch, phần đầu đập dập, phần lá cắt nhỏ.Chuẩn bị chảo dầu nóng, trút đậu phụ non đã cắt miếng vuông vào chiên vàng rồi vớt ra đĩa. Đặt chảo lên bếp, đun nóng một ít màu dầu điều, phi thơm đầu hành.Cho lần lượt cà chua, củ cải trắng, một chút hành boa rô đã sơ chế vào xào chín cùng 1 ít muối, đường, xào đều tay. Tiếp tục dùng lại chảo đó, đun nóng ít dầu, cho đậu phụ đã bóp nát vào xào chung với một ít muối. Xào khoảng 5 – 7 phút, tiếp tục cho bột mì vào, đảo đều. Bột mì có tác dụng kết dính để khi đun sẽ tạo thành mảng riêu nổi lên bề mặt. Khi thấy rau củ quả hầm đã chín mềm, tiến hành vớt bỏ bã, lọc lại nước dùng.Sau đó, cho hỗn hợp rau củ đã xào cùng đậu phụ chiên vào và nấu khoảng 15 phút. Nêm vào nồi nước dùng một ít giấ, dùng muỗng múc từng muôi hỗn hợp đậu phụ riêu cua thả vào nồi nước dùng, đun lửa nhỏ để mảng riêu đậu phụ nổi lên bề mặt. Nêm nếm lại gia vị cho vừa ăn, thêm một ít hành boa rô cắt nhỏ vào và tắt bếp. Khi ăn, bạn gắp một ít bún vào tô lớn, chan nước dùng có lẫn cà chua, đậu phụ, nấm các loại và múc một ít riêu đậu phụ, rắc thêm một ít hành boa rô, rau mùi cắt nhỏ. Dùng nóng với các loại rau ăn kèm.","nutrition":{"kcal":446.7,"protein_g":19.6,"fat_g":11.6,"carbs_g":66.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv010ot8m1tqlpzmvu","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nấm rơm","unlisted_ingredient_phrase:cai trang","unlisted_ingredient_phrase:cu cai trang","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:rau mui"],"source_categories":[{"label":"Món nước chay từ 8-18 tuổi","id":"mon_nuoc_chay_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước chay"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p