],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:bot nem","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào","id":"mon_xao","kind":"food_category","baseLabel":"Món xào"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo034lt8m18cx8sc6v#variant-1","name":"Lạp xưởng chiên","detail_name":"Lạp xưởng chiên","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"35 g / Dĩa vừa","quantity_value":35,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":null,"instructions_raw":"Chuẩn bị một chiếc chảo chống dính, xếp lạp xưởng vào trong chảo. Đổ nước lọc vào chảo đến khi mặt nước ngập xâm xấp mặt lạp xưởng. Mục đích của việc đổ nước nhiều như vậy là để lạp xưởng không bị tiếp xúc nhiều với đáy chảo, tránh bị cháy xém trong quá trình chiên lăn nước. Bật bếp lên ở mức lửa vừa rồi vừa đun, vừa đảo đều lạp xưởng cho thấm. Bạn cứ đun cho tới khi nước trong chảo cạn gần hết thì bắt đầu đảo liên tục. Tiếp tục đảo cho tới khi lạp xưởng chảy mỡ ra bên ngoài, vỏ lạp xưởng chuyển sang màu vàng cánh gián đẹp mắt thì tắt bếp. Bày biện lạp xưởng ra đĩa, trang trí tùy thích rồi cùng gia đình thưởng thức. Cách chiên lạp xưởng ngon đúng điệu bằng nước dừa","nutrition":{"kcal":204.8,"protein_g":7.3,"fat_g":19.3,"carbs_g":0.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oo034lt8m18cx8sc6v","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","listing_count_not_visible_in_detail","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:lap xuong","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:nuoc loc"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag