g_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05m1t8m1z92da3h2#variant-1","name":"Xíu mại kho cà","detail_name":"Xíu mại kho cà","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"71 g / Dĩa nhỏ","quantity_value":71,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thịt eo rửa sạch, xay nhuyễn Cà chua rửa sạch, bỏ hạt, cắt hạt lựu nhỏ Mộc nhĩ ngâm mềm, rửa sạch, cắt nhỏ. Tỏi bó vỏ, băm nhuyễn Cho thịt xay, tỏi, mộc nhĩ, gia vị vào tô, trộn đều. Lấy 1 cái đĩa lớn, thoa một lớp dầu ăn lên bề mặt đĩa để khi hấp thịt không bị dính. Sau đó lấy hỗn hợp thịt ở trên viên thành những viên tròn vừa ăn, xếp thịt viên lên đĩa, thực hiện đến khi hết thịt. Cho thịt vào hấp khoảng 10 phút cho chín. Bắc chảo lên bếp,phi thơm tỏi. Tiếp đó cho cà chua vào đảo kỹ, rồi cho phần sốt cà chua và phần nước khi hấp thịt vào cùng. Nêm nếm vừa ăn, cho những viên thịt đã hấp chín vào đảo đều, đun nhỏ lửa cho thịt ngấm sốt và đến khi nước sốt sền sệt là được. Tắt bếp, cho thịt ra đĩa cùng với nước sốt sau đó rắc xíu hành lá, rau mùi lên trên là được.","nutrition":{"kcal":209.1,"protein_g":8.7,"fat_g":17.1,"carbs_g":5.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05m1t8m1z92da3h2","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_