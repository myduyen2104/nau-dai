[{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00ypt8m1od209060#variant-1","name":"Bún gạo xào thập cẩm","detail_name":"Bún gạo xào thập cẩm","category":"Món khô 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"117 g / Dĩa nhỏ","quantity_value":117,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Bún khô","quantity_raw":"45 g","quantity_value":45,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Trứng cút (10g/quả)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Bún khô ngâm mềm, vớt để ráo nước. Cắt khúc vừa ăn. Thịt heo rửa sạch, băm nhuyễn, tôm bóc vỏ, lấy chỉ đen, băm nhuyễn, ướp gia vị. Trứng cút luộc chín, bóc vỏ. Cà rốt gọt vỏ, rửa sạch, bào sợi. Giá đậu xanh rửa sạch, để ráo nước. Nấm rơm rửa sạch, cắt nhỏ. Bắt chảo lên bếp, thêm dầu, thêm hành tỏi băm phi thơm, rồi cho thịt heo, tôm vào đảo đều, thêm cà rốt, nấm rơm, giá đậu xanh vào xào chín. Thêm bún khô vào trộn đều, thêm gia vị vừa ăn đảo đều cho chín rồi tắt bếp.","nutrition":{"kcal":291.9,"protein_g":10.4,"fat_g":10.9,"carbs_g":38.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00ypt8m1od209060","quality_status":"complete","warnings":[],"integrity_findings":[],"source_categories":[{"label":"Món khô 3-4 tuổi","id":"mon_kho_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00zqt8m13a5zhv7h#variant-1","name":"Bún măng chua chay","detail_name":"Bún măng chua chay","category":"Món nước- chay","age_group":null,"serving":{"raw":"423.3 g / Tô nhỏ","quantity_value":423.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"220 g","quantity_value":220,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Tàu hủ ky khô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Măng chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Cà chua bỏ cuống, rửa sạch rồi bổ dọc hình múi cau. Măng chua đem rửa sạch lại với nước để bớt chua. Hành lá cắt bỏ phần gốc, lá úa hỏng rồi thái nhỏ. Rau muống , rau thơm rửa sạch, nhặt bỏ phần hư. Đậu hũ rửa sạch, cắt thành từng khối vuông nhỏ. Nấm rơm đem rửa sạch rồi để ráo nước, cắt bỏ chân. Bắc nồi lên bếp, thêm một chút dầu chay vào rồi đun sôi già thì cho phần sả đập dập cắt khúc vào. Tiếp đó cho vào nấm phi thơm lên. Cho tiếp cà chua vào đảo đều tay cho tới khi hỗn hợp mềm, tiếp tục đảo đều rồi nêm nếm một ít gia vị.Tiếp theo cho măng chua và rau muống vào nồi xào chung với cà chua. Khi măng đã ngấm gia vị, đổ thêm nước lọc vào nồi. Việc cho nước vào nồi canh măng chua có thể điều chỉnh nhiều ít tùy vào lượng người ăn để cho sao phù hợp nhất. Sau đó, đun sôi nồi nước với lửa vừa. Trong lúc đun sôi nước thì trụng sơ bún qua nước sôi rồi vớt ra rửa lại với nước lạnh. Sau cùng, bỏ đậu hũ vừa xắt nhỏ vào nấu cùng khoảng 5 phút, thêm đầu hành thái nhỏ, chút ớt tiêu vào làm đậm vị đảo đều rồi tắt bếp. Cho bún ra tô rồi bỏ cái vào trước, sau đó múc nước dùng vào. Thưởng thức kèm với rau thơm","nutrition":{"kcal":456.8,"protein_g":19.2,"fat_g":12.9,"carbs_g":66.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00zqt8m13a5zhv7h","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tàu hủ ky khô","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:chua co","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước- chay","id":"mon_nuoc_chay","kind":"food_category","baseLabel":"Món nước- chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw018xt8m1lc7bt1cz#variant-1","name":"Cá lóc xào hành nấm","detail_name":"Cá lóc xào hành nấm","category":"Món mặn","age_group":null,"serving":{"raw":"174 g / Dĩa vừa","quantity_value":174,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cá quả (cá lóc)","quantity_raw":"120 g","quantity_value":120,"quantity_unit":"g"},{"name":"Nấm hương tươi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_