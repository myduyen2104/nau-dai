[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tw00cxt8m1pr56xdsj#variant-1","name":"Bánh canh chay","detail_name":"Bánh canh chay","category":"Món nước chay từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"469.5 g / Tô nhỏ","quantity_value":469.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh canh tươi","quantity_raw":"200 g","quantity_value":200,"quantity_unit":"g"},{"name":"Tàu hủ ky khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Ngô bắp tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Su su","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bánh canh cho vào nồi hoặc tô lớn tùy thích, đổ nước đun sôi vừa đủ, trụng sơ bánh canh rồi vớt ra rổ để ráo nước. Tàu hủ ky: cắt thành sợ hoặc cắt miếng cho vừa ăn và đẹp mắt. Đậu hũ tươi: cắt miếng vừa ăn và chiên giòn. Nấm làm sạch, cắt đôi. Cà rốt, củ cải trắng, su su gọt vỏ, làm sạch, cắt miếng. Bắp mĩ cắt miếng nhỏ theo khoanh tròn khoảng 2cm. Hành, ngò rí làm sạch, cắt nhỏ. Nước dùng: Lấy 2 lít nước dùng, đun sôi cùng với cà rốt, củ cải trắng, su su, bắp mỹ để lấy chất ngọt tự nhiên từ rau, củ. Lấy tàu hủ đã cắt sẵn, nấm rơm đem xào sơ qua cùng với một chút dầu điều cho màu sắc đẹp mắt, nêm hạt nêm chay, tiêu. Khi nước dùng đã sôi cho nấm rơm đã phi thơm vào, sau đó cho thêm hạt nêm chay, bột ngọt, đường, muối, nếm thử theo khẩu vị và tắt bếp.Cho bánh canh vào tô, có thể thêm giá sống hoặc trụng bên dưới tùy sở thích. Múc nước dùng đã nấu cho vào tô, thêm poa-rô đã phi thơm, tàu hũ ky, hành, ngò rí, ớt, một chút tiêu, chanh… tùy theo sở thích.","nutrition":{"kcal":453.7,"protein_g":18.3,"fat_g":11,"carbs_g":70.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00cxt8m1pr56xdsj","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ chiên","unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:chien gion","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:tu nhien"],"source_categories":[{"label":"Món nước chay từ 8-18 tuổi","id":"mon_nuoc_chay_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước chay"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00n2t8m1ruo3hsi6#variant-1","name":"BBGP-18-24M-Mì Soba bò bằm","detail_name":"BBGP-18-24M-Mì Soba bò bằm","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"70.1 g","quantity_value":70.1,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Mì Soba Tươi Sợi Tròn","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt bò, lưng, nạc","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Bí đỏ (bí ngô)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Cải thìa/cải trắng","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường cát","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Mì sợi khô ngâm với nước ấm cho mềm, vớt ra để ráo, trộn với dầu ăn cho khỏi dính. Thịt bò rửa sạch, băm nhuyễn, ướp gia vị. Cà rốt gọt vỏ, rửa sạch, thái sợi. Bắt chảo lên bếp, thêm dầu ăn, tỏi phi thơm rồi thêm cà rốt vào đảo đều, thêm thịt bò vào xào chín, Nêm gia vị vừa ăn. Thêm mì vào đảo đều rồi tắt bếp.","nutrition":{"kcal":116.8,"protein_g":3.7,"fat_g":2.5,"carbs_g":1.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00n2t8m1ruo3hsi6","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Cà chua","ingredient_not_mentioned_by_name:Hành tây","ingredient_not_mentioned_by_name:Bí đỏ (bí ngô)","ingredient_not_mentioned_by_name:Cải thìa/cải trắng","ingredient_not_mentioned_by_name:Hành lá (hành hoa)","ingredient_not_mentioned_by_name:Đường cát","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:mi soi kho","unlisted_ingredient_phrase:soi kho","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw014jt8m1d9kptzf0#variant-1","name":"Cá chim chiên","detail_name":"Cá chim chiên","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"115 g / Dĩa vừa","quantity_value":115,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cá chim","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cá mua về dùng dao cạo nhẹ cho sạch nhớt và vảy cá, rửa sạch cá với muối , để ráo. Tỏi băm nhuyễn. Đặt chảo lên bếp cho dầu ăn vào, kế tiếp thả cá vào chiên cho chín vàng đều trở cá cho chín 2 mặt. Pha hỗn hợp nước mắm gồm tỏi băm, chanh, đường nước mắm và nước sôi để nguội đánh tan hỗn hợp trên. Sau cùng vớt cá ra dĩa là dùng được.","nutrition":{"kcal":201.9,"protein_g":17.9,"fat_g":11.4,"carbs_g":7.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw014jt8m1d9kptzf0","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá chim","title_ingredient_not_mentioned:Cá chim","unlisted_ingredient_phrase:hon hop","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qy01iyt8m15bbfl019#variant-1","name":"Canh cải bó xôi nấu tôm","detail_name":"Canh cải bó xôi nấu tôm","category":"Món canh 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"51.5 g / Chén","quantity_value":51.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cải bó xôi","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Cải bó xôi rửa sạch để ráo sau đó vò nát. Tôm lột vỏ, rửa sạch với nước muối, vớt ra, để ráo, băm nhỏ. Bắc nồi lên, cho dầu ăn vào, phi tỏi cho thơm, cho tôm vào xào xơ Cho nước vào, đun sôi, vớt bọt. Tiếp đến cho cải bó xôi vào Nêm nếm vừa ăn, tắt bếp.","nutrition":{"kcal":28.4,"protein_g":3,"fat_g":1.4,"carbs_g":1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qy01iyt8m15bbfl019","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh 25-35 tháng tuổi","id":"mon_canh_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01oot8m1pbdim0cc#variant-1","name":"Canh hẹ nấm đậu hủ","detail_name":"Canh hẹ nấm đậu hủ","category":"Món canh chay","age_group":null,"serving":{"raw":"141.5 g / Chén","quantity_value":141.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Hẹ lá","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Nấm rửa sạch cắt nhỏ. Hẹ lá rửa sạch cắt khúc. Đậu hũ cắt miếng vuông. Bắc nồi lên bếp, cho nước vào cùng với muối, hạt nêm, đường, nấu sôi dưới lửa lớn.Sau đó, bạn cho đậu hũ, nấm, hẹ lá vào, vặn nhỏ lửa lại nấu chín nguyên liệu. Khi canh gần chín,nêm nếm gia vị lại 1 lần nữa rồi tắt bếp.\"","nutrition":{"kcal":52.6,"protein_g":5.1,"fat_g":1.9,"carbs_g":3.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01oot8m1pbdim0cc","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nấm rơm","ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nguyen lieu","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh chay","id":"mon_canh_chay","kind":"food_category","baseLabel":"Món canh chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01pdt8m1gb86q0n8#variant-1","name":"Canh khổ qua nhồi đậu hủ nấm","detail_name":"Canh khổ qua nhồi đậu hủ nấm","category":"Món canh chay 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"141.5 g / Chén","quantity_value":141.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Khổ qua (mướp đắng)","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Đậu phụ (đậu hũ)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Khổ qua móc bỏ ruột, ngâm muối rửa sạch với nước, đem cắt mỗi trái thành khoanh tròn kích thước bằng nhau. Đun sôi 1 nồi nước, cho khổ qua vào luộc sơ 2 phút sau đó vớt ra xả ngay vào nước lạnh. Trộn nhân nhồi khổ qua gồm đậu hũ trắng bóp nhuyễn, chắt nước, nấm băm nhuyễn, hành barô cùng tiêu và hạt nêm chay nấm hương, sau đó nhồi nhân vào khổ qua, dùng tay ém chặt. Đun sôi 1l nước, sau đó nhẹ nhàng thả từng khoanh khổ qua vào nồi, nấu trong 20 phút, khi khổ qua đã mềm, nêm gia vị với muối, đường và hạt nêm chay nấm hương, khuấy đều rồi tắt bếp.","nutrition":{"kcal":51.6,"protein_g":3.8,"fat_g":1.9,"carbs_g":5.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01pdt8m1gb86q0n8","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","ingredient_not_mentioned_by_name:Nấm rơm","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nam huong","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh chay 8-18 tuổi","id":"mon_canh_chay_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh chay"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01y1t8m1gqmfxifm#variant-1","name":"Canh súp lơ xanh nấu tôm","detail_name":"Canh súp lơ xanh nấu tôm","category":"Món canh 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"83.8 g / Chén","quantity_value":83.8,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Súp lơ xanh","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Ngâm súp lơ với 1 ít muối, sau đó rửa sạch lại bằng nước lạnh thông thường. Phần bông dùng dao tách lần lượt từng nhánh, phần thân gọt lớp vỏ cứng bên ngoài sau đó cắt miếng vừa ăn. Tôm rửa sạch, lột sạch vỏ, sau đó tách đầu tôm để riêng. Giã nhuyễn phần thân để phần nước canh được ngọt hơn. Tiếp theo cho dầu ăn vào phi thơm hành tím cùng với đầu tôm và thân tôm giã nhuyễn. Nêm một ít gia vị vào xào chung. Khi tôm đã chín đều thì cho nước vào nấu sôi. Khi nước sôi, bạn hớt bớt phần bọt để cho nước canh được trong hơn. Nêm nếm gia vị cho vừa ăn nhé. Cuối cùng cho súp lơ đã cắt vào nấu cho đến khi sôi lại, sôi được thêm 2 phút thì tắt bếp rồi rắc thêm một ít tiêu, hành lá.","nutrition":{"kcal":45.4,"protein_g":3.9,"fat_g":1.4,"carbs_g":4.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01y1t8m1gqmfxifm","quality_status":"needs_review","warnings":["recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Súp lơ xanh","title_ingredient_not_mentioned:Súp lơ xanh"],"source_categories":[{"label":"Món canh 6-7 tuổi","id":"mon_canh_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt021bt8m158dkk271#variant-1","name":"Cháo bồ câu hạt sen bí đỏ","detail_name":"Cháo bồ câu hạt sen bí đỏ","category":"Cháo 9-12 tháng tuổi","age_group":"9-12 tháng","serving":{"raw":"65 g / Chén","quantity_value":65,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Thịt bồ câu ra ràng","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bí đỏ (bí ngô)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":"* Chim bồ câu sau khi mua về thì dùng nước chanh pha chút muối chà sát lên toàn bộ thịt chim và để khoảng 5 phút thì rửa lại thật sạch với nước. Sau đó, chặt bỏ phần chân chim và lọc để lấy phần thịt 2 bên đùi và lườn đem đi băm nhuyễn. * Bí đỏ gọt vỏ, bỏ hột, rửa sạch. Hạt sen rửa sạch, tách bỏ tim sen. Bí đỏ và hạt sen luộc với 1 chén nước cho đến khi bí và hạt sen mềm, vớt ra để nguội rồi tán nhuyễn. * Hòa tan nạc bồ câu với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng , bắc lên bếp khuấy đều cho đến khi sôi, thêm bí đỏ và hạt sen vào nấu chín. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":182.6,"protein_g":6.9,"fat_g":7.8,"carbs_g":21.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt021bt8m158dkk271","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Bí đỏ (bí ngô)","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Cháo 9-12 tháng tuổi","id":"chao_9_12_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"9-12 tháng","id":"9_12_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu028tt8m1mgxgoyhj#variant-1","name":"Cháo thịt heo mồng tơi","detail_name":"Cháo thịt heo mồng tơi","category":"Cháo 7-8 tháng tuổi","age_group":"7-8  tháng","serving":{"raw":"70 g / Chén","quantity_value":70,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Rau mồng tơi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"* Thịt heo cắt bỏ gân trắng, rửa sạch, băm nhuyễn. * Mồng tơi chọn lá non, mềm, rửa sạch, cắt bỏ sống lá, lấy lá cắt nhỏ băm nhuyễn. * Hòa tan thịt heo với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng, bắc lên bếp khuấy đều cho đến khi sôi, thêm mồng tơi vào cho sôi lại. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":219.3,"protein_g":7.1,"fat_g":14,"carbs_g":16.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu028tt8m1mgxgoyhj","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam"],"source_categories":[{"label":"Cháo 7-8 tháng tuổi","id":"chao_7_8_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"7-8  tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02cst8m1dmmv4ydl#variant-1","name":"Chè nếp đậu trắng","detail_name":"Chè nếp đậu trắng","category":"Chè","age_group":null,"serving":{"raw":"122 g / Chén","quantity_value":122,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đậu trắng hạt (đậu tây)","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Gạo nếp máy (loại thường)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"\"Ngâm đậu cùng muối trong khoảng vài tiếng, rồi rửa sạch vớt ra. Làm như vậy đậu khi nấu sẽ mau mềm, chè ăn sẽ tan ngày trong miệng. Sau đó tiếp tục cho đậu vào nồi cùng với nước rồi luộc. Cho thêm muối cho vào để đậu có vị bùi bùi ngon hơn. Thời gian luộc trong khoảng 40 phút và luộc với lửa nhỏ để đậu không bị nứt. Canh chừng cho đến khi đậu mềm thì tắt lửa rồi vớt ra. Tiếp theo là rửa sạch nếp, để cho có độ nhựa độ dẻo hơn thì cho muối vào trong nếp & ngâm. Cho nước cốt dừa vào ngâm trong khoảng 15 phút để cho hạt nếp béo và dẻo hơn. Trong khi chờ đợi nếp thì tranh thủ làm nước cốt. Lấy nước cốt đặc & nước cốt loãng cùng đường phèn & muối hòa tan vào nhau. Tiếp theo lấy bột năng, bột gạo và ba thìa canh nước cốt hòa vào nhau để tạo độ sánh. Nấu hỗn hợp này trên lửa nhỏ để nước cốt được béo & sánh lại. Sau khi gạo nếp đã ngâm xong thì nấu chín. Cho đường phèn vào và khuấy đều cho tan. Sau đó đậu trắng cho vào nấu cùng với xôi. Khuấy cho nếp cùng đậu hòa quyện vào nhau, đậu mềm, xôi nếp dẻo là hoàn tất. Khi nào ăn thì bạn hãy múc chè đậu trắng ra chén, sau đó rưới vào nước cốt dừa rồi thưởng thức.\"","nutrition":{"kcal":451.3,"protein_g":11,"fat_g":10.1,"carbs_g":79.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02cst8m1dmmv4ydl","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot gao","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:uong phen","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Chè","id":"che","kind":"food_category","baseLabel":"Chè"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02dlt8m1edcoj2xj#variant-1","name":"Chim bồ câu nhồi cốm hấp","detail_name":"Chim bồ câu nhồi cốm hấp","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"34 g / Dĩa nhỏ","quantity_value":34,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bồ câu ra ràng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Chả heo (lợn)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Cốm","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cách làm: Bước 1: Bồ câu đem làm sạch, bỏ đầu đi và rút xương. Trước tiên bạn thực hiện xẻ dọc một đường ở giữa lưng con bồ câu, rồi dọc theo xương lưng dùng dao cắt phần xương sống ra khỏi thịt. Bạn dùng tay đẩy xương cánh, xương đùi lòi ra rồi cắt từ từ. Bước 2: Cà rốt đem đi thái nhỏ, phần hạt sen cần luộc chín mềm. Để hạt sen nhanh chín, trước khi luộc, bạn chú ý ngâm với nước ấm. Nâm hương ngâm nước nóng, cắt đuôi, thái mỏng, băm nhuyễn Bước 3: Cho cốm, hạt sen , nấm hương vào thịt lợn xay, ướp gia vị, nhồi vào thân chim bồ câu rồi đem hấp chín trong tủ nấu cơm khoảng 10 phút, sau đó dùng dây buộc cho thật chặt thân chim rồi đem rán vàng. Bước 4: Khi chim bồ câu chín, bạn đem thái khoanh.","nutrition":{"kcal":90.4,"protein_g":2.9,"fat_g":6.6,"carbs_g":5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02dlt8m1edcoj2xj","quality_status":"needs_review","w