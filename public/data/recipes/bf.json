ông để rách da. Hạt sen hầm nhừ. Thịt lợn, mề, gan gà rửa sạch, băm nhỏ. Nấm hương ngâm nước nhặt rửa sạch băm nhỏ, hành, tỏi bóc vỏ băm nhỏ.\" \"Trộn đều các thứ trên rồi nêm gia vị cho vừa, nhồi vào bụng chim khâu kín lại, nhồi vừa phải để khỏi vỡ. Lau khô da chim rồi quét đều khắp mạch nha hòa chút nước sôi, để 15 phút cho khô, rồi lại bôi tiếp lần nữa để khô. Cho dầu vào chảo để nóng già, treo con chim phía trên chảo, múc dầu sôi từ từ lên chim để khỏi nử bụng, sau đó bỏ vào chảo rán đều khi nhân chín vớt ra. sau đó lại chao lại lần thứ hai bằng dầu thật nóng để tạo mẫu đẹp, vớt ra để nguội, cahwjt miếng bày vào đĩa.\"","nutrition":{"kcal":189.9,"protein_g":8.4,"fat_g":12.9,"carbs_g":10.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02dwt8m106s8wxpp","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gừng tươi","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:nam huong","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02mdt8m1dc6ukrf8#variant-1","name":"Đậu hủ non thịt bằm sốt cà chua","detail_name":"Đậu hủ non thịt bằm sốt cà chua","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"79 g / Dĩa nhỏ","quantity_value":79,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Đậu phụ (đậu hũ)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g",