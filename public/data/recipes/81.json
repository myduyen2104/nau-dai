":35.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu024st8m1r9b43ocj","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Gừng tươi","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02cpt8m1j7bgrlvw#variant-1","name":"Chè mè đen","detail_name":"Chè mè đen","category":"Chè","age_group":null,"serving":{"raw":"80 g / Chén","quantity_value":80,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Vừng (đen, trắng)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Mè đen sau khi mua về nhặt sạn, bỏ tạp chất và hạt bị hư. Cho mè đen lên chảo rang trong 5 phút cho mè thơm rồi tắt bếp.Cho mè vào máy xay sinh tố cùng với nước dừa tươi xay nhuyễn rồi đổ ra ray lọc (có lỗ nhỏ) để chè được mịn hơn.Cho vào nồi thêm nước lọc, kế đến cho bột sắn dây vào khuấy đều cho bột tan hết. Sau đó cho tiếp đường phèn đập nhỏ vào đun với lửa vừa cho đến khi tạo thành một hỗn hợp sền sệt thì cho gừng vào.Đổ nước mè đen vào nồi đun cho đến khi hỗn hợp sôi lăn tăn và sánh lại thì tắt bếp.","nutrition":{"kcal":349,"protein_g":6,"fat_g":18.1,"carbs_g":40.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02cpt8m1j7bgrlvw","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Vừng (đen, trắng)","unlisted_ingredient_phrase:bot san","unlisted_ingredient_phrase:bot san day","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc dua","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:san day","unlisted_ingredient_phrase:uong phen","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Chè","id":"che","kind":"food_category","baseLabel":"Chè"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02d5t8m1x9qojrba#variant-1","name":"Chè thưng","detail_name":"Chè thưng","category":"Chè (18 tháng trở lên)","age_group":"18 tháng","serving":{"raw":"110 g / Chén","quantity_value":110,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đậu xanh (đậu tắt)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Khoai lang nghệ","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Khoai môn","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Táo tàu khô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"\"Trước tiên cần dùng nước nóng ngâm đậu xanh, đậu phộng, táo tàu ngâm riêng từng món. Lá dứa cũng đem rửa sạch rồi cuộn lại cho gọn. Khoai lang và khoai môn rửa sạch, gọt vỏ rồi cắt hạt lựu. Nấu nồi nước, cho đậu xanh, đậu phộng, khoai vào ninh. Đến khi đậu xanh, đậu phộng, khoai lang mềm thì vớt ra. Nếu thấy nước còn ít thì thêm chút nước lọc vào rồi tiếp tục nấu đến khi nước sôi. Nước sôi cho lá dứa vào, sau đó tiếp tục cho đậu xanh, đậu phộng, hạt sen, khoai lang vào khuấy đều. Cho bột năng đã hòa tan vào, khuấy đều tay, vặn lửa nhỏ lại. Ccho nước cốt dừa vào, nêm đường, chút muối và vani cho thơm. Khi nào thấy chè sánh lại vừa thì tắt bếp. Múc ra chén rồi rắc thêm ít dừa nạo trang trí, chén chè đã sẵn sàng.\"","nutrition":{"kcal":339.5,"protein_g":7,"fat_g":11.7,"carbs_g":52.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02d5t8m1x9qojrba","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:hat sen","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:nuoc loc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Chè (18 tháng trở lên)","id":"che_18_thang_tro_len","kind":"age_scoped_food_category","baseLabel":"Chè"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02h8t8m183gemfu4#variant-1","name":"Cơm muối mè","detail_name":"Cơm muối mè","category":"Cơm","age_group":null,"serving":{"raw":"105.2 g / Dĩa","quantity_value":105.2,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Vừng (đen, trắng)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Gạo vo sơ cho loại bỏ bụi bẩn, cho vào nồi cơm điện đổ nước nhiều hơn 1 chút xíu so với việc nấu cơm thông thường rồi đem nấu chín. Đậu đen rang chín, để nguội rồi chà xát để loại bỏ vỏ, đem đi giã nhỏ. Cơm sau khi nấu chín thì múc ra khăn sạch đã dấp nước cho ẩm và vắt kỹ. Cuộn chặt khăn lại nhào kỹ nắm cơm cho tới khi được một khối dền, mịn. Để cho cơm nguội.Mè đem rang chín rồi trộn đều với đậu đen và muối.Cơm khi đã nguội dùng dao cắt miếng vừa ăn. Chấm kèm muối mè.","nutrition":{"kcal":436.9,"protein_g":13,"fat_g":14.2,"carbs_g":64.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02h8t8m183gemfu4","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phộng (lạc hạt)","ingredient_not_mentioned_by_name:Vừng (đen, trắng)","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Cơm","id":"com","kind":"food_category","baseLabel":"Cơm"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02ikt8m1di3mb1xg#variant-1","name":"Cua sốt me","detail_name":"Cua sốt me","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"69 g / Dĩa nhỏ","quantity_value":69,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cua bế","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cua biển rửa sạch, để ráo, luộc chín, gỡ lấy thịt cua. Hành củ tươi bóc vỏ rửa sạch, bằm nhỏ. Hành lá rửa sạch bỏ rể, cắt nhỏ. Me hòa chung với nước ấm. Bắt chảo lên bếp thêm một ít dầu ăn, cho hành củ đã băm nhỏ vào phi thơm. Cho