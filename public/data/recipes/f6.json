[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tw00dct8m13y0shzjn#variant-1","name":"Bánh canh giò heo","detail_name":"Bánh canh giò heo","category":"Món nước 5 tuổi","age_group":"5 tuổi","serving":{"raw":"247.3 g / Tô nhỏ","quantity_value":247.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh canh tươi","quantity_raw":"130 g","quantity_value":130,"quantity_unit":"g"},{"name":"Chân giò heo (lợn)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Sơ chế các nguyên liệu khác Giò heo, thịt nạc chân giò cạo sạch lông, rửa sạch với muối. Cà rốt, củ cải gọt vỏ, rửa sạch, cắt khúc. Nấu nước dùng Xương lợn chần qua nước sôi, rửa sạch rồi cho vào nồi nước lạnh ninh lấy nước dùng cùng với giò heo và thịt chân giò cùng với củ cải và cà rốt vào. Phi hành thơm vào nồi và đổ nước hầm xương vào. Sau đó thịt chân giò mềm vớt ra cắt lát mỏng. Xếp bánh canh ra bát, cho thịt chân giò và giò heo vào,. Chan nước dùng rồi rắc hành, mùi, hạt tiêu lên trên và thưởng thức ăn kèm với giá.","nutrition":{"kcal":357.6,"protein_g":12.7,"fat_g":15.7,"carbs_g":41.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00dct8m13y0shzjn","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hat tieu","unlisted_ingredien