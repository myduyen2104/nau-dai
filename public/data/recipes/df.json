ity_unit":"g"}],"instructions_raw":"Cá diêu hồng làm sạch, để ráo, ướp gia vị. Miến, mộc nhĩ ngâm nở, miến cắt khúc dài và mộc nhĩ cắt sợi chỉ. Hành lá, cần tây rửa sạch cắt nhuyễn. Hành tây bóc vỏ, cùng cà chua rửa sạch, bổ múi cau. Trải mộc nhĩ xuống dưới cùng rồi cho cá đã ướp lên, trên cùng là miến, hành tây, cà chua, sau cùng là đậu tương. Hấp cá đến khi cá chín thì cho hành lá, cần tây lên trên mặt cá. Cá hấp dùng nóng với cơm.","nutrition":{"kcal":91.3,"protein_g":7.7,"fat_g":3.8,"carbs_g":6.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw013zt8m1ku9o3dha","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá chép","ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","title_ingredient_not_mentioned:Cá chép","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw015et8m1hxyal40o#variant-1","name":"Cá điêu hồng chiên","detail_name":"Cá điêu hồng chiên","category":"Món mặn","age_group":null,"serving":{"raw":"96 g / Dĩa nhỏ","quantity_value":96,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá điêu hồng","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"