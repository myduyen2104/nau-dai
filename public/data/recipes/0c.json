ue":40,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bún khô ngâm mềm, vớt để ráo nước. Cắt khúc vừa ăn. Thịt heo rửa sạch, băm nhuyễn, tôm bóc vỏ, lấy chỉ đen, băm nhuyễn, ướp gia vị. Trứng cút luộc chín, bóc vỏ. Cà rốt gọt vỏ, rửa sạch, bào sợi. Giá đậu xanh rửa sạch, để ráo nước. Nấm rơm rửa sạch, cắt nhỏ. Hành lá rửa sạch, cắt nhỏ. Bắt chảo lên bếp, thêm dầu, thêm hành tỏi băm phi thơm, rồi cho thịt heo, tôm vào đảo đều, thêm cà rốt, nấm rơm, giá đậu xanh vào xào chín. Thêm bún khô vào trộn đều, thêm gia vị vừa ăn đảo đều cho chín rồi tắt bếp.","nutrition":{"kcal":425,"protein_g":17.4,"fat_g":15.9,"carbs_g":53.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00yrt8m18flus723","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Hạt tiêu"],"source_categories":[{"label":"Món khô 6-7 tuổi","id":"mon_kho_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw016kt8m1o2g7xf4t#variant-1","name":"Cá hồi sốt bơ tỏi","detail_name":"Cá hồi sốt bơ tỏi","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"58.5 g","quantity_value":58.5,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Cá hồi","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"0.5 g","quanti