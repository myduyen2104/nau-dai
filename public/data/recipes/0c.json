":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Khoai tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu hà lan (hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bột bắp (bột ngô vàng)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Sườn heo rửa sạch để ráo ướp gia vị 30 phút. Cà chua rửa sạch cắt nhỏ. Cà rốt , khoai tây gọt vỏ rửa sạch cắt vừa ăn. Đậu hà lan rửa sạch để ráo. Tỏi ta bóc vỏ rửa sạch băm nhuyễn. Đặt 1 cái nồi lên bếp phi thơm tỏi , cho tiếp thịt vào xào sơ, tiếp theo cho cà chua vào xào chung. Kế tiếp cho nước vào đun sôi trên lửa nhỏ. Tiếp theo cho khoai tây, cà rốt, đậu hà lan vào nấu chung, nêm nếm gia vị lại cho vừa ăn. Cuối cùng tắt bếp.","nutrition":{"kcal":89.6,"protein_g":5.2,"fat_g":5.3,"carbs_g":5.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04v4t8m1v4dxxifk","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Bột bắp (bột ngô vàng)","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04x3t8m1btsgohrh#variant-1","name":"Súp lơ xào mực","detail_name":"Súp lơ xào mực","category":"Món xào 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"96.5 g / Dĩa vừa","quantity_value":96.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Mực tươi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Súp lơ xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Ngô bao tử/bắp non","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Dùng dao nhỏ tách súp lơ thành các múi đều nhau. Múi to bổ dọc làm đôi. Phần cuống gọt vỏ nếu cần, thái thành các lát mỏng. Bông súp lơ có nhiều khe/kẽ nên khó rửa, cần ngâm nước muối loãng 5-10 phút. Cà rốt nạo vỏ, bào sợi, thái lát mỏng hoặc miếng tròn tùy thích. Bắp nón cắt khúc. Mực làm sạch, cắt khoanh và để ráo rồi ướp với chút bột canh và hạt tiêu. Đun nóng dầu ăn rồi cho mực vào xào xơ rồi cho cà rốt, bắp non vào xào trước rồi đến súp lơ. Nêm nếm thêm gia vị cho vừa miệng rồi tắt bếp. Rắc thêm hạt tiêu nếu thích ăn cay hoặc trang trí thêm vài cọng rau mùi nếu có.","nutrition":{"kcal":85.9,"protein_g":5.1,"fat_g":5.4,"carbs_g":4.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04x3t8m1btsgohrh","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Súp lơ xanh","unlisted_ingredient_phrase:bot canh","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:rau mui"],"source_categories":[{"label":"Món xào 6-7 tuổi","id":"mon_xao_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04zmt8m14j9751tx#variant-1","name":"SWHCM-18-24M-Canh cải bó xôi bò bằm","detail_name":"SWHCM-18-24M-Canh cải bó xôi bò bằm","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"36.2 g","quantity_value":36.2,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Cải bó xôi","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Súp lơ cắt thành từng miếng vừa ăn, rửa sạch để ráo. Nấm rơm rửa sạch, ngâm muối, để ráo. Hành rửa sạch, cắt nhỏ. Cho ít dầu vào nồi, thêm chút hành, đảo vài lần cho nóng hành rồi cho thịt băm vào đảo cho chín tới. Cho thêm nước vào, khi nước sôi, cho súp lơ, nấm vào nấu chín, nêm gia vị vừa ăn, tắt bếp.","nutrition":{"kcal":22.6,"protein_g":1.9,"fat_g":1.4,"carbs_g":0.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04zmt8m14j9751tx","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cải bó xôi","title_ingredient_not_mentioned:Cải bó xôi","unlisted_ingredient_phrase:nam rom"],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gi05e5t8m1nv65hzcv#variant-1","name":"Trứng chiên nấm","detail_name":"Trứng chiên nấm","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"75 g / Dĩa nhỏ","quantity_value":75,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng gà ta (35g/quả)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Trứng gà đập ra chén, cho gia vị, hành lá cắt nhỏ vào khuấy đều. Nấm rơm rửa sạch, cắt mỏng. Làm nóng dầu ăn trong chảo, cho lần lượt nấm rơm, hỗn hợp trứng gà vào, tráng đều, chiên nhỏ lửa. Tiếp theo, gấp đôi miếng trứng lại, chiên thêm 1 phút. Tắt bếp, bày món ăn ra đĩa và dùng với cơm trắng.","nutrition":{"kcal":112.9,"protein_g":7.2,"fat_g":8.8,"carbs_g":1.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05e5t8m1nv65hzcv","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà ta (35g/quả)","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05mat8m1hp9342vv#variant-1","name":"Xíu mại nhồi trứng cút","detail_name":"Xíu mại nhồi trứng cút","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"140.5 g / Dĩa vừa","quantity_value":140.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Trứng cút (10g/quả)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thịt heo rửa sạch, xay nhuyễn .Cà chua rửa sạch, bỏ hạt, cắt hạt lựu nhỏ . Trứng cút luộc, bóc vỏ Tỏi bó vỏ, băm nhuyễn . Cho thịt xay, tỏi, gia vị vào tô, trộn đều. Lấy 1 cái đĩa lớn, thoa một lớp dầu ăn lên bề mặt đĩa để khi hấp thịt không bị dính. Sau đó lấy hỗn hợp thịt ở trên viên thành những viên tròn vừa ăn, nhét quả trứng cút vào chính giữa viên thịt xay, xếp thịt viên lên đĩa, thực hiện đến khi hết thịt. Cho thịt vào hấp khoảng 10 phút cho chín. Bắc chảo lên bếp, phi thơm tỏi. Tiếp đó cho cà chua vào đảo kỹ, rồi cho phần sốt cà chua và phần nước khi hấp thịt vào cùng. Nêm nếm vừa ăn, cho những viên thịt đã hấp chín vào đảo đều, đun nhỏ lửa cho thịt ngấm sốt và đến khi nước sốt sền sệt là được. Tắt bếp, cho thịt ra đĩa cùng với nước sốt sau đó rắc xíu hành lá, rau mùi lên trên là được.","nutrition":{"kcal":411.8,"protein_g":19.2,"fat_g":35.4,"carbs_g":4.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05mat8m1hp9342vv","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:sot ca chua","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]