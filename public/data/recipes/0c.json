lại tắt bếp. Nêm gia vị vừa ăn.","nutrition":{"kcal":66,"protein_g":3.5,"fat_g":4.5,"carbs_g":2.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01rnt8m1dvtc5m60","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:toi xay","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món canh 6-7 tuổi","id":"mon_canh_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01xrt8m1xb71jw9q#variant-1","name":"Canh súp lơ xanh nấu thịt heo","detail_name":"Canh súp lơ xanh nấu thịt heo","category":"Món canh 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"45.5 g / Chén","quantity_value":45.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Súp lơ xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Cà rốt, súp lơ thái miếng vừa ăn xong rửa sạch để ráo, cắt hạt lựu. Đun 1 nồi nước sôi sau đó cho thịt vào đến khi thịt chín xong cho cà rốt vào trước tiếp đó cho súp lơ Nêm nếm vừa ăn, nước sôi lần nữa thì tắt bếp.","nutrition":{"kcal":55,"protein_g":2.9,"fat_g":3.6,"carbs_g":2.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt01xrt8m1xb71jw9q","quality_status":"needs_review","warnings":["recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Súp lơ xanh","ingredient_not_mentioned_by_name:Muối","title_ingredient_not_mentioned:Súp lơ xanh"],"source_categories":[{"label":"Món canh 25-35 tháng tuổi","id":"mon_canh_25_3