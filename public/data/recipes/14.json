– Hành lá và gừng thì rửa sạch, thái nhỏ. – Bạn lấy phần xương bồ câu và lượng nước vừa phải vào nồi ninh lửa vừa cho đến khi sôi thì vớt phần xương bồ câu ra. Lưu ý: nhớ liên tục vớt bọt để nước dùng được trong. – Cho phần gạo, đậu xanh vào nồi nước dùng cùng với chút gừng. Nếu bạn muốn cháo loãng thì có thể thêm chút nước sôi. Để lửa vừa đun cho nồi cháo sôi và sánh lại thì bạn cho phần thịt bồ câu đã ướp vào và nêm nếm muối, bột nêm và chút muối. Tiếp tục đun khoảng 30 – 40 phút cho sôi lần nữa là có thể tắt bếp. - Múc ra bát cho rau răm , hàng ngò, tiêu vào là có thể thưởng thức.","nutrition":{"kcal":252.1,"protein_g":8.9,"fat_g":6.7,"carbs_g":39},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu022qt8m1utfkyehp","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc","unlisted_ingredient_phrase:xuong bo","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu025dt8m1aaxjefu6#variant-1","name":"Cháo lươn bí đỏ hạt sen","detail_name":"Cháo lươn bí đỏ hạt sen","category":"Cháo 9-12 tháng tuổi","age_group":"9-12 tháng","serving":{"raw":"77 g / Chén","quantity_value":77,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Lươn","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bí đỏ (bí ngô)"