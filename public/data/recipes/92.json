d":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gg04v1t8m1u2miuwdr#variant-1","name":"Sườn cốt lết rim nước dừa","detail_name":"Sườn cốt lết rim nước dừa","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"265.5 g / Dĩa vừa","quantity_value":265.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước dừa non tươi","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Sườn cốt lết rửa sạch, để ráo nước rồi dùng búa đập thịt dần 2 mặt miếng cốt lết để thịt được mềm và mỏng dễ thấm gia vị hơn. Ướp gia vị, để 15 phút cho sườn ngấm gia vị. Bắc chảo nóng với dầu ăn, gắp sườn vào chảo rồi rán vàng 2 mặt. Tiếp theo thêm vào nước, đun đến khi sôi thì hạ nhỏ lửa, ram liu riu khoảng 20-30 phút đến khi nước keo lại. Khi còn một ít nước trong chảo, bạn thêm vào 1 muỗng canh đường, dùng muỗng khuấy đều cho đường hòa tan vào nước. Để lửa nhỏ cho sườn rim thêm một chút nữa sẽ thấy nước đổi màu cánh gián, dùng đũa đảo miếng sườn và lật mặt để sườn được áo màu cánh gián đẹp mắt là hoàn thành xong. Khi ăn gắp sườn rim ra dĩa, cắt thành những miếng nhỏ vừa ăn. Rưới mỡ hành lên miếng sườn rim để trông được bắt mắt và ngon miệng hơn.","nutrition":{"kcal":684.8,"protein_g":31.6,"fat_g":58,"carbs_g":9.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gg04v1t8m1u2miuwdr","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Nước dừa non tươi","ingredient_not_mentioned_by_name:Hạt nêm Knorr","title_ingredient_not_mentioned:Nước dừa non tươi","unlisted_ingredient_phrase:hoa tan"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]