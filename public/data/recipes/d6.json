ntions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:chan gio","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv011wt8m1q7x8l7t7#variant-1","name":"Bún thịt bò nấu cần","detail_name":"Bún thịt bò nấu cần","category":"Món nước 18-35 tháng","age_group":"18-35 tháng","serving":{"raw":"151.3 g / Tô nhỏ","quantity_value":151.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cần ta","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Xương bò rửa sạch, rồi để ráo nước. (Bạn có thể nướng xương bò bằng lò nướng trong khoảng 10 phút với cách làm này sẽ giúp bạn khử mùi gây của xương bò). Sau khi nướng xong, thì cho xương vào nồi chế ngập nước, nước sôi chắt phần nước bỏ đi rồi thêm nước đậy nồi áp suất và hầm khoảng 2 giờ. Sau đó chắt lấy nước xương để riêng. (Bước này nên chuẩn bị từ tối để tiết kiệm thời gian) Bước 2: Cà chua, rau cần, hành hoa, mùi rửa sạch. Cà chua bổ múi cau, rau cần cắt khúc. Hành hoa, mùi thái nhỏ. Bước 3: Thịt bò thái mỏng. (Nếu thích bạn có thể ướp thêm một chút xíu gia vị). Bước 4: Phi thơm hành khô băm nhỏ cho cà chua vào xào, nêm 1 thìa bột nêm cho cà chua mau mềm. Bước 5: Cho phần cà chua vừa xào vào nồi nước dùng xương, nêm nếm gia vị cho vừa miệng. Bước 6: Trong lúc đợi nồi nước dùng xương sôi thì trần bún qua nước sôi xếp vào tô. Nước dùng sôi hạ bớt lửa, cho rau cần, thịt bò vào chần, riêng rau cần nhúng chín rồi xếp vào tô bún cùng ít hành răm thái nhỏ, vài lát ớt hiểm rồi từ từ chan nước dùng ngập bún.","nutrition":{"kcal":205.6,"protein_g":8.4,"fat_g":8.2,"carbs_g":25.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv011wt8m1q7x8l7t7","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:hanh hoa","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:xuong bo"],"source_categories":[{"label":"Món nước 18-35 tháng","id":"mon_nuoc_18_35_thang","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"18-35 tháng","id":"18_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw0177t8m1g44zzjaq#variant-1","name":"Cá hú/ cá basa kho tiêu","detail_name":"Cá hú/ cá basa kho tiêu","category":"Món mặn","age_group":null,"serving":{"raw":"114.5 g / Dĩa vừa","quantity_value":114.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cá mỡ/cá hú/cá basa","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_uni