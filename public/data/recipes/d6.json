hi nấu nên khuấy đều tay để đậu không dính đáy nồi, vớt sạch bọt. Cho thêm đường vào (lượng đường cho vào có thể thay đổi theo khẩu vị của), nấu thêm 15 phút nữa cho đậu chín và mềm ra, nước sệt lại là được. Sau khi nấu đậu mềm nhừ, tiếp tục cho đậu lên bếp và bật lửa nhỏ, dùng bó đũa, vá hay muỗng đánh đậu xanh cho mềm, nhuyễn mịn và sánh nước lại là được, đến khi đậu xanh đặc sệt lại thì tắt bếp. Nấu nước cốt dừa Cho ít nước lọc vào một cái nồi sạch khác. Đổ lon nước cốt dừa với bột năng, phần đường còn lại vào, khuấy đều và đun sôi. Nấu nước cốt dừa đến khi sánh đặc lại vừa vị là được. Cho đậu xanh đánh nhuyễn vào chén, vị đậu xanh bùi bùi được đánh nhuyễn dễ ăn, hòa quyện với hương vị thơm ngon của nước cốt dừa béo ngậy, ăn kèm với hạt đậu phộng rang hay dừa bào sợi giòn giòn.","nutrition":{"kcal":375.4,"protein_g":12.9,"fat_g":10.2,"carbs_g":58},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02cnt8m1k0y144p8","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:au phong","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:lon nuoc","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua","unlisted_ingredient_phrase:nuoc loc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Chè","id":"che","kind":"food_category","baseLabel":"Chè"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02dct8m1xam4t004#variant-1","name":"Chim bồ câu hầm cốm hạt sen","detail_name":"Chim bồ câu hầm cốm hạt sen","category":"Món mặn","age_group":null,"serving":{"raw":"64.5 g / Dĩa nhỏ","quantity_value":64.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bồ câu ra ràng","quantity_raw":"20 g","quantity_value":20,"quantity_u