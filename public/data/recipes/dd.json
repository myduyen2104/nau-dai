[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3tw00d4t8m1utn6pbl9#variant-1","name":"Bánh canh cua","detail_name":"Bánh canh cua","category":"Món nước 5 tuổi","age_group":"5 tuổi","serving":{"raw":"261.3 g / Tô nhỏ","quantity_value":261.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh canh tươi","quantity_raw":"130 g","quantity_value":130,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cua bế","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Củ cải trắng","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm rơm","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Cua biển mua về rửa sạch, hấp chín, gỡ lấy phần thịt và gạch để riêng. Cho hành băm nhuyễn vào chảo phi thơm với dầu ăn, rồi xào thịt cua cùng ít mắm, tiêu cho thơm. Gạch cua bạn cũng phi hành khô, xào qua, để riêng. Sơ chế các nguyên liệu khác Củ cải, cà rốt gọt vỏ, rửa sạch, cắt khúc. Nấm rơm rửa sạch, ngâm nước muối loãng, bổ dọc, cho vào chảo xào qua. Thịt chân giò luộc chín, thái khoanh. Rửa sạch tôm, cắt bỏ râu Nấu nước dùng Xương lợn chần qua nước sôi, rửa sạch rồi cho vào nồi nước lạnh ninh lấy nước dùng. Phi hành thơm vào nồi và đổ nước hầm xương vào cũng với của cải và cà rốt. Bỏ tôm vào nước lèo cho ngọt. Khi tôm chín vớt ra bóc vỏ. Sau khi nêm nếm vừa ăn thì đợi đến lúc nước sôi nhẹ và cho nấm rơm vào cùng. Hòa một ít bột năng đổ từ từ vào nồi nước dùng, vừa đổ vừa khuấy đều để tạo độ sánh. Xếp bánh canh ra bát, cho thịt chân giò, thịt cua, gạch cua, tôm . Chan nước dùng rồi rắc hành, mùi, hạt tiêu lên trên và thưởng thức cùng với rau.","nutrition":{"kcal":358.6,"protein_g":13.7,"fat_g":14.7,"carbs_g":43.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3tw00d4t8m1utn6pbl9","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Giá đậu xanh","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:bot nang","unlisted_ingredient_phrase:chan gio","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:thit va"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00p4t8m11gd9theu#variant-1","name":"Bê thui bóp thấu","detail_name":"Bê thui bóp thấu","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"120.2 g / Dĩa nhỏ","quantity_value":120.2,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt bò loại 1","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Khế","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"chuối xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Thịt bê mua về rửa sạch, cắt lát mỏng. Khế rửa sạch, cắt bỏ các gân và viền bên ngoài. Chuối gọt vỏ. Chuẩn bị một tô nước lọc và vắt nửa quả chanh vào để sẵn. Sau đó thái mỏng chuối và khế bỏ ngay vào tô nước chanh ngâm chung với ngó sen cho không bị thâm và bớt chát. Hành tây lột vỏ, rửa sạch, bổ dọc làm đôi rồi thái ngang. Rau thơm nhặt rửa sạch, để ráo nước rồi thái nhỏ. Tỏi bóc vỏ, băm nhỏ. Ớt sừng rửa sạch, lọc bỏ hạt, băm nhỏ. Đậu phộng rang chín giòn, tách vỏ và đập dập. Chuẩn bị một chén sạch, pha các nguyên liệu gia vị: nước cốt chanh, nước mắm, đường kính, nước lọc, tỏi, ớt băm. Khuấy đều cho tan hết. Cho thịt bò thái mỏng vào tô, sau đó thêm vào tỏi băm, tiêu, dầu ăn vào đảo đều rồi để ướp khoảng 3 phút. Bắc chảo lên bếp cho nón rồi đổ thịt bò đã ướp vào xào tái là được. Dùng thố lớn hoặc thau sạch lần lượt cho khế, chuối xanh (sau khi vớt ra để ráo nước), thịt bò đã xào, nước xốt trộn gỏi vào. Trộn đều nhẹ nhàng rồi tiếp tục cho thêm hành tây, rau thơm, đậu phộng rang đập dập, tiêu vào trộn tiếp cho đều các nguyên liệu là xong. Trình bày ra đĩa thưởng thức.","nutrition":{"kcal":160.9,"protein_g":13.1,"fat_g":7.2,"carbs_g":11.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00p4t8m11gd9theu","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_i