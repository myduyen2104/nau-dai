hú ý hớt bỏ bọt trong quá trình ninh xương). Bước 3: Gầu bò rửa với muối, rửa sạch lại với nước, hầm chung với nồi xương hầm, khi nào thấy chín mềm vớt ra thái miếng vừa ăn. Bắp bò rửa sạch thái lát mỏng vừa ăn. Hành, mùi tàu, rau mùi/húng rửa sạch, cắt ngắn. Bánh phở chần qua nước sôi. Bước 4: Tất cả xếp vào bát, chan nước dùng, thêm chanh, ớt là có bát phở xịn sò tại gia. Lưu ý nước lèo phải thật sôi để khi chan vào đảm bảo tái bắp bò sẽ chín.","nutrition":{"kcal":453,"protein_g":20.9,"fat_g":12.8,"carbs_g":65.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03wwt8m1utttnnkq","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt bò loại 1","ingredient_not_mentioned_by_name:Thịt bò loại 2","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Tương ngô","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mui tau","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc ham","unlisted_ingredient_phrase:voi nuoc","unlisted_ingredient_phrase:xuong bo","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72n0499t8m14bzl40hm#variant-1","name":"ROHTO N26 CHAY - Đậu hủ non sốt nấm đông cô","detail_name":"ROHTO N26 CHAY - Đậu hủ non sốt nấm đông cô","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"135.4 g","quantity_value":135.4,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Đậu phụ (đậu hũ)","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Nấm hương khô"