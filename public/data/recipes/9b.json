null,"serving":{"raw":"145 g / Dĩa vừa","quantity_value":145,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Tôm đồng","quantity_raw":"120 g","quantity_value":120,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Tôm lột vỏ bỏ đầu chừa đuôi cho đẹp. Ướp tôm với gia vị trong vòng 20 phút. Me chín, cho ra chén, đỗ chén nước nóng vào, dầm me cho kỹ, lấy nước me bỏ hạt. Cho chảo lên bếp, phi tỏi vàng thơm. Trút tôm đã ướp vào chảo. Rim với lửa vừa, đến khi nước me trong chảo sệt lại một chút là được. Ăn kèm với cơm nóng.","nutrition":{"kcal":192.9,"protein_g":22.7,"fat_g":9.3,"carbs_g":5.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05bqt8m1i15unv0n","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Hành lá (hành hoa)","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gi05cjt8m1dgurvz82#variant-1","name":"Tôm sốt trứng muối","detail_name":"Tôm sốt trứng muối","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"71 g / Dĩa nhỏ","quantity_value":71,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Tôm đồng","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Trứng vịt muối (55g/quả)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Tôm rửa sạch để ráo. Trứng vịt muối dùng lòng đỏ tán đều. Dùng chảo dầu chiên vàng tôm. Gạn bớt dầu phi thơm tỏi sau đó cho trứng muối vào xào đều cùng gia vị. Cuối cùng cho tôm vào đảo đều cho thấm gia vị và tắt bếp có thể dùng được.","nutrition":{"kcal":103.7,"protein_g":10.5,"fat_g":5.2,"carbs_g":4.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gi05cjt8m1dgurvz82","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls"],"integrity_findings":["ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05g3t8m12hbjf582#variant-1","name":"Trứng gà chiên thịt bằm","detail_name":"Trứng gà chiên thịt bằm","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"120.5 g / Dĩa vừa","quantity_value":120.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Trứng gà công nghiệp (50g/quả)","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Trứng gà đập ra tô. Thêm gia vị vào, khuấy đều. Thịt heo bằm cho ra chén. Hành lá cắt nhỏ. Phi thơm phần thân hành lá, cho thịt heo bằm vào, đảo đều 1 phút. Đổ trứng gà vào, tráng mỏng. Chiên nhỏ lửa cho trứng chín đều. Cuối cùng rắc thêm ít tiêu. Cho món ăn ra đĩa, dùng với cơm trắng.","nutrition":{"kcal":218,"protein_g":15,"fat_g":16.7,"carbs_g":2.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05g3t8m12hbjf582","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:o trung","unlisted_ingredient_phrase:o trung ga"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05nxt8m1km0llg1z#variant-1","name":"Xôi vò","detail_name":"Xôi vò","category":"Xôi (18 tháng trở lên)","age_group":"18 tháng","serving":{"raw":"150.2 g / Dĩa vừa","quantity_value":150.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Gạo nếp cái","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Nấu đậu xanh Trước tiên, bạn cần ngâm gạo nếp, đậu xanh trong khoảng thời gian 3 tiếng hoặc để qua đêm. Sau đó, bạn vo gạo và đậu xanh thật sạch, để ra rổ cho ráo. Tiếp đó, đổ đậu xanh vào nồi xửng đặt lên bếp, hấp chín từ 15 đến 20 phút. Nấu xôi Đậu xanh chín, cho vào máy xay sinh tố (loại có cối sử dụng xay thịt) để xay nhuyễn. Đổ gạo nếp vào một chiếc thố lớn, tiếp đó đổ ½ đậu xanh đã xay vào, thêm dầu ăn và trộn đều. Sau đó, bạn cho hỗn hợp trong thố vào nồi xửng và hấp chín lần thứ nhất trong 30 phút. Thỉnh thoảng, bạn mở nắp nồi hấp ra và đảo để xôi được chín đều, ngon hơn, nhớ trước khi đậy nắp nồi nên lau sạch nước trên nắp để xôi không bị nhão. Khi đã hấp chín hết 30 phút, bạn trải một lớp giấy nướng, giấy nến lên mặt bàn, đổ hỗn hợp ra, thêm ½ đậu xanh còn lại lên hỗn hợp, thêm tiếp đường và trộn đều. Sau đó, đổ hỗn hợp vào nồi xửng hấp lần 2 thêm 10 phút nữa. Thành phẩm Xôi vò mềm dẻo, thơm phức, nóng nổi hấp dẫn đến lạ! Cùng bắt tay làm ngay cho gia đình thưởng thức nhé.","nutrition":{"kcal":576.8,"protein_g":18.6,"fat_g":12.4,"carbs_g":98.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05nxt8m1km0llg1z","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hon hop","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Xôi (18 tháng trở lên)","id":"xoi_18_thang_tro_len","kind":"age_scoped_food_category","baseLabel":"Xôi"}],"source_age_group":{"label":"18 tháng","id":"18_thang"},"source_tag_evidence_status":"captured_catalog_metadata"}]