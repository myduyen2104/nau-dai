age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw0199t8m1cje7cvxx#variant-1","name":"Cá ngừ chiên","detail_name":"Cá ngừ chiên","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"54 g / Dĩa nhỏ","quantity_value":54,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá ngừ","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cá ngừ rửa sạch với nước, cắt khoanh vừa ăn. Đặt chảo dầu nóng sau đó cho cá vào chiên vàng đều 2 mặt. Pha hỗn hợp nước chấm gồm chanh, đường, nước mắm, và nước sôi để nguội. Khuấy đều hỗn hợp cho tan đường, nếm lại cho vừa ăn. Cá sau khi chiên vàng đều 2 mặt tắt bếp múc ra dĩa, cùng hỗn hợp nước chấm là có thể dùng được.","nutrition":{"kcal":93.4,"protein_g":8.6,"fat_g":5.1,"carbs_g":3.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw0199t8m1cje7cvxx","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tỏi ta","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01drt8m1kk3sremk#variant-1","name":"Cá trê om sốt thịt","detail_name":"Cá trê om sốt thịt","category":"Món mặn","age_group":null,"serving":{"raw":"108 g / Dĩa vừa","quantity_value":108,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cá trê","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nấm hương khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cá mua về rửa sạch cá với muối , để ráo. Cắt khúc Nấm hương khô ngâm nước nóng, cắt bỏ chân, rửa sạch, cắt nhỏ băm nhuyễn. Gừng, hành củ bóc vỏ, rửa sạch, băm nhuyễn. Trộn hỗn hợp: thịt heo xay, nấm hương, ít gừng và ít hành băm và ướp với các loại gia vị. Cá trê đem đi chiên vàng. Bắc chảo dầu nóng phi hành, tỏi và gừng cho thơm, đỗ hỗn hợp thịt heo vào xào thơm, cho nước xâm xấp vào, nêm nếm gia vị vừa ăn. Sau đó cho cá trê vào đun lửa nhỏ đến khi nước gia vị thấm vào cá.","nutrition":{"kcal":230.6,"protein_g":17.3,"fat_g":16.3,"carbs_g":4.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01drt8m1kk3sremk","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hanh cu","unlisted_ingredient_phrase:hon hop","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt022ft8m1lbr5x9a8#variant-1","name":"Cháo cá rô cải xanh","detail_name":"Cháo cá rô cải xanh","category":"Cháo 13-24 tháng tuổi","age_group":"13-24 tháng","serving":{"raw":"97.5 g / Chén","quantity_value":97.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cá rô đồng","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cải xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"}],"instructions_raw":"* Cá rửa sạch, lấy nạc băm nhuyễn hay cá luộc chín/hấp chín, nghiền nhỏ. * Cải xanh rửa sạch, cắt bỏ sống lá, lấy lá băm nhuyễn. * Hòa tan nạc cá với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng , bắc lên bếp khuấy đều cho đến khi sôi, thêm cải xanh vào nấu chín. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":211.5,"protein_g":8.6,"fat_g":9,"carbs_g":24},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt022ft8m1lbr5x9a8","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Cá rô đồng","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam"],"source_categories":[{"label":"Cháo 13-24 tháng tuổi","id":"chao_13_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"13-24 tháng","id":"13_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02bit8m17r6w4ysi#variant-1","name":"Cháo vịt","detail_name":"Cháo vịt","category":"Món nước 5 tuổi","age_group":"5 tuổi","serving":{"raw":"126.5 g / Tô nhỏ","quantity_value":126.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Gạo nếp cái","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Thịt vịt","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Sơ chế thịt vịt Đầu tiên, bạn làm sạch lông thịt vịt mua về, chà xát muối, rửa lại nhiều lần với nước. Sau đó, bạn gọt vỏ, băm nhỏ ½ củ gừng, chà xát lên toàn bộ bề mặt của vịt, rửa lại nhiều lần bằng nước sạch để khử mùi tanh. Đậu xanh ngâm nước, rửa sạch. Bước 2: Luộc thịt vịt Tiếp theo, bạn nướng 1 củ hành tím rồi bóc vỏ, đập dập miếng gừng còn lại. Sau đó, bạn cho vào chung hành, gừng, ít muối vào nồi nước, tiến hành luộc vịt. Bước 3: Phi hành Sau đó, bạn thái mỏng củ hành tím còn lại cho vào chảo dầu phi vàng. Bước 4: Nấu cháo Sau đó, bạn trộn gạo nếp và gạo tẻ, đậu xanh đã vo sạch, để trên rổ cho ráo nước rồi cho vào chảo rang sơ qua đến khi ngả sang màu hơi vàng. Khi vịt chín, bạn vớt ra ngoài. Kế đó, bạn cho gạo vào nồi nước luộc vịt, đun tiếp cho đến khi nồi cháo sôi bùng lên thì nhanh tay điều chỉnh lửa nhỏ và hầm để cháo chín nhừ. Nêm nếm cháo. Bước 5: Chặt vịt Trong thời gian hầm cháo, bạn dùng dao để chặt vịt thành từng miếng nhỏ vừa ăn và xếp ra đĩa ăn. Bước 6: Pha nước chấm Tiếp theo, bạn pha nước mắm chấm công thức: 1 thìa tỏi băm, ½ thìa ớt băm, 1 thìa đường, nước mắm ngon, ½ củ gừng thái sợi chỉ cùng một ít nước lọc, trộn đều. Bước 7: Hoàn thành và trình bày Kế đó, bạn nhặt và rửa sạch các loại rau ăn kèm như hành lá, rau răm, rau mùi bằng nước muối pha loãng. Sau đó, bạn thái nhỏ các loại rau và để riêng. Khi cháo chín nhuyễn, bạn múc cháo ra bát, cho lên trên một ít hành phi, hành lá, rau răm và rau mùi cùng một ít tiêu xay.","nutrition":{"kcal":294.9,"protein_g":12.1,"fat_g":8.4,"carbs_g":42.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02bit8m17r6w4ysi","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước 5 tuổi","id":"mon_nuoc_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65f02bjt8m1wdmoivog#variant-1","name":"Cháo vịt","detail_name":"Cháo vịt","category":"Món nước 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"141.5 g / Tô nhỏ","quantity_value":141.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Gạo nếp cái","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Thịt vịt","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}