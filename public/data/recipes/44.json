ity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt rửa sạch băm nhuyễn ướp gia vị. Mộc nhỉ ngâm nước cho nở cắt nhuyễn. Hành lá rửa sạch bỏ rể cắt nhỏ. Đập trứng gà vào tô trộn đều hỗn hợp thịt, mộc nhỉ hành lá và nêm nếm cho vừa ăn. Đặt 1 nồi nước sôi cho tô trứng vào nồi hấp trong 30 phút. Sau cùng đánh lên bề mặt 1 cái lòng đỏ trứng và hấp tiếp trong 5 phút. Sau cùng tắt bếp là có thể dùng được.","nutrition":{"kcal":294.1,"protein_g":17.3,"fat_g":21.7,"carbs_g":7.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh053bt8m1ce1y7lq8","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:long o trung","unlisted_ingredient_phrase:o trung"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh053wt8m1mxp0k8gp#variant-1","name":"Thịt bò hấp chấm mắm gừng","detail_name":"Thịt bò hấp chấm mắm gừng","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"121 g / Dĩa vừa","quantity_value":121,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt bò loại 2","quantity_raw":"110 g","quantity_value":110,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Nên chọn phần thịt bò bắp sẽ ngon hơn. Thịt bò mua về rửa sạch, để ráo. Ướp thịt bò cùng gia vị. Dùng tay xoa đều phần thịt và ướp thịt trong 6 tiếng hoặc ướp qua đêm. Chuẩn bị xửng hấp có nước sôi sẵn, đặt thịt bắp bò đã ướp vào sửng, sau đó rắc tiếp gừng cắt lát. Đậy nắp và hấp chín bò trong khoảng 120 phút tùy vào độ dày của thịt bắp bò. Dùng tăm xiên thử vào thịt, nếu không có nước máu đỏ chảy lên là thịt đã chín. Nước mắm gừng: Cho ớt, tỏi, gừng và đường vào cối, giã đến khi các nguyên liệu nhuyễn và đường tan bớt. Sau đó cho nước mắm và vắt nước cốt chanh vào. Dùng muỗng khuấy đều đến khi các nguyên liệu hòa quyện với nhau. Cắt thịt bắp bò thành những lát mỏng vừa ăn. Ăn kèm nước mắm gừng.","nutrition":{"kcal":199.3,"protein_g":20,"fat_g":11.6,"carbs_g":3.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh053wt8m1mxp0k8gp","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc mau","unlisted_ingredient_phrase:thit va","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},