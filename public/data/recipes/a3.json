nd":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01jst8m14fbx14z1#variant-1","name":"Canh cải cúc nấu cá thác lác","detail_name":"Canh cải cúc nấu cá thác lác","category":"Món canh 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"81.8 g / Chén","quantity_value":81.8,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Tần ô/cải cúc","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Cá nạc/cá thác lác","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Cá thác lác sau khi nạo thêm gia vị, dầu ăn quết nhuyễn cho cá được dai. Cải cúc rửa sạch cắt khúc. Bắc nồi nước lên bếp nấu sôi, ngắt từng viên cá thả vào nấu sôi, thêm rau cải cúc vào nấu sôi và tắt bếp. Nêm gia vị vừa ăn.","nutrition":{"kcal":32,"protein_g":2.9,"fat_g":1.1,"carbs_g":2.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01jst8m14fbx14z1","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 6-7 tuổi","id":"mon_canh_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01n2t8m1uvldh2g4#variant-1","name":"Canh củ cải trắng nấu thịt heo","detail_name":"Canh củ cải trắng nấu thịt heo","category":"Món canh 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"43.5 g / Chén","quantity_value":43.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Củ cải trắng","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Củ cải trắng gọt vỏ, rửa sạch, cắt hạt lựu nhỏ. Thịt heo rửa sạch, băm nhuyễn Bắt nồi lên bếp, thêm dầu ăn vào, thêm hành phi thơm, thêm thịt băm vào đảo đều cho thịt săn lại rồi thêm nước vào nấu sôi. Sau đó cho củ cải trắng vào nấu chín. Nêm gia vị vừa ăn, cho ít hành lá rồi tắt bếp.","nutrition":{"kcal":57.3,"protein_g":2.5,"fat_g":4.5,"carbs_g":1.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01n2t8m1uvldh2g4","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 25-35 tháng tuổi","id":"mon_canh_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01nht8m1r26tahiq#variant-1","name":"Canh đu đủ xanh nấu thịt heo","detail_name":"Canh đu đủ xanh nấu thịt heo","category":"Món canh 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"46.5 g / Chén","quantity_value":46.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đu đủ xanh","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc vai","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Thịt rửa sạch. Xay nhuyễn, ướp thịt bằm với gia vị vừa ăn. Trộn đều và ướp khoảng 30 phút cho thịt thấm đều gia vị. Đu đủ mua về dùng dao khứa nhiều vết trên vỏ đu đủ xanh, sao cho đu đủ ra hết nhựa trắng, rửa sạch. Sau đó gọt bỏ phần vỏ, bỏ hạt rồi cắt thành từng miếng vuông vừa ăn. Ngâm đu đủ trong nước muối loãng khoảng 15 phút để sạch mủ. Nấu canh Bắc chảo lên bếp, cho dầu ăn vào. Dầu nóng, các bạn cho tiếp tỏi băm vào phi thơm. Tiếp tục cho phần thịt heo băm vào xào nhanh tay khoảng 2 phút ở lửa lớn để thịt chín sơ. Đổ nước vào nồi, khi canh sôi cho đu đủ vào và nêm nếm gia vị vừa ăn.","nutrition":{"kcal":40.6,"protein_g":1.3,"fat_g":2.8,"carbs_g":2.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01nht8m1r26tahiq","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nau canh","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món canh 25-35 tháng tuổi","id":"mon_canh_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01tct8m1rv65w4wp#variant-1","name":"Canh nghêu (sò)","detail_name":"Canh nghêu (sò)","category":"Món canh","age_group":null,"serving":{"raw":"149.5 g / Chén","quantity_value":149.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cà chua","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Sò","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Ngâm ngao với nước muối và ớt trong khoảng 3-4 giờ để ngao nhả bùn cát. Sau đó chà sạch vỏ ngao. Rửa sạch và thái múi cau cà chua, rửa sạch lá chanh. Rửa sạch sả, cắt bỏ phần ngọn giữ lại gốc sả, đập dập để ra mùi tốt hơn. Gọt vỏ và thái lát gừng tươi. Phi thơm tỏi, thêm cà chua vào xào lấy màu, khi cà chua đã ra màu thì bắt đầu cho lá chanh vào, đảo nhanh tay tránh để cà bị cháy. Cho vào nồi cà chua nước lọc, khi nước sôi nhẹ thì cho sả và gừng vào. Cho vắt me vào tô, lấy ít nước canh nóng cho vào, dầm nát. Khi me tan thì chắt lấy nước me cho vào canh và bỏ hạt. Nêm canh với gia vị vừa ăn Khi nước canh sôi kĩ thì cho ngao vào, đậy vung nồi lại đun tiếp cho canh sôi trong 1 phút là được. Thêm rau răm cắt nhỏ lên trên.","nutrition":{"kcal":50.2,"protein_g":4.3,"fat_g":1.4,"carbs_g":5.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01tct8m1rv65w4wp","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Hành lá (hành hoa)","unlisted_ingredient_phrase:gung tuoi","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:la chanh","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món canh","id":"mon_canh","kind":"food_category","baseLabel":"Món canh"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt01wtt8m1j8naaz5g#variant-1","name":"canh su hào nấu nấm","detail_name":"canh su hào nấu nấm","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"142 g","quantity_value":142,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Su hào","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Nấm kim châm","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g