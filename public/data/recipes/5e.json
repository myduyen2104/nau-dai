e":0.5,"quantity_unit":"g"}],"instructions_raw":"Cho một ít muối hột vào bóp với lòng cho sạch, rửa lại với nước rồi cắt nhỏ. Ướp lòng với hành tím, gia vị cho ngấm. Mướp gọt vỏ, rửa sạch và cắt miếng. Nấm rơm rửa sạch, ngâm nước muối, để ráo, cắt vừa ăn. Hành lá rửa sạch và thái nhỏ. Cho ít dầu ăn vào nồi, dầu nóng thì cho hành tím vào phi thơm. Đổ lòng gà vào xào cho thấm gia vị. Đổ nước vào, nấu cho sôi rồi cho mướp, nấm vào, khi nước sôi lại thì tắt bếp, cho hành lá vào. Nêm lại cho vừa ăn rồi múc ra tô là có thể thưởng thức.","nutrition":{"kcal":34.3,"protein_g":2.5,"fat_g":1.8,"carbs_g":2.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01swt8m1ovg67us2","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh từ 3-4 tuổi","id":"mon_canh_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01v5t8m1ff5zemlp#variant-1","name":"Canh rau má nấu thịt bằm","detail_name":"Canh rau má nấu thịt bằm","category":"Món canh","age_group":null,"serving":{"raw":"112.5 g / Chén","quantity_value":112.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau má, má mơ","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc vai","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Rau má rửa sạch, cắt vừa ăn.Thịt heo nạc rửa sạch, băm nhuyễn, ướp gia vị. Bắt nồi lên bếp thêm chút dầu ăn phi thơm hành, cho thịt vào đảo đều rồi thêm nước vào nấu sôi khoảng 5 phút, thêm rau má vào nấu sôi trở lại thì nêm nếm, tắt bếp.","nutrition":{"kcal":86.7,"protein_g":5.3,"fat_g":4.5,"carbs_g":6.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01v5t8m1ff5zemlp","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:heo nac","unlisted_ingredient_phrase:thit heo nac"],"source_categories":[{"label":"Món canh","id":"mon_canh","kind":"food_category","baseLabel":"Món canh"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bt022ht8m1l5npdfh7#variant-1","name":"Cháo cật heo","detail_name":"Cháo cật heo","category":"Món nước","age_group":null,"serving":{"raw":"100.5 g / Tô nhỏ","quantity_value":100.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"35 g","quantity_value":35,"quantity_unit":"g"},{"name":"Gạo nếp máy (loại thường)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bầu dục heo (lợn)","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"- Bước 1: Cật heo chà muối, rửa sạch, cắt lát mỏng Bước 2: Đem cật đi xào thơm qua với hành phi, nêm nếm gia vị Bước 3: Cho gạo vào nồi , đổ nước vào bắt lên bếp nấu Bước 4: Cho cật vào nồi cháo, nấu đến khi cháo nhừ, thì nêm nếm và bỏ hành ngò, tiêu vào.","nutrition":{"kcal":234.7,"protein_g":8.9,"fat_g":6.8,"carbs_g":35.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bt022ht8m1l5npdfh7",