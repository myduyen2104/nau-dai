Tôm khô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt sen tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rượu trắng (cồn 39 g)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nghệ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Gừng cạo, rửa sạch, giã nhỏ, trộn với rượu. Nghệ cạo vỏ, rửa sạch, giã nhỏ, cho vào 1 thìa nước. Ếch rửa sạch, rạch sống lưng, lột da, mổ bỏ ruột, rứa sạch, chặt mỗi con làm 7 miếng, tẩm rượu, gừng rồi bỏ gia vị vào bóp kỹ, ướp 15 phút. Hạt sen tươi luộc chín. Tôm khô bóc vỏ, rứa sạch, để ráo. Hành khô bóc vỏ, đập giập. Rau mùi tàu nhặt rửa sạch, thái chỉ. \"Cho dầu vào chảo, đun nóng già, bỏ hành củ vào phi thơm, trút thịt ếch vào xào cho ngấm gia vị, cho tôm vào xào cùng, đảo đều, khi tôm chín mềm xúc ra bát. Múc ếch đã xào với tôm cho vào nồi nước dùng nấu với hạt sen, đun nhỏ lửa.Tần như vậy chừng 35-45 phút, thịt ếch và hạt sen chín nhừ, nước cạn sánh, nêm nếm lại vừa ăn là được.Múc tất cả ra bát to, rắc hạt tiêu, rau mùi tàu lên trên.","nutrition":{"kcal":194.1,"protein_g":25,"fat_g":4.4,"carbs_g":7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02r2t8m1kd46octc","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:mui tau","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:rau mui tau"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03iot8m1nne93xjw#variant-1","name":"Miến lươn xào","detail_name":"Miến lươn xào","category":"Món khô từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"233.5 g / Dĩa","quantity_value":233.5,"quantity_unit":"g","portion_label":"Dĩa"},"ingredients":[{"name":"Miến dong khô","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Lươn","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Miến dong ngâm với nước ấm cho sợi miến mềm, vớt ra để ráo, cắt vừa ăn. Lươn luộc chín, gỡ lấy thịt. Giá đậu xanh rửa sạch, để ráo. Cà rốt gọt vỏ, rửa sạch, thái sợi. Mộc nhĩ ngâm trong nước ấm cho mềm rồi để ráo, thái sợi. Hành tây gọt vỏ, rửa sạch, thái lát. Bắt chảo lên bếp, thêm dầu ăn vào phi thơm tỏi, thêm thịt lươn vào xào chín. Múc ra rồi thêm cà rốt, mộc nhĩ, giá đậu xanh, hành tây, vào xào chín, Thêm miến dong vào trộn đều, thêm lươn vào đảo đều, Nêm gia vị vừa ăn.","nutrition":{"kcal":454.5,"protein_g":17.8,"fat_g":11.3,"carbs_g":71.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03iot8m1nne93xjw","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Rau răm","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món khô từ 8-18 tuổi","id":"mon_kho_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh057kt8m1ddcqex46#variant-1","name":"Thịt heo nhồi cà chua","detail_name":"Thịt heo nhồi cà chua","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"141.5 g / Dĩa nhỏ","quantity_value":141.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cà chua","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cà chua rửa sạch cắt đôi. Thịt heo rửa sạch băm nhỏ. Mộc nhỉ ngâm nở băm nhỏ. Tỏi ta lột vỏ rửa sạch băm nhỏ. Hành lá rửa sạch bỏ rể cắt nhỏ. Trộn đều hỗn hợp gồm thịt heo, mộc nhỉ , tỏi, cùng với gia vị. Sau đó nhồi thịt vào chính giữa cà chua. Đặt 1 chiếc nồi lên nấu sôi nước cà chua đã nhồi vào hấp trong 20 phút thì cà chua chín. Sau cùng tắt bếp và có thể dùng được.","nutrition":{"kcal":304,"protein_g":13.5,"fat_g":23.3,"carbs_g":10.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh057kt8m1ddcqex46","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:hon hop"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7gh05adt8m1gs62u0p8#variant-1","name":"Tôm hấp","detail_name":"Tôm hấp","category":"Món tự thiết kế","age_group":null,"serving":{"raw":"120 g","quantity_value":120,"quantity_unit":"g","portion_label":null},"ingredients":null,"instructions_raw":null,"nutrition":{"kcal":98.4,"protein_g":21.1,"fat_g":1.1,"carbs_g":1.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7gh05adt8m1gs62u0p8","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","instructions_missing_from_detail","listing_count_not_visible_in_detail"],"integrity_findings":[],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status"