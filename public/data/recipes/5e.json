, lấy vài tai xắt nhỏ. Còn lại để nguyên hoặc cắt đôi. Miến ngâm nước, vớt ra để ráo. Hành lá cắt lấy phần trắng , lấy vài cọng tỉa hoa.\" Trộn chung thịt nạc , 1/2 hạt sen, cốm, nấm cắt nhỏ, hành củ băm nhỏ phi vàng, gia vị… rồi dồn thịt vào bụng chim, may lại, để ráo. Bắc chảo dầu lên bếp đun sôi, gác vỉ lên chảo cho chim lên, múc mỡ xối lên cho săn thịt và hơi vàng. Bắc nồi nước dùng lên bếp đun sôi, cho chim vào hầm mềm, cho chút muối, vài lát gừng, để lửa nhỏ và hớt bọt kỹ. Thỉnh thoảng trở chim cho chín mềm đều. Khi chim mềm, cho nấm, miến và sen còn lại và nấu tiếp.Nêm gia vị vừa ăn. Cho hành vào rồi nhắc xuống.","nutrition":{"kcal":105.8,"protein_g":3.6,"fat_g":7.9,"carbs_g":5.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02d9t8m1i52qexy2","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nấm hương khô","ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Tỏi ta","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:bot gia","unlisted_ingredient_phrase:bot gia vi","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:thit va"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02lrt8m1jpf6hpch#variant-1","name":"Đậu hũ ngũ sắc","detail_name":"Đậu hũ ngũ sắc","category":"Món chay 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"203 g / Dĩa vừa","quantity_value":203,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Đậu phụ (đậu hũ)","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1