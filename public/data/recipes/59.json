[{"id":"https://dinhduong2598.food/mon-an/cmrg0p3ty00pat8m1wlb9t8d6#variant-1","name":"Bí đao luộc","detail_name":"Bí đao luộc","category":"Món luộc","age_group":null,"serving":{"raw":"150 g / Dĩa vừa","quantity_value":150,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":null,"instructions_raw":"Bí đao mua về rửa sạch gọt vỏ, sau đó rửa lại với nước thêm lần nữa. Cắt bí ra thành từng khoanh vừa ăn. Đặt nồi nước sôi thả bí vào luộc trong 10 phút, thấy bí trong vớt ra dĩa để nguội và thưởng thức.","nutrition":{"kcal":24,"protein_g":0.9,"fat_g":0,"carbs_g":5.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p3ty00pat8m1wlb9t8d6","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","listing_count_not_visible_in_detail","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món luộc","id":"mon_luoc","kind":"food_category","baseLabel":"Món luộc"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv0118t8m1ho51ih2q#variant-1","name":"Bún riêu ốc","detail_name":"Bún riêu ốc","category":"Món nước","age_group":null,"serving":{"raw":"485 g / Tô vừa","quantity_value":485,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Bún tươi","quantity_raw":"180 g","quantity_value":180,"quantity_unit":"g"},{"name":"Ốc bươu","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Tiết heo (lợn) luộc","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đậu phụ chiên","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hoa chuối","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"12 g","quantity_value":12,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1.5 g","quantity_value":1.5,"quantity_unit":"g"}],"instructions_raw":"Cua đồng tách mai, rửa sạch ( gạch cua ở trong mai khều bỏ riêng) giã nhuyễn thân cua hoặc xay, đổ nước và muối , hạt nêm ( có thể bỏ muối từ lúc giã thì giã sẽ đỡ văng) khấy đều cho tan thịt cua, lọc bằng rá hoặc lưới bỏ bã đi, gạn lấy nước bỏ cặn ở đáy, để trong xoong 15 phút cho lắng xuống và bật bếp nấu lửa thật nhỏ, không đảo, không quấy trong khi nấu. Khi thấy riêu cua nổi lên trên mặt nước thành tảng thì mở lửa lớn hơn chút cho đủ sôi rồi tắt bếp. Huyết heo luộc chín nêm chút muối cho huyết heo ngon hơn. Đậu phụ cắt khoảng 2 cm x 4cm, cho dầu ăn vào chảo, đun nóng dầu cho đậu phụ vào rán ( chiên) cho vàng. Làm ốc: lấy dao nhỏ cắt miếng chắn ở miệng ốc rồi dùng ngón tay nhấn vào miệng ốc cho ruột ốc tụt vào trong làm đứt những màng bám của ruột vào vỏ ốc, cho qua thau (chậu nhỏ) để khoảng 10 phút thì cầm vỏ ốc vảy cho ruột ốc bung ra, trường hợp chưa bung thì phải dùng nĩa nhỏ khêu lấy ra. Sau đó dùng dao nhọn loại nhỏ để bóc tách phần màu đen mà mềm ở phần ruột ốc đó là chất thải bỏ đi. Vắt 1 -2 quả chanh lấy nước cho vào để 1 phút rồi bóp đều và rửa, bỏ thêm 8 muỗng dấm ngâm 2 phút rối rửa sạch cho hết nhớt. Mỗi ruột ốc thái làm 2 hoặc để nguyên tuỳ con lớn hay nhỏ, cho vào 1 tô lớn ướp với nước bột nghệ và 1 muỗng nhỏ bột nêm cùng 1 chút nước mắm, khoảng 20 phút. Thái mỏng 4 củ hành khô cho vào chảo dầu nóng phi vàng thì đổ ốc vào xào đảo nhanh tay khoảng3 - 4 phút cho ốc vừa chín tới thì đổ ra đĩa. Cho dầu vào chảo xào chín gạch cua rồi gạn nước ốc trả lại chảo và đổ dấm đã lọc bỏ bã vào nấu sôi rồi đổ ra tô để riêng. Khi chuẩn bị ăn cho sườn vào lại nước dùng nấu cho nóng, khi sôi thì cho đậu phụ chiên, huyết heo vào luôn, rồi lấy cà chua mỗi quả bổ dọc làm 6 miếng ( bổ cau) cho vào nước chờ nấu sôi 1 phút là dùng chan vào tô bún được. Cho bún chần nước sôi (trụng nóng) cho vào tô đủ ăn, vớt đậu phụ nóng, vớt một miếng riêu cua bỏ vào, cho ốc rồi rắc hành lá + rau thơm + ngò đã thái nhỏ, cho 4- 5 muỗng dấm đã nấu sôi cùng gạch cua- tuỳ khẩu vị thích chua nhiều hay ít, rắc thêm chút tiêu xay, cuối cùng cho nước dùng đang sôi vào cho ngập cái trong tô. Rau muống chẻ, hoa chuối thái, xà lách thái nhỏ, ớt băm, mắm tôm, tất cả để riêng (ai ăn được mắm tôm cho 1/2 muỗng ) những thứ này để cho vào tô bún đang nóng ăn kèm khi ăn.","nutrition":{"kcal":504.8,"protein_g":25.7,"fat_g":15.5,"carbs_g":66.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv0118t8m1ho51ih2q","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Ốc bươu","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:cua ong","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mam tom","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw0170t8m1ouc7bj7s#variant-1","name":"Cá hú/ cá basa kho tiêu","detail_name":"Cá hú/ cá basa kho tiêu","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"49 g / Dĩa nhỏ","quantity_value":49,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá mỡ/cá hú/cá basa","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cá mua về cắt khúc vừa ăn rửa sạch, ướp với gia vị trong 30 phút. Hành củ lọt vỏ băm nhuyễn. Bắt nồi lên bếp cho đường và nước vào đun nhỏ lửa đến khi đường có màu cánh gián. Kế tiếp xếp cá vào nồi cùng với hành băm, nêm thêm gia vị cho vừa ăn, kho lửa nhỏ đến khi cá có màu nâu thì tắt bếp.","nutrition":{"kcal":86.8,"protein_g":6.8,"fat_g":5.7,"carbs_g":2.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw0170t8m1ouc7bj7s","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Cá mỡ/cá hú/cá basa","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Nước mắm cá","title_ingredient_not_mentioned:Cá mỡ/cá hú/cá basa","unlisted_ingredient_phrase:uong co","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qx01e0t8m1kcft8u6y#variant-1","name":"Cải chua xào thịt heo","detail_name":"Cải chua xào thịt heo","category":"Món xào 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"126.5 g / Dĩa vừa","quantity_value":126.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dưa cải bẹ","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Thịt heo rửa sạch, cắt miếng nhỏ Dưa cải cắt miếng nhỏ, rửa sạch, vắt khô Cho dầu vào chảo đung nóng, cho thịt heo vào đảo cho săn. Tiếp tục cho dưa cải vào xào với thịt. Thịt và dưa cải săn lại thì cho bột nêm vào cho vừa ăn, đậy nắp lại cho dưa cải mêm và thấm hơn Dưa và thịt đã chín thì tắt bếp và cho ra dĩa","nutrition":{"kcal":148.1,"protein_g":5.9,"fat_g":12,"carbs_g":4.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qx01e0t8m1kcft8u6y","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:thit va","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào 8-18 tuổi","id":"mon_xao_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qy01hkt8m13f5ng5yf#variant-1","name":"Canh bí đỏ nấu thịt heo","detail_name":"Canh bí đỏ nấu thịt heo","category":"Món canh","age_group":null,"serving":{"raw":"90.5 g / Chén","quantity_value":90.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Bí đỏ (bí ngô)","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Bước 1: Chuẩn bị bí đỏ Sau khi mua bí về bạn gọt sạch vỏ, rửa sạch, cắt nhỏ bí thành những miếng vừa ăn Bước 2: Chuẩn bị hành, rau mùi Hành lá và rau mùi bạn đem rửa sạch cắt thành từng khúc nhỏ. Bước 3: Chuẩn bị thịt Thịt nạc băm bạn cho vào bát ướp gia vị, bạn cho một ít hành lá băm nhuyễn vào + một ít hạt tiêu + đường + 1 ít muối sau đó bạn trộn đều chúng lại với nhau và ướp hỗn hợp này khoảng 15 phút cho thịt thấm đều gia vị. Bước 4: Xào thịt Sau khi thịt thấm đều gia vị, bạn bắt một cái nồi lên bếp, cho một ít dầu ăn vào, đun cho dầu ăn nóng lên sau đó bạn cho một ít hành vào phi cho thơm, sau đó cho hỗn hợp thịt này vào xào cho đến khi thịt chín. Khi thịt đã chín bạn cho vào nồi khoảng 3 bát lớn nước bật lửa lớn lên đun cho nước thật sôi, lưu ý trong quá trình đun sôi bạn nên thường xuyên vớt bọt để làm cho nồi canh thêm ngon hơn, nước không bị đục. Bước 5: Nấu canh bí đỏ Quan sát thấy nước sôi lên, bạn cho hết phần bí vào nồi tiếp tục nấu khoảng 5 phút nữa cho đến khi bí chín và mềm thì thôi. Sau khi bí chính bạn tiến hành nêm nếm gia vị lại một lần nữa cho vừa ăn, kế tiếp bạn cho phần hành lá và rau mùi đã chuẩn bị sẵn vào nồi đảo nhanh tay sau đó tắt bếp.\"","nutrition":{"kcal":52.7,"protein_g":1.3,"fat_g":2.8,"carbs_g":5.6},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qy01hkt8m13f5ng5yf","quality_status":"needs_review","warnings":["duplicate_identical_catalog_metadata","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Bí đỏ (bí ngô)","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:lon nuoc","unlisted_ingredient_phrase:nau canh"],"source_categories":[{"label":"Món canh","id":"mon_canh","kind":"food_category","baseLabel":"Món canh"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qy01i5t8m1xvevt4ag#variant-1","name":"Canh cà chua cá thác lác","detail_name":"Canh cà chua cá thác lác","category":"Món canh 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"96.8 g / Chén","quantity_value":96.8,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cà chua","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Cá nạc/cá thác lác","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"- Sơ chế: Cá thác lác mua về nêm chút gia vị cho vào cối quết đến khi dẻo lại (để khỏi dính cối trước khi quết cho vào cối tí dầu ăn). Sau khi quết xong thì bỏ thì là đã thái nhuyễn vào trộn đều. Cà chua rửa sạch. Một quả băm nhuyễn. Hai quả còn lại cắt múi cau. - Chế biến Cho một tí dầu ăn vào nồi, phi hành cho thơm. Sau đó cho phần cà chua băm nhuyễn vào xào cho ra màu. Đổ nước vào nấu sôi khoảng 70 độ thì lấy muỗng phết cá thác lác miếng vừa ăn bỏ vào nồi nước. Đến khi sôi bùng khoảng 5 phút thì cho phần cà chua cắt múi cau vào. Để khoảng 2 phút nữa thì hạ lửa, cho chút nước mắm, nêm nếm vừa ăn sau đó tắt bếp và bỏ phần hành lá cùng rau mùi đã thái còn lại vào.","nutrition":{"kcal":33.1,"protein_g":2.4,"fat_g":1.3,"carbs_g":3.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qy01i5t8m1xvevt4ag","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 6-7 tuổi","id":"mon_canh_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01mkt8m1waupozi5#variant-1","name":"Canh chua hến","detail_name":"Canh chua hến","category":"Món canh từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"64.5 g / Chén","quantity_value":64.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Hến","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Đậu bắp","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Bạc hà (dọc mùng)","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Quả me chua","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Rau mùi tàu/ Ngò gai","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Cà chua rửa sạch cắt múi cau. Đậu bắp rửa sạch cắt khúc, dọc mùng tước sạch vỏ, xắt mỏng bóp muối rửa sạch Nghêu mua về rửa sạch cho hết cát rồi xào chung với cà chua cùng với gia vị. Xào đến khi cà chua chín thì cho nước vào nấu sôi Bỏ me ra bát, dùng nước canh sôi để dầm me, me dầm đến khi nước me trong lại thì thôi Cuối cùng cho bạc hà, đậu bắp vào nêm nếm rồi tắt bếp. Rắc ngò gai, rau ôm, quế cắt nhuyễn lên trên rồi thưởng thức","nutrition":{"kcal":28.7,"protein_g":1.1,"fat_g":0.2,"carbs_g":5.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01mkt8m1waupozi5","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","recipe_name_ingredient_not_mentioned_in_method"],"integrity_findings":["ingredient_not_mentioned_by_name:Hến","ingredient_not_