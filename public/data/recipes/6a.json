0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"1.Cải xoong nhặt và rửa sạch, để ráo nước, lấy lá căt nhuyễn 2.Thịt bò rửa sạch, cắt lát mỏng, băm nhuyễn. 3.Phi thơm tỏi băm với dầu ăn, cho thịt bò vào, xào sơ rồi vớt ra đĩa 4.Cũng trong nồi vừa xào thịt, thêm vào nước lọc, đun sôi thì thả rau vào. Khi nước sôi lại thì cho thịt vừa xào vào, nêm nếm gia vị vừa ăn, khuấy đều rồi tắt bếp.","nutrition":{"kcal":20,"protein_g":1.6,"fat_g":1.2,"carbs_g":0.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01kxt8m138v12lv1","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nuoc loc"],"source_categories":[{"label":"Món canh từ 18-24 tháng tuổi","id":"mon_canh_tu_18_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"18-24 tháng","id":"18_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01ngt8m1zj7x8egq#variant-2","name":"Canh đu đủ xanh nấu thịt heo","detail_name":"Canh đu đủ xanh nấu thịt heo","category":"Món canh từ 18-24 tháng tuổi","age_group":null,"serving":{"raw":"31.5 g / Chén","quantity_value":31.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đu đủ xanh","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc vai","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Thịt rửa sạch. Xay nhuyễn, ướp thịt bằm với gia vị vừa ăn. Trộn đều và ướp khoảng 30 phút cho thịt thấm đều gia vị. Đu đủ mua về dùng dao khứa nhiều vết trên vỏ đu đủ xanh, sao cho đu đủ ra hết nhựa trắng, rửa sạch. Sau đó gọt bỏ phần vỏ, bỏ hạt rồi cắt thành từng miếng vuông vừa ăn. Ngâm đu đủ trong nước muối loãng khoảng 15 phút để sạch mủ. Nấu canh Bắc chảo lên bếp, cho dầu ăn vào. Dầu nóng, các bạn cho tiếp tỏi băm vào phi thơm. Tiếp tục cho phần thịt heo băm vào xào nhanh tay khoảng 2 phút ở lửa lớn để thịt chín sơ. Đổ nước vào nồi, khi canh sôi cho đu đủ vào và nêm nếm gia vị vừa ăn.","nutrition":{"kcal":36.1,"protein_g":1.2,"fat_g":2.8,"carbs_g":1.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01ngt8m1zj7x8egq","quality_status":"unmatched","warnings":["duplicate_listing_row_occurrence","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nau canh","unlisted_ingredient_phrase:trong nuoc","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món canh từ 18-24 tháng tuổi","id":"mon_canh_tu_18_24_thang_tuoi","kind":"food_category","baseLabel":"Món canh từ 18-24 tháng tuổi"}],"source_age_group":null,"source_tag_evidence_status":"catalog_capture_unmatched_to_detail"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01nrt8m1eynijce6#variant-1","name":"Canh đu đủ xanh nấu tôm","detail_name":"Canh đu đủ xanh nấu tôm","category":"Món canh 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"83.8 g / Chén","quantity_value":83.8,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Đu đủ xanh","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"}],"instructions_raw":"Đu đủ gọt vỏ rửa sạch cắt lát mỏng. Tôm rửa sạch lột vỏ dã dập. Rồi ướp tôm với chút gia vị Bắc nồi lên bếp với dầu ăn phi thơm hành tím, cho tôm lên xào săn rồi thêm nước vào. Nước sôi cho đu đủ lên nấu mềm rồi nêm vừa ăn. Cuối cùng cho hành lá vào l