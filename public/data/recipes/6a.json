ntegrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Xì dầu","ingredient_not_mentioned_by_name:Đường kính","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05hyt8m1fpeiwtyg#variant-1","name":"Ức gà kho sả","detail_name":"Ức gà kho sả","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"60 g / Dĩa nhỏ","quantity_value":60,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt gà công nghiệp, lườn","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Chặt thịt gà thành miếng vừa ăn. Băm nhuyễn hành củ, sả thái nhỏ. Ướp thịt gà với sả, gia vị, để khoảng 15phút. Đun nóng dầu, phi thơm hành băm, cho gà vào chảo. Xào gà trên lửa lớn cho thấm gia vị. Thêm nước vào kho cho đến khi miếng gà mềm và thấm, nêm nếm vừa ăn, tắt bếp.","nutrition":{"kcal":97.4,"protein_g":9.4,"fat_g":5,"carbs_g":4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05hyt8m1fpeiwtyg","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Sả cây","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:uop thit"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05ljt8m12j2xdr0x#variant-1","name":"Vịt trộn chua ngọt","detail_name":"Vịt trộn chua ngọt","category":"Món xào 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"113.3 g / Dĩa vừa","quantity_value":113.3,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.1 g","quantity_value":0.1,"quantity_unit":"g"}],"instructions_raw":"Thịt vịt sau khi mua về bạn dùng muối xát đều lên da để khử mùi hôi hiệu quả. Sau đó, rửa lại với 3 lần nước sạch. Chuẩn bị một âu nước lạnh nhỏ. Bóc vỏ hành tây, rửa sạch rồi thái thành sợi mỏng và cho hết vào âu nước lạnh ngâm trong khoảng 15 – 20 phút cho bớt mùi hăng. Rau răm nhặt những lá non rồi mang rửa sạch và vớt ra rổ để ráo nước. Tỏi bóc lớp vỏ khô bên ngoài rồi dùng dao băm nhuyễn Đậu phụng mang đi rang chín đều. Sau đó, xa vỏ và cho vào cối giã nhỏ vừa phải, đừng mịn quá. Cà rốt gọt vỏ, rửa sạch, cắt sợi nhuyễn. Bạn pha nước chấm: nước cốt chanh, nước mắm, đường, nước trắng, ớt, tỏi băm nhuyễn. Nhớ trộn đều cho các nguyên liệu quyện đều vào nhau nhé. Vịt sau khi sơ chế xong, bạn mang luộc chín. Sau đó, vớt ra để ráo nước, đợi nguội rồi xé sợi. Chuẩn bị một âu sạch. Tiến hành cho lần lượt các nguyên liệu vào chung, gồm: thịt vịt xé sợi, hành tây, cà rốt, rau răm đã được sơ chế. Rưới nước chấm vào âu nguyên liệu ở bước 2 rồi trộn đều và để yên khoảng 15 phút cho nước chấm thấm đều vào nguyên liệu. Cuối cùng, bạn rắc đậu phụng đập nhỏ và một ít tiêu xay lên trên rồi dọn ra dĩa, trang trí tùy thích và mời mọi người thưởng thức.","nutrition":{"kcal":162.1,"protein_g":8.3,"fat_g":8.9,"carbs_g":12.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05ljt8m12j2xdr0x","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phộng (lạc hạt)","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc cot","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào 8-18 tuổi","id":"mon_xao_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món xào"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"}]