l":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65i02wtt8m13t5hmnqd#variant-1","name":"Gỏi măng chua","detail_name":"Gỏi măng chua","category":"Món luộc","age_group":null,"serving":{"raw":"156.2 g / Dĩa vừa","quantity_value":156.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Măng chua","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau răm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đậu phộng (lạc hạt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Thịt mua về, rửa sạch, luộc chín, cắt miếng vừa ăn. Măng chua mua về rửa thật sạch cho bớt chua rồi cho vào nồi nước đang sôi luộc sơ và vớt ra xả qua nước lạnh, để ráo nước.Hành tây bóc vỏ, rửa sạch, cắt khoanh mỏng. Hành tỏi lột vỏ, giã dập. Ớt băm nhuyễn. Cho nước mắm vào chén cùng chanh và đường, nêm nếm vừa ăn theo ý thích là được. Đậu phộng rang chín, xát bỏ vỏ, giã hơi nát. Rau răm rửa sạch, để ráo và cắt nhỏ. Sau đó cho măng chua vào một tô lớn, thịt, hành tây, thêm rau, ớt, tỏi cùng nước mắm vừa làm rồi trộn thật đều lên.Tùy khẩu vị mỗi gia đình mà bạn nêm nếm lại nha. Gắp gỏi ra dĩa và thưởng thức ngay nhé. Nộm măng chua với cách làm đơn giản, nhanh chóng, thơm ngon, giòn giòn kèm vị chua chua khá kích thích vị giác đấy. Chị em nhanh tay lưu ngay công thức lại và làm ăn nhé.","nutrition":{"kcal":196.1,"protein_g":7.7,"fat_g":12.3,"carbs_g":13.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65i02wtt8m13t5hmnqd","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món luộc","id":"mon_luoc","kind":"food_category","baseLabel":"Món luộc"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03j0t8m1g4iuju8x#variant-1","name":"Miến măng vịt","detail_name":"Miến măng vịt","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"279.5 g / Tô vừa","quantity_value":279.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Miến dong khô","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt vịt","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Măng khô","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: vịt làm sạch sau đó xát vịt bằng gừng và rượu để mất đi mùi hôi. Tiếp theo rửa sạch vịt đã hết mùi bằng nước sạch sau đó để ráo nước tuy nhiên vẫn để một vài lát gừng lên mình vịt để vịt thơm ngon và hấp dẫn hơn. Bước 2: Măng cần được chọn những loại non sau đó đem ngâm nước để làm hết bụi bẩn có trên măng sau đó vắt khô và rửa sạch lại với nước. Bước 3: Bắc một nồi nước lên bếp sau đó khi nồi nước sôi thì cho măng vào và đun sôi cho tới khi măng mềm ra, tiếp theo vớt măng ra rổ và để ráo nước. Bước 4: Ngâm miến với nước nóng để miến mềm ra. Bước 5: Cho nồi lên bếp sau đó xào hành tỏi thơm dậy mùi. Sau đó xào măng lên cùng hành và tỏi. Bước 6: Bắc một nồi nước lên bếp sau đó cho vài lát gừng vào nồi và luộc vịt cho đến khi vịt chín. Sau khi vịt chín để nguội và chặt thịt vịt thành từng miếng nhỏ vừa ăn. Bạn có thể lọc thịt vịt để dễ ăn hơn. Bước 7: lấy nước dùng luộc vịt sau đó thả măng và hành tỏi đã sào vào nồi và đun sôi. Khi nước sôi trần qua miến sau đó cho thêm thịt vịt và miến vào từng bát dành cho các thành viên trong gia đình và nêm gia vị cùng rau thơm vừa đủ cho mỗi bát, dùng với rau ăn kèm.","nutrition":{"kcal":602.2,"protein_g":17.9,"fat_g":15.7,"carbs_g":97.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03j0t8m1g4iuju8x","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03j9t8m1wo31gh0c#variant-1","name":"Miến thịt heo","detail_name":"Miến thịt heo","category":"Món nước 3-4 t