:1.8,"fat_g":4,"carbs_g":7.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oo036nt8m18hq6csfu","quality_status":"missing_at_source","warnings":["instructions_missing_from_detail"],"integrity_findings":[],"source_categories":[{"label":"Món tự thiết kế","id":"mon_tu_thiet_ke","kind":"food_category","baseLabel":"Món tự thiết kế"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo038lt8m15x18q9sn#variant-1","name":"Lươn bọc lá lốt","detail_name":"Lươn bọc lá lốt","category":"Món mặn 25-35 tháng tuổi","age_group":"25-35 tháng","serving":{"raw":"52.5 g / Dĩa nhỏ","quantity_value":52.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Lươn","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Lá lốt","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tía tô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thái lươn thành những miếng dài cỡ ngón tay. Ướp lươn với một ít gia vị. Rửa sạch vài lá tía tô và lá lốt, vẩy sạch nước, thái sợi, cho vào bát thịt nạc xay. Trộn đều các nguyên liệu, gia vị lại với nhau. Trải miếng lươn ra thớt, cho hỗn hợp thịt xay vào giữa, cuộn tròn miếng lươn lại. Tiếp tục trải lá lốt ra thớt, cho cuộn lươn bọc thịt lên, cuộn lá lốt lại. Lấy hành hoa vừa chần buộc cố định lại để lá lốt không bị bung ra. Cho dầu ăn vào chảo, chờ dầu nóng già thì cho từng miếng lươn cuộn vào chảo, vặn nhỏ lửa/giảm nhiệt độ để lươn chín vàng mà lá lốt không bị cháy.","nutrition":{"kcal":96.6,"protein_g":6.4,"fat_g":4.2,"carbs_g":8.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oo038lt8m15x18q9sn","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Mộc nhĩ/ Nấm mèo","ingredient_not_mentioned_by_name:Sả cây","ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hanh hoa","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nguyen lieu"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03n2t8m16ax8etp5#variant-1","name":"Mực rôti","detail_name":"Mực rôti","category":"Món mặn","age_group":null,"serving":{"raw":"169.5 g / Dĩa vừa","quantity_value":169.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Mực tươi","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Mộc nhĩ/ Nấm mèo","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước dừa non tươi","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"- Mực rửa sạch để ráo. Nếu không cần giữ đầu mực để ghim cho đẹp, băm nhuyễn đầu mực rồi trộn chung vào nhân. Để thân mực vào rổ cho ráo. - Mộc nhĩ rửa sạch, băm nhuyễn. - Thịt lợn xay trộn chung với đầu mực, mộc nhĩ, hành tím, miến, nêm thịt với hạt tiêu, đường, muối, ít hạt nêm, trộn đều cho hỗn hợp nhân được thấm, để ướp khoảng 30 phút. - Dồn nhân vào thân mực, dùng tăm nhọn ghim ở phần đầu lại để nhân không bị đổ ra ngoài (không nên dồn mực quá đầy vì mực chín sẽ co lại). - Đun nóng dầu, đổ tỏi đã đập dập vào chảo phi thơm, cho mực vào chiên vàng. Khi mực đã săn vàng, cho vào nước tương, đường, nếu thích bạn có thể cho vào ít nước màu cho nước mực có màu đẹp, nêm hơi nhạt khi kho xong nước sốt rút lại sẽ không bị mặn, giảm nhỏ lửa liu riu và nấu tiếp tục cho đến khi nước sốt sánh lại là được.","nutrition":{"kcal":272.4,"protein_g":23.5,"fat_g":16.5,"carbs_g":8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03n2t8m16ax8etp5","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước dừa non tươi","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc mau","unlisted_ingredient_phrase:nuoc tuong"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03xat8m1ddy7sv7k#variant-1","name":"Phở bò xào","detail_name":"Phở bò xào","category":"Món khô 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"256 g / Dĩa nhỏ","quantity_value":256,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cải xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"8 g","quantity_value":8,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Thịt bò rửa sạch, thái lát mỏng, ướp gia vị. Cà rốt gọt vỏ, rửa sạch, thái lát mỏng. Cải xanh cắt gốc, rửa sạch, cắt khúc vừa ăn. Giá đậu xanh rửa sạch, để ráo. Bắt chảo lên bếp, thêm dầu ăn vào phi thơm tỏi, thêm thịt bò vào xào chín rồi vớt ra. Tiếp tục xào cà rốt, cải xanh, giá đậu xanh nêm gia vị vừa ăn. Sau đó thêm phở vào đảo đều đến chín, rồi thêm thịt bò vào đảo đều. Tắt bếp. Thêm rau mùi lên trên, ăn kèm với tương ngô, tương ớt.","nutrition":{"kcal":364.3,"protein_g":14.9,"fat_g":10.2,"carbs_g":54.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03xat8m1ddy7sv7k","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:tuong ot"],"source_categories":[{"label":"Món khô 6-7 tuổi","id":"mon_kho_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món khô"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_