khô"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv00xtt8m17sxg9x42#variant-1","name":"Bún cà ri tôm","detail_name":"Bún cà ri tôm","category":"Món nước","age_group":null,"serving":{"raw":"385.5 g / Tô nhỏ","quantity_value":385.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"180 g","quantity_value":180,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Khoai lang","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nước cốt dừa, đóng hộp","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Sả cây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cary bột","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Sả rửa sạch 1 cây băm nhỏ, 1 cây đập dập rồi cắt khúc. Tỏi cũng bóc vỏ rồi băm nhỏ. Khoai lang gọt vỏ, thái miếng vuông vừa ăn, ngâm vào bát nước muối pha loãng để khoai khỏi thâm. Cà rốt, hành tây bạn cũng thái miếng cỡ miếng khoai lang. Rau húng quế nhặt rửa sạch. Tôm rửa sạch, bóc vỏ, bỏ đầu, lấy chỉ lưng và bụng. Sau đó rửa sạch lại một lần nữa rồi để ráo nước. Tiếp theo ướp tôm với 1 chút tỏi và sả băm nhỏ, một ít hạt nêm, gia vị, ớt bột và 1 gói cà ri. Để khoảng 10 phút sau đó cho khoai vào chảo rán hơi vàng các mặt (hoặc chỉ cần se các mặt), sau đó gắp ra đĩa. Cho sả và tỏi vào phi thơm lên, cho tôm vào xào qua. Đổ khoảng 1 bát con nước vào nồi tôm, đun sôi sau đó bạn cho khoai và cà rốt vào nồi. Đun sôi hỗn hợp trong vài phút rồi cho hành tây và nước cốt dừa vào. Nêm thêm hạt nêm, gia vị và đun sôi thêm vài phút nữa rồi thả rau húng quế vào. Cuối cùng cho cà ri tôm ra bát, ăn cùng cơm, bánh mì hay bún đều rất ngon.","nutrition":{"kcal":437.7,"protein_g":17.4,"fat_g":10.8,"carbs_g":68.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv00xtt8m17sxg9x42","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:banh mi","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:rau hung","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw015ot8m1rh8wjqmy#variant-1","name":"Cá điêu hồng chiên sốt cà","detail_name":"Cá điêu hồng chiên sốt cà","category":"Món mặn","age_group":null,"serving":{"raw":"143.5 g / Dĩa nhỏ","quantity_value":143.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá điêu hồng","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành