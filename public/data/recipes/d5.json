 cho nước sôi, hạ lửa nhỏ hầm khoảng 30 phút để thịt vịt chín mềm. Lúc này bạn cho huyết, măng vào nấu sôi lại lần nữa rồi nêm nếm lại cho vừa ăn thì tắt bếp. Làm nước chấm Bạn cho phần tỏi băm còn lại, ớt, 1 muỗng canh đường cùng phần gừng còn lại vào cối giã nhuyễn. Sau đó, cho ra chén, cho 1 muỗng canh nước mắm và một muỗng cà phê nước cốt chanh vào khuấy đều là xong. Cho bún vào tô, xếp thịt vịt lên rồi chan nước dùng cùng với tiết vịt và măng vào. Thêm hành lá, rau mùi, ớt thái nhỏ lên trên. Khi thưởng thức bún măng vịt, bạn ăn kèm với rau sống và mắm gừng.","nutrition":{"kcal":649.4,"protein_g":23.4,"fat_g":19,"carbs_g":96.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv0100t8m11pv4dvml","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Hoa chuối","unlisted_ingredient_phrase:bot ngot","unlisted_ingredient_phrase:gia vi nau","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:rau ram","unlisted_ingredient_phrase:ruou trang","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw018st8m1awdnq38y#variant-1","name":"Cá lóc xào hành nấm","detail_name":"Cá lóc xào hành nấm","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"73.5 g / Dĩa nhỏ","quantity_value":73.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá quả (cá lóc)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Nấm hương tươi","quantity_raw"