atus":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nuoc khoang","unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món canh 6-7 tuổi","id":"mon_canh_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu027yt8m10zizyow5#variant-1","name":"Cháo thịt gà đậu xanh cải xanh","detail_name":"Cháo thịt gà đậu xanh cải xanh","category":"Cháo 9-12 tháng tuổi","age_group":"9-12 tháng","serving":{"raw":"81 g / Chén","quantity_value":81,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Thịt gà công nghiệp, đùi","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Cải xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"6 g","quantity_value":6,"quantity_unit":"g"}],"instructions_raw":"* Thịt gà rửa sạch, lọc lấy phần thịt đùi, băm nhuyễn. * Đậu xanh vo, ngâm bóc vỏ, rửa sạch, nấu đến chín mềm, tán nhuyễn. Cải xanh rửa sạch, cắt bỏ sống lá, lấy lá băm nhuyễn. * Hòa tan thịt gà với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng, bắc lên bếp khuấy đều cho đến khi sôi, thêm cải xanh và đậu xanh vào cho sôi lại. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":196.7,"protein_g":8,"fat_g":8.1,"carbs_g":22.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu027yt8m10zizyow5","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"i