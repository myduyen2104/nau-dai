ho hải sản chín, nêm nêm gia vị lại cho vừa ăn. Cho cà rốt, đậu hà lan vào đảo thêm 2 phút cho chín thì vớt ra. Bạn bắc chảo lên dầu nóng bạn phi thơm hành tím.Tiếp đó thêm cơm vào chiên trên lửa lớn, thêm nước sốt hải sản vào, chiên khoảng 5 phút cho hạt cơm ráo, khô lại, lâu lâu bạn đảo đều. Khi hạt cơm đã ráo bạn đập thêm trứng, đảo đều tay để trứng áo 1 lớp đều trên hạt cơm. Nêm nếm gia vị lại cho vừa ăn, thêm hỗn hợp hải sản vào đảo đều thêm 2 phút. Cuối cùng thêm tiêu xanh, hành lá vào đảo đều và tắt bếp.","nutrition":{"kcal":677.7,"protein_g":34.1,"fat_g":16.6,"carbs_g":99.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02gyt8m1izxk570i","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Trứng gà công nghiệp (50g/quả)","ingredient_not_mentioned_by_name:Cà chua","ingredient_not_mentioned_by_name:Dưa chuột/ Dưa leo","ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:au ha lan","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Cơm","id":"com","kind":"food_category","baseLabel":"Cơm"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02iet8m1fci96sak#variant-1","name":"Cua rang gừng","detail_name":"Cua rang gừng","category":"Món mặn","age_group":null,"serving":{"raw":"104 g / Dĩa nhỏ","quantity_value":104,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cua bế","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{