ty_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Bí đỏ (bí ngô)","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam"],"source_categories":[{"label":"Cháo 7-8 tháng tuổi","id":"chao_7_8_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"7-8  tháng","id":"7_8_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02sxt8m1ii84v1i2#variant-2","name":"Gà kho hành gừng","detail_name":"Gà kho hành gừng","category":"Món mặn","age_group":null,"serving":{"raw":"152.5 g / Dĩa vừa","quantity_value":152.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Thịt gà công nghiệp, đùi","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"24 g","quantity_value":24,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Ớt khô bột","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1.5 g","quantity_value":1.5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Dùng rượu trắng, muối hạt, gừng giã để xát vào gà cho sạch và khử mùi hôi của gà. Gà sau khi rửa sạch, các bạn chặt miếng nhỏ vừa ăn, ướp thêm nước mắm, hạt tiêu, thìa dầu ăn, 1 ít gừng, hạt nêm,ớt bột, tất cả trộn đều vào nhau, ướp trong vòng 15 phút. Hành củ bóc vỏ, băm nhuyễn. Hành lá nhặt sạch, cắt nhỏ. Gừng gọt vỏ, cắt sợi Bắc nồi, cho dầu ăn vào, đun đến nóng già, cho hành, gừng thái sợi vào phi thơm, hơi cháy 1 chút, cho 1 thìa nước mắm vào phi thơm cùng hành, gừng. Cho gà đã ướp vào xào cùng, đảo săn lên. Lưu ý đừng để lửa quá to, gà bị cháy sẽ khô, vị ngọt mềm trong gà cũng bị mất đi. Kho đến khi gà chín mềm, mùi hương ngào ngạt là được, nêm nếm thêm gia vị vừa ăn. Tắt bếp, trút gà ra đĩa, rồi đổ phần nước kho lên trên để miếng thịt có màu đẹp mắt, mềm mại, cho thêm ít lát ớt, cọng ngò trang trí. Món gà kho gừng đậm đà đưa cơm, ăn lúc nóng mới ngon.","nutrition":{"kcal":291.1,"protein_g":18.4,"fat_g":22,"carbs_g":6.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02sxt8m1ii84v1i2","quality_status":"unmatched","warnings":["duplicate_listing_row_occurrence","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:ruou trang"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"catalog_capture_unmatched_to_detail"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oo039bt8m1ff5ibvbc#variant-1","name":"Lươn om riềng giấm","detail_name":"Lươn om riềng giấm","category":"Món mặn từ 3-4 tuổi","age_group":"3-4 tuổi","serving":{"raw":"63 g / Dĩa nhỏ","quantity_value":63,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Lươn","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Riềng","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Nghệ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"n