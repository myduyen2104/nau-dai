:"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bu0277t8m1mkzj0zaz#variant-1","name":"Cháo thịt bò cà rốt phômai","detail_name":"Cháo thịt bò cà rốt phômai","category":"Cháo 13-24 tháng tuổi","age_group":"13-24 tháng","serving":{"raw":"100.5 g / Chén","quantity_value":100.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Pho mát","quantity_raw":"15 g","quantity_value":15,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"* Thịt bò cắt bỏ gân trắng, rửa sạch, băm nhuyễn. * Cà rốt gọt vỏ, rửa sạch. Đem đi luộc đến khi mềm, vớt ra để nguội, tán nhuyễn * Hòa tan thịt bò với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng, bắc lên bếp khuấy đều cho đến khi sôi, thêm cà rốt vào cho sôi lại. Sau đó cho phô mai vào. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":243.5,"protein_g":10.9,"fat_g":10.8,"carbs_g":25.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bu0277t8m1mkzj0zaz","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","ingredient_not_mentioned_by_name:Pho mát","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:pho mai"],"source_categories":[{"label":"Cháo 13-24 tháng tuổi","id":"chao_13_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"13-24 tháng","id":"13_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02s9t8m19tc1wgmy#variant-1","name":"Gà hấp cải bẹ xanh","detail_name":"Gà hấp cải bẹ xanh","category":"Món mặn 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"76 g / Dĩa nhỏ","quantity_value":76,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt gà công nghiệp, đùi","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Cải xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Nấm hương tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Bóp gà với ít muối, rửa sạch và để ráo nước, ướp gà với các loại gia vị, dùng đũa trộn đều cho gà thấm gia vị. Uớp gà trong vòng 15 phút cho gà thấm. Cắt bỏ gốc cải bẹ xanh, cắt bỏ bớt bớt lá cải, chỉ lấy phần cọng. Ngâm cải xanh vào trong 1 thau nước muối pha loãng trong vòng 5 phút. Sau đó, rửa sạch và để ráo. Cắt cải xanh thành đoạn tầm 6cm. Nấm hương rửa sạch, để ráo Bật bếp, bắt 1 cái nồi lên bếp, cho vào nồi 500ml nước và đun sôi. Gà sau khi ướp cho gà ra dĩa lớn, có đáy trũng. Nước sôi, cho vĩ hấp vào nồi, cho dĩa gà vào nồi, đập nắp lại hấp 10 phút. Mở nắp nồi gà đang hấp xả hơi. Tiếp tục cho cải bẹ xanh, nấm hương vào hấp thêm 5 phút nữa. Mở nắp nồi, kiểm tra xem gà đã chín thì bắt nồi gà đang hấp xuống bếp. Lấy 1 cái chén sạch, dùng dụng cụ gấp dĩa gà đang hấp ra, chắc toàn bộ nước gà vào chén. Đun sôi phần nước gà, lấy 1 cái chén sạch, cho vào bột dong và nước. Dùng muỗng quậy đều cho bột tan ra. Cho bột dong đã pha vào chảo nước sốt đang sôi, đổ bột từ từ và dùng đũa quậy nước sốt sền sệt là đạt. Cho thịt gà và cải xanh ra đĩa, chế nước sốt lên gà. chấm kèm nước tương. Chúc các bạn thành công nhé!","nutrition":{"kcal":98.6,"protein_g":7.9,"fat_g":4.8,"carbs_g":6.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02s9t8m19tc1wgmy","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Dầu thực vật","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:nuoc tuong"],"source_categories":[{"label":"Món mặn 6-7 tuổi","id":"mon_man_6_7_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"6-7 tuổi","id":"6_7_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03jpt8m1mo4wfou1#variant-1","name":"Miến tôm","detail_name":"Miến tôm","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"304.5 g / Tô vừa","quantity_value":304.5,"quantity_unit":"g","portion_label":"Tô vừa"},"ingredients":[{"name":"Miến dong khô","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}