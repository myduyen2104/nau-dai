 5 phút rồi cho tàu hủ ky vào đảo sơ qua rồi tắt bếp. Nước chấm: Cho vào chén tỏi, ớt, hạt nêm, đường rồi giã nát. Tiếp tục cho vào nước tương, nước lọc tiêu xay sau đó khuấy đều. \"","nutrition":{"kcal":579.3,"protein_g":21.3,"fat_g":28,"carbs_g":60.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv012tt8m19ff77f1m","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Xì dầu","unlisted_ingredient_phrase:bun gao","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc loc","unlisted_ingredient_phrase:nuoc tuong"],"source_categories":[{"label":"Món khô chay","id":"mon_kho_chay","kind":"food_category","baseLabel":"Món khô chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw019kt8m1jg943wt5#variant-1","name":"Cá ngừ kho","detail_name":"Cá ngừ kho","category":"Món mặn","age_group":null,"serving":{"raw":"97 g / Dĩa vừa","quantity_value":97,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cá ngừ","quantity_raw":"80 g","quantity_value":80,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Ớt khô bột","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Rửa sạch cá ngừ để ráo. Ướp vào cá bột nêm, nước mắm, tiêu trộn đều. Sau đó bạn chiên sơ cho cá vàng 2 mặt.Tiếp đến, bạn bắc chảo/ nồi lên bếp, dầu ăn, đường thắng đường cho có màu vàng cánh gián. Nhớ khi thắng đường các bạn lấy đũa khuấy cho đường tan. Chờ đến khi đường chuyển qua màu vàng tắt bếp rồi cho tỏi, hành, ớt vào xào cho thơm.Sau đó thì cho dứa và cà chua vào xào 4 phút. Tiếp theo cho nước dừa tươi vào nấu sôi.Cuối cùng bạn cho cá chiên vàng vào, lửa nhỏ rim cá cho thấm, rim cho tới khi cá sền sệt, nêm nếm lại cho vừa ăn là tắt bếp. Bạn cho cá ra tô, rắc hành và vài lát ớt và thưởng thức.","nutrition":{"kcal":130.6,"protein_g":17.1,"fat_g":5.3,"carbs_g":4.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw019kt8m1jg943wt5","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:ca chua","unlisted_ingredient_phrase:nuoc dua"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01kot8m1xx6mob05#variant-1","name":"Canh cải ngọt thịt heo","detail_name":"Canh cải ngọt thịt heo","category":"Món canh","age_group":null,"serving":{"raw":"57.5 g / Chén","quantity_value":57.5,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Cải xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":40.1,"protein_g":1.9,"fat_g":2.8,"carbs_g":1.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5br01kot8m1xx6mob05","quality_status":"missing_at_source","warnings":[