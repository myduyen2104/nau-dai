598.food/mon-an/cmrg0p4qx01dst8m17tuy6mvx","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hanh cu","unlisted_ingredient_phrase:hon hop","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5br01oat8m18vz524wa#variant-1","name":"Cánh gà sốt dầu hào","detail_name":"Cánh gà sốt dầu hào","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"65 g / Dĩa nhỏ","quantity_value":65,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt gà công nghiệp, cánh","quantity_raw":"40 g","quantity_value":40,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu hào maggi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Bột dong lọc","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Cánh gà rửa sạch, để ráo. Hành tây lột vỏ rửa sạch cắt khoanh. Tỏi ta bóc vỏ rửa sạch băm nhỏ. Đặt 1 cái chảo chiên sơ cánh gà , sau đó gặn bớt dầu ra , cho tiếp tỏi băm vào phi thơm , thả gà đã chiên vào chảo cho thêm dầu hào và nêm nếm lại cho vừa ăn. Pha bột dong lộc với nước đun sôi để nguội rồi cho vào chảo gà. Sau cùng tắt bếp, rắc thêm tiêu lên gà là có thể dùng được.","nutrition":{"kcal"