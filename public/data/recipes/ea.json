"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Sơ chế tất cả các nguyên liệu: Tôm bóc vỏ, lấy đường chỉ sống lưng, rửa sạch để ráo. Thịt heo rửa sạch, luộc sơ qua nước sôi cho sạch. Các loại rau nhặt sạch, rửa sạch, để ráo. Tôm để ráo nước đem rang chín, cho chút nước mắm. Thịt luộc chín thái mỏng, bún cắt ngắn.\" \"Cho giấm bỗng, đường đỏ và lạc rang (giả nhỏ) vào xoong chưng kỹ cho khô. Trải rau xà lách ra, đặt bún, tôm thịt, giấm bỗng chưng, thơm mùi vào rồi cuốn tròn lại (cuốn chắc tay). Món này dùng với nước mắm và cà cuống.\"","nutrition":{"kcal":227.7,"protein_g":18.7,"fat_g":12.7,"carbs_g":9.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02ist8m1arc3rebt","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Tần ô/cải cúc","ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Muối","ingredient_not_mentioned_by_name:Hạt tiêu","ingredient_not_mentioned_by_name:Tương ngô","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:tom thit","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02met8m15zq21i0a#variant-1","name":"Đậu hủ non thịt bằm sốt cà chua","detail_name":"Đậu hủ non thịt bằm sốt cà chua","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"79 g / Dĩa nhỏ","quantity_value":79,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Đậu phụ (đậu hũ)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"4 g","quantity_value":4,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Thịt rửa sạch, xay nhuyễn. Đậu hũ non mua sẵn ngoài chợ, cắt thành miếng nhỏ, hình vuông vừa ăn. Cà chua rửa sạch, cắt hạt lựu. Tỏi bóc vỏ, băm nhuyễn. Làm nóng dầu ăn, phi thơm tỏi. Cho thịt vào đảo đều, cà chua vào, đảo đều đến khi cà chua mềm. Thêm gia vị cho vừa ăn. Đổ nước vào, nấu sôi khoảng 1 phút. Tiếp theo, cho đậu hũ vào, nấu lim rim nhỏ lửa cho ngấm phần sốt. Dùng đũa trở nhẹ tay miếng đậu hũ. Chú ý không để miếng đậu hũ bị nát. Tắt bếp, cho món ăn ra đĩa.","nutrition":{"kcal":143.2,"protein_g":6.7,"fat_g":12.2,"carbs_g":2.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02met8m15zq21i0a","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)","unlisted_ingredient_phrase:au hu non","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02skt8m1gjl5anwt#variant-1","name":"Gà hấp lá chanh","detail_name":"Gà hấp lá chanh","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"75 g / Dĩa nhỏ","quantity_value":75,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt gà ta","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"}],"instructions_raw":"Gà rửa sạch để ráo. Sả cắt làm đôi đập dập, lá chanh rửa sạch. Tiếp theo rải đều muối xuống đáy nồi, xếp sả lên trên, cuối cùng rải 1 lớp lá chanh rồi đặt gà lên sao cho gà không dính muối. Rắc một vài lá chanh lên trên mặt gà rồi đậy vung lại hấp với lửa vừa, sau đó để lửa liu riu để gà được chín đều bên trong.","nutrition":{"kcal":143.8,"protein_g":14.3,"fat_g":9.2,"carbs_g":0.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65h02skt8m1gjl5anwt","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Thịt gà ta","ingredient_not_mentioned_by_name:Hạt tiêu","unlisted_ingredient_phrase:la chanh","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 8-18 tuổi","id":"mon_man_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65h02uct8m1jam5v7t9#variant-1","name":"Gà sốt chua ngọt","detail_name":"Gà sốt chua ngọt","category":"Món mặn","age_group":null,"serving":{"raw":"98.2 g / Dĩa nhỏ","quantity_value":98.2,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt gà công nghiệp, lườn","quantity_raw":"70 g","quantity_value":70,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value