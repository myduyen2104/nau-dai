[{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv0120t8m1q5msq0px#variant-1","name":"Bún thịt bò nấu cần","detail_name":"Bún thịt bò nấu cần","category":"Món nước từ 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"424.5 g / Tô nhỏ","quantity_value":424.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"220 g","quantity_value":220,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"60 g","quantity_value":60,"quantity_unit":"g"},{"name":"Cần ta","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau sà lách","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Xương bò rửa sạch, rồi để ráo nước. (Bạn có thể nướng xương bò bằng lò nướng trong khoảng 10 phút với cách làm này sẽ giúp bạn khử mùi gây của xương bò). Sau khi nướng xong, thì cho xương vào nồi chế ngập nước, nước sôi chắt phần nước bỏ đi rồi thêm nước đậy nồi áp suất và hầm khoảng 2 giờ. Sau đó chắt lấy nước xương để riêng. (Bước này nên chuẩn bị từ tối để tiết kiệm thời gian) Bước 2: Cà chua, rau cần, hành hoa, mùi rửa sạch. Cà chua bổ múi cau, rau cần cắt khúc. Hành hoa, mùi thái nhỏ. Bước 3: Thịt bò thái mỏng. (Nếu thích bạn có thể ướp thêm một chút xíu gia vị). Bước 4: Phi thơm hành khô băm nhỏ cho cà chua vào xào, nêm 1 thìa bột nêm cho cà chua mau mềm. Bước 5: Cho phần cà chua vừa xào vào nồi nước dùng xương, nêm nếm gia vị cho vừa miệng. Bước 6: Trong lúc đợi nồi nước dùng xương sôi thì trần bún qua nước sôi xếp vào tô. Nước dùng sôi hạ bớt lửa, cho rau cần, thịt bò vào chần, riêng rau cần nhúng chín rồi xếp vào tô bún cùng ít hành răm thái nhỏ, vài lát ớt hiểm rồi từ từ chan nước dùng ngập bún.","nutrition":{"kcal":448.7,"protein_g":19.1,"fat_g":12.5,"carbs_g":65.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv0120t8m1q5msq0px","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:bot nem","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:xuong bo"],"source_categories":[{"label":"Món nước từ 8-18 tuổi","id":"mon_nuoc_tu_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qv012yt8m1ds9jj0jx#variant-1","name":"Bún xáo vịt","detail_name":"Bún xáo vịt","category":"Món nước","age_group":null,"serving":{"raw":"383.5 g / Tô nhỏ","quantity_value":383.5,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bún tươi","quantity_raw":"200 g","quantity_value":200,"quantity_unit":"g"},{"name":"Thịt vịt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn), nạc thăn","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Măng tre","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Rau muống","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Rau thơm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Vịt làm sạch, lọc thịt ở cổ, cánh, chân và xương sống đem giần kỹ rồi băm nhuyễn cho thịt nạc vai vào băm lẫn, nêm vừa mắm, muối, hạt tiêu trộn kỹ cho dẻo quánh rồi viên thành từng viên nhỏ. Phần thịt còn lại cho vào nước luộc chín, vớt ra để nguội chặt miếng bày dĩa. Măng thái mỏng, luộc chín vớt ra để ráo. Hành hoa nhặt rửa sạch,thái nhỏ,phần gốc và lá để riêng.\" Cho dầu vào chảo đun nóng già,phi thơm hành bỏ măng vào đảo đều.Nêm mắm muối cho ngấm đều vào măng rồi trút sang nồi nước luộc thịt vịt đun sôi, thả các thịt viên chín,nêm vừa mắm,muối rồi thả hành hoa. Lúc ăn lấy bún vào bát to, chan xáo măng ngập bún. Ăn với thịt vịt luộc, chấm nước mắm chanh ớt tỏi.\"","nutrition":{"kcal":524.3,"protein_g":19,"fat_g":22.3,"carbs_g":62.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qv012yt8m1ds9jj0jx","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Rau muống","ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hat tieu","unlisted_ingredient_phrase:nac vai","unlisted_ingredient_phrase:nuoc mam"],"source_categories":[{"label":"Món nước","id":"mon_nuoc","kind":"food_category","baseLabel":"Món nước"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw0149t8m19mky52uh#variant-1","name":"Cá chim chiên","detail_name":"Cá chim chiên","category":"Món mặn 18-24 tháng tuổi","age_group":"18-24 tháng","serving":{"raw":"28 g / Dĩa nhỏ","quantity_value":28,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Cá chim","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"4 g","quantity_value":4,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"}],"instructions_raw":"Cá chim rửa sạch, để ráo. Tỏi bóc vỏ, băm nhuyễn. Đun nóng dầu, cho cá vào chiên lửa vừa, vàng đều hai mặt là được. Pha nước chắm: cho vào chén đường, nước chín, khuấy tan, thêm nước mắm, tỏi băm, nước cốt chanh, nêm nếm vừa ăn.","nutrition":{"kcal":68.8,"protein_g":3.7,"fat_g":5.3,"carbs_g":2.1},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p4qw0149t8m19mky52uh","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:nuoc cot"],"source_categories":[{"label":"Món mặn 18-24 tháng tuổi","id":"mon_man_18_24_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"18-24 tháng","id":"18_24_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p4qw0157t8m1zg8d4yzp#variant-1","name":"Cá cơm/ cá bống kho tiêu","detail_name":"Cá cơm/ cá bống kho tiêu","category":"Món mặn 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"134.5 g / Dĩa vừa","quantity_value":134.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Cá bống","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) mỡ ( thịt ba rọi)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"2 g","quantity_value":2,"quan