 nóng chiên chim hơi vàng rồi vớt ra để ráo dầu. Kế tiếp phi thơm hành tơi trong 1 cái nồi cùng với dầu ăn, sau đó cho chim đã chiên vào đảo đều. Cho nước dừa non vào cùng với cà rốt, hạt sen, táo tàu, hầm trên lửa nhỏ trong 30 phút. Sau cùng khi chim đã mềm thì nêm nếm gia vị lại cho vừa ăn rồi múc ra tô là có thể dùng được.","nutrition":{"kcal":88,"protein_g":4.6,"fat_g":5.5,"carbs_g":5.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65f02f3t8m1suysqu2a","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Gừng tươi"],"source_categories":[{"label":"Món mặn 25-35 tháng tuổi","id":"mon_man_25_35_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"25-35 tháng","id":"25_35_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p65g02k2t8m1k9g2bzyc#variant-1","name":"Đậu hủ chiên chấm tương","detail_name":"Đậu hủ chiên chấm tương","category":"Món chay","age_group":null,"serving":{"raw":"160 g / Dĩa nhỏ","quantity_value":160,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Đậu phụ (đậu hũ)","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Nước tương MAGGI Đậu Nành Đậm Đặc - NESTLÉ","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"}],"instructions_raw":"Cắt đậu hũ thành miếng vừa ăn. Chiên lên đến khi giòn cả 2 mặt. Ăn cùng nước tương","nutrition":{"kcal":150,"protein_g":16.7,"fat_g":8.1,"carbs_g":2.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p65g02k2t8m1k9g2bzyc","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Đậu phụ (đậu hũ)"],"source_categories":[{"label":"Món chay","id":"mon_chay","kind":"food_category","baseLabel":"Món chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_met