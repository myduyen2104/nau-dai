bel":"Chén"},"ingredients":[{"name":"Củ từ","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"\"Khoai từ gọt vỏ rồi rửa sạch để ráo và cắt miếng vừa ăn. Cho nồi lên bếp cho ít dầu ăn vào chờ dầu nóng cho ít hành băm vào phi thơm rồi cho thịt bằm vào xào. Cho nước vào đun sôi Khi nước sôi thì cho khoai từ vào nấu chín nêm lại cho vừa ăn rồi cho đầu hành lá vào rồi tắt bếp\"","nutrition":{"kcal":57.7,"protein_g":1.5,"fat_g":2.8,"carbs_g":6.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01qtt8m173ohbmp7","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hanh la","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món canh 5 tuổi","id":"mon_canh_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bs01u0t8m176r6q022#variant-1","name":"Canh rau dền cơm nấu thịt heo","detail_name":"Canh rau dền cơm nấu thịt heo","category":"Món canh 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"112.2 g / Chén","quantity_value":112.2,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Rau giền cơm","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Thịt heo (lợn) nạc","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Rau dền nhặt bỏ lá già, rửa sạch, cắt nhỏ. Thịt nạc heo rửa sạch, băm nhuyễn ướp với gia vị vừa ăn Đầu tiên đặt nồi lên bếp, cho dầu ăn vào nồi sau đó cho hành vào phi thơm lên. Tiếp đến ta cho thịt băm vào đảo săn lại rồi đổ nước vào nấu sôi lên. Khi nước sôi bạn cho rau dền vào nấu khoảng 4-5 phút cho rau chín, trong khi nấu ta nêm nếm gia vị cho vừa miệng sau đó tắt bếp.","nutrition":{"kcal":75.7,"protein_g":5.5,"fat_g":4.8,"carbs_g":2.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bs01u0t8m176r6q022","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món canh 8-18 tuổi","id":"mon_canh_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món canh"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bv029qt8m1woggcw0s#variant-1","name":"Cháo tim heo hành tây rau cần","detail_name":"Cháo tim heo hành tây rau cần","category":"Cháo 9-12 tháng tuổi","age_group":"9-12 tháng","serving":{"raw":"77 g / Chén","quantity_value":77,"quantity_unit":"g","portion_label":"Chén"},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Tim heo (lợn)","quantity_raw":"25 g","quantity_value":25,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cần tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Dầu mè","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"}],"instructions_raw":"* Tim heo rửa qua muối, sau đó rửa sạch lại bằng nước, băm nhuyễn. * Hành tây gọt vỏ, rửa sạch, băm nhuyễn. Rau cần tây rửa sạch, lấy lá băm nhuyễn. * Hòa tan tim heo với 1/3 chén nước nguội, dùng đũa đánh đều, cho vào nồi cùng 2/3 chén cháo trắng, bắc lên bếp khuấy đều cho đến khi sôi, thêm hành tây và rau cần tây vào cho sôi lại. Nêm nhạt với muối iốt hoặc vài giọt nước mắm. Tắt bếp, đỗ ra chén rồi cho dầu vào.","nutrition":{"kcal":182.9,"protein_g":6.3,"fat_g":8.1,"carbs_g":21.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bv029qt8m1woggcw0s","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Gạo tẻ máy","unlisted_ingredient_phrase:hoa tan","unlisted_ingredient_phrase:nuoc mam"],"source_categories":[{"label":"Cháo 9-12 tháng tuổi","id":"chao_9_12_thang_tuoi","kind":"age_scoped_food_category","baseLabel":"Cháo"}],"source_age_group":{"label":"9-12 tháng","id":"9_12_thang"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p5bv02aot8m1rkcjiy62#variant-1","name":"Cháo tôm rau mồng tơi","detail_name":"Cháo tôm rau mồng tơi","category":"Món nước","age_group":null,"serving":{"raw":"291.7 g","quantity_value":291.7,"quantity_unit":"g","portion_label":null},"ingredients":[{"name":"Gạo tẻ máy","quantity_raw":"75 g","quantity_value":75,"quantity_unit":"g"},{"name":"Rau mồng tơi","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Tôm đồng","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường cát","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Hạt nêm Knorr","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":null,"nutrition":{"kcal":415,"protein_g":26.5,"fat_g":5.6,"carbs_g":64.8},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p5bv02aot8