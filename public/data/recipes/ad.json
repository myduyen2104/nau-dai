"https://dinhduong2598.food/mon-an/cmrg0p7gi05cst8m1bv2z2tnj","quality_status":"complete","warnings":[],"integrity_findings":["ingredient_not_mentioned_by_name:Muối"],"source_categories":[{"label":"Món mặn từ 3-4 tuổi","id":"mon_man_tu_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rw05gzt8m1gt3k8zoi#variant-1","name":"Trứng vịt chiên cà chua","detail_name":"Trứng vịt chiên cà chua","category":"Món mặn","age_group":null,"serving":{"raw":"90.5 g / Dĩa nhỏ","quantity_value":90.5,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Trứng vịt (55g/quả)","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Nước mắm cá","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Hạt tiêu","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Cà chua rửa sạch, cắt hạt lựu. Hành lá lột sạch, rửa cắt nhỏ. Trứng vịt đập tách vỏ cho vào tô, đánh đều với gia vị và hành lá cắt nhỏ. Đầu hành đập dập cho vào chảo dầu nóng phi thơm, sau đó trút cà chua vào xào, nêm ít gia vị, tiếp theo đỗ trứng vào, chiên đến khi trứng chín vàng đều thì tắt bếp.","nutrition":{"kcal":137.9,"protein_g":6.9,"fat_g":11.1,"carbs_g":3.2},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rw05gzt8m1gt3k8zoi","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Nước mắm cá","unlisted_ingredient_phrase:o trung"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05kst8m1mujucrpk#variant-1","name":"Vịt quay tiêu","detail_name":"Vịt quay tiêu","category":"Món mặn 5 tuổi","age_group":"5 tuổi","serving":{"raw":"79 g / Dĩa nhỏ","quantity_value":79,"quantity_unit":"g","portion_label":"Dĩa nhỏ"},"ingredients":[{"name":"Thịt vịt","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Cà rốt","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Gừng tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Hành củ tươi","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu hào maggi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Tỏi ta","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Sơ chế thịt vịt Thịt vịt sau khi mua về, bạn rửa sạch với nước rồi khử mùi hôi. Bạn có thể khử mùi hôi cho vịt bằng rất nhiều cách: Trộn muối và giấm với nhau, dùng hỗn hợp này để bóp vịt cả bên trong lẫn ngoài; dùng chanh tươi chà xát lên thân vịt nhiều lần; bóp vịt với gừng giã nhuyễn hay rượu trắng,…. Cuối cùng, bạn rửa vịt lại với nước rồi để ráo, vịt đã sạch và hoàn toàn hết mùi hôi. Bước 2: Chuẩn bị nước ướp Nước ướp bạn pha theo tỷ lệ như sau: tiêu xay + hạt nêm + dầu hào + nước mắm Bước 3: Chuẩn bị ướp vịt Dùng nước ướp vừa pha xoa lên mình vịt. Hành tây, cà rốt bạn gọt sạch vỏ rửa sạch và thái lát mỏng. Bước 4: Nướng vịt Cho vịt vào lò nướng để nướng, bạn cũng có thể dùng lò nướng hoặc dùng bếp than hoa Cứ nướng khoảng 20 phút bạn lại tưới một lớp nước ướp lên vịt để món ăn không bị khô. Làm như vậy khoảng 3 lần là thịt vịt sẽ chín tới và da vàng giòn. Khi vịt chín vàng đều là được. Bước 5: Hoàn thành Chặt vịt thành những miếng vừa ăn cho đều, đẹp mắt rồi xếp ra đĩa và trang trí cùng với cà rốt hành tây.","nutrition":{"kcal":116.9,"protein_g":6.2,"fat_g":6.6,"carbs_g":7.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05kst8m1mujucrpk","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Đường kính","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc mam","unlisted_ingredient_phrase:ruou trang","unlisted_ingredient_phrase:voi nuoc","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món mặn 5 tuổi","id":"mon_man_5_tuoi","kind":"age_scoped_food_category","baseLabel":"Món mặn"}],"source_age_group":{"label":"5 tuổi","id":"5_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p7rx05n9t8m1tx0cak7u#variant-1","name":"Xôi đậu xanh","detail_name":"Xôi đậu xanh","category":"Xôi","age_group":null,"serving":{"raw":"68.2 g / Dĩa vừa","quantity_value":68.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Gạo nếp cái","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Đậu xanh (đậu tắt)","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Cùi dừa già","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Vừng (đen, trắng)","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"}],"instructions_raw":"Gạo nếp và đậu xanh cho ra thau, đổ nước ấm ngập mặt gạo và đậu. Ngâm trong vòng 4-5 tiếng (hoặc trước khi đi ngủ ngâm gạo đỗ, sáng hôm sau nấu), tùy theo nếu có thời gian, còn nếu không thì 3 tiếng cũng được. Gạo và đậu sau khi ngâm nở to hơn, đem vo nhẹ, xóc, để ráo nước. Cho muối, đường vào xóc đều để gạo ngấm rồi đổ gạo và đậu vào nồi cơm điện. Cho nước sôi và nước cốt dừa vào xâm xấp mặt gạo, đảo đều rồi đậy nắp nồi cơm điện lại, nhấn nút Cook nấu như bình thường. Khoảng 5 phút khi nước bắt đầu sôi bạn mở nắp đảo đều để gạo và đậu chín đều, đều nước, đều hơi. Sau khi cạn nước nồi cơm điện sẽ chuyển qua chế độ hâm nóng bạn cứ để như vậy khoảng 10 phút thì bật lại nút nấu. Nồi cơm điện sẽ chuyển qua chế độ nấu lần 2. Bạn để như vậy 30 phút sau thì xôi chín. Múc xôi ra đĩa, rưới vừng đã rang lên và thưởng thức.","nutrition":{"kcal":249.4,"protein_g":8.3,"fat_g":5.9,"carbs_g":40.7},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p7rx05n9t8m1tx0cak7u","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:cot dua","unlisted_ingredient_phrase:nuoc cot","unlisted_ingredient_phrase:nuoc cot dua"],"source_categories":[{"label":"Xôi","id":"xoi","kind":"food_category","baseLabel":"Xôi"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"}]