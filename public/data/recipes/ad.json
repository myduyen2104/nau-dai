:"g"},{"name":"Dầu thực vật","quantity_raw":"10 g","quantity_value":10,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"2 g","quantity_value":2,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Luộc hoặc hấp cua chín và gỡ lấy thịt. Phần nước luộc để dành lại cho vào nước dùng, nêm gia vị vừa ăn. Phi hành tím với ít dầu điều cho thơm, sau đó vớt hành ra ngoài, để ráo nhằm giữ được độ giòn. Rửa thịt heo sạch, chần qua nước sôi, luộc chín trong nước dùng, vớt ra cắt mỏng Nhặt và rửa các loại rau ăn kèm, để ráo Khi ăn, bạn sắp miến vào tô, xếp thịt , cho cua đã gỡ thịt vào tô chan nước dùng vào. Để tô miến thêm hấp dẫn, bạn rắc thêm hành phi và hành lá trang trí.","nutrition":{"kcal":307.3,"protein_g":10,"fat_g":14,"carbs_g":36.4},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03hut8m1wc9f5ij6","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Miến dong khô","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:trong nuoc"],"source_categories":[{"label":"Món nước 3-4 tuổi","id":"mon_nuoc_3_4_tuoi","kind":"age_scoped_food_category","baseLabel":"Món nước"}],"source_age_group":{"label":"3-4 tuổi","id":"3_4_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6oq03ldt8m1fszvrowh#variant-1","name":"Mít non luộc","detail_name":"Mít non luộc","category":"Món luộc 8-18 tuổi","age_group":"8-18 tuổi","serving":{"raw":"100 g / Dĩa vừa","quantity_value":100,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":null,"instructions_raw":"Mít non gọt lớp vỏ ngoài, rửa với nước muối cho sạch. Nấu nước sôi cho thêm chút muối sau đó cho mít vào luộc 20 phút. Sau đó vớt mít ra để nguội","nutrition":{"kcal":31,"protein_g":2.3,"fat_g":0.4,"carbs_g":10.5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6oq03ldt8m1fszvrowh","quality_status":"missing_at_source","warnings":["ingredients_missing_from_detail","listing_count_not_visible_in_detail","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["unlisted_ingredient_phrase:mit non","unlisted_ingredient_phrase:voi nuoc"],"source_categories":[{"label":"Món luộc 8-18 tuổi","id":"mon_luoc_8_18_tuoi","kind":"age_scoped_food_category","baseLabel":"Món luộc"}],"source_age_group":{"label":"8-18 tuổi","id":"8_18_tuoi"},"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03nmt8m1gvnpyntl#variant-1","name":"Mực xào thập cẩm","detail_name":"Mực xào thập cẩm","category":"Món mặn","age_group":null,"serving":{"raw":"198.5 g / Dĩa vừa","quantity_value":198.5,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Mực tươi","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Cà chua","quantity_raw":"12 g","quantity_value":12,"quantity_unit":"g"},{"name":"Dưa chuột/ Dưa leo","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Dứa ta (thơm)","quantity_raw":"30 g","quantity_value":30,"quantity_unit":"g"},{"name":"Cần tây","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.5 g","quantity_value":0.5,"quantity_unit":"g"}],"instructions_raw":"Đầu mực đem chà xát với ít muối và rượu trắng để khử mùi hôi tanh, sau đó rửa sạch và cắt thành từng miếng nhỏ vừa ăn.Gừng, 1 ít hành tím bóc vỏ, cắt lát, cho vào nồi nước sôi trụng khoảng 30 giây, vớt ra ngoài để ráo. Cách làm này sẽ giúp mực mất mùi hôi tanh hoàn toàn và vẫn giữ lại độ ngọt thịt, hấp dẫn.Mực sau khi trụng xong, bạn để ráo, cho vào âu ướp với hạt nêm, đường mỗi loại ½ muỗng cà phê cùng dầu hào, 1 ít tiêu xay, trộn đều và để khoảng 10 phút cho mực ngấm gia vị.Ớt chuông rửa sạch, bỏ hạt, cắt thành từng miếng vuông nhỏ.Khóm gọt vỏ, bỏ mắt, cắt miếng vừa ăn.Hành tây bóc vỏ, cắt miếng vuông.Cà chua bi bỏ cuốn, rửa sạch và để ráo.Tỏi và hành tím bóc vỏ, băm nhuyễn.Hành lá, rau cần tàu làm sạch, cắt khúc.Đặt chảo lên bếp, đun nóng dầu ăn và phi thơm tỏi, hành tím băm. Bạn tiếp tục cho mực đã ướp vào xào. Sau 2 phút, bạn lần lượt cho khóm, ớt chuông, cà chua vào xào và nêm thêm đường, hạt nêm, dầu hào mỗi loại 1 muỗng cà phê cùng một ít tiêu xay.Khi thấy các nguyên liệu gần chín, bạn cho hành tây vào. Sau 2 phút, bạn cho tiếp hành lá, và rau cần tàu, đảo đều rồi tắt bếp.","nutrition":{"kcal":141.2,"protein_g":17.5,"fat_g":6,"carbs_g":5},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6or03nmt8m1gvnpyntl","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dưa chuột/ Dưa leo","unlisted_ingredient_phrase:ca chua bi","unlisted_ingredient_phrase:chua bi","unlisted_ingredient_phrase:dau hao","unlisted_ingredient_phrase:hanh la","unlisted_ingredient_phrase:hanh tay","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:nguyen lieu","unlisted_ingredient_phrase:ruou trang"],"source_categories":[{"label":"Món mặn","id":"mon_man","kind":"food_category","baseLabel":"Món mặn"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p6or03qst8m1alwjtjyg#variant-1","name":"Nộm đọt su su","detail_name":"Nộm đọt su su","category":"Món xào chay","age_group":null,"serving":{"raw":"122.2 g / Dĩa vừa","quantity_value":122.2,"quantity_unit":"g","portion_label":"Dĩa vừa"},"ingredients":[{"name":"Ngọn su su","quantity_raw":"100 g","quantity_value":100,"quantity_unit":"g"},{"name":"Giấm","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Ớt đỏ to","quantity_raw":"1 g","quantity_value":1,"quantity_unit":"g"},{"name":"Rau mùi","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Xì dầu","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.2 g","quantity_value":0.2,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Ngọn su su bỏ lá già, tướt bỏ sơ, bẻ thành những khúc vừa ăn, rửa sạch. Chần rau qua nước sôi khoảng 2 phút, rồi vớt ra để ráo. Tỏi, ớt băm nhuyễn. Trộn giấm, nước tương, đường thành hỗn hợp rồi trộn vào ngọn đọt su su đã chần, trộn đều lên cho ngấm gia vị. Thêm dầu ăn, hành phi vào trộn đều lên là có thể ăn ngay.","nutrition":{"kcal":82.9,"protein_g":3.6,"fat_g":5.1,"carbs_g":5.9},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p6or03qst8m1alwjtjyg","quality_status":"needs_review","warnings":["identical_recipe_content_on_distinct_source_urls","method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Muối","unlisted_ingredient_phrase:hon hop","unlisted_ingredient_phrase:nuoc tuong","identical_recipe_content_on_distinct_source_urls"],"source_categories":[{"label":"Món xào chay","id":"mon_xao_chay","kind":"food_category","baseLabel":"Món xào chay"}],"source_age_group":null,"source_tag_evidence_status":"captured_catalog_metadata"},{"id":"https://dinhduong2598.food/mon-an/cmrg0p72l03vyt8m1mm7lixaw#variant-1","name":"Phở bò (chín)","detail_name":"Phở bò (chín)","category":"Món nước 6-7 tuổi","age_group":"6-7 tuổi","serving":{"raw":"251.3 g / Tô nhỏ","quantity_value":251.3,"quantity_unit":"g","portion_label":"Tô nhỏ"},"ingredients":[{"name":"Bánh phở tươi","quantity_raw":"150 g","quantity_value":150,"quantity_unit":"g"},{"name":"Thịt bò loại 1","quantity_raw":"50 g","quantity_value":50,"quantity_unit":"g"},{"name":"Hành tây","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Giá đậu xanh","quantity_raw":"20 g","quantity_value":20,"quantity_unit":"g"},{"name":"Hành lá (hành hoa)","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Chanh","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"},{"name":"Dầu thực vật","quantity_raw":"7 g","quantity_value":7,"quantity_unit":"g"},{"name":"Đường kính","quantity_raw":"3 g","quantity_value":3,"quantity_unit":"g"},{"name":"Muối","quantity_raw":"0.3 g","quantity_value":0.3,"quantity_unit":"g"},{"name":"Tương ngô","quantity_raw":"5 g","quantity_value":5,"quantity_unit":"g"}],"instructions_raw":"Bước 1: Xương rửa sạch cho lên ninh cùng 1 chút muối. Nếu là xương bò thì nên nướng qua xương, sau đó luộc qua, đổ nước đầu đi rồi mới ninh tiếp. Ninh xương tối thiểu 6 tiếng (tối đa 12 tiếng) sẽ cho món nước dùng rất ngon. Có thể làm từ tối hôm trước, cho xương vào ninh để hôm sau có nồi nước dùng ngon. Bước 2: - Gừng, hành khô, quế, hồi, thảo quả nướng rồi đập dập, tất cả cho vào ninh cùng nồi nước xương. Khi gần được thì thêm 1 củ hành tây vào đun cùng tiếp. Khi nước dùng đã ninh xong thì thêm hạt nêm vừa ăn (chú ý hớt bỏ bọt trong quá trình ninh xương). Bước 3: Bắp bò rửa sạch, thái miếng vừa ăn. Hành, mùi tàu, rau mùi/húng rửa sạch, cắt ngắn. Bánh phở chần qua nước sôi. Bước 4: Tất cả xếp vào bát, chan nước dùng, thêm chanh, ớt là có bát phở xịn sò tại gia. Lưu ý nước dùng phải sôi ùng ục để thịt bò chín được nhé.","nutrition":{"kcal":364.6,"protein_g":16.8,"fat_g":9.5,"carbs_g":54.3},"source_url":"https://dinhduong2598.food/mon-an/cmrg0p72l03vyt8m1mm7lixaw","quality_status":"needs_review","warnings":["method_mentions_known_unlisted_ingredient_phrase"],"integrity_findings":["ingredient_not_mentioned_by_name:Dầu thực vật","ingredient_not_mentioned_by_name:Đường kính","ingredient_not_mentioned_by_name:Tương ngô","unlisted_ingredient_phrase:hat nem","unlisted_ingredient_phrase:mui tau","unlisted_ingredient_phrase:nuoc dung","unlisted_ingredient_phrase:rau mui","unlisted_ingredient_phrase:xuong bo"],"source_categories":[{"label"